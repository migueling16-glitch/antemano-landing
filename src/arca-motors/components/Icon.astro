const body = STROKE[name] ?? FILL[name] ?? '';
const isFill = name in FILL;
---
<svg
  class={`am-icon ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  aria-hidden="true"
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={body}
/>
