---
/**
 * Hero de la landing: "showroom" vertical.
 *  - Intro (1.ª vez por sesión, sin reduce): cortina negra con una línea roja tipo faro que se abre.
 *  - Titular gigante con letras que suben por máscara mientras el eje wdth de Saira pasa 75 → 125 → base.
 *  - Escenario en arco con 5–6 autos reales (fotos verticales), Ken Burns, cambio con barrido diagonal
 *    y línea neón; fondo con la misma foto desenfocada + "blob" que sigue al cursor (deriva en táctil).
 *  - Tarjeta flotante sincronizada (marca, año, enganche, mensualidad) con números que ruedan.
 *  - Barras tipo stories (botones), pausa con hover/foco/botón y fuera de pantalla.
 *  - Al hacer scroll: "cámara" que se aleja (scroll-driven con fallback JS).
 * Sin JS: primer auto fijo, todo visible. Con reduce: sin intro, sin autoplay, sin movimiento continuo.
 */
import Icon from './Icon.astro';
import { BASE, NEGOCIO, wa } from '../config';
import { enVenta, foto, dinero, urlAuto, ETIQUETA_CARROCERIA, type Vehiculo } from '../inventario';

/** Autos del escenario, en orden. Solo entran los que siguen disponibles y tienen foto. */
const FOLIOS = ['ARC-0213', 'ARC-0214', 'ARC-0216', 'ARC-0215', 'ARC-0221', 'ARC-0219'];
const DUR = 5600; // ms por auto

const disponibles = enVenta();
const nDisponibles = disponibles.filter((v) => v.estatus === 'disponible').length;
let autos = FOLIOS.map((f) => disponibles.find((v) => v.folio === f)).filter(
  (v): v is Vehiculo => !!v && v.estatus === 'disponible' && v.nFotos > 0,
);
if (autos.length < 2) autos = disponibles.filter((v) => v.estatus === 'disponible' && v.nFotos > 0).slice(0, 6);

const slides = autos.map((v) => ({
  v,
  folio: v.folio.toLowerCase(),
  marca: v.marca,
  modelo: [v.modelo, v.version].filter(Boolean).join(' '),
  anio: String(v.anio),
  tipo: ETIQUETA_CARROCERIA[v.carroceria],
  eng: dinero(v.enganche),
  mes: dinero(v.mensualidad),
  url: urlAuto(v),
  nombre: `${v.marca} ${v.modelo}${v.version ? ' ' + v.version : ''} ${v.anio}`,
}));
const data = slides.map(({ v, ...s }) => s);
const first = slides[0];
const pad = (n: number) => String(n).padStart(2, '0');
// Dirección del Ken Burns de cada auto (alterna para que no se sienta repetido).
const KX = ['-2%', '2%', '-1.5%', '1.5%', '-2.5%', '2.5%'];
// Titular partido en palabras y letras desde el servidor: no depende de que cargue el JS (antes se
// ocultaba hasta 1.5 s y "brincaba" al aparecer). Cada línea va en su propio bloque.
const TITULO = [
  [{ t: 'Excelencia', c: 'am-silver-text' }],
  [{ t: 'en', c: 'am-silver-text' }, { t: 'seminuevos.', c: 'am-red-text' }],
];
let ci = 0;
const lineas = TITULO.map((ws) => ws.map((w) => ({ c: w.c, chars: [...w.t].map((ch) => ({ ch, i: ci++ })) })));
---
<script is:inline>
  // Intro solo la primera vez por sesión, con JS y con movimiento. La cortina no se abre hasta que la
  // foto del primer auto y las fuentes están listas (mín. 0.9 s, tope 2.6 s): así nunca se abre sobre
  // un escenario vacío. .hx-go arranca la apertura y la entrada del contenido.
  (function (h) {
    var go = function () { h.classList.add('hx-go'); };
    try {
      if (!h.classList.contains('am-anim') || sessionStorage.getItem('arca-intro')) { go(); return; }
      sessionStorage.setItem('arca-intro', '1');
    } catch (e) { go(); return; }
    h.classList.add('am-intro');
    var t0 = Date.now(), done = false;
    var open = function () {
      if (done) return; done = true;
      setTimeout(go, Math.max(0, 900 - (Date.now() - t0)));
    };
    setTimeout(open, 2600);
    document.addEventListener('DOMContentLoaded', function () {
      var img = document.querySelector('.hx__slide.is-active .hx__img');
      var waits = [];
      if (document.fonts && document.fonts.ready) waits.push(document.fonts.ready);
      if (img && img.decode) waits.push(img.decode().catch(function () {}));
      Promise.all(waits).then(open, open);
    });
  })(document.documentElement);
</script>

<div class="hx-intro" aria-hidden="true">
  <span class="hx-intro__half hx-intro__half--t">
    <img class="hx-intro__mark" src="/arca-motors/brand/arca-wordmark-solo-dark.svg" alt="" width="190" height="18" />
  </span>
  <span class="hx-intro__half hx-intro__half--b"></span>
  <span class="hx-intro__line"></span>
  <span class="hx-intro__beam"></span>
</div>

<section
  class="hx am-under-header"
  data-hero
  data-spotlight
  data-dur={DUR}
  data-slides={JSON.stringify(data)}
  aria-labelledby="hx-title"
  style={`--hx-dur:${DUR}ms`}
>
  <!-- Fondo: la misma foto desenfocada + capa "iluminada" revelada por el blob del cursor -->
  <div class="hx__bgcam" aria-hidden="true">
    <div class="hx__bg">
      {slides.map((s, i) => (
        <img class:list={['hx__bgimg', { 'is-active': i === 0 }]} src={foto(s.v, 0, 800).replace(/01-800\.webp$/, 'bg.webp')} alt="" width="96" height="128" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
      ))}
    </div>
    <div class="hx__lit">
      {slides.map((s, i) => (
        <img class:list={['hx__bgimg hx__litimg', { 'is-active': i === 0 }]} src={foto(s.v, 0, 800)} alt="" width="800" height="1066" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? undefined : 'low'} decoding="async" />
      ))}
    </div>
  </div>
  <span class="am-spotlight hx__spot" aria-hidden="true"></span>
  <div class="hx__scrim" aria-hidden="true"></div>
  <div class="hx__ghost am-loop" aria-hidden="true">
    <div class="hx__ghost-track"><span>Seminuevos</span><span>Seminuevos</span></div>
  </div>

  <div class="am-wrap hx__in">
    <div class="hx__copy">
      <div class="hx__copycam">
        <p class="am-kicker hx__kicker">
          <span class="am-pulse-dot" aria-hidden="true"></span>
          <span>{NEGOCIO.ciudad} · <span data-count data-count-dur="2000">{nDisponibles}</span> unidades disponibles</span>
        </p>
        <h1 class="hx__title" id="hx-title" data-kinetic data-kinetic-radius="320" data-split-done="1" aria-label="Excelencia en seminuevos.">
          {lineas.map((ws) => (
            <span class="hx__line">
              {ws.map((w, k) => (
                <>{k > 0 && ' '}<span class="am-w" aria-hidden="true"><span class="am-w__i">{w.chars.map(({ ch, i }) => <span class={`am-ch ${w.c}`} style={`--ci:${i}`}>{ch}</span>)}</span></span></>
              ))}
            </span>
          ))}
        </h1>
      </div>
    </div>

    {first && (
      <div class="hx__visual">
        <div class="hx__cam">
          <span class="hx__halo" aria-hidden="true"></span>
          <div class="hx__stage" data-cursor="Ver">
            {slides.map((s, i) => (
              <a
                class:list={['hx__slide', { 'is-active': i === 0 }]}
                href={s.url}
                tabindex="-1"
                aria-hidden="true"
                data-hero-link
                style={`--kx:${KX[i % KX.length]}`}
              >
                <span class="hx__kb">
                  <img
                    class="hx__img"
                    src={foto(s.v, 0, 1280)}
                    srcset={`${foto(s.v, 0, 800)} 800w, ${foto(s.v, 0, 1280)} 1280w`}
                    sizes="(max-width: 999px) 92vw, 560px"
                    alt=""
                    width="960"
                    height="1280"
                    loading={i === 0 ? 'eager' : 'lazy'}
                    fetchpriority={i === 0 ? 'high' : 'low'}
                    decoding="async"
                  />
                </span>
              </a>
            ))}
            <span class="hx__shade" aria-hidden="true"></span>
            <span class="hx__wipe" aria-hidden="true"></span>
            <span class="hx__tag" aria-hidden="true">
              <span class="am-pulse-dot"></span> Disponible
              <span class="hx__tag-sep"></span>
              <span class="hx-roll" data-roll="folio" data-v={first.folio.toUpperCase()}><span class="hx-roll__set">{first.folio.toUpperCase()}</span></span>
            </span>
          </div>
        </div>

        <div class="hx__cardcam">
          <div class="hx__card">
            <p class="hx-sr" data-hero-live aria-live="off">{first.nombre}. Enganche {first.eng}, mensualidad {first.mes}.</p>
            <div aria-hidden="true">
              <div class="hx__card-top">
                <p class="hx__card-k">
                  <span class="hx-roll" data-roll="marca" data-v={first.marca}><span class="hx-roll__set">{first.marca}</span></span>
                  <span class="hx__sep"></span>
                  <span class="hx-roll" data-roll="anio" data-v={first.anio}><span class="hx-roll__set">{first.anio}</span></span>
                </p>
                <p class="hx__card-idx">
                  <span class="hx-roll" data-roll="idx" data-v="01"><span class="hx-roll__set">01</span></span><span class="hx__card-tot">/{pad(slides.length)}</span>
                </p>
              </div>
              <p class="hx__card-name"><span class="hx-roll" data-roll="modelo" data-v={first.modelo}><span class="hx-roll__set">{first.modelo}</span></span></p>
              <dl class="hx__card-plan">
                <div>
                  <dt>Enganche</dt>
                  <dd><span class="hx-roll" data-roll="eng" data-v={first.eng}><span class="hx-roll__set">{first.eng}</span></span></dd>
                </div>
                <div>
                  <dt>Mensualidad</dt>
                  <dd class="hx__mes"><span class="hx-roll" data-roll="mes" data-v={first.mes}><span class="hx-roll__set">{first.mes}</span></span>*</dd>
                </div>
              </dl>
            </div>
            <a class="am-btn am-btn--red hx__go" href={first.url} data-hero-link data-cursor="Ver" data-magnetic="0.25" aria-label={`Ver este auto: ${first.nombre}`}>
              Ver este auto <Icon name="arrowUpRight" size={16} />
            </a>
          </div>
        </div>

        <div class="hx__ctrl">
          <div class="hx__bars" role="group" aria-label="Elegir auto">
            {slides.map((s, i) => (
              <button type="button" class="hx__bar" data-goto={i} aria-label={`Ver ${s.nombre}`} aria-current={i === 0 ? 'true' : undefined}>
                <span class="hx__bar-fill"></span>
              </button>
            ))}
          </div>
          <button type="button" class="hx__pause" data-hero-pause aria-label="Pausar presentación">
            <svg class="hx__pause-i" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1" fill="currentColor" /><rect x="14" y="5" width="4" height="14" rx="1" fill="currentColor" /></svg>
            <svg class="hx__play-i" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor" /></svg>
          </button>
        </div>
      </div>
    )}

    <div class="hx__foot">
      <div class="hx__footcam">
        <p class="am-lead hx__lead">Camionetas y autos seleccionados uno por uno, la mayoría de único dueño y con factura de agencia. Estrena con enganche accesible y mensualidades cómodas.</p>
        <div class="hx__ctas">
          <a class="am-btn am-btn--red am-btn--lg" href={`${BASE}/catalogo/`} data-magnetic>Ver catálogo <Icon name="arrow" size={18} /></a>
          <a class="am-btn am-btn--ghost am-btn--lg" href={wa('Hola Arca Motors, busco un auto y quiero que me asesoren.')} target="_blank" rel="noopener" data-magnetic="0.25"><Icon name="whatsapp" size={18} /> Escríbenos</a>
        </div>
        <a class="hx__scroll" href="#buscar" aria-label="Desliza: bajar al buscador">
          <span class="hx__mouse" aria-hidden="true"></span>
          <span aria-hidden="true">Desliza</span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  type Slide = { folio: string; marca: string; modelo: string; anio: string; tipo: string; eng: string; mes: string; url: string; nombre: string };

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) initHero(hero);

  function initHero(hero: HTMLElement) {
    const reduceMQ = matchMedia(document.documentElement.classList.contains('am-anim') ? 'not all' : 'all');
    const motion = () => !reduceMQ.matches;
    const lite = document.documentElement.classList.contains('is-touch');
    const $ = <T extends Element = HTMLElement>(s: string) => hero.querySelector<T>(s);
    const $$ = <T extends Element = HTMLElement>(s: string) => [...hero.querySelectorAll<T>(s)];

    /* ---- cámara: fallback JS para navegadores sin animation-timeline ---- */
    if (motion() && !document.documentElement.classList.contains('is-touch') && !CSS.supports('animation-timeline', 'scroll()')) {
      let raf = 0;
      let last = -1;
      const upd = () => {
        raf = 0;
        const p = Math.min(1, Math.max(0, window.scrollY / Math.max(1, window.innerHeight)));
        if (p === last) return;
        last = p;
        hero.style.setProperty('--hp', p.toFixed(4));
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(upd); }, { passive: true });
      upd();
    }

    let data: Slide[] = [];
    try { data = JSON.parse(hero.dataset.slides || '[]'); } catch { data = []; }
    const n = data.length;
    const slides = $$('.hx__slide');
    if (n < 2 || slides.length !== n) return;

    const bgs = $$('.hx__bg .hx__bgimg');
    const lits = $$('.hx__lit .hx__bgimg');
    const bars = $$<HTMLButtonElement>('[data-goto]');
    const stage = $('.hx__stage')!;
    const visual = $('.hx__visual')!;
    const go = $<HTMLAnchorElement>('.hx__go')!;
    const live = $('[data-hero-live]')!;
    const pauseBtn = $<HTMLButtonElement>('[data-hero-pause]')!;
    const rolls = new Map<string, HTMLElement>();
    $$('[data-roll]').forEach((el) => rolls.set(el.dataset.roll!, el));

    let cur = 0;
    let manual = false;
    let hover = false;
    let focus = false;
    let off = false;
    let leaveT = 0;

    hero.classList.add('is-live');
    if (motion()) hero.classList.add('is-auto');

    const sync = () => {
      hero.classList.toggle('is-paused', manual || hover || focus || off || document.hidden);
      // Mientras rota solo, el lector de pantalla no recibe avisos; si el usuario controla, sí.
      live.setAttribute('aria-live', manual || focus || !hero.classList.contains('is-auto') ? 'polite' : 'off');
    };

    const roll = (key: string, text: string) => {
      const el = rolls.get(key);
      if (!el || el.dataset.v === text) return;
      el.dataset.v = text;
      if (!motion()) { el.textContent = text; return; }
      el.querySelectorAll('.hx-roll__set.is-out').forEach((o) => o.remove());
      const old = el.querySelector('.hx-roll__set');
      const set = document.createElement('span');
      set.className = 'hx-roll__set';
      // En táctil rueda el texto completo (un elemento), no letra por letra (~70 animaciones por cambio).
      if (lite) {
        set.textContent = text;
        if (old) { old.classList.add('is-out'); window.setTimeout(() => old.remove(), 500); }
        el.append(set);
        return;
      }
      [...text].forEach((ch, i) => {
        const s = document.createElement('span');
        s.className = 'hx-roll__ch';
        s.style.setProperty('--i', String(i));
        s.textContent = ch === ' ' ? ' ' : ch;
        set.append(s);
      });
      if (old) {
        // El primer texto viene del servidor sin partir en letras: se parte aquí para que también salga animado.
        if (!old.querySelector('.hx-roll__ch')) {
          const t = old.textContent || '';
          old.textContent = '';
          [...t].forEach((ch, i) => {
            const s = document.createElement('span');
            s.className = 'hx-roll__ch';
            s.style.setProperty('--i', String(i));
            s.textContent = ch === ' ' ? ' ' : ch;
            old.append(s);
          });
        }
        old.classList.add('is-out');
        window.setTimeout(() => old.remove(), 800);
      }
      el.append(set);
    };

    function show(target: number) {
      const i = ((target % n) + n) % n;
      if (i === cur) return;
      const prev = cur;
      cur = i;
      hero.classList.add('is-cycled');
      const a = slides[prev];
      const b = slides[i];
      slides.forEach((s, k) => { if (k !== prev && k !== i) s.classList.remove('is-leaving', 'is-entering'); });
      a.classList.remove('is-active', 'is-entering');
      b.classList.remove('is-leaving', 'is-entering');
      if (motion()) {
        a.classList.add('is-leaving');
        void b.offsetWidth;
        b.classList.add('is-entering');
        stage.classList.remove('is-wiping');
        void stage.offsetWidth;
        stage.classList.add('is-wiping');
      }
      b.classList.add('is-active');
      bgs.forEach((im, k) => im.classList.toggle('is-active', k === i));
      lits.forEach((im, k) => im.classList.toggle('is-active', k === i));
      bars.forEach((bt, k) => {
        if (k === i) bt.setAttribute('aria-current', 'true');
        else bt.removeAttribute('aria-current');
        bt.classList.toggle('is-done', k < i);
      });
      const d = data[i];
      roll('marca', d.marca);
      roll('anio', d.anio);
      roll('modelo', d.modelo);
      roll('eng', d.eng);
      roll('mes', d.mes);
      roll('idx', String(i + 1).padStart(2, '0'));
      roll('folio', d.folio.toUpperCase());
      go.href = d.url;
      go.setAttribute('aria-label', `Ver este auto: ${d.nombre}`);
      live.textContent = `${d.nombre}. Enganche ${d.eng}, mensualidad ${d.mes}.`;
      clearTimeout(leaveT);
      leaveT = window.setTimeout(() => {
        slides.forEach((s) => { if (!s.classList.contains('is-active')) s.classList.remove('is-leaving', 'is-entering'); });
        stage.classList.remove('is-wiping');
      }, 1400);
    }

    // El avance lo marca la propia animación de la barra (así la pausa CSS lo pausa todo).
    hero.addEventListener('animationend', (e) => {
      if (e.animationName !== 'hx-fill') return;
      const bar = (e.target as Element).closest('[data-goto]');
      if (bar && bar.getAttribute('aria-current') === 'true') show(cur + 1);
    });
    bars.forEach((b, k) => b.addEventListener('click', () => show(k)));

    pauseBtn.addEventListener('click', () => {
      manual = !manual;
      pauseBtn.classList.toggle('is-manual', manual);
      pauseBtn.setAttribute('aria-label', manual ? 'Reanudar presentación' : 'Pausar presentación');
      sync();
    });
    visual.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { hover = true; sync(); } });
    visual.addEventListener('pointerleave', () => { hover = false; sync(); });
    // Solo el foco de teclado pausa (un clic con mouse en una barra no debe dejarlo detenido).
    visual.addEventListener('focusin', (e) => {
      let kb = true;
      try { kb = (e.target as Element).matches(':focus-visible'); } catch { kb = true; }
      if (kb) { focus = true; sync(); }
    });
    visual.addEventListener('focusout', (e) => {
      if (!visual.contains(e.relatedTarget as Node | null)) { focus = false; sync(); }
    });
    document.addEventListener('visibilitychange', sync);
    new IntersectionObserver((en) => { off = !en[0].isIntersecting; sync(); }, { threshold: 0.05 }).observe(hero);

    // Deslizar el escenario en táctil cambia de auto (y no abre la ficha).
    let sx = 0;
    let sy = 0;
    let swiped = 0;
    stage.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      const t = e.changedTouches[0];
      const dx = t.clientX - sx;
      if (Math.abs(dx) > 44 && Math.abs(dx) > Math.abs(t.clientY - sy) * 1.3) {
        swiped = performance.now();
        show(cur + (dx < 0 ? 1 : -1));
      }
    }, { passive: true });
    stage.addEventListener('click', (e) => { if (performance.now() - swiped < 450) e.preventDefault(); });

    // View Transition: la foto del escenario "vuela" a la ficha. Le cede el nombre la tarjeta que lo tenga.
    const claimed: [HTMLElement, string][] = [];
    hero.addEventListener('click', (e) => {
      const link = (e.target as Element).closest('[data-hero-link]');
      if (!link || !motion()) return;
      const img = slides[cur].querySelector<HTMLElement>('.hx__img');
      if (!img) return;
      const name = `car-${data[cur].folio}`;
      document.querySelectorAll<HTMLElement>('[style*="view-transition-name"]').forEach((el) => {
        if (el !== img && el.style.viewTransitionName === name) {
          el.style.viewTransitionName = 'none';
          claimed.push([el, name]);
        }
      });
      slides.forEach((s) => { const im = s.querySelector<HTMLElement>('.hx__img'); if (im) im.style.viewTransitionName = ''; });
      img.style.viewTransitionName = name;
    });
    addEventListener('pageshow', (e) => {
      if (!e.persisted) return;
      claimed.splice(0).forEach(([el, name]) => { el.style.viewTransitionName = name; });
      slides.forEach((s) => { const im = s.querySelector<HTMLElement>('.hx__img'); if (im) im.style.viewTransitionName = ''; });
    });

    sync();
  }
</script>

<style>
  /* =========================================================== INTRO */
  .hx-intro { display: none; }
  
    /* Fase 1 (al cargar): línea, faro y logo. Fase 2 (.hx-go, cuando ya cargó la foto): se abre.
       Las animaciones de la fase 2 tienen nombre propio para que empiecen cuando llega la clase.
       Si el script fallara, la cortina se quita sola a los 4 s. */
    :global(html.am-anim.am-intro) .hx-intro { display: block; position: fixed; inset: 0; z-index: 80; pointer-events: none; animation: hx-gone 10ms linear 4s forwards; }
    :global(html.am-anim.am-intro.hx-go) .hx-intro { animation: hx-gone2 10ms linear .9s forwards; }
    :global(html.am-anim.am-intro.hx-go) .hx-intro__half--t { animation: hx-open-t .8s var(--am-ease-io) forwards; }
    :global(html.am-anim.am-intro.hx-go) .hx-intro__half--b { animation: hx-open-b .8s var(--am-ease-io) forwards; }
    :global(html.am-anim.am-intro) .hx-intro__line { animation: hx-line-in .6s var(--am-ease-out) .05s forwards; }
    :global(html.am-anim.am-intro.hx-go) .hx-intro__line { transform: scaleX(1); animation: hx-line-out .6s var(--am-ease-io) .04s forwards; }
    :global(html.am-anim.am-intro) .hx-intro__beam { animation: hx-beam .95s var(--am-ease-io) .02s forwards; }
    :global(html.am-anim.am-intro) .hx-intro__mark { animation: hx-mark .5s var(--am-ease-out) .12s forwards; }
    :global(html.am-anim.am-intro.hx-go) .hx-intro__mark { opacity: 1; }
  
  .hx-intro__half { position: absolute; left: 0; right: 0; height: 50.5%; background: #070708; }
  .hx-intro__half--t { top: 0; }
  .hx-intro__half--b { bottom: 0; }
  .hx-intro__mark { position: absolute; left: 50%; bottom: 26px; width: min(240px, 56vw); height: auto; translate: -50% 0; opacity: 0; }
  .hx-intro__line {
    position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; transform: scaleX(0);
    background: linear-gradient(90deg, transparent, var(--am-red) 14%, #fff 50%, var(--am-red) 86%, transparent);
    box-shadow: 0 0 18px 3px rgba(255, 42, 31, .6), 0 0 60px 12px rgba(255, 42, 31, .22);
  }
  .hx-intro__beam {
    position: absolute; left: 0; top: 50%; width: 46vw; height: 36vh; margin-top: -18vh; opacity: 0;
    background: radial-gradient(closest-side, rgba(255, 255, 255, .9), rgba(255, 90, 76, .5) 32%, rgba(255, 42, 31, .14) 62%, transparent);
    mix-blend-mode: screen;
  }
  @keyframes hx-gone { to { visibility: hidden; } }
  @keyframes hx-gone2 { to { visibility: hidden; } }
  @keyframes hx-open-t { to { transform: translateY(-101%); } }
  @keyframes hx-open-b { to { transform: translateY(101%); } }
  @keyframes hx-line-in { to { transform: scaleX(1); } }
  @keyframes hx-line-out { from { transform: scaleX(1); opacity: 1; } to { transform: scaleX(1) scaleY(34); opacity: 0; } }
  @keyframes hx-beam {
    0% { opacity: 0; transform: translateX(-50vw) scaleY(.2); }
    25% { opacity: 1; }
    70% { opacity: .9; }
    100% { opacity: 0; transform: translateX(110vw) scaleY(.4); }
  }
  @keyframes hx-mark { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

  /* =========================================================== HERO: capas */
  .hx {
    --hero-d: .15s;
    position: relative; isolation: isolate; overflow: hidden;
    background: var(--am-bg);
  }
  :global(html.am-intro) .hx { --hero-d: .4s; }

  .hx__bgcam { position: absolute; inset: 0; z-index: 0; transform-origin: 50% 30%; }
  .hx__bg, .hx__lit { position: absolute; inset: 0; }
  .hx__bgimg {
    position: absolute; left: -6%; top: -6%; width: 112%; height: 112%; max-width: none;
    object-fit: cover; object-position: center 60%;
    /* bg.webp ya viene desenfocado y oscurecido (brand-src/hero-bg.mjs): sin filter en vivo. */
    opacity: 0; visibility: hidden; transform: scale(1.06);
    transition: opacity 1.2s ease, visibility 0s linear 1.2s;
  }
  .hx__bgimg.is-active { opacity: 1; visibility: visible; transition: opacity 1.2s ease, visibility 0s; }
  /* Capa iluminada: la misma foto nítida y saturada, revelada por un blob que sigue al puntero (--sx --sy los pone motion.ts). */
  .hx__lit .hx__bgimg { left: 0; top: 0; width: 100%; height: 100%; filter: brightness(.92) saturate(1.35) contrast(1.06); transform: scale(1.02); }
  @property --hx-bx { syntax: '<length>'; inherits: true; initial-value: 0px; }
  @property --hx-by { syntax: '<length>'; inherits: true; initial-value: 0px; }
  .hx__lit {
    --r: clamp(170px, 22vw, 340px);
    --hx-bx: 70px; --hx-by: -40px;
    -webkit-mask-image:
      radial-gradient(circle var(--r) at var(--sx, 72%) var(--sy, 45%), #000 0%, rgba(0, 0, 0, .55) 42%, transparent 100%),
      radial-gradient(circle calc(var(--r) * .6) at calc(var(--sx, 72%) + var(--hx-bx)) calc(var(--sy, 45%) + var(--hx-by)), rgba(0, 0, 0, .9), transparent 100%);
    mask-image:
      radial-gradient(circle var(--r) at var(--sx, 72%) var(--sy, 45%), #000 0%, rgba(0, 0, 0, .55) 42%, transparent 100%),
      radial-gradient(circle calc(var(--r) * .6) at calc(var(--sx, 72%) + var(--hx-bx)) calc(var(--sy, 45%) + var(--hx-by)), rgba(0, 0, 0, .9), transparent 100%);
  }
  .hx__spot { z-index: 1; --am-spot-size: min(95vmax, 1100px); opacity: .85; }
  .hx__scrim {
    position: absolute; inset: 0; z-index: 2; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(7, 7, 8, .9) 0%, rgba(7, 7, 8, .55) 36%, rgba(7, 7, 8, .08) 68%, rgba(7, 7, 8, .35) 100%),
      linear-gradient(180deg, rgba(7, 7, 8, .55) 0%, transparent 24%, transparent 70%, var(--am-bg) 100%);
  }
  .hx__ghost { position: absolute; left: 0; right: 0; bottom: 9%; z-index: 3; pointer-events: none; }
  .hx__ghost-track { display: flex; width: max-content; }
  .hx__ghost-track span {
    padding-right: 6vw; font-family: var(--am-display); font-weight: 800; font-stretch: 125%;
    font-size: clamp(120px, 21vw, 360px); line-height: .8; letter-spacing: -.02em; text-transform: uppercase;
    color: transparent; -webkit-text-stroke: 1px rgba(232, 234, 237, .13); user-select: none;
  }

  /* =========================================================== HERO: layout */
  .hx__in {
    /* min-height en la propia grilla: así las filas fr se reparten el alto de la pantalla */
    position: relative; z-index: 4; max-width: 1440px;
    min-height: calc(max(100svh, 640px) - var(--am-header-h));
    display: grid; align-items: center;
    padding-top: clamp(12px, 3vh, 36px); padding-bottom: clamp(100px, 13vh, 150px);
  }
  .hx__copy { grid-area: copy; position: relative; z-index: 3; min-width: 0; }
  .hx__foot { grid-area: foot; position: relative; z-index: 3; min-width: 0; }
  /* El texto va encima del escenario: sus cajas no deben tapar los clics de la tarjeta flotante. */
  .hx__copy, .hx__foot, .hx__copycam, .hx__footcam, .hx__ctas { pointer-events: none; }
  .hx__kicker, .hx__title, .hx__lead, .hx__ctas > *, .hx__scroll { pointer-events: auto; }
  .hx__visual { grid-area: visual; position: relative; z-index: 2; width: calc(var(--stage-h) * .75); }

  @media (min-width: 1000px) {
    .hx__in {
      --stage-h: clamp(400px, min(100svh - 300px, 54vw), 720px);
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: minmax(0, .8fr) minmax(0, 1.2fr);
      grid-template-areas: 'copy visual' 'foot visual';
      column-gap: clamp(28px, 4vw, 72px);
    }
    .hx__copy { align-self: end; }
    .hx__foot { align-self: start; padding-top: 4px; }
    .hx__visual { align-self: center; }
    .hx__title { white-space: nowrap; }
  }
  @media (max-width: 999px) {
    .hx__in {
      --stage-h: min(calc((100vw - 2 * var(--am-gutter)) * 4 / 3), 62svh, 600px);
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'copy' 'visual' 'foot';
      row-gap: 22px;
    }
    .hx__visual { justify-self: center; max-width: 100%; }
    .hx__scrim {
      background: linear-gradient(180deg, rgba(7, 7, 8, .78) 0%, rgba(7, 7, 8, .35) 30%, rgba(7, 7, 8, .45) 62%, var(--am-bg) 100%);
    }
    .hx__ghost { bottom: auto; top: 34%; }
  }

  /* =========================================================== HERO: copy */
  .hx__kicker::before { display: none; }
  .hx__kicker { margin-bottom: 18px; color: #ffb0a8; }
  .hx__title {
    margin: 0; font-family: var(--am-display); font-weight: 800; font-stretch: 118%;
    font-size: clamp(40px, 11.6vw, 84px); line-height: .94; letter-spacing: -.02em;
    filter: drop-shadow(0 10px 30px rgba(0, 0, 0, .55));
  }
  @media (min-width: 1000px) { .hx__title { font-size: clamp(56px, 6.4vw, 108px); } }
  .hx__line { display: block; white-space: nowrap; }
  .hx__title .am-ch { --am-k: 118; }
  .hx__lead { max-width: 46ch; margin-top: 0; color: #b4b8bf; }
  .hx__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  @media (max-width: 520px) { .hx__ctas .am-btn { flex: 1 1 100%; } }
  .hx__scroll {
    display: inline-flex; align-items: center; gap: 12px; min-height: 44px; margin-top: 26px;
    font-family: var(--am-display); font-weight: 600; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: var(--am-dim);
    transition: color .3s ease;
  }
  .hx__scroll:hover { color: var(--am-text); }
  .hx__mouse { position: relative; width: 22px; height: 34px; box-sizing: border-box; border: 1.5px solid rgba(255, 255, 255, .32); border-radius: 12px; }
  .hx__mouse::after { content: ''; position: absolute; left: 50%; top: 6px; width: 3px; height: 7px; margin-left: -1.5px; border-radius: 2px; background: var(--am-red-hi); box-shadow: 0 0 8px var(--am-neon); }
  :global(html.is-touch) .hx__mouse { width: 2px; border: 0; border-radius: 2px; background: rgba(255, 255, 255, .2); }
  :global(html.is-touch) .hx__mouse::after { width: 4px; height: 10px; margin-left: -2px; top: 0; }

  /* =========================================================== HERO: escenario en arco */
  .hx__cam { position: relative; isolation: isolate; }
  .hx__cam::after {
    content: ''; position: absolute; inset: -34px; z-index: -1; pointer-events: none;
    border: 1px solid rgba(255, 255, 255, .06);
    border-radius: 50% 50% 40px 40px / 37.5% 37.5% 40px 40px;
  }
  @property --hx-ang { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .hx__halo {
    position: absolute; inset: -12px; z-index: -1; pointer-events: none; padding: 1px;
    border-radius: 50% 50% 32px 32px / 37.5% 37.5% 32px 32px;
    background: conic-gradient(from var(--hx-ang), rgba(255, 74, 61, 0) 0deg, rgba(255, 74, 61, .95) 46deg, rgba(255, 236, 232, .85) 60deg, rgba(255, 74, 61, 0) 118deg, rgba(255, 255, 255, .14) 210deg, rgba(255, 74, 61, 0) 360deg);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    filter: drop-shadow(0 0 8px rgba(255, 42, 31, .5));
  }
  .hx__stage {
    position: relative; width: 100%; aspect-ratio: 3 / 4; overflow: hidden; isolation: isolate;
    border-radius: 50% 50% 24px 24px / 37.5% 37.5% 24px 24px;
    background: #0b0b0c;
    box-shadow: 0 50px 90px -40px rgba(0, 0, 0, .95), 0 0 90px -30px rgba(255, 42, 31, .45), inset 0 0 0 1px rgba(255, 255, 255, .08);
  }
  .hx__slide { position: absolute; inset: 0; display: block; overflow: hidden; visibility: hidden; pointer-events: none; z-index: 0; }
  .hx__slide.is-active { visibility: visible; pointer-events: auto; z-index: 2; }
  .hx__slide.is-leaving { visibility: visible; z-index: 1; }
  .hx__kb { position: absolute; inset: 0; display: block; }
  .hx__img { width: 100%; height: 100%; object-fit: cover; object-position: center 58%; }
  .hx__shade {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background: linear-gradient(180deg, rgba(0, 0, 0, .5) 0%, transparent 22%, transparent 64%, rgba(0, 0, 0, .5) 100%);
  }
  .hx__tag {
    position: absolute; left: 50%; top: 8.5%; z-index: 4; translate: -50% 0;
    display: inline-flex; align-items: center; gap: 8px; white-space: nowrap;
    padding: 6px 12px; border-radius: 999px; background: rgba(7, 7, 8, .55); border: 1px solid rgba(255, 255, 255, .12);
    -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
    font-family: var(--am-display); font-stretch: 112%; font-weight: 600; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: #e9ebee;
  }
  .hx__tag-sep { width: 1px; height: 10px; background: rgba(255, 255, 255, .25); }
  /* Línea neón que acompaña el borde del barrido diagonal. */
  .hx__wipe { position: absolute; top: -10%; bottom: -10%; left: 0; width: 100%; z-index: 5; pointer-events: none; opacity: 0; transform: translateX(130%) skewX(-8.5deg); }
  .hx__wipe::before {
    content: ''; position: absolute; left: -1.5px; top: 0; bottom: 0; width: 3px;
    background: linear-gradient(180deg, transparent, #ff4a3d 18%, #fff 50%, #ff4a3d 82%, transparent);
    box-shadow: 0 0 22px 5px rgba(255, 42, 31, .6);
  }
  .hx__wipe::after { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 140px; background: linear-gradient(90deg, rgba(255, 74, 61, .32), transparent); mix-blend-mode: screen; }

  /* =========================================================== HERO: tarjeta flotante */
  .hx__cardcam { position: absolute; z-index: 6; left: calc(-1 * clamp(56px, 8vw, 150px)); bottom: 86px; width: min(300px, 78%); }
  @media (max-width: 999px) {
    .hx__cardcam { position: relative; left: auto; bottom: auto; width: auto; margin: -64px 14px 0; }
  }
  .hx__card {
    position: relative; padding: 16px 18px 18px; border-radius: 20px;
    background: rgba(14, 14, 17, .64); border: 1px solid rgba(255, 255, 255, .12);
    -webkit-backdrop-filter: saturate(1.6) blur(18px); backdrop-filter: saturate(1.6) blur(18px);
    box-shadow: 0 30px 60px -24px rgba(0, 0, 0, .95), inset 0 1px 0 rgba(255, 255, 255, .08);
  }
  .hx__card::before { content: ''; position: absolute; left: 18px; right: 18px; top: -1px; height: 1px; background: linear-gradient(90deg, transparent, var(--am-red-hi), transparent); box-shadow: 0 0 12px var(--am-neon); }
  .hx-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; margin: -1px; }
  .hx__card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .hx__card-k { margin: 0; display: flex; align-items: center; gap: 8px; font-size: 11.5px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--am-muted); }
  .hx__sep { width: 4px; height: 4px; border-radius: 50%; background: var(--am-red-hi); box-shadow: 0 0 8px var(--am-neon); }
  .hx__card-idx { margin: 0; font-family: var(--am-display); font-stretch: 110%; font-weight: 700; font-size: 13px; color: var(--am-text); font-variant-numeric: tabular-nums; }
  .hx__card-tot { color: var(--am-dim); font-weight: 500; }
  .hx__card-name { margin: 6px 0 12px; font-family: var(--am-display); font-stretch: 112%; font-weight: 700; font-size: clamp(22px, 2vw, 27px); line-height: 1.08; letter-spacing: -.01em; }
  .hx__card-plan { margin: 0 0 14px; padding-top: 12px; border-top: 1px solid var(--am-line); display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .hx__card-plan dt { font-size: 10.5px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--am-dim); }
  .hx__card-plan dd { margin: 3px 0 0; font-family: var(--am-display); font-stretch: 108%; font-weight: 700; font-size: 19px; font-variant-numeric: tabular-nums; }
  .hx__mes { color: #d9dce0; font-weight: 600 !important; }
  .hx__go { width: 100%; min-height: 46px; }

  /* números que ruedan (los spans los crea el script) */
  .hx-roll { display: inline-grid; vertical-align: bottom; overflow: hidden; padding-block: .1em; margin-block: -.1em; }
  .hx-roll :global(.hx-roll__set) { grid-area: 1 / 1; white-space: nowrap; }
  .hx-roll :global(.hx-roll__ch) { display: inline-block; }
  
    html.am-anim .hx-roll :global(.hx-roll__set:not(.is-out) .hx-roll__ch) { animation: hx-roll-in .75s var(--am-ease-out) backwards; animation-delay: calc(var(--i, 0) * 24ms + 90ms); }
    html.am-anim .hx-roll :global(.hx-roll__set.is-out .hx-roll__ch) { animation: hx-roll-out .5s var(--am-ease-io) forwards; animation-delay: calc(var(--i, 0) * 14ms); }
  
  @keyframes hx-roll-in { from { transform: translateY(105%); opacity: 0; } }
  @keyframes hx-roll-out { to { transform: translateY(-105%); opacity: 0; } }

  /* =========================================================== HERO: barras tipo stories */
  .hx__ctrl { display: flex; align-items: center; gap: 10px; height: 56px; margin-top: 10px; }
  .hx:not(.is-live) .hx__ctrl { visibility: hidden; }
  .hx__bars { flex: 1; min-width: 0; display: flex; gap: 6px; }
  .hx__bar { position: relative; flex: 1; min-width: 0; height: 44px; padding: 0; border: 0; background: none; cursor: pointer; border-radius: 6px; }
  .hx__bar::before, .hx__bar-fill { position: absolute; left: 0; right: 0; top: 50%; height: 3px; margin-top: -1.5px; border-radius: 3px; }
  .hx__bar::before { content: ''; background: rgba(255, 255, 255, .18); transition: background .3s ease; }
  .hx__bar:hover::before { background: rgba(255, 255, 255, .34); }
  .hx__bar-fill { background: linear-gradient(90deg, var(--am-red), var(--am-red-hi)); box-shadow: 0 0 10px var(--am-neon); transform: scaleX(0); transform-origin: 0 50%; }
  .hx__bar.is-done .hx__bar-fill { transform: scaleX(1); background: rgba(255, 255, 255, .55); box-shadow: none; }
  .hx__bar[aria-current='true'] .hx__bar-fill { transform: scaleX(1); }
  .hx.is-paused .hx__bar-fill { animation-play-state: paused !important; }
  .hx__pause {
    flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; cursor: pointer;
    border: 1px solid var(--am-line2); background: rgba(10, 10, 11, .5); color: var(--am-text);
    transition: border-color .25s ease, background .25s ease;
  }
  .hx__pause:hover { border-color: rgba(255, 74, 61, .6); background: rgba(227, 20, 31, .14); }
  .hx__pause svg { grid-area: 1 / 1; }
  .hx__play-i, .hx__pause.is-manual .hx__pause-i { display: none; }
  .hx__pause.is-manual .hx__play-i { display: block; }
  .hx:not(.is-auto) .hx__pause { display: none; }

  /* =========================================================== MOVIMIENTO (solo sin reduce) */
  
    /* bucles siempre activos */
    html.am-anim .hx__bgimg.is-active { animation: hx-bgkb 18s ease-out both; }
    html.am-anim .hx__lit { animation: hx-blob 9s var(--am-ease-io) infinite; }
    html.am-anim .hx__ghost-track { animation: hx-ghost 70s linear infinite; }
    html.am-anim .hx__halo { animation: hx-spin 9s linear infinite; }
    html.am-anim .hx__mouse::after { animation: hx-wheel 1.9s var(--am-ease-out) infinite; }
    :global(html.am-anim.is-touch) .hx__mouse::after { animation-name: hx-drip; }

    /* autoplay: la barra activa se llena en --hx-dur; al terminar, el script pasa al siguiente */
    :global(html.am-anim.hx-go) .hx.is-auto .hx__bar[aria-current='true'] .hx__bar-fill { animation: hx-fill var(--hx-dur, 5600ms) linear both; }
    /* el primer auto espera a que termine la entrada */
    :global(html.am-anim.hx-go) .hx.is-auto:not(.is-cycled) .hx__bar[aria-current='true'] .hx__bar-fill { animation-delay: calc(var(--hero-d) + .8s); }

    /* cambio de auto: barrido diagonal + línea neón + zoom de entrada; el que sale se oscurece */
    html.am-anim .hx__slide.is-entering { animation: hx-wipe 1.15s var(--am-ease-io) both; }
    html.am-anim .hx__slide.is-entering .hx__img { animation: hx-zoom 1.7s var(--am-ease-out) both; }
    html.am-anim .hx__slide.is-leaving .hx__img { animation: hx-leave 1.15s var(--am-ease-io) forwards; }
    html.am-anim .hx__stage.is-wiping .hx__wipe { animation: hx-wipe-line 1.15s var(--am-ease-io) both; }
    html.am-anim .hx__slide:is(.is-active, .is-leaving) .hx__kb { animation: hx-kb calc(var(--hx-dur, 5600ms) + 2.4s) linear both; }

    /* entrada de la página (CSS puro: termina sola aunque falle el JS) */
    :global(html.am-anim.js.hx-go) .hx__kicker { animation: hx-up .9s var(--am-ease-out) calc(var(--hero-d) - .05s) backwards; }
    :global(html.am-anim.js.hx-go) .hx__lead { animation: hx-up 1s var(--am-ease-out) calc(var(--hero-d) + .5s) backwards; }
    :global(html.am-anim.js.hx-go) .hx__ctas { animation: hx-up 1s var(--am-ease-out) calc(var(--hero-d) + .62s) backwards; }
    :global(html.am-anim.js.hx-go) .hx__scroll { animation: hx-up 1s var(--am-ease-out) calc(var(--hero-d) + .85s) backwards; }
    :global(html.am-anim.js.hx-go) .hx__stage { animation: hx-stage-in 1.5s var(--am-ease-io) calc(var(--hero-d) - .25s) backwards; }
    :global(html.am-anim.js.hx-go) .hx:not(.is-cycled) .hx__slide:first-child .hx__img { animation: hx-zoom-first 2.2s var(--am-ease-out) calc(var(--hero-d) - .25s) backwards; }
    :global(html.am-anim.js.hx-go) .hx__halo { animation: hx-spin 9s linear infinite, hx-fade 1.6s ease calc(var(--hero-d) + .4s) backwards; }
    :global(html.am-anim.js.hx-go) .hx__card { animation: hx-up 1.1s var(--am-ease-out) calc(var(--hero-d) + .5s) backwards; }
    :global(html.am-anim.js.hx-go) .hx__ctrl { animation: hx-fade 1s ease calc(var(--hero-d) + .75s) backwards; }
    :global(html.am-anim.js.hx-go) .hx__bg { animation: hx-bg-in 1.8s ease calc(var(--hero-d) - .45s) backwards; }
    :global(html.am-anim.js.hx-go) .hx__lit { animation: hx-blob 9s var(--am-ease-io) infinite, hx-fade 2.2s ease calc(var(--hero-d) + .2s) backwards; }
    :global(html.am-anim.js.hx-go) .hx__ghost-track { animation: hx-ghost 70s linear infinite, hx-fade 2.4s ease calc(var(--hero-d) + .3s) backwards; }

    html.am-anim .hx__title .am-w { overflow: visible clip; }
    /* cada letra sube por la máscara "estirada" y se asienta. Solo transform: el ancho real de las
       letras no cambia, así que las líneas no se reacomodan (antes el eje wdth movía todo). */
    :global(html.am-anim.js.hx-go) .hx__title .am-ch {
