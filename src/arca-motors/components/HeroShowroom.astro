  :global(html.am-anim.is-touch) .hx-roll :global(.hx-roll__set:not(.is-out)) { animation: hx-roll-in .55s var(--am-ease-out) .08s backwards; }
  :global(html.am-anim.is-touch) .hx-roll :global(.hx-roll__set.is-out) { animation: hx-roll-out .35s var(--am-ease-io) forwards; }
