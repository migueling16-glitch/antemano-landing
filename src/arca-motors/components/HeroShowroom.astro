  /* =========================================================== CÁMARA al hacer scroll */
  /* En móvil el hero es más alto que la pantalla: solo se mueven el fondo y el texto gigante
     (si no, los CTA se desvanecerían estando aún a la vista). */
  @supports (animation-timeline: scroll()) {
    
      html.am-anim .hx__bgcam { animation: hx-cam-bg linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
      html.am-anim .hx__ghost { animation: hx-cam-ghost linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
      /* .is-off (motion.ts) pausa todo lo de adentro fuera de pantalla; la cámara debe seguir al scroll. */
      html.am-anim .hx.is-off .hx__bgcam, html.am-anim .hx.is-off .hx__ghost, html.am-anim .hx.is-off .hx__cam, html.am-anim .hx.is-off .hx__cardcam, html.am-anim .hx.is-off .hx__copycam, html.am-anim .hx.is-off .hx__footcam { animation-play-state: running !important; }
    
    @media (min-width: 1000px) {
      html.am-anim .hx__cam { animation: hx-cam-stage linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
      html.am-anim .hx__cardcam { animation: hx-cam-card linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
      html.am-anim .hx__copycam, html.am-anim .hx__footcam { animation: hx-cam-copy linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
    }
  }
  @keyframes hx-cam-bg { to { transform: translate3d(0, 24vh, 0) scale(1.14); } }
  @keyframes hx-cam-stage { to { transform: translate3d(0, 12vh, 0) scale(.82); filter: blur(6px) brightness(.55); } }
  @keyframes hx-cam-card { to { transform: translate3d(0, -8vh, 0) scale(.94); } }
  @keyframes hx-cam-copy { to { transform: translate3d(0, 26vh, 0); opacity: 0; } }
  @keyframes hx-cam-ghost { to { transform: translate3d(-10%, 14vh, 0); } }
  /* Fallback: el script pone --hp (0 → 1) en .hx */
  @supports not (animation-timeline: scroll()) {
    
      html.am-anim .hx__bgcam { transform: translate3d(0, calc(var(--hp, 0) * 24vh), 0) scale(calc(1 + var(--hp, 0) * .14)); }
      html.am-anim .hx__ghost { transform: translate3d(calc(var(--hp, 0) * -10%), calc(var(--hp, 0) * 14vh), 0); }
    
    @media (min-width: 1000px) {
      html.am-anim .hx__cam { transform: translate3d(0, calc(var(--hp, 0) * 12vh), 0) scale(calc(1 - var(--hp, 0) * .18)); filter: blur(calc(var(--hp, 0) * 6px)) brightness(calc(1 - var(--hp, 0) * .45)); }
      html.am-anim .hx__cardcam { transform: translate3d(0, calc(var(--hp, 0) * -8vh), 0) scale(calc(1 - var(--hp, 0) * .06)); }
      html.am-anim .hx__copycam, html.am-anim .hx__footcam { transform: translate3d(0, calc(var(--hp, 0) * 26vh), 0); opacity: calc(1 - var(--hp, 0)); }
    }
  }

  /* =========================================================== CELULAR: versión ligera
     En táctil se apaga lo que obliga a repintar cada cuadro: la capa iluminada con máscara que deriva,
     el Ken Burns del fondo desenfocado, la cámara del fondo al hacer scroll, el halo cónico girando y
     los vidrios esmerilados (backdrop-filter) sobre contenido que se mueve. Se quedan el barrido entre
     autos, el Ken Burns del escenario, la entrada y la tarjeta. */
  :global(html.is-touch) .hx__bg .hx__bgimg { transform: scale(1.06); }
  :global(html.is-touch) .hx__lit, :global(html.is-touch) .hx__spot { display: none; }
  :global(html.am-anim.is-touch) .hx__bgimg.is-active { animation: none; }
  :global(html.am-anim.is-touch) .hx__bgcam, :global(html.am-anim.is-touch) .hx__ghost { animation: none !important; transform: none !important; }
  :global(html.am-anim.js.hx-go.is-touch) .hx__halo, :global(html.am-anim.is-touch) .hx__halo { animation: hx-fade 1.6s ease calc(var(--hero-d) + .4s) backwards; --hx-ang: 40deg; filter: none; }
  :global(html.is-touch) .hx__card { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(16, 16, 19, .94); }
  :global(html.is-touch) .hx__tag { -webkit-backdrop-filter: none; backdrop-filter: none; background: rgba(7, 7, 8, .78); }

  /* =========================================================== CELULAR: más recortes (auditoría 5-nov)
     Cambio de auto con fundido + zoom (solo opacity/transform) en vez de clip-path + filter; textos
     que ruedan completos; fantasma y título sin animaciones de repintado. */
  :global(html.am-anim.is-touch) .hx__slide.is-entering { animation: hx-fade .7s ease both; }
  :global(html.am-anim.is-touch) .hx__slide.is-leaving .hx__img { animation: none; }
  :global(html.is-touch) .hx__wipe { display: none; }
  :global(html.am-anim.js.hx-go.is-touch) .hx__bg, :global(html.am-anim.is-touch) .hx__bg { animation: hx-fade 1.2s ease calc(var(--hero-d) - .2s) backwards; }
  :global(html.am-anim.js.hx-go.is-touch) .hx__ghost-track, :global(html.am-anim.is-touch) .hx__ghost-track { animation: hx-fade 2.4s ease calc(var(--hero-d) + .3s) backwards; }
