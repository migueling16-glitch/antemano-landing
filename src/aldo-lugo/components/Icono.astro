---
/**
 * <Icono nombre="flecha" clase? titulo? />
 * Set propio de línea: trazo de 1.5 px en retícula de 24 px, currentColor (ESPEC §7.9).
 * Incluye los pictogramas de las seis lumbres. Decorativo por omisión (aria-hidden); con `titulo`, role="img".
 * El check-sello es el único ícono que puede ir en rojo (lo colorea el CSS de quien lo usa).
 */
interface Props {
  nombre:
    | 'flecha' | 'abajo' | 'atras' | 'cerrar' | 'mas' | 'anterior' | 'siguiente' | 'check' | 'copiar' | 'whatsapp'
    | 'colgadero' | 'jaula' | 'parrilla' | 'disco' | 'rescoldo' | 'olla';
  clase?: string;
  titulo?: string;
}
const { nombre, clase, titulo } = Astro.props;

const TRAZOS: Record<Props['nombre'], string> = {
  flecha: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  abajo: '<path d="M12 4v15M6 13l6 6 6-6"/>',
  atras: '<path d="M20 12H5M11 6l-6 6 6 6"/>',
  cerrar: '<path d="M6 6l12 12M18 6L6 18"/>',
  mas: '<path d="M12 5v14M5 12h14"/>',
  anterior: '<path d="M15 5l-7 7 7 7"/>',
  siguiente: '<path d="M9 5l7 7-7 7"/>',
  check: '<path d="M4.5 12.5l4.5 4.5L19.5 6.5"/>',
  copiar: '<rect x="8" y="8" width="12" height="12" rx="1.5"/><path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8"/>',
  // Burbuja de conversación con auricular: glifo de línea, monocromo.
  whatsapp:
    '<path d="M4.2 19.8l1.1-3.9A8.2 8.2 0 1 1 8.4 19l-4.2.8z"/><path d="M9.3 8.4c.3-.5.8-.5 1-.1l.8 1.6c.1.3 0 .6-.2.8l-.5.5c.6 1.2 1.5 2.1 2.7 2.7l.5-.5c.2-.2.5-.3.8-.2l1.6.8c.4.2.4.7-.1 1-.8.6-1.8.8-2.7.4a8 8 0 0 1-4.3-4.3c-.4-.9-.2-1.9.4-2.7z"/>',
  // Pictogramas de las lumbres (propuesta §3)
  colgadero: '<path d="M4 21V4h16v17"/><path d="M9 4v2.5M15 4v2.5"/><rect x="7.5" y="6.5" width="3" height="6.5" rx="1.2"/><rect x="13.5" y="6.5" width="3" height="6.5" rx="1.2"/><path d="M8.5 21c-.8-1.6.4-2.4.4-3.6.9.8 1.6 1.8 1.2 3.6M13.6 21c-.6-1.4.5-2.3.6-3.4.8.9 1.5 1.9 1 3.4"/>',
  jaula: '<path d="M4 19a8 8 0 0 1 16 0"/><path d="M12 11v8M8.2 12.2C7.6 14 7.4 16.5 7.5 19M15.8 12.2c.6 1.8.8 4.3.7 6.8"/><path d="M2.5 19h19"/><path d="M12 3v2"/><circle cx="12" cy="7.5" r="1.6"/><path d="M10.2 22c-.4-1 .4-1.6.5-2.4M13.8 22c.4-1-.4-1.6-.5-2.4"/>',
  parrilla: '<rect x="3" y="10" width="18" height="4" rx=".5"/><path d="M7.5 10v4M12 10v4M16.5 10v4"/><path d="M5.5 14l-1.5 6M18.5 14l1.5 6"/><path d="M9 7.5c-.6-1 .6-1.6 0-3M13.5 7.5c-.6-1 .6-1.6 0-3"/>',
  disco: '<ellipse cx="12" cy="14.5" rx="9" ry="3"/><path d="M12 13c-1.8-1.5-1-3.6.2-5.2.3 1.4 1.8 2.3 1.6 3.9-.1.6-.7 1.1-1.8 1.3z"/><path d="M6 17l-1 4M18 17l1 4"/>',
  rescoldo: '<path d="M2.5 19c2-3.6 5.4-5.5 9.5-5.5s7.5 1.9 9.5 5.5"/><ellipse cx="12" cy="12.3" rx="4.5" ry="2"/><path d="M6.5 17.2h.01M10 16.4h.01M14.5 16.6h.01M17.8 17.6h.01"/><path d="M2 19h20"/>',
  olla: '<path d="M5 10h14v6.5a3.5 3.5 0 0 1-3.5 3.5h-7A3.5 3.5 0 0 1 5 16.5V10z"/><path d="M3 10h18M5 12H3.5M19 12h1.5"/><path d="M9.5 7c-.6-1 .6-1.6 0-3M14.5 7c-.6-1 .6-1.6 0-3"/>',
};
const trazo = TRAZOS[nombre];
---
<svg
  class:list={['ml-icono', `ml-icono--${nombre}`, clase]}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={titulo ? 'img' : undefined}
  aria-label={titulo}
  aria-hidden={titulo ? undefined : 'true'}
  focusable="false"
  set:html={trazo}
></svg>
