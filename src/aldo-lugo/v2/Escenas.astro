    text-decoration-thickness: 1px; text-decoration-color: rgba(237, 230, 214, .5);
  }
  .e2-enlace--oscuro { color: var(--al-carbon); text-decoration-color: rgba(20, 20, 20, .4); }
  .e2-credito { display: block; font-size: .72rem; letter-spacing: .02em; color: rgba(237, 230, 214, .6); margin-top: .35rem; }
  .e2-sec { padding: clamp(44px, 9vw, 120px) 0; }
  .e2-sec--noche { background: #0b0a09; color: var(--al-hueso); }
  .e2-cab { display: grid; gap: 10px; padding: 0 var(--al-margen); margin: 0 auto 22px; max-width: var(--al-max); }
  .e2-cab__sub { margin: 4px 0 0; color: var(--al-ceniza); font-size: 1.05rem; max-width: 40ch; }
  [data-tema='dia'] .e2-cab__sub { color: var(--al-tizne); }
  @media (min-width: 1024px) { .e2-carril { max-width: var(--al-max); margin: 0 auto; } }

  /* Loops de video: encima de su foto; entran con fundido al reproducirse (la foto es el respaldo). */
  .e2-clip { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .9s ease; pointer-events: none; }
  .e2-clip.is-viva { opacity: 1; }
  [data-quieto] .e2-clip, [data-suave] .e2-clip { display: none; }

  /* Brasas flotantes: pocas, lentas, solo transform/opacity; se detienen solas (6 ciclos). */
  .e2-brasas { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .e2-brasas i {
    position: absolute; bottom: -10px; left: calc(8% + var(--i) * 10.5%); width: 4px; height: 4px; border-radius: 50%;
    background: radial-gradient(circle, #ffe2b0 0 30%, #e8742a 60%, transparent 70%);
    box-shadow: 0 0 8px 2px rgba(232, 116, 42, .55); opacity: 0;
  }
  html:not([data-quieto]) .e2-brasas i { animation: e2-sube calc(5.5s + var(--i) * .55s) cubic-bezier(.3, .6, .4, 1) calc(var(--i) * .7s) 6 both; }
  @keyframes e2-sube {
    0% { opacity: 0; transform: translate3d(0, 0, 0) scale(1); }
    12% { opacity: .95; }
    70% { opacity: .55; }
    100% { opacity: 0; transform: translate3d(calc((var(--i) - 4) * 9px), -78vh, 0) scale(.4); }
  }

  /* ── 0 · Encendido ──────────────────────────────────────────────────────────────────── */
  @property --e2-r { syntax: '<length>'; inherits: false; initial-value: 0px; }
  .e2-intro { display: none; }
  html.e2-con-intro .e2-intro {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 90; pointer-events: auto;
    background: radial-gradient(circle at 50% 56%, rgba(255, 196, 120, .95) calc(var(--e2-r) - 2px), rgba(232, 116, 42, .9) var(--e2-r), #0b0a09 calc(var(--e2-r) + 70px));
    -webkit-mask: radial-gradient(circle at 50% 56%, transparent calc(var(--e2-r) - 6px), #000 calc(var(--e2-r) + 1px));
    mask: radial-gradient(circle at 50% 56%, transparent calc(var(--e2-r) - 6px), #000 calc(var(--e2-r) + 1px));
    animation: e2-quema 1.35s cubic-bezier(.55, 0, .2, 1) 1.75s forwards, e2-apaga .3s linear 3.05s forwards;
  }
  html.e2-con-intro .e2-intro.is-fuera { animation: e2-apaga .35s linear forwards; }
  @keyframes e2-quema { to { --e2-r: 150vmax; } }
  @keyframes e2-apaga { to { opacity: 0; visibility: hidden; } }
  .e2-intro__brasa {
    position: absolute; left: 50%; top: 56%; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%;
    background: radial-gradient(circle, #fff1d6 0 25%, #ffb35c 45%, #e8742a 65%, transparent 72%);
    box-shadow: 0 0 22px 8px rgba(232, 116, 42, .5);
