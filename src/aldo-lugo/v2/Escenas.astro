---
/**
 * Landing v3 — ritmo horizontal, claridad y voz de Aldo (27-nov-2026).
 * Cada escena ≈ una pantalla. Lo que antes era scroll vertical largo ahora son carriles horizontales
 * (v2/Carril.astro) con invitación obvia a deslizar, y el contraste es un comparador que se arrastra de lado.
 * Copy concreto, como escribe Aldo (fuego, leña, técnica; nada de poesía de más). Desde sus correcciones del
 * 27-nov (WhatsApp) va en tercera persona ("Aldo lleva el fuego"), con sus nombres: domo, chapa, tomahawk y su menú real.
 * Respuestas del 28-nov (WhatsApp): banquetes y catering (las cenas privadas de 10 a 20 son catering), show cooking como
 * experiencia especial, menú por temporada, desde $450 por persona, de 5 a 12 eventos al mes, catering en Durango desde
 * 2018 y todo el contacto a su WhatsApp, que contesta él. 28-nov, más tarde: "que diga en grande Burning Man 2025" en vez de
 * "desierto de Nevada" (Miguel: es para una propuesta privada) y la foto de Fuego de Marca pasa a F261, la que mandó Aldo.
 * Movimiento: v2/movimiento.ts.
 */
import Foto from '../components/Foto.astro';
import FotoArte from '../components/FotoArte.astro';
import Texto from '../components/Texto.astro';
import Preguntas from '../components/Preguntas.astro';
import Carril from './Carril.astro';
import { OFERTA, CTA, SECCIONES, SITIO, mxn, type FotoRef, type Recorte } from '../config';
import { VERSIONES, type Ranura, type VersionId } from './versiones';

interface Props {
  /** Misma historia con otras tomas del evento (v2/versiones.ts). */
  version?: VersionId;
}
const { version = 'a' } = Astro.props;

const R = (id: string, recorte: Recorte, alt = ''): FotoRef => ({ id, recorte, tratamiento: 'brasa', alt });
/** Loop de la ranura en esta versión ('' = solo foto). La foto queda debajo; el video entra con fundido al reproducirse. */
const clip = (r: Ranura | '') => (r && VERSIONES[version].clips[r] ? `/aldo-lugo/video/${VERSIONES[version].clips[r]}.mp4` : '');

/** Estructura y comida, no el lugar ni las mesas: que no se entienda que los eventos son ahí (Aldo, 27-nov). */
const HISTORIAS = [
  { hora: '09:00', frase: 'La leña se prende temprano. El fuego no se apura.', foto: R('F028', '9x16', 'Pollos enteros y berenjenas colgados en el domo, con humo'), clip: 'historia-1' as Ranura },
  { hora: '18:16', frase: 'Baja el sol. El humo ya avisa que algo viene.', foto: R('V011', '9x16', 'Aldo Lugo entre el humo, junto al domo'), clip: 'historia-2' as Ranura },
  { hora: '19:08', frase: 'Del fuego al plato, frente a todos.', foto: R('V085', '9x16', 'Aldo Lugo emplata frente a una fila de platos'), clip: 'historia-3' as Ranura },
  { hora: '21:39', frase: 'Y nadie se quiere ir.', foto: R('V142', '9x16', 'Tuétanos asados, de noche'), clip: 'historia-4' as Ranura },
];

/** Nombres y piezas como los dice Aldo (27-nov): domo, chapa, tomahawk, zanahorias en leña de manzano. */
const OFICIO: { id: string; clip: Ranura; nombre: string; linea: string }[] = [
  { id: 'F252', clip: 'colgadero', nombre: 'Colgadero', linea: 'Tomahawk colgado sobre leña de encino. Horas de humo.' },
  { id: 'F139', clip: 'domo', nombre: 'Domo', linea: 'Pollo al romero que se dora colgado, despacio.' },
  { id: 'F044', clip: 'parrilla', nombre: 'Parrilla', linea: 'Lomo bridado, término medio. Costra afuera, jugo adentro.' },
  { id: 'F220', clip: 'chapa', nombre: 'Chapa', linea: 'Tuétanos a la chapa.' },
  { id: 'F250', clip: 'rescoldo', nombre: 'Rescoldo', linea: 'Zanahorias chamuscadas en leña de manzano.' },
  { id: 'F140', clip: 'olla', nombre: 'Olla de leña', linea: 'Risotto de hongos en una olla grande, al centro de la brasa.' },
];

/** El menú de La Tapada de Luna: los 8 platos que hizo Aldo, con los nombres que él mandó (27-nov). */
const PLATOS: { foto: string; clip: Ranura | ''; nombre: string; linea: string }[] = [
  { foto: 'F203', clip: '', nombre: 'Aceitunas a la brasa', linea: 'Maceradas en ajos confitados, con queso añejo.' },
  { foto: 'F308', clip: 'plato-picadas', nombre: 'Picadas veracruzanas', linea: 'Con mole de guayaba, queso fresco y tuétanos.' },
  { foto: 'F216', clip: 'plato-hummus', nombre: 'Hummus', linea: 'Con salchicha picante y pistache.' },
  { foto: 'F276', clip: 'plato-muhamara', nombre: 'Muhamara y kebab', linea: 'Con almendras y pan a la brasa.' },
  { foto: 'F310', clip: 'plato-risotto', nombre: 'Risotto de hongos', linea: 'Con cabrería sin hueso y provolone ahumado.' },
  { foto: 'V055', clip: 'plato-pollo', nombre: 'Pollo al romero', linea: 'Dorado despacio en el domo.' },
  { foto: 'F251', clip: 'plato-tomahawk', nombre: 'Tomahawk en colgadero', linea: 'Horas sobre leña de encino.' },
  { foto: 'F321', clip: 'plato-postre', nombre: 'Calabaza en tacha', linea: 'Con helado de requesón y guayaba.' },
];

const MESAS: Record<string, string> = {
  'mesa-intima': 'Cenas privadas, pedidas y aniversarios.',
  'mesa-larga': 'Cumpleaños, fiestas y reuniones familiares.',
  'boda-al-fuego': 'Tu boda, la cena de bienvenida o el tornaboda.',
  'fuego-de-marca': 'Cierres de año, lanzamientos y show cooking para tu equipo.',
};

/** Otros eventos que Aldo contó el 28-nov (sus posts de Instagram). Sin fotos: las de Instagram son solo referencia. */
const FUEGOS = [
  { donde: 'Catering · 10 días', que: 'Burning Man 2025', det: '250 personas al día: el staff y los invitados de un campamento internacional.' },
  { donde: 'Pedida de mano · 20 invitados', que: 'Cena privada', det: 'Camote ahumado en leña de manzano, filete sous vide, cebolla al rescoldo y salsa bordelesa.' },
  { donde: 'Evento de empresa · show cooking', que: 'Paella a la leña', det: 'Los invitados aprendieron a hacerla con Aldo. Con tortilla de patata y crema catalana.' },
];

const LUGAR = ['Espacio al aire libre para el fuego', 'Que se permita leña', 'Que el equipo pueda llegar', 'Un plan por si llueve'];
const BRASAS = Array.from({ length: 9 }, (_, i) => i);
---
<script is:inline>
  // Antes de pintar: decide si hay intro (una vez por visita; "Pausar movimiento" la quita).
  (function () {
    try {
      var q = document.documentElement.hasAttribute('data-quieto');
      if (!q && !sessionStorage.getItem('al-encendido')) document.documentElement.classList.add('e2-con-intro');
    } catch (e) {}
  })();
</script>

<!-- 0 · Encendido -->
<div class="e2-intro" data-intro aria-hidden="true">
  <span class="e2-intro__brasa"></span>
  <p class="e2-intro__frase">Antes de la comida, está el fuego.</p>
</div>

<!-- 1 · Portada: qué es, para quién y cómo se pide, de un vistazo -->
<section id={SECCIONES.inicio} class="e2-hero" aria-labelledby="e2-h1">
  <div class="e2-hero__media">
    <div class="e2-hero__mueve" data-parallax>
      <FotoArte
        movil={R('F080', '9x16')}
        escritorio={R('F080', '4x5')}
        alt="Aldo Lugo cocinando frente al colgadero de hierro, con tomahawks sobre la leña encendida"
        loading="eager"
        fetchpriority="high"
        sizesMovil="100vw"
        sizesEscritorio="48vw"
        clase="e2-hero__foto"
      />
      <video class="e2-clip" data-clip={clip('hero')} data-clip-tras-carga muted playsinline loop preload="none" disablepictureinpicture aria-hidden="true"></video>
    </div>
    <div class="e2-brasas" aria-hidden="true">{BRASAS.map((i) => <i style={`--i:${i}`}></i>)}</div>
  </div>
  <div class="e2-hero__texto">
    <p class="e2-label">Banquetes · Catering · Show cooking</p>
    <h1 id="e2-h1" class="e2-h1 e2-hero__h1">
      {['Banquetes', 'al', 'fuego', 'para', 'tu', 'evento.'].map((p, i) => <Fragment><span style={`--i:${i}`}>{p}</span>{i < 5 ? ' ' : ''}</Fragment>)}
    </h1>
    <p class="e2-hero__sub">Cocina de brasa y fuego para bodas, cumpleaños y empresas, de 10 a 300 personas. <strong>Tú pones el lugar, Aldo lleva el fuego.</strong></p>
    <div class="e2-hero__ctas" data-hero-cta>
      <a class="al-btn al-btn--primario" href={`#${SECCIONES.tuFecha}`} data-abrir-hoja>{CTA.principal}</a>
      <a class="e2-enlace" href="#asi-se-vive">Ver cómo se vive <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<!-- 2 · Así se vive (historias horizontales) -->
<section id="asi-se-vive" class="e2-sec e2-sec--noche e2-historias" aria-labelledby="e2-hist-h2">
  <header class="e2-cab">
    <p class="e2-label">Así se vive</p>
    <h2 id="e2-hist-h2" class="e2-h2">Un día de fuego.</h2>
  </header>
  <Carril etiqueta="Así se vive un banquete al fuego" tipo="historias" n={HISTORIAS.length + 1}>
    {HISTORIAS.map((h, i) => (
      <li class="e2-carril__item e2-historia" aria-roledescription="diapositiva" aria-label={`${i + 1} de ${HISTORIAS.length + 1}`}>
        <figure class="e2-historia__media">
          <FotoArte movil={h.foto} escritorio={h.foto} alt={h.foto.alt} sizesMovil="80vw" sizesEscritorio="24vw" />
          {clip(h.clip) && <video class="e2-clip" data-clip={clip(h.clip)} muted playsinline loop preload="none" disablepictureinpicture aria-hidden="true"></video>}
        </figure>
        <div class="e2-historia__texto">
          <p class="e2-historia__hora">{h.hora}</p>
          <p class="e2-historia__frase">{h.frase}</p>
        </div>
      </li>
    ))}
    <li class="e2-carril__item e2-historia e2-historia--fin" aria-roledescription="diapositiva" aria-label={`${HISTORIAS.length + 1} de ${HISTORIAS.length + 1}`}>
      <div class="e2-historia__fin">
        <p class="e2-historia__fin-txt">Eso se siente<br /><em>con el alma.</em></p>
        <a class="al-btn al-btn--primario" href={`#${SECCIONES.tuFecha}`} data-abrir-hoja>{CTA.principal}</a>
      </div>
    </li>
  </Carril>
</section>

<!-- 3 · Aquí nada llega de charola (comparador que se arrastra de lado) -->
<section class="e2-sec e2-sec--noche e2-contraste" aria-labelledby="e2-contraste-h2">
  <header class="e2-cab">
    <p class="e2-label">La diferencia</p>
    <h2 id="e2-contraste-h2" class="e2-h2">Aquí nada llega <em>de charola.</em></h2>
    <p class="e2-cab__sub">Se cocina frente a tus invitados: una experiencia de cercanía con el producto.</p>
  </header>
  <div class="e2-antes" data-antes style="--p:58%">
    <div class="e2-antes__capa e2-antes__capa--bn" aria-hidden="true">
      <FotoArte movil={R('F220', '4x5')} escritorio={R('F220', '4x5')} decorativa sizesMovil="100vw" sizesEscritorio="60vw" />
    </div>
    <div class="e2-antes__capa e2-antes__capa--color">
      <FotoArte movil={R('F220', '4x5')} escritorio={R('F220', '4x5')} alt="Tuétanos a la chapa sobre la leña encendida" sizesMovil="100vw" sizesEscritorio="60vw" />
      {clip('chapa') && <video class="e2-clip" data-clip={clip('chapa')} muted playsinline loop preload="none" disablepictureinpicture aria-hidden="true"></video>}
    </div>
    <span class="e2-antes__et e2-antes__et--izq" aria-hidden="true">Servido</span>
    <span class="e2-antes__et e2-antes__et--der" aria-hidden="true">Al fuego</span>
    <div class="e2-antes__mango" aria-hidden="true">
      <span class="e2-antes__linea"></span>
      <span class="e2-antes__bola">
        <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l-6 6 6 6" /><path d="M15 6l6 6-6 6" /></svg>
      </span>
      <span class="e2-antes__desliza">Desliza</span>
    </div>
    <input class="e2-antes__rango" type="range" min="0" max="100" value="58" aria-label="Compara un banquete servido con uno al fuego" data-antes-rango />
  </div>
</section>

<!-- 4 · Quién cocina (día) -->
<section id={SECCIONES.anfitrion} class="e2-guia" data-tema="dia" aria-labelledby="e2-guia-h2">
  <div class="e2-guia__grid">
    <figure class="e2-guia__retrato al-revela">
      <Foto id="F042" recorte="4x5" sizes="(min-width: 1024px) 34vw, 100vw" ajuste="cover" />
    </figure>
    <div class="e2-guia__texto">
      <p class="e2-label">Quién cocina</p>
      <h2 id="e2-guia-h2" class="e2-h2 al-revela">Aldo Lugo.</h2>
      <p class="e2-guia__linea al-revela">Lleva 18 años en la cocina y desde 2018 hace catering en Durango. Su cocina es libre y de mucha técnica: leña, brasa, rescoldo… y precisión.</p>
      <blockquote class="e2-cita al-revela">
        <p>“Cocinar es una forma de comunicar, de expresar quién eres.”</p>
      </blockquote>
      <p class="e2-guia__inspira al-revela">Entre las cocinas que lo inspiran está la de fuego abierto que Francis Mallmann popularizó.</p>
      <a class="e2-enlace e2-enlace--oscuro" href="https://www.instagram.com/tacoscanito/" target="_blank" rel="noopener">También fundó Tacos Canito <span aria-hidden="true">→</span></a>
    </div>
    <figure class="e2-guia__accion al-revela" style="--al-delay:120ms">
      <Foto id="F249" recorte="4x5" sizes="(min-width: 1024px) 26vw, 82vw" ajuste="cover" />
      {clip('guia') && <video class="e2-clip" data-clip={clip('guia')} muted playsinline loop preload="none" disablepictureinpicture aria-hidden="true"></video>}
    </figure>
  </div>
</section>

<!-- 5 · El oficio (carril) -->
<section id={SECCIONES.lumbres} class="e2-sec e2-sec--noche e2-oficio" aria-labelledby="e2-oficio-h2">
  <header class="e2-cab">
    <p class="e2-label">El oficio</p>
    <h2 id="e2-oficio-h2" class="e2-h2">Cada pieza pide <em>su fuego.</em></h2>
  </header>
  <Carril etiqueta="Las técnicas de fuego" n={OFICIO.length}>
    {OFICIO.map((l, i) => (
      <li class="e2-carril__item e2-lumbre" aria-roledescription="diapositiva" aria-label={`${l.nombre}, ${i + 1} de ${OFICIO.length}`}>
        <figure class="e2-lumbre__foto">
          <Foto id={l.id} recorte="4x5" sizes="(min-width: 768px) 30vw, 74vw" ajuste="cover" />
          {clip(l.clip) && <video class="e2-clip" data-clip={clip(l.clip)} muted playsinline loop preload="none" disablepictureinpicture aria-hidden="true"></video>}
        </figure>
        <h3 class="e2-lumbre__nombre">{l.nombre}</h3>
        <p class="e2-lumbre__linea">{l.linea}</p>
      </li>
    ))}
  </Carril>
</section>

<!-- 5b · Lo que llegó a la mesa (carril de platos, día) -->
<section id="platos" class="e2-sec e2-platos" data-tema="dia" aria-labelledby="e2-platos-h2">
  <header class="e2-cab">
    <p class="e2-label">El menú · La Tapada de Luna</p>
    <h2 id="e2-platos-h2" class="e2-h2">Lo que llegó <em>a la mesa.</em></h2>
    <p class="e2-cab__sub">Los 8 platos que Aldo cocinó para 200 invitados. Cada menú se diseña para tu evento y la temporada.</p>
  </header>
  <Carril etiqueta="Los platos del menú" n={PLATOS.length} tema="dia">
    {PLATOS.map((p, i) => (
      <li class="e2-carril__item e2-plato" aria-roledescription="diapositiva" aria-label={`${p.nombre}, ${i + 1} de ${PLATOS.length}`}>
        <figure class="e2-plato__foto">
          <Foto id={p.foto} recorte="4x5" sizes="(min-width: 768px) 30vw, 74vw" ajuste="cover" />
          {clip(p.clip) && <video class="e2-clip" data-clip={clip(p.clip)} muted playsinline loop preload="none" disablepictureinpicture aria-hidden="true"></video>}
          <span class="e2-plato__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </figure>
        <h3 class="e2-plato__nombre">{p.nombre}</h3>
        <p class="e2-plato__linea">{p.linea}</p>
      </li>
    ))}
  </Carril>
</section>

<!-- 6 · Un evento real -->
<section id={SECCIONES.unaNoche} class="e2-prueba" aria-labelledby="e2-prueba-h2">
  <div class="e2-prueba__dron">
    <div class="e2-prueba__zoom" data-zoom>
      <FotoArte movil={R('F019', '4x5')} escritorio={R('F019', '16x9')} alt="Vista aérea al atardecer: mesas largas en cruz y la cocina de leña encendida" sizesMovil="100vw" sizesEscritorio="100vw" />
      {clip('prueba') && <video class="e2-clip" data-clip={clip('prueba')} muted playsinline loop preload="none" disablepictureinpicture aria-hidden="true"></video>}
    </div>
    <div class="e2-prueba__texto">
      <p class="e2-label e2-label--claro">Un evento real · Chef invitado · nov 2026</p>
      <h2 id="e2-prueba-h2" class="e2-h2">La Tapada de Luna</h2>
      <p class="e2-prueba__linea">Nombre de Dios, Durango. Aldo y su brigada cocinaron para todos los invitados.</p>
      <dl class="e2-cifras">
        <div><dt><span data-cuenta="200">200</span></dt><dd>invitados</dd></div>
        <div><dt><span data-cuenta="7">7</span></dt><dd>tiempos</dd></div>
        <div><dt><span data-cuenta="4">4</span></dt><dd>fuegos de leña</dd></div>
      </dl>
    </div>
  </div>
</section>

<!-- 6b · Más fuegos: otros eventos (texto; sin fotos de Instagram) -->
<section id="mas-fuegos" class="e2-sec e2-sec--noche e2-fuegos" aria-labelledby="e2-fuegos-h2">
  <header class="e2-cab">
    <p class="e2-label">Desde 2018</p>
    <h2 id="e2-fuegos-h2" class="e2-h2 al-revela">Y muchos <em>fuegos más.</em></h2>
    <p class="e2-cab__sub">Bodas civiles, cenas privadas, pedidas de mano, cumpleaños y empresas.</p>
  </header>
  <ul class="e2-fuegos__lista">
    {FUEGOS.map((f, i) => (
      <li class="al-revela" style={`--al-delay:${i * 120}ms`}>
        <p class="e2-label">{f.donde}</p>
        <p class="e2-fuegos__que">{f.que}</p>
        <p class="e2-fuegos__det">{f.det}</p>
      </li>
    ))}
  </ul>
  <p class="e2-fuegos__pie">
    <a class="e2-enlace" href={SITIO.instagram.url} target="_blank" rel="noopener">Ver sus eventos en Instagram <span aria-hidden="true">→</span></a>
  </p>
</section>

<!-- 7 · Tu evento (carril de mesas, día) -->
<section id={SECCIONES.experiencias} class="e2-sec e2-mesas" data-tema="dia" aria-labelledby="e2-mesas-h2">
  <header class="e2-cab">
    <p class="e2-label">Tu evento · de 10 a 300 personas</p>
    <h2 id="e2-mesas-h2" class="e2-h2">Tú pones el lugar.<br /><em>Aldo lleva el fuego.</em></h2>
    <p class="e2-cab__sub">Banquetes, catering y cenas privadas. Y si quieres que tus invitados cocinen con él, pide el show cooking.</p>
  </header>
  <Carril etiqueta="Tipos de evento" n={OFERTA.formatos.length} tema="dia">
    {OFERTA.formatos.map((f, i) => (
      <li class="e2-carril__item e2-mesa" aria-roledescription="diapositiva" aria-label={`${f.nombre}, ${i + 1} de ${OFERTA.formatos.length}`}>
        <figure class="e2-mesa__foto"><Foto id={f.foto.id} recorte="4x5" sizes="(min-width: 768px) 30vw, 74vw" ajuste="cover" /></figure>
        <h3 class="e2-mesa__nombre">{f.nombre}</h3>
        <p class="e2-mesa__rango">{f.invitados[0]}–{f.invitados[1]} personas</p>
        <p class="e2-mesa__para">{MESAS[f.id] ?? f.para}</p>
        <a class="e2-mesa__cta" href={`#${SECCIONES.tuFecha}`} data-abrir-hoja data-preset={JSON.stringify(f.preset)}>Cotizar <span aria-hidden="true">→</span></a>
        <details class="e2-mas">
          <summary>Qué incluye</summary>
          <ul>{f.incluye.map((t) => <li><Texto t={t} /></li>)}</ul>
          <p class="e2-mas__precio">{f.precio.desde ? `Desde ${mxn(f.precio.desde)} por persona. Según el número de invitados, puede incluir loza y meseros.` : 'Precio por confirmar con el chef'}</p>
        </details>
      </li>
    ))}
  </Carril>
  <details class="e2-mas e2-mas--lugar">
    <summary>¿Qué necesito del lugar?</summary>
    <ul class="e2-lugar">{LUGAR.map((l) => <li>{l}</li>)}</ul>
  </details>
</section>

<!-- 8 · Así empieza -->
<section id={SECCIONES.proceso} class="e2-pasos" aria-labelledby="e2-pasos-h2">
  <h2 id="e2-pasos-h2" class="e2-h2 al-revela">Así empieza.</h2>
  <ol class="e2-pasos__lista">
    <li class="al-revela"><span class="e2-sello">1</span><p><strong>Comparte tu fecha.</strong> Dos minutos.</p></li>
    <li class="al-revela" style="--al-delay:120ms"><span class="e2-sello">2</span><p><strong>Aldo te contesta en persona.</strong> Revisa tu lugar y diseña un menú de temporada.</p></li>
    <li class="al-revela" style="--al-delay:240ms"><span class="e2-sello">3</span><p><strong>Aldo prende el fuego.</strong></p></li>
  </ol>
  <p class="e2-pasos__nota al-revela">Cada evento se prepara desde cero. Aldo toma de 5 a 12 eventos al mes: aparta tu fecha con tiempo.</p>
</section>

<!-- 9 · Preguntas -->
<Preguntas />

<!-- 10 · Cierre -->
<section id={SECCIONES.cierre} class="e2-cierre" aria-labelledby="e2-cierre-h2" data-oculta-barra>
