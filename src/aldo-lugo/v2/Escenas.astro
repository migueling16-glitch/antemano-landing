---
/**
 * Landing v2 — la historia (Chef Aldo Lugo/04_Docs/GUION_LANDING_v2.md).
 * Primero se siente, luego se presenta al guía, al final se explica cómo se contrata.
 * Texto mínimo: una frase grande por pantalla; el detalle vive en <details> para quien quiera entrar.
 * Movimiento: v2/movimiento.ts (solo transform/opacity ligados al scroll; reduced-motion = todo quieto).
 */
import Foto from '../components/Foto.astro';
import FotoArte from '../components/FotoArte.astro';
import Texto from '../components/Texto.astro';
import Preguntas from '../components/Preguntas.astro';
import { OFERTA, CTA, SECCIONES, type FotoRef, type Recorte } from '../config';

const R = (id: string, recorte: Recorte, alt = ''): FotoRef => ({ id, recorte, tratamiento: 'brasa', alt });

const IMAGINA = [
  { hora: '15:43', frase: 'La leña se enciende horas antes.', movil: R('F028', '9x16'), escritorio: R('F028', '4x5') },
  { hora: '18:16', frase: 'El sol baja sobre el campo.', movil: R('F013', '9x16'), escritorio: R('F013', '4x5') },
  { hora: '19:08', frase: 'La mesa larga espera.', movil: R('F153', '9x16'), escritorio: R('F153', '4x5') },
  { hora: '21:39', frase: 'Y nadie se quiere ir.', movil: R('F255', '9x16'), escritorio: R('F255', '4x5') },
];

const LUMBRES = [
  { id: 'F252', nombre: 'Colgadero', linea: 'Horas de humo antes del primer corte.' },
  { id: 'F139', nombre: 'Jaula', linea: 'Lo que cuelga se dora despacio.' },
  { id: 'F044', nombre: 'Parrilla', linea: 'Costra afuera, jugo adentro.' },
  { id: 'F220', nombre: 'Disco', linea: 'Acero al rojo. Tuétanos que burbujean.' },
  { id: 'F250', nombre: 'Rescoldo', linea: 'Brasa y ceniza: dulce, con sabor a tierra.' },
];

const TIRA = [
  { id: 'F174', hora: '15:43', que: 'La cocina, a la vista' },
  { id: 'F216', hora: '19:08', que: 'La cena' },
  { id: 'F289', hora: '21:39', que: 'La noche', credito: 'Horno de tierra de los maestros mezcaleros' },
];

const LUGAR = ['Espacio al aire libre para el fuego', 'Que se permita leña', 'Acceso para el equipo', 'Un plan de lluvia'];
const BRASAS = Array.from({ length: 9 }, (_, i) => i);
---
<script is:inline>
  // Antes de pintar: decide si hay intro (una vez por visita, nunca con "reducir movimiento").
  (function () {
    try {
      var q = document.documentElement.hasAttribute('data-quieto');
      if (!q && !sessionStorage.getItem('al-encendido')) document.documentElement.classList.add('e2-con-intro');
    } catch (e) {}
  })();
</script>

<!-- 0 · Encendido -->
<div class="e2-intro" data-intro aria-hidden="true">
  <span class="e2-intro__brasa"></span>
  <p class="e2-intro__frase">Antes de la comida, está el fuego.</p>
</div>

<!-- 1 · Portada -->
<section id={SECCIONES.inicio} class="e2-hero" aria-labelledby="e2-h1">
  <div class="e2-hero__media">
    <div class="e2-hero__mueve" data-parallax>
      <FotoArte
        movil={R('F080', '9x16')}
        escritorio={R('F080', '4x5')}
        alt="Aldo Lugo frente al colgadero de hierro, con costillares sobre la leña encendida"
        loading="eager"
        fetchpriority="high"
        sizesMovil="100vw"
        sizesEscritorio="48vw"
        clase="e2-hero__foto"
      />
    </div>
    <div class="e2-brasas" aria-hidden="true">{BRASAS.map((i) => <i style={`--i:${i}`}></i>)}</div>
  </div>
  <div class="e2-hero__texto">
    <p class="e2-label">Banquetes al fuego · Durango</p>
    <h1 id="e2-h1" class="e2-h1 e2-hero__h1">
      {['La', 'lumbre', 'pone', 'la', 'mesa.'].map((p, i) => <Fragment><span style={`--i:${i}`}>{p}</span>{i < 4 ? ' ' : ''}</Fragment>)}
    </h1>
    <div class="e2-hero__ctas" data-hero-cta>
      <a class="al-btn al-btn--primario" href={`#${SECCIONES.tuFecha}`} data-abrir-hoja>{CTA.principal}</a>
      <a class="e2-enlace" href="#imagina">Ver cómo se vive <span aria-hidden="true">↓</span></a>
    </div>
  </div>
</section>

<!-- 2 · Imagina -->
<section id="imagina" class="e2-imagina" aria-label="Una noche de lumbre" data-imagina>
  <div class="e2-imagina__escena">
    {IMAGINA.map((b, i) => (
      <figure class="e2-imagina__foto" data-n={i} aria-hidden={i === 0 ? undefined : 'true'}>
        <FotoArte movil={b.movil} escritorio={b.escritorio} decorativa={i !== 0} sizesMovil="100vw" sizesEscritorio="50vw" />
      </figure>
    ))}
    <p class="e2-imagina__hora" aria-hidden="true"><span data-hora>{IMAGINA[0].hora}</span></p>
  </div>
  <ol class="e2-imagina__pasos">
    {IMAGINA.map((b, i) => (
      <li class="e2-paso" data-paso={i} data-hora-paso={b.hora}>
        <p class="e2-frase"><span class="e2-sr">{b.hora}. </span>{b.frase}</p>
      </li>
    ))}
  </ol>
  <div class="e2-imagina__remate">
    <p class="e2-h2 al-revela">Eso es una<br /><em>Mesa de Lumbre.</em></p>
  </div>
</section>

<!-- 3 · El contraste -->
<section class="e2-contraste" aria-label="Banquetes que se viven" data-contraste>
  <div class="e2-contraste__fijo">
    <div class="e2-contraste__bn" aria-hidden="true">
      <FotoArte movil={R('F220', '9x16')} escritorio={R('F220', '4x5')} decorativa sizesMovil="100vw" sizesEscritorio="50vw" />
    </div>
    <div class="e2-contraste__color" data-color>
      <div class="e2-contraste__color-in" data-color-in>
        <FotoArte movil={R('F220', '9x16')} escritorio={R('F220', '4x5')} alt="Disco de acero en llamas con tuétanos alrededor" sizesMovil="100vw" sizesEscritorio="50vw" />
      </div>
      <span class="e2-contraste__linea" aria-hidden="true"></span>
    </div>
    <div class="e2-contraste__texto">
      <p class="e2-contraste__antes" data-tacha>Hay banquetes que se sirven.</p>
      <p class="e2-h2">Y banquetes<br />que se <em>viven.</em></p>
      <p class="e2-label">Fuego a la vista · Sin charolas · Sin prisa</p>
    </div>
  </div>
</section>

<!-- 4 · El que cuida el fuego -->
<section id={SECCIONES.anfitrion} class="e2-guia" data-tema="dia" aria-labelledby="e2-guia-h2">
  <div class="e2-guia__grid">
    <figure class="e2-guia__retrato al-revela">
      <Foto id="F042" recorte="4x5" sizes="(min-width: 1024px) 34vw, 100vw" ajuste="cover" />
    </figure>
    <div class="e2-guia__texto">
      <p class="e2-label">El que cuida el fuego</p>
      <h2 id="e2-guia-h2" class="e2-h2 al-revela">Aldo Lugo</h2>
      <p class="e2-guia__linea al-revela">Del taco y el nixtamal a la mesa larga.</p>
      <blockquote class="e2-cita al-revela">
        <p>“Cocinar es una forma de comunicar, de expresar quién eres.”</p>
      </blockquote>
      <a class="e2-enlace e2-enlace--oscuro" href="https://www.instagram.com/tacoscanito/" target="_blank" rel="noopener">También fundó Tacos Canito <span aria-hidden="true">→</span></a>
    </div>
    <figure class="e2-guia__accion al-revela" style="--al-delay:120ms">
      <Foto id="F249" recorte="4x5" sizes="(min-width: 1024px) 26vw, 82vw" ajuste="cover" />
    </figure>
  </div>
</section>

<!-- 5 · Cada pieza pide su fuego -->
<section id={SECCIONES.lumbres} class="e2-oficio" aria-labelledby="e2-oficio-h2" data-oficio>
  <div class="e2-oficio__fijo">
    <header class="e2-oficio__cab">
      <p class="e2-label">El oficio</p>
      <h2 id="e2-oficio-h2" class="e2-h2">Cada pieza<br />pide su fuego.</h2>
    </header>
    <ul class="e2-oficio__pista" data-pista>
      {LUMBRES.map((l) => (
        <li class="e2-lumbre">
          <figure class="e2-lumbre__foto"><Foto id={l.id} recorte="4x5" sizes="(min-width: 1024px) 26vw, 76vw" ajuste="cover" /></figure>
          <h3 class="e2-lumbre__nombre">{l.nombre}</h3>
          <p class="e2-lumbre__linea">{l.linea}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<!-- 6 · Una noche real -->
<section id={SECCIONES.unaNoche} class="e2-prueba" aria-labelledby="e2-prueba-h2">
  <div class="e2-prueba__dron">
    <div class="e2-prueba__zoom" data-zoom>
      <FotoArte movil={R('F019', '4x5')} escritorio={R('F019', '16x9')} alt="Vista aérea al atardecer: mesas largas en cruz y la cocina de leña encendida" sizesMovil="100vw" sizesEscritorio="100vw" />
    </div>
    <div class="e2-prueba__texto">
      <p class="e2-label">Una noche real · 21 nov 2026</p>
      <h2 id="e2-prueba-h2" class="e2-h2">La Tapada de Luna</h2>
      <p class="e2-label e2-label--claro">Nombre de Dios, Durango</p>
      <dl class="e2-cifras">
        <div><dt><span data-cuenta="200" data-pre="≈">≈200</span></dt><dd>invitados</dd></div>
        <div><dt><span data-cuenta="8" data-suf=" h">8 h</span></dt><dd>de fuego</dd></div>
      </dl>
    </div>
  </div>
  <ol class="e2-tira">
    {TIRA.map((t, i) => (
      <li class="e2-tira__item al-revela" style={`--al-delay:${i * 110}ms`}>
        <figure>
          <Foto id={t.id} recorte="4x5" sizes="(min-width: 1024px) 30vw, 80vw" ajuste="cover" />
          <figcaption><span class="e2-tira__hora">{t.hora}</span> {t.que}{t.credito && <span class="e2-credito">{t.credito}</span>}</figcaption>
        </figure>
      </li>
    ))}
  </ol>
</section>

<!-- 7 · Tu mesa -->
<section id={SECCIONES.experiencias} class="e2-mesas" data-tema="dia" aria-labelledby="e2-mesas-h2">
  <header class="e2-mesas__cab">
    <p class="e2-label">Tu mesa · de 10 a 300 invitados</p>
    <h2 id="e2-mesas-h2" class="e2-h2 al-revela">Ustedes eligen el lugar.<br /><em>Nosotros llevamos la lumbre.</em></h2>
  </header>
  <ul class="e2-mesas__lista">
    {OFERTA.formatos.map((f, i) => (
      <li class="e2-mesa al-revela" style={`--al-delay:${i * 90}ms`}>
        <figure class="e2-mesa__foto"><Foto id={f.foto.id} recorte="4x5" sizes="(min-width: 1024px) 22vw, 84vw" ajuste="cover" /></figure>
        <h3 class="e2-mesa__nombre">{f.nombre}</h3>
        <p class="e2-mesa__rango">{f.invitados[0]}–{f.invitados[1]} invitados</p>
        <details class="e2-mas">
          <summary>Qué incluye</summary>
          <p class="e2-mas__para">{f.para}</p>
          <ul>{f.incluye.map((t) => <li><Texto t={t} /></li>)}</ul>
          <p class="e2-mas__precio">Precio por confirmar con el chef{f.precio.iva === 'mas_iva' ? ' · más IVA' : ' · IVA incluido'}</p>
        </details>
        <a class="e2-mesa__cta" href={`#${SECCIONES.tuFecha}`} data-abrir-hoja data-preset={JSON.stringify(f.preset)}>La quiero <span aria-hidden="true">→</span></a>
      </li>
    ))}
  </ul>
  <details class="e2-mas e2-mas--lugar">
    <summary>¿Qué necesitamos del lugar?</summary>
    <ul class="e2-lugar">{LUGAR.map((l) => <li>{l}</li>)}</ul>
  </details>
</section>

<!-- 8 · Así empezamos -->
<section id={SECCIONES.proceso} class="e2-pasos" aria-labelledby="e2-pasos-h2">
  <h2 id="e2-pasos-h2" class="e2-h2 al-revela">Así empezamos.</h2>
  <ol class="e2-pasos__lista">
    <li class="al-revela"><span class="e2-sello">1</span><p><strong>Nos cuentas tu fecha.</strong> Dos minutos.</p></li>
    <li class="al-revela" style="--al-delay:120ms"><span class="e2-sello">2</span><p><strong>Vemos tu lugar y tu menú.</strong></p></li>
    <li class="al-revela" style="--al-delay:240ms"><span class="e2-sello">3</span><p><strong>Encendemos.</strong></p></li>
  </ol>
  <p class="e2-pasos__nota al-revela">Cada noche se prepara desde cero. Conviene apartar la fecha con tiempo.</p>
</section>

<!-- 9 · Preguntas -->
<Preguntas />

<!-- 10 · Cierre -->
<section id={SECCIONES.cierre} class="e2-cierre" aria-labelledby="e2-cierre-h2" data-oculta-barra>
  <div class="e2-cierre__media">
    <FotoArte movil={R('F289', '9x16')} escritorio={R('F289', '16x9')} alt="Piedra volcánica incandescente entre piñas de agave, bajo luces colgantes" sizesMovil="100vw" sizesEscritorio="100vw" />
    <span class="e2-cierre__luz" aria-hidden="true"></span>
    <div class="e2-brasas e2-brasas--cierre" aria-hidden="true">{BRASAS.map((i) => <i style={`--i:${i}`}></i>)}</div>
  </div>
  <div class="e2-cierre__texto">
    <p class="e2-cierre__antes al-revela">El fuego se apaga.</p>
    <h2 id="e2-cierre-h2" class="e2-h1 al-revela">La noche<br />se queda.</h2>
    <a id={SECCIONES.tuFecha} class="al-btn al-btn--primario al-revela" href={`#${SECCIONES.tuFecha}`} data-abrir-hoja>{CTA.principal}</a>
    <p class="e2-credito">Brasa del horno de tierra de los maestros mezcaleros · La Tapada de Luna</p>
  </div>
</section>

<script>
  import { iniciarMovimiento } from './movimiento';
  iniciarMovimiento();
</script>

<style is:global>
  /* ── Base de la historia ─────────────────────────────────────────────────────────────── */
  .e2-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .e2-label {
    font-family: var(--al-f-label); font-weight: 600; text-transform: uppercase; letter-spacing: .16em;
    font-size: .78rem; line-height: 1.3; color: var(--al-ceniza); margin: 0;
  }
  [data-tema='dia'] .e2-label { color: var(--al-tizne); }
  .e2-label--claro { color: rgba(237, 230, 214, .82); }
  .e2-h1 {
    font-family: var(--al-f-display); font-weight: 560; margin: 0;
    font-size: clamp(3.3rem, 1.6rem + 8.4vw, 9.6rem); line-height: .94; letter-spacing: -.012em; text-wrap: balance;
  }
  .e2-h2 {
    font-family: var(--al-f-display); font-weight: 560; margin: 0;
    font-size: clamp(2.5rem, 1.5rem + 4.4vw, 6.2rem); line-height: 1; letter-spacing: -.01em; text-wrap: balance;
  }
  .e2-h1 em, .e2-h2 em { font-style: normal; color: #f2c38f; }
  [data-tema='dia'] .e2-h2 em { color: var(--al-sello-tinta); }
  .e2-frase {
    font-family: var(--al-f-display); font-weight: 560; margin: 0;
    font-size: clamp(2.2rem, 1.3rem + 3.6vw, 4.8rem); line-height: 1.02; text-wrap: balance;
  }
  .e2-enlace {
    display: inline-flex; align-items: center; gap: .45em; min-height: var(--al-tap);
    color: var(--al-hueso); font-weight: 600; text-decoration: underline; text-underline-offset: .3em;
    text-decoration-thickness: 1px; text-decoration-color: rgba(237, 230, 214, .5);
  }
  .e2-enlace--oscuro { color: var(--al-carbon); text-decoration-color: rgba(20, 20, 20, .4); }
  .e2-credito { display: block; font-size: .72rem; letter-spacing: .02em; color: rgba(237, 230, 214, .6); margin-top: .35rem; }

  /* Brasas flotantes: pocas, lentas, solo transform/opacity; se detienen solas (6 ciclos). */
  .e2-brasas { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .e2-brasas i {
    position: absolute; bottom: -10px; left: calc(8% + var(--i) * 10.5%); width: 4px; height: 4px; border-radius: 50%;
    background: radial-gradient(circle, #ffe2b0 0 30%, #e8742a 60%, transparent 70%);
    box-shadow: 0 0 8px 2px rgba(232, 116, 42, .55); opacity: 0;
  }
  html:not([data-quieto]) .e2-brasas i {
    animation: e2-sube calc(5.5s + var(--i) * .55s) cubic-bezier(.3, .6, .4, 1) calc(var(--i) * .7s) 6 both;
  }
  @keyframes e2-sube {
    0% { opacity: 0; transform: translate3d(0, 0, 0) scale(1); }
    12% { opacity: .95; }
    70% { opacity: .55; }
    100% { opacity: 0; transform: translate3d(calc((var(--i) - 4) * 9px), -78vh, 0) scale(.4); }
  }

  /* ── 0 · Encendido ───────────────────────────────────────────────────────────────────── */
  @property --e2-r { syntax: '<length>'; inherits: false; initial-value: 0px; }
  .e2-intro { display: none; }
  html.e2-con-intro .e2-intro {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 90; pointer-events: auto;
    background: radial-gradient(circle at 50% 56%, rgba(255, 196, 120, .95) calc(var(--e2-r) - 2px), rgba(232, 116, 42, .9) var(--e2-r), #0b0a09 calc(var(--e2-r) + 70px));
    -webkit-mask: radial-gradient(circle at 50% 56%, transparent calc(var(--e2-r) - 6px), #000 calc(var(--e2-r) + 1px));
    mask: radial-gradient(circle at 50% 56%, transparent calc(var(--e2-r) - 6px), #000 calc(var(--e2-r) + 1px));
    animation: e2-quema 1.35s cubic-bezier(.55, 0, .2, 1) 1.75s forwards, e2-apaga .3s linear 3.05s forwards;
  }
  html.e2-con-intro .e2-intro.is-fuera { animation: e2-apaga .35s linear forwards; }
  @keyframes e2-quema { to { --e2-r: 150vmax; } }
  @keyframes e2-apaga { to { opacity: 0; visibility: hidden; } }
  .e2-intro__brasa {
    position: absolute; left: 50%; top: 56%; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%;
    background: radial-gradient(circle, #fff1d6 0 25%, #ffb35c 45%, #e8742a 65%, transparent 72%);
    box-shadow: 0 0 22px 8px rgba(232, 116, 42, .5);
    animation: e2-respira 1.1s ease-in-out infinite alternate, e2-crece .5s ease-in 1.55s forwards;
  }
  @keyframes e2-respira { from { transform: scale(.8); opacity: .75; } to { transform: scale(1.35); opacity: 1; } }
  @keyframes e2-crece { to { transform: scale(9); opacity: 0; } }
  .e2-intro__frase {
    position: absolute; left: 0; right: 0; top: calc(56% + 34px); margin: 0; padding: 0 24px; text-align: center;
    font-family: var(--al-f-display); font-weight: 560; font-size: clamp(1.15rem, .9rem + 1.2vw, 1.8rem);
    color: rgba(237, 230, 214, .92); opacity: 0; animation: e2-frase 1.45s ease .3s forwards;
  }
  @keyframes e2-frase { 0% { opacity: 0; transform: translateY(8px); } 30%, 75% { opacity: 1; transform: none; } 100% { opacity: 0; } }

  /* Modo suave (el sistema pide menos movimiento): intro que se desvanece, fundidos en lugar de desplazamientos. */
  html[data-suave].e2-con-intro .e2-intro { background: #0b0a09; -webkit-mask: none; mask: none; animation: e2-apaga .7s ease 1.7s forwards; }
  html[data-suave] .e2-intro__brasa { animation: e2-respira 1.1s ease-in-out infinite alternate; }
  [data-suave] .e2-imagina__foto img, [data-suave] .e2-mesa__foto img { transform: none; transition: none; }
  [data-suave] .e2-paso .e2-frase { transform: none; }
  [data-suave] .e2-contraste__color, [data-suave] .e2-contraste__color-in { transform: none; }
  [data-suave] .e2-contraste__color { opacity: var(--e2-o, 0); transition: opacity .2s linear; }
  [data-suave] .e2-contraste__linea { display: none; }
  [data-suave] .e2-oficio__pista.is-viva .e2-lumbre { transform: none; }
  [data-suave] .al-anima .e2-pasos__lista li.is-visible .e2-sello { animation-name: e2-aparece; }
  @keyframes e2-aparece { from { opacity: 0; } to { opacity: 1; } }

  /* ── 1 · Portada ─────────────────────────────────────────────────────────────────────── */
  .e2-hero { position: relative; min-height: calc(100svh - var(--al-demo-h) - var(--al-cabecera-h)); display: grid; align-items: end; background: var(--al-carbon); overflow: clip; }
  .e2-hero__media { position: absolute; inset: 0; }
  .e2-hero__mueve { position: absolute; inset: -6% 0 0 0; will-change: transform; }
  .e2-hero__foto, .e2-hero__foto img { width: 100%; height: 100%; }
  .e2-hero__media::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(20, 20, 20, .55) 0%, rgba(20, 20, 20, 0) 22%, rgba(20, 20, 20, 0) 46%, rgba(20, 20, 20, .88) 78%, #141414 100%);
  }
  .e2-hero__texto { position: relative; z-index: 2; padding: 0 var(--al-margen) clamp(28px, 7svh, 64px); display: grid; gap: 14px; }
  .e2-hero__h1 { max-width: 9ch; }
  .e2-hero__h1 span { display: inline-block; }
  .e2-encendido .e2-hero__h1 span { animation: e2-enciende 1.3s ease both; animation-delay: calc(var(--i) * 95ms); }
  @keyframes e2-enciende {
    0% { color: #a39a8a; text-shadow: none; }
