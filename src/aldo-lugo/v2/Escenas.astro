  }
  @keyframes e2-respira { from { transform: scale(.8); opacity: .75; } to { transform: scale(1.35); opacity: 1; } }
  @keyframes e2-crece { to { transform: scale(9); opacity: 0; } }
  .e2-intro__frase {
    position: absolute; left: 0; right: 0; top: calc(56% + 34px); margin: 0; padding: 0 24px; text-align: center;
    font-family: var(--al-f-display); font-weight: 560; font-size: clamp(1.15rem, .9rem + 1.2vw, 1.8rem);
    color: rgba(237, 230, 214, .92); opacity: 0; animation: e2-frase 1.45s ease .3s forwards;
  }
  @keyframes e2-frase { 0% { opacity: 0; transform: translateY(8px); } 30%, 75% { opacity: 1; transform: none; } 100% { opacity: 0; } }

  /* Modo suave (el sistema pide menos movimiento): intro que se desvanece, fundidos en lugar de desplazamientos. */
  html[data-suave].e2-con-intro .e2-intro { background: #0b0a09; -webkit-mask: none; mask: none; animation: e2-apaga .7s ease 1.7s forwards; }
  html[data-suave] .e2-intro__brasa { animation: e2-respira 1.1s ease-in-out infinite alternate; }
  [data-suave] .e2-mesa__foto img { transform: none; transition: none; }
  [data-suave] .al-anima .e2-pasos__lista li.is-visible .e2-sello { animation-name: e2-aparece; }
  @keyframes e2-aparece { from { opacity: 0; } to { opacity: 1; } }

  /* ── 1 · Portada ────────────────────────────────────────────────────────────────────── */
  .e2-hero { position: relative; min-height: calc(100svh - var(--al-demo-h) - var(--al-cabecera-h)); display: grid; align-items: end; background: var(--al-carbon); overflow: clip; }
  .e2-hero__media { position: absolute; inset: 0; }
  .e2-hero__mueve { position: absolute; inset: -6% 0 0 0; will-change: transform; }
  .e2-hero__foto, .e2-hero__foto img { width: 100%; height: 100%; }
  .e2-hero__media::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(20, 20, 20, .5) 0%, rgba(20, 20, 20, 0) 20%, rgba(20, 20, 20, 0) 38%, rgba(20, 20, 20, .9) 70%, #141414 100%);
  }
  .e2-hero__texto { position: relative; z-index: 2; padding: 0 var(--al-margen) clamp(24px, 5svh, 56px); display: grid; gap: 12px; }
  .e2-hero__h1 { max-width: 11ch; font-size: clamp(3rem, 1.5rem + 6.6vw, 6.4rem); }
  .e2-hero__h1 span { display: inline-block; }
  .e2-encendido .e2-hero__h1 span { animation: e2-enciende 1.3s ease both; animation-delay: calc(var(--i) * 85ms); }
  @keyframes e2-enciende {
    0% { color: #a39a8a; text-shadow: none; }
    45% { color: #ffe0b4; text-shadow: 0 0 26px rgba(232, 116, 42, .85), 0 0 2px rgba(255, 200, 140, .9); }
    100% { color: var(--al-hueso); text-shadow: none; }
  }
  .e2-hero__sub { margin: 0; max-width: 34ch; font-size: clamp(1.02rem, .95rem + .4vw, 1.3rem); line-height: 1.45; color: rgba(237, 230, 214, .86); }
  .e2-hero__sub strong { color: var(--al-hueso); font-weight: 600; }
  .e2-hero__ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; margin-top: 6px; }
  @media (min-width: 1024px) {
    .e2-hero { grid-template-columns: 1fr minmax(0, 46%); align-items: center; }
    .e2-hero__media { inset: 0 0 0 auto; width: 46%; }
    .e2-hero__media::after { background: linear-gradient(90deg, #141414 0%, rgba(20, 20, 20, 0) 26%), linear-gradient(0deg, rgba(20, 20, 20, .55), transparent 30%); }
    .e2-hero__texto { grid-column: 1; padding: calc(var(--al-cabecera-h) + 40px) var(--al-margen) 72px; gap: 20px; }
  }

  /* ── 2 · Así se vive (historias) ────────────────────────────────────────────────────── */
  .e2-historia { aspect-ratio: 9 / 16; border-radius: 14px; overflow: hidden; background: #1a1714; }
  .e2-historia__media { position: absolute; inset: 0; margin: 0; }
  .e2-historia__media :is(picture, img) { width: 100%; height: 100%; }
  .e2-historia::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11, 10, 9, .45) 0%, transparent 26%, transparent 52%, rgba(11, 10, 9, .85) 100%); pointer-events: none; }
  .e2-historia__texto { position: absolute; z-index: 2; left: 18px; right: 18px; bottom: 20px; display: grid; gap: 8px; }
  .e2-historia__hora {
    justify-self: start; margin: 0; font-family: var(--al-f-label); font-weight: 600; letter-spacing: .2em; font-size: .85rem;
    color: #f2c38f; padding: 4px 9px; border: 1px solid rgba(242, 195, 143, .55); background: rgba(11, 10, 9, .35);
  }
  .e2-historia__frase { margin: 0; font-family: var(--al-f-display); font-weight: 560; font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.3rem); line-height: 1.05; color: var(--al-hueso); text-shadow: 0 2px 18px rgba(0, 0, 0, .6); }
  .e2-historia--fin { background: radial-gradient(circle at 50% 70%, rgba(232, 116, 42, .35), transparent 60%), #141210; display: grid; place-items: center; }
  .e2-historia--fin::after { display: none; }
  .e2-historia__fin { display: grid; gap: 22px; justify-items: center; text-align: center; padding: 24px; }
  .e2-historia__fin-txt { margin: 0; font-family: var(--al-f-display); font-weight: 560; font-size: clamp(2rem, 1.4rem + 2vw, 2.8rem); line-height: 1.04; }
  .e2-historia__fin-txt em { font-style: normal; color: #f2c38f; }

  /* ── 3 · Comparador servido / al fuego ──────────────────────────────────────────────── */
  .e2-antes {
    position: relative; margin: 0 var(--al-margen); aspect-ratio: 4 / 5; max-height: 72svh; overflow: hidden; border-radius: 14px;
    touch-action: pan-y; user-select: none; -webkit-user-select: none; cursor: ew-resize; --p: 58%;
  }
  .e2-antes__capa { position: absolute; inset: 0; }
  .e2-antes__capa :is(picture, img) { width: 100%; height: 100%; -webkit-user-drag: none; }
  .e2-antes__capa--bn img { filter: grayscale(1) contrast(1.05) brightness(.62); }
  .e2-antes__capa--color { clip-path: inset(0 0 0 var(--p)); }
  .e2-antes__et {
    position: absolute; z-index: 3; top: 14px; font-family: var(--al-f-label); font-weight: 600; text-transform: uppercase;
    letter-spacing: .18em; font-size: .78rem; padding: 5px 10px 4px; border-radius: 999px; background: rgba(11, 10, 9, .55); color: var(--al-hueso);
  }
  .e2-antes__et--izq { left: 14px; color: rgba(237, 230, 214, .8); }
  .e2-antes__et--der { right: 14px; color: #f2c38f; }
  .e2-antes__mango { position: absolute; z-index: 4; top: 0; bottom: 0; left: var(--p); width: 0; pointer-events: none; }
  .e2-antes__linea { position: absolute; top: 0; bottom: 0; left: -1.5px; width: 3px; background: linear-gradient(180deg, transparent, #ffb35c 15%, #fff0d0 50%, #ffb35c 85%, transparent); box-shadow: 0 0 18px 4px rgba(232, 116, 42, .6); }
  .e2-antes__bola {
    position: absolute; top: 50%; left: 0; width: 58px; height: 58px; margin: -29px 0 0 -29px; border-radius: 50%;
