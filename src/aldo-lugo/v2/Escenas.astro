  .e2-antes:focus-within { outline: 2px solid var(--al-hueso); outline-offset: 4px; }
  @media (min-width: 1024px) { .e2-antes { max-width: 760px; margin: 0 auto; aspect-ratio: 4 / 3; } }

  /* ── 4 · Quién cocina (día) ─────────────────────────────────────────────────────────── */
  .e2-guia { background: var(--al-hueso); color: var(--al-carbon); padding: clamp(44px, 9vw, 120px) var(--al-margen); }
  .e2-guia__grid { display: grid; gap: 24px; max-width: var(--al-max); margin: 0 auto; }
  .e2-guia figure { margin: 0; overflow: hidden; position: relative; }
  .e2-guia__retrato { aspect-ratio: 4 / 5; }
  .e2-guia__retrato :is(picture, img), .e2-guia__accion :is(picture, img) { width: 100%; height: 100%; }
  .e2-guia__texto { display: grid; gap: 14px; align-content: start; }
  .e2-guia__linea { margin: 0; font-size: 1.15rem; line-height: 1.5; color: #2b2824; max-width: 36ch; }
  .e2-guia__inspira { margin: 0; font-size: .9rem; line-height: 1.5; color: var(--al-tizne); max-width: 38ch; }
  .e2-cita { margin: 6px 0; padding: 0; border: 0; }
  .e2-cita p { margin: 0; font-family: var(--al-f-display); font-weight: 560; font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.8rem); line-height: 1.12; color: var(--al-carbon); text-wrap: balance; }
  .e2-guia__accion { aspect-ratio: 4 / 5; width: 78%; justify-self: end; }
  @media (min-width: 1024px) {
    .e2-guia__grid { grid-template-columns: 1.05fr 1fr .8fr; align-items: center; gap: clamp(32px, 4vw, 72px); }
    .e2-guia__accion { width: 100%; align-self: end; transform: translateY(12%); }
  }

  /* ── 5 · El oficio ──────────────────────────────────────────────────────────────────── */
  .e2-lumbre__foto { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 12px; position: relative; }
  .e2-lumbre__foto :is(picture, img) { width: 100%; height: 100%; }
  .e2-lumbre__nombre { margin: 14px 0 4px; font-family: var(--al-f-display); font-weight: 560; font-size: clamp(1.7rem, 1.4rem + 1.2vw, 2.4rem); line-height: 1; }
  .e2-lumbre__linea { margin: 0; color: var(--al-ceniza); line-height: 1.45; }

  /* ── 5b · Lo que llegó a la mesa (día) ─────────────────────────────────────────────── */
  .e2-platos { background: #efe7d6; color: var(--al-carbon); }
  .e2-plato__foto { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 12px; position: relative; background: #d9cfbb; }
  .e2-plato__foto :is(picture, img) { width: 100%; height: 100%; }
  .e2-plato__num {
    position: absolute; z-index: 2; left: 12px; top: 12px; font-family: var(--al-f-label); font-weight: 600; letter-spacing: .14em;
    font-size: .8rem; color: var(--al-hueso); background: rgba(20, 20, 20, .55); padding: 4px 8px 3px; border-radius: 999px;
  }
  .e2-plato__nombre { margin: 14px 0 4px; font-family: var(--al-f-display); font-weight: 560; font-size: clamp(1.7rem, 1.4rem + 1.2vw, 2.4rem); line-height: 1; }
  .e2-plato__linea { margin: 0; color: #2b2824; line-height: 1.45; }

  /* ── 6 · Lo que ya hice ─────────────────────────────────────────────────────────────── */
  .e2-prueba { background: #0b0a09; }
  .e2-prueba__dron { position: relative; min-height: 92svh; overflow: hidden; display: grid; align-items: end; }
  .e2-prueba__zoom { position: absolute; inset: 0; transform: scale(var(--e2-z, 1)); transform-origin: 50% 45%; will-change: transform; }
  .e2-prueba__zoom :is(picture, img) { width: 100%; height: 100%; }
  .e2-prueba__dron::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(11, 10, 9, .25), transparent 32%, rgba(11, 10, 9, .9) 78%, #0b0a09); pointer-events: none; }
  .e2-prueba__texto { position: relative; z-index: 2; padding: 0 var(--al-margen) calc(96px + env(safe-area-inset-bottom)); display: grid; gap: 10px; }
  .e2-prueba__linea { margin: 0; color: rgba(237, 230, 214, .86); max-width: 36ch; }
  .e2-cifras { display: flex; flex-wrap: wrap; gap: 14px clamp(22px, 6vw, 80px); margin: 12px 0 0; }
  .e2-cifras div { display: grid; }
  .e2-cifras dt { font-family: var(--al-f-display); font-weight: 560; font-size: clamp(2.6rem, 1.8rem + 4vw, 6rem); line-height: 1; color: #f2c38f; font-variant-numeric: tabular-nums; }
  .e2-cifras dd { margin: 4px 0 0; font-family: var(--al-f-label); font-weight: 600; text-transform: uppercase; letter-spacing: .16em; font-size: .8rem; color: var(--al-ceniza); }

  /* ── 7 · Tu evento (día) ────────────────────────────────────────────────────────────── */
  .e2-mesas { background: var(--al-hueso); color: var(--al-carbon); }
  .e2-mesa { display: grid; gap: 6px; align-content: start; }
  .e2-mesa__foto { margin: 0 0 8px; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 12px; }
  .e2-mesa__foto :is(picture, img) { width: 100%; height: 100%; transition: transform 1.2s var(--al-ease-brasa); }
  @media (hover: hover) { .e2-mesa:hover .e2-mesa__foto img { transform: scale(1.04); } }
  .e2-mesa__nombre { margin: 0; font-family: var(--al-f-display); font-weight: 560; font-size: clamp(1.8rem, 1.5rem + 1.2vw, 2.5rem); line-height: 1; }
  .e2-mesa__rango { margin: 0; font-family: var(--al-f-label); font-weight: 600; text-transform: uppercase; letter-spacing: .14em; font-size: .8rem; color: var(--al-tizne); }
  .e2-mesa__para { margin: 0; color: #2b2824; }

  /* Más fuegos: tres eventos en texto, con una línea de brasa arriba. */
  .e2-fuegos { padding-top: clamp(28px, 6vw, 72px); }
  .e2-fuegos__lista {
    list-style: none; margin: 0 auto; padding: 0 var(--al-margen); max-width: var(--al-max);
    display: grid; gap: 26px;
  }
  .e2-fuegos__lista li { display: grid; gap: 8px; align-content: start; padding-top: 16px; border-top: 1px solid rgba(242, 195, 143, .28); }
  .e2-fuegos__que {
    margin: 0; font-family: var(--al-f-display); font-weight: 560; line-height: 1.02; letter-spacing: -.01em;
    font-size: clamp(1.9rem, 1.3rem + 2.4vw, 3rem); color: #f2c38f;
