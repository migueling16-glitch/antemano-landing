  }
  html:not([data-quieto]) .e2-antes:not(.is-tocado) .e2-antes__bola { animation: e2-late-bola 1.6s ease-in-out infinite; }
  @keyframes e2-late-bola { 0%, 100% { box-shadow: 0 6px 24px rgba(0, 0, 0, .45), 0 0 0 0 rgba(242, 195, 143, .7); } 50% { box-shadow: 0 6px 24px rgba(0, 0, 0, .45), 0 0 0 14px rgba(242, 195, 143, 0); } }
  .e2-antes__desliza {
    position: absolute; top: calc(50% + 38px); left: 0; transform: translateX(-50%); white-space: nowrap;
