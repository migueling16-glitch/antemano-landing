    {clip('cierre') && <video class="e2-clip" data-clip={clip('cierre')} muted playsinline loop preload="none" disablepictureinpicture aria-hidden="true"></video>}
    <span class="e2-cierre__luz" aria-hidden="true"></span>
    <div class="e2-brasas e2-brasas--cierre" aria-hidden="true">{BRASAS.map((i) => <i style={`--i:${i}`}></i>)}</div>
  </div>
  <div class="e2-cierre__texto">
    <p class="e2-cierre__antes al-revela">El fuego se apaga.</p>
    <h2 id="e2-cierre-h2" class="e2-h1 al-revela">La noche<br />se queda.</h2>
    <a id={SECCIONES.tuFecha} class="al-btn al-btn--primario al-revela" href={`#${SECCIONES.tuFecha}`} data-abrir-hoja>{CTA.principal}</a>
  </div>
</section>

<script>
  import { iniciarMovimiento } from './movimiento';
  iniciarMovimiento();
</script>

<style is:global>
  /* ── Base ───────────────────────────────────────────────────────────────────────────── */
