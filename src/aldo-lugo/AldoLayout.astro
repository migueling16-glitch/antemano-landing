---
/**
 * ALDO chef LUGO — layout autocontenido del demo (landing y cuestionario).
 * Todo lo de la marca vive en src/aldo-lugo/ y public/aldo-lugo/. Tokens y utilidades: ver README.md.
 *
 * Props:
 *   title, description   (por omisión, los de SITIO.seo)
 *   variante             'landing' (cabecera con nav y CTA, pie completo) | 'cuestionario' (cabecera simple)
 * Slots:
 *   default              contenido de <main id="contenido">
 *   head                 etiquetas extra en <head>
 *   barra                barra fija inferior de la landing (va fuera de <main>)
 *
 * Contratos para las secciones:
 *   - Cualquier elemento con [data-abrir-hoja] (y data-preset='{"formato":…}' opcional) abre el formulario;
 *     sin JS es un enlace a #tu-fecha. Lo implementa el componente del formulario.
 *   - [data-al-aviso="texto"] → al tocarlo muestra ese aviso (toast) y no navega. window.alAviso(texto) también.
 *   - .al-revela → aparece al entrar en pantalla (nunca en el hero). <html data-quieto> = sin movimiento.
 */
import {
  DEMO, BASE, ASSETS, ORIGEN, SITIO, NAV, SECCIONES, DATOS, CTA, CREDITO_FOTOS,
} from './config';
import { LOGOTIPO, ISOTIPO } from './logos';
import Logo from './components/Logo.astro';
import Dato from './components/Dato.astro';

interface Props {
  title?: string;
  description?: string;
  variante?: 'landing' | 'cuestionario';
}
const { title = SITIO.seo.title, description = SITIO.seo.description, variante = 'landing' } = Astro.props;
const esLanding = variante === 'landing';
const og = `${ORIGEN}${ASSETS}/og.jpg`;
const fuentes =
  'https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@144,560,30,0&family=Barlow+Condensed:wght@600&display=swap';
const anio = 2026;
---
<!doctype html>
<html lang="es-MX" data-variante={variante}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
  <script is:inline>
    // Antes del primer pintado: solo banderas, nada se oculta aquí.
    // data-quieto = sin movimiento (solo si la persona toca "Pausar movimiento").
    // data-suave = el sistema pide menos movimiento: versión calmada (fundidos y brillos, sin zooms ni desplazamientos),
    //   salvo que la persona elija "Ver con movimiento completo" (localStorage al-movimiento-completo = 1).
    // data-inapp = navegador de IG/FB.
    (function (d) {
      var h = d.documentElement, q = false, p = null, c = null;
      h.classList.add('al-js');
      try { q = matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      try { p = localStorage.getItem('al-sin-movimiento'); c = localStorage.getItem('al-movimiento-completo'); } catch (e) {}
      if (p === '1') { h.setAttribute('data-sin-movimiento', ''); h.setAttribute('data-quieto', ''); }
      else if (q && c !== '1') h.setAttribute('data-suave', '');
      if (/Instagram|FBAN|FBAV|FB_IAB|Line\//i.test(navigator.userAgent || '')) h.setAttribute('data-inapp', '');
    })(document);
  </script>
  <title>{title}</title>
  <meta name="description" content={description} />
  {DEMO && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#141414" />
  <meta name="color-scheme" content="dark light" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_MX" />
  <meta property="og:site_name" content={SITIO.marca} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={og} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={`${ASSETS}/brand/favicon.svg`} type="image/svg+xml" />
  <link rel="icon" href={`${ASSETS}/brand/favicon-48.png`} sizes="48x48" type="image/png" />
  <link rel="apple-touch-icon" href={`${ASSETS}/brand/apple-touch-icon.png`} />
  <!-- Fuentes sin bloquear el primer pintado: la hoja se aplica al cargar; mientras, Georgia / system-ui. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href={fuentes} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={fuentes} /></noscript>
  <slot name="head" />
</head>
<body class:list={['al', `al--${variante}`]}>
  <!-- Sprite de marca: el trazo viaja una vez; <Logo /> lo usa con <use>. No usar display:none. -->
  <svg class="al-sprite" width="0" height="0" aria-hidden="true" focusable="false">
    <symbol id="al-logotipo" viewBox={`0 0 ${LOGOTIPO.w} ${LOGOTIPO.h}`}><path fill="currentColor" fill-rule="evenodd" d={LOGOTIPO.d} /></symbol>
    <symbol id="al-isotipo" viewBox={`0 0 ${ISOTIPO.w} ${ISOTIPO.h}`}><path fill="currentColor" fill-rule="evenodd" d={ISOTIPO.d} /></symbol>
  </svg>

  <a class="al-saltar" href="#contenido">Saltar al contenido</a>

  {DEMO && (
    <div class="al-demo" role="note">
      <div class="al-wrap al-demo__in">
        <span class="al-demo__punto" aria-hidden="true"></span>
        {esLanding ? (
          <span class="al-demo__txt"><span class="al-demo__largo">{SITIO.demo.franja}</span><span class="al-demo__corto">{SITIO.demo.franjaCorta}</span></span>
          <button class="al-demo__mov" type="button" data-movimiento-completo hidden>Ver movimiento completo</button>
          <a class="al-demo__enlace" href={`${BASE}/cuestionario/`}><span class="al-demo__largo">{SITIO.demo.enlaceCuestionario}</span><span class="al-demo__corto">{SITIO.demo.enlaceCorto}</span><span class="al-demo__flecha" aria-hidden="true">→</span></a>
        ) : (
          <span class="al-demo__txt">{SITIO.demo.franjaCuestionario}</span>
        )}
      </div>
    </div>
  )}

  <header class="al-cabecera" data-tema="noche">
    <div class="al-wrap al-cabecera__in">
      <a class="al-cabecera__logo" href={`${BASE}/`} aria-label={`${SITIO.marca}, inicio`}>
        <Logo tipo="logotipo" decorativo />
      </a>
      {esLanding ? (
        <>
          <nav class="al-nav" aria-label="Secciones">
            {NAV.map((n) => <a href={n.href}>{n.texto}</a>)}
          </nav>
          <a class="al-cabecera__cta" href={`#${SECCIONES.tuFecha}`} data-abrir-hoja>{CTA.principal}</a>
        </>
      ) : (
        <a class="al-cabecera__cta" href={`${BASE}/`}>Ver la página</a>
      )}
    </div>
  </header>

  <main id="contenido" tabindex="-1">
    <slot />
  </main>

  {esLanding ? (
    <footer class="al-pie" data-tema="noche">
      <div class="al-wrap al-pie__in">
        <a class="al-pie__logo" href={`${BASE}/`} aria-label={`${SITIO.marca}, inicio`}><Logo tipo="logotipo" decorativo /></a>
        <p class="al-label al-pie__linea">{SITIO.linea} · Banquetes al fuego · Durango</p>
        <ul class="al-pie__lista">
          <li><span class="al-muted">WhatsApp</span> <Dato valor={null} etiqueta="número" pregunta={16} /></li>
          <li><a href={SITIO.instagram.url} target="_blank" rel="noopener">@{SITIO.instagram.usuario}</a></li>
          <li><span class="al-muted">Aviso de privacidad</span> <Dato valor={DATOS.avisoPrivacidadUrl} etiqueta="aviso" pregunta={18} /></li>
          <li><span class="al-muted">Razón social y RFC</span> <Dato valor={DATOS.razonSocial} etiqueta="datos fiscales" pregunta={18} /></li>
        </ul>
        <p class="al-small al-muted">{CREDITO_FOTOS}. Horno de tierra: maestro mezcalero Paco Camacho.</p>
        <div class="al-pie__base">
          <p class="al-small al-muted">© {anio} {SITIO.chef}{DEMO && ' · Demo preparado por Antemano'}</p>
          <button class="al-movimiento" type="button" data-al-movimiento aria-pressed="false">Pausar movimiento</button>
        </div>
      </div>
    </footer>
  ) : (
    <footer class="al-pie al-pie--simple" data-tema="noche">
      <div class="al-wrap al-pie__base">
        <a class="al-pie__iso" href={`${BASE}/`} aria-label={`${SITIO.marca}, inicio`}><Logo tipo="isotipo" decorativo /></a>
        <p class="al-small al-muted">{SITIO.chef} · {SITIO.linea}{DEMO && ' · Demo preparado por Antemano'}</p>
      </div>
    </footer>
  )}

  <slot name="barra" />

  <div class="al-aviso" role="status" aria-live="polite" data-al-aviso-caja></div>

  <script>
    // ---------- Revelado ligero (solo opacity/transform) ----------
    // Lo que ya está en pantalla al cargar se marca visible ANTES de activar .al-anima: el primer pintado nunca oculta nada.
    const raiz = document.documentElement;
    const quieto = () => raiz.hasAttribute('data-quieto');
    const pendientes = Array.from(document.querySelectorAll<HTMLElement>('.al-revela'));

    function mostrarTodo() {
      pendientes.forEach((el) => el.classList.add('is-visible'));
      raiz.classList.remove('al-anima');
    }

    if (quieto() || !('IntersectionObserver' in window)) {
      mostrarTodo();
    } else {
      const alto = window.innerHeight || 800;
      const fuera: HTMLElement[] = [];
      for (const el of pendientes) {
        const r = el.getBoundingClientRect();
        if (r.top < alto && r.bottom > 0) el.classList.add('is-visible');
        else fuera.push(el);
      }
      const io = new IntersectionObserver(
        (entradas) => {
          for (const e of entradas) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
      );
      fuera.forEach((el) => io.observe(el));
      raiz.classList.add('al-anima');
    }

    // ---------- Avisos (toast) ----------
    const caja = document.querySelector<HTMLElement>('[data-al-aviso-caja]');
    let reloj = 0;
    function alAviso(texto: string) {
      if (!caja || !texto) return;
      caja.textContent = '';
      caja.classList.remove('is-visible');
      // El aviso no recibe toques (pointer-events: none): nunca tapa un botón. Se va solo a los 5 s.
    // Reescribir en el siguiente cuadro para que el lector de pantalla lo anuncie aunque se repita.
      requestAnimationFrame(() => {
        caja.textContent = texto;
        caja.classList.add('is-visible');
      });
      clearTimeout(reloj);
      reloj = window.setTimeout(() => caja.classList.remove('is-visible'), 5000);
    }
    (window as any).alAviso = alAviso;
    document.addEventListener('click', (ev) => {
      const t = (ev.target as Element | null)?.closest<HTMLElement>('[data-al-aviso]');
      if (!t) return;
      ev.preventDefault();
      alAviso(t.dataset.alAviso || '');
    });

    // ---------- Movimiento completo (el sistema pide menos; la persona puede pedir todo) ----------
    const btnCompleto = document.querySelector<HTMLButtonElement>('[data-movimiento-completo]');
    const sistemaReduce = (() => { try { return matchMedia('(prefers-reduced-motion: reduce)').matches; } catch { return false; } })();
    if (btnCompleto && sistemaReduce) {
      const completo = (() => { try { return localStorage.getItem('al-movimiento-completo') === '1'; } catch { return false; } })();
      btnCompleto.hidden = false;
      btnCompleto.textContent = completo ? 'Movimiento suave' : 'Ver movimiento completo';
      btnCompleto.addEventListener('click', () => {
        try { localStorage.setItem('al-movimiento-completo', completo ? '0' : '1'); sessionStorage.removeItem('al-encendido'); } catch {}
        location.reload();
      });
    }

    // ---------- Pausar movimiento (WCAG 2.2.2) ----------
    document.querySelectorAll<HTMLButtonElement>('[data-al-movimiento]').forEach((b) => {
      const pintar = () => {
        const pausado = raiz.hasAttribute('data-sin-movimiento');
        b.setAttribute('aria-pressed', pausado ? 'true' : 'false');
        b.textContent = pausado ? 'Reanudar movimiento' : 'Pausar movimiento';
      };
      pintar();
      b.addEventListener('click', () => {
        const pausar = !raiz.hasAttribute('data-sin-movimiento');
        raiz.toggleAttribute('data-sin-movimiento', pausar);
        raiz.toggleAttribute('data-quieto', pausar);
        try { localStorage.setItem('al-sin-movimiento', pausar ? '1' : '0'); } catch {}
        if (pausar) mostrarTodo();
        pintar();
        alAviso(pausar ? 'Movimiento en pausa.' : 'Movimiento activado.');
        document.dispatchEvent(new CustomEvent('al:movimiento', { detail: { pausado: pausar } }));
      });
    });
  </script>
</body>
</html>

<style is:global>
  /* =====================================================================
     TOKENS (propuesta §8; ESPEC §3.1) — todo con prefijo --al-
     ===================================================================== */
  :root {
    /* Color: monocromo + acentos. Sello y brasa ≤ 2 % y ≤ 1 % de la pantalla. */
    --al-carbon: #141414;
    --al-hollin: #1f1d1a;
    --al-carbon-3: #2b2824; /* solo filetes decorativos */
    --al-hueso: #ede6d6;
    --al-cal: #e0d6c2;
    --al-ceniza: #9a9183; /* texto secundario sobre carbón/hollín (5.9 / 5.4:1) */
    --al-tizne: #5e5950; /* texto secundario sobre hueso/cal (5.6 / 4.8:1) */
    --al-sello: #e3120b; /* solo gráficos o texto ≥ 24 px */
    --al-sello-tinta: #b0140f; /* fondo del CTA primario (hueso encima 5.7:1); nunca texto sobre oscuro */
    --al-sello-tinta-2: #95110c; /* hover/activo del primario */
    --al-brasa: #e8742a; /* solo luz: progreso, brillos. Nunca texto */

    /* Tipografía */
    --al-f-display: 'Fraunces', Georgia, 'Noto Serif', 'Times New Roman', serif;
    --al-f-label: 'Barlow Condensed', 'Avenir Next Condensed', 'Arial Narrow', 'Roboto Condensed', sans-serif;
    --al-f-text: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    --al-fs-h1: clamp(2.75rem, 1rem + 7.4vw, 9rem); /* 44 px en 375 · ~122 px en 1440 */
    --al-fs-h2: clamp(2.125rem, 1.4rem + 3.2vw, 5rem);
    --al-fs-h3: clamp(1.625rem, 1.3rem + 1.2vw, 2.5rem);
    --al-fs-manifiesto: clamp(1.75rem, 1.2rem + 2.4vw, 3.5rem);
    --al-fs-lead: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    --al-fs-body: 1.0625rem; /* 17 px */
    --al-fs-label: 0.8125rem;
    --al-fs-small: 0.8125rem;
    --al-fs-input: max(1rem, 16px);
    --al-lh-h1: 0.98;
    --al-lh-h2: 1.04;
    --al-lh-h3: 1.1;
    --al-lh-body: 1.55;
    --al-tr-label: 0.14em;
    --al-medida: 36ch;

    /* Espaciado 4/8 */
    --al-sp-1: 4px; --al-sp-2: 8px; --al-sp-3: 12px; --al-sp-4: 16px; --al-sp-5: 24px; --al-sp-6: 32px;
    --al-sp-7: 48px; --al-sp-8: 64px; --al-sp-9: 96px; --al-sp-10: 128px;
    --al-margen: 20px;
    --al-sec-pad: clamp(3rem, -1rem + 10vw, 8rem);
    --al-max: 1440px;
    --al-tap: 44px;
    --al-btn-h: 52px;
    --al-btn-h-2: 48px;

    /* Radios: editorial, casi rectos */
    --al-r-0: 0; --al-r-1: 2px; --al-r-2: 4px; --al-r-full: 999px;

    /* Movimiento */
    --al-ease-brasa: cubic-bezier(.22, 1, .36, 1);
    --al-ease-corte: cubic-bezier(.76, 0, .24, 1);
    --al-t-micro: 160ms;
    --al-t-ui: 280ms;
    --al-t-reveal: 700ms;

    /* Capas y alturas */
    --al-z-cabecera: 30; --al-z-barra: 50; --al-z-aviso: 55; --al-z-dialogo: 60;
    --al-demo-h: 32px;
    --al-cabecera-h: 56px;
  }
  @media (min-width: 768px) { :root { --al-margen: 32px; } }
  @media (min-width: 1024px) { :root { --al-margen: clamp(32px, 5vw, 96px); --al-cabecera-h: 72px; --al-fs-body: 1.125rem; } }

  /* Temas por sección: data-tema="noche" (carbón) | "dia" (hueso). Sin transiciones ligadas al scroll. */
  [data-tema='noche'] {
    --al-bg: var(--al-carbon); --al-fg: var(--al-hueso); --al-fg-2: var(--al-ceniza); --al-sup: var(--al-hollin);
    --al-linea: rgba(237, 230, 214, .16); --al-foco: var(--al-hueso); --al-enlace: var(--al-hueso);
  }
  [data-tema='dia'] {
    --al-bg: var(--al-hueso); --al-fg: var(--al-carbon); --al-fg-2: var(--al-tizne); --al-sup: var(--al-cal);
    --al-linea: rgba(20, 20, 20, .14); --al-foco: var(--al-carbon); --al-enlace: var(--al-sello-tinta);
  }
  [data-tema] { background-color: var(--al-bg); color: var(--al-fg); }

  /* =====================================================================
     BASE
     ===================================================================== */
  html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; scroll-padding-top: 16px; }
  html:has(dialog[open]) { overflow: hidden; }
  @media (prefers-reduced-motion: no-preference) { html:not([data-quieto]) { scroll-behavior: smooth; } }
  body.al {
    --al-bg: var(--al-carbon); --al-fg: var(--al-hueso); --al-fg-2: var(--al-ceniza); --al-sup: var(--al-hollin);
    --al-linea: rgba(237, 230, 214, .16); --al-foco: var(--al-hueso); --al-enlace: var(--al-hueso);
    margin: 0; min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column;
    background: var(--al-carbon); color: var(--al-hueso);
    font: 400 var(--al-fs-body) / var(--al-lh-body) var(--al-f-text);
    -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
    overflow-x: clip;
  }
  .al ::selection { background: var(--al-sello-tinta); color: var(--al-hueso); }
  .al img, .al svg, .al video { max-width: 100%; }
  .al a { color: inherit; }
  .al :focus { outline: none; }
  .al :focus-visible { outline: 2px solid var(--al-foco); outline-offset: 2px; border-radius: var(--al-r-1); }
  .al input, .al select, .al textarea { font-size: var(--al-fs-input); }
  .al p { margin: 0; }
  .al-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  main#contenido { flex: 1 0 auto; }
  main#contenido:focus { outline: none; }

  /* =====================================================================
     UTILIDADES — layout
     ===================================================================== */
  .al-wrap { width: 100%; max-width: var(--al-max); margin-inline: auto; padding-inline: var(--al-margen); }
  .al-sec { padding-block: var(--al-sec-pad); position: relative; }
  .al-medida { max-width: var(--al-medida); }
  @media (min-width: 1024px) { .al-medida { max-width: 60ch; } }
  .al-pila > * + * { margin-top: var(--al-pila, var(--al-sp-4)); }
  .al-filete { height: 1px; border: 0; background: var(--al-linea); margin: 0; }
  .al-sr {
    position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* =====================================================================
     UTILIDADES — tipografía
     ===================================================================== */
  .al-h1, .al-h2, .al-h3, .al-display {
    font-family: var(--al-f-display); font-weight: 560; margin: 0;
    font-optical-sizing: auto; text-wrap: balance; color: inherit;
  }
  .al-h1 { font-size: var(--al-fs-h1); line-height: var(--al-lh-h1); letter-spacing: -.02em; }
  .al-h2 { font-size: var(--al-fs-h2); line-height: var(--al-lh-h2); letter-spacing: -.015em; }
  .al-h3 { font-size: var(--al-fs-h3); line-height: var(--al-lh-h3); letter-spacing: -.01em; }
  .al-manifiesto { font-family: var(--al-f-display); font-weight: 560; font-size: var(--al-fs-manifiesto); line-height: 1.15; text-wrap: pretty; }
  .al-label {
    font-family: var(--al-f-label); font-weight: 600; font-size: var(--al-fs-label); line-height: 1.25;
    letter-spacing: var(--al-tr-label); text-transform: uppercase; margin: 0;
  }
  .al-lead { font-size: var(--al-fs-lead); line-height: 1.45; text-wrap: pretty; }
  .al-small { font-size: var(--al-fs-small); line-height: 1.45; }
  .al-muted { color: var(--al-fg-2); }
  .al-num { font-variant-numeric: tabular-nums lining-nums; }
  .al-cita { font-family: var(--al-f-display); font-weight: 560; font-size: var(--al-fs-h3); line-height: 1.2; margin: 0; }

  /* =====================================================================
     UTILIDADES — acciones
     .al-btn--primario: el ÚNICO rojo de la pantalla (nunca dos juntos).
     .al-btn--secundario: filete de 1 px + flecha, 48 px.
     ===================================================================== */
  .al-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .5em;
    min-height: var(--al-btn-h); padding: 0 1.375rem; border: 1px solid transparent; border-radius: var(--al-r-1);
    font: 600 1rem/1.2 var(--al-f-text); text-decoration: none; text-align: center; cursor: pointer;
    -webkit-tap-highlight-color: transparent; touch-action: manipulation; user-select: none;
    transition: background-color var(--al-t-micro) ease, color var(--al-t-micro) ease, border-color var(--al-t-micro) ease, transform var(--al-t-micro) ease;
  }
  .al-btn:active { transform: scale(.98); }
  .al-btn[disabled], .al-btn[aria-disabled='true'] { opacity: .55; cursor: not-allowed; }
  .al-btn--primario { background: var(--al-sello-tinta); color: var(--al-hueso); }
  .al-btn--primario:hover { background: var(--al-sello-tinta-2); }
