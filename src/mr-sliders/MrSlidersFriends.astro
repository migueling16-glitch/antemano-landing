      html:not(.force-motion) :is(.grain, .cursor) { display: none; }
    }
  </style>

  <script>
    import Lenis from 'lenis';

    const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T | null;
    const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => Array.from(r.querySelectorAll(s)) as T[];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches && !document.documentElement.classList.contains('force-motion');
    const fine = window.matchMedia('(pointer: fine)').matches;
    const body = document.body;

    /* ── Rolling digits ──────────────────────────────────────────────── */
    function initCol(col: HTMLElement) {
      if (col.childElementCount) return;
      col.innerHTML = Array.from({ length: 20 }, (_, i) => `<span>${i % 10}</span>`).join('');
      col.style.setProperty('--n', '0');
      col.dataset.v = '0';
    }
    function setDigit(col: HTMLElement, v: number) {
      const prev = Number(col.dataset.v ?? 0);
      if (prev === v && col.dataset.init) return;
      col.dataset.init = '1';
      col.dataset.v = String(v);
      if (v < prev) {
        col.style.setProperty('--n', String(v + 10));
        const snap = () => {
          col.classList.add('snap');
          col.style.setProperty('--n', String(v));
          void col.offsetHeight;
          col.classList.remove('snap');
          col.removeEventListener('transitionend', snap);
        };
        col.addEventListener('transitionend', snap);
      } else {
        col.style.setProperty('--n', String(v));
      }
    }
    function setNumber(box: HTMLElement, value: number, minSlots = 2) {
      const str = String(Math.max(0, value)).padStart(minSlots, '0');
      let slots = $$('.dg', box);
      while (slots.length < str.length) {
        const s = document.createElement('span'); s.className = 'dg';
        const c = document.createElement('span'); c.className = 'dg-col'; s.appendChild(c);
        box.prepend(s); slots = $$('.dg', box);
      }
      slots.forEach((slot, i) => {
        const col = $('.dg-col', slot)!; initCol(col);
        setDigit(col, Number(str[i]));
      });
    }

    /* ── Countdown ──────────────────────────────────────────────────── */
    function countdown(root: HTMLElement | null, targetIso: string | undefined, onDone?: () => void) {
      if (!root || !targetIso) return;
      const target = new Date(targetIso).getTime();
      const units: Record<string, HTMLElement> = {};
      $$('.cd-num', root).forEach((n) => { units[n.dataset.unit!] = n; $$('.dg-col', n).forEach(initCol); });
      let done = false;
      const tick = () => {
        let diff = Math.max(0, target - Date.now());
        const d = Math.floor(diff / 864e5); diff -= d * 864e5;
        const h = Math.floor(diff / 36e5); diff -= h * 36e5;
        const m = Math.floor(diff / 6e4); diff -= m * 6e4;
        const s = Math.floor(diff / 1e3);
        setNumber(units.d, d); setNumber(units.h, h); setNumber(units.m, m); setNumber(units.s, s);
        if (target - Date.now() <= 0 && !done) {
          done = true; root.classList.add('done');
          const live = $('.cd-live', root); if (live) live.hidden = false;
          onDone?.();
        }
      };
      tick(); setInterval(tick, 1000);
    }

    /* ── Reveal card (ubicación) ─────────────────────────────────────── */
    const card = $('#revealCard');
    function openReveal() {
      if (!card || card.classList.contains('flip')) return;
      const open = $('#revealOpen', card)!; open.hidden = false;
      requestAnimationFrame(() => card.classList.add('flip'));
    }
    if (card) {
      const t = new Date(card.dataset.target!).getTime();
      if (Date.now() >= t) { openReveal(); $('#revealLocked', card)!.hidden = true; }
      else countdown($('#cdReveal'), card.dataset.target, () => setTimeout(openReveal, 600));
    }

    /* ── Intro ──────────────────────────────────────────────────────── */
    const intro = $('#intro');
    const skipIntro = document.documentElement.classList.contains('no-intro') || !intro;
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    function startHero() {
      body.classList.remove('locked');
      body.classList.add('ready');
      const party = $('#cdParty'); countdown(party, party?.dataset.target);
    }
    if (skipIntro) {
      intro?.remove();
      requestAnimationFrame(startHero);
    } else {
      body.classList.add('locked');
      const num = $('#introNum')!, count = $('.intro-count', intro!)!, masc = $('#introMascot')!;
      const rings = $('#introRings')!, word = $('#introWord')!;
      $$('path', masc).forEach((p, i) => (p as HTMLElement).style.setProperty('--k', String(i)));
      const t0 = performance.now();
      const dur = 1300;
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        num.textContent = String(Math.round(ease(p) * 365)).padStart(3, '0');
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      setTimeout(() => masc.classList.add('drop'), 1100);
      setTimeout(() => {
        masc.classList.remove('drop'); masc.classList.add('smash');
        rings.classList.add('go'); intro!.classList.add('shake');
        count.classList.add('gone'); word.classList.add('go');
      }, 1720);
      setTimeout(() => {
        intro!.classList.add('out');
        try { sessionStorage.setItem('msf-intro', '1'); } catch {}
        startHero();
        setTimeout(() => intro!.remove(), 1200);
      }, 2750);
    }

    /* ── Lenis ──────────────────────────────────────────────────────── */
    let velocity = 0;
    if (!reduce) {
      const lenis = new Lenis({ duration: 1.15, easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), smoothWheel: true });
      (window as any).lenis = lenis;
      document.documentElement.classList.add('has-lenis');
      lenis.on('scroll', (e: any) => { velocity = e.velocity; });
      const raf = (t: number) => { lenis.raf(t); requestAnimationFrame(raf); };
      requestAnimationFrame(raf);
      const sync = () => (body.classList.contains('locked') ? lenis.stop() : lenis.start());
      new MutationObserver(sync).observe(body, { attributes: true, attributeFilter: ['class'] });
      sync();
    } else {
      window.addEventListener('scroll', () => { velocity = 0; }, { passive: true });
    }

    /* ── Marquee (velocidad ligada al scroll) ───────────────────────── */
    const track = $('#marqueeTrack');
    if (track && !reduce) {
      let x = 0, half = 0;
      const measure = () => { half = track.scrollWidth / 2; };
      measure(); window.addEventListener('resize', measure);
      const loop = () => {
        const speed = 0.9 + Math.min(6, Math.abs(velocity) * 0.25);
        x -= speed; if (x <= -half) x += half;
        const skew = Math.max(-12, Math.min(12, velocity * 0.6));
        track.style.transform = `translate3d(${x}px,0,0) skewX(${skew}deg)`;
        requestAnimationFrame(loop);
      };
      requestAnimationFrame(loop);
    }

    /* ── Reveals on scroll ──────────────────────────────────────────── */
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        en.target.classList.add('in'); io.unobserve(en.target);
        const roll = $('[data-roll]', en.target) ?? (en.target.matches('[data-roll]') ? (en.target as HTMLElement) : null);
        if (roll) {
          $$('.dg-col', roll).forEach(initCol);
          en.target.closest('.h2')?.classList.add('go');
          const len = Math.max(2, String(Number(roll.dataset.roll)).length);
          while ($$('.dg', roll).length > len) $('.dg', roll)!.remove();
          setTimeout(() => setNumber(roll, Number(roll.dataset.roll), len), 250);
        }
        $$('[data-count]', en.target).forEach((el) => {
          const to = Number(el.dataset.count); const t0 = performance.now(); const dur = 1400;
          const step = (now: number) => {
            const p = Math.min(1, (now - t0) / dur);
            el.textContent = String(Math.round(ease(p) * to));
            if (p < 1) requestAnimationFrame(step);
          };
          requestAnimationFrame(step);
        });
      });
    }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
    $$('[data-reveal]').forEach((el) => io.observe(el));

    /* ── Cursor, aura, parallax, magnet ─────────────────────────────── */
    const cursor = $('#cursor'), aura = $('#aura'), mascot = $('#heroMascot');
    let mx = innerWidth / 2, my = innerHeight / 2, cx = mx, cy = my, ax = mx, ay = my;
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    if (fine && !reduce) {
      window.addEventListener('pointermove', (e) => {
        mx = e.clientX; my = e.clientY;
        if (mascot) {
          const rx = (e.clientX / innerWidth - 0.5), ry = (e.clientY / innerHeight - 0.5);
          const svg = $('svg', mascot)!;
          svg.style.setProperty('--px', `${rx * -22}px`); svg.style.setProperty('--py', `${ry * -16}px`);
          svg.style.setProperty('--rz', `${rx * 6}deg`);
        }
      }, { passive: true });
      const tickCursor = () => {
        cx = lerp(cx, mx, 0.35); cy = lerp(cy, my, 0.35);
        ax = lerp(ax, mx, 0.06); ay = lerp(ay, my, 0.06);
        if (cursor) cursor.style.transform = `translate3d(${cx}px,${cy}px,0)`;
        if (aura) aura.style.transform = `translate3d(${ax - innerWidth * 0.35}px,${ay - innerHeight * 0.35}px,0) translate(-15%,-15%)`;
        requestAnimationFrame(tickCursor);
      };
      requestAnimationFrame(tickCursor);
      $$('[data-hover]').forEach((el) => {
        el.addEventListener('pointerenter', () => cursor?.classList.add('hover'));
        el.addEventListener('pointerleave', () => cursor?.classList.remove('hover'));
      });
      window.addEventListener('pointerdown', () => cursor?.classList.add('down'));
      window.addEventListener('pointerup', () => cursor?.classList.remove('down'));
      $$('[data-magnet]').forEach((el) => {
        el.addEventListener('pointermove', (e: PointerEvent) => {
          const r = el.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2), dy = e.clientY - (r.top + r.height / 2);
          el.style.transform = `translate(${dx * 0.22}px,${dy * 0.28}px)`;
        });
        el.addEventListener('pointerleave', () => { el.style.transform = ''; });
      });
    } else if (aura) {
      aura.style.transform = `translate(${innerWidth * 0.6}px,${innerHeight * 0.3}px) translate(-50%,-50%)`;
    }

    /* ── Touch: toques que disparan lo que en desktop hace el hover ─── */
    const coarse = window.matchMedia('(pointer: coarse)').matches;
    if (coarse && !reduce) {
      const poke = (sel: string, cls: string, ms = 650) => {
        $$(sel).forEach((el) => {
          el.addEventListener('pointerdown', () => {
            el.classList.remove(cls); void (el as HTMLElement).offsetWidth; el.classList.add(cls);
            setTimeout(() => el.classList.remove(cls), ms);
          }, { passive: true });
        });
      };
      poke('.cd-group', 'wob'); poke('.friends-word', 'wob', 900); poke('#revealLocked', 'poke', 1200);
      poke('.crowd .head', 'wave', 600); poke('.stat', 'poke', 900); poke('.tix-card', 'poke', 900);
      poke('.btn', 'poke', 500); poke('.top-brand', 'poke', 600); poke('.promo', 'poke', 700);

      // Parallax de la mascota del hero: scroll siempre, giroscopio cuando el dispositivo lo permite.
      const svg = mascot ? $('svg', mascot) : null;
      let gx = 0, gy = 0, gyro = false;
      const applyMascot = () => {
        if (!svg) return;
        const sy = Math.min(1, window.scrollY / Math.max(1, innerHeight));
        svg.style.setProperty('--py', `${gy * -14 + sy * 60}px`);
        svg.style.setProperty('--px', `${gx * -18}px`);
        svg.style.setProperty('--rz', `${gx * 8 + sy * 6}deg`);
      };
      window.addEventListener('scroll', applyMascot, { passive: true });
      const onTilt = (e: DeviceOrientationEvent) => {
        if (e.gamma == null || e.beta == null) return;
        gyro = true;
        gx = lerp(gx, Math.max(-1, Math.min(1, e.gamma / 30)), 0.15);
        gy = lerp(gy, Math.max(-1, Math.min(1, (e.beta - 45) / 30)), 0.15);
        applyMascot();
      };
      const enableGyro = () => {
        const DOE: any = (window as any).DeviceOrientationEvent;
        if (!DOE) return;
        if (typeof DOE.requestPermission === 'function') {
          DOE.requestPermission().then((r: string) => { if (r === 'granted') window.addEventListener('deviceorientation', onTilt); }).catch(() => {});
        } else window.addEventListener('deviceorientation', onTilt);
      };
      // iOS exige un gesto del usuario para pedir permiso; Android lo da directo.
      if (typeof (window as any).DeviceOrientationEvent?.requestPermission === 'function') {
        window.addEventListener('pointerdown', enableGyro, { once: true });
      } else enableGyro();
      void gyro;
    }

    /* ── Click = smash ripple ───────────────────────────────────────── */
    if (!reduce) {
      window.addEventListener('pointerdown', (e) => {
        if (body.classList.contains('locked')) return;
        const r = document.createElement('span'); r.className = 'ripple';
        r.style.left = `${e.clientX}px`; r.style.top = `${e.clientY}px`;
        body.appendChild(r); r.addEventListener('animationend', () => r.remove());
        const m = $('.hero-mascot-inner');
        if (m) { m.style.animation = 'squash .5s var(--out) both'; setTimeout(() => (m.style.animation = ''), 520); }
      });
    }

    /* ── Sprinkles del hero con delay individual ────────────────────── */
    $$('.hero-mascot path').forEach((p, i) => (p as HTMLElement).style.setProperty('--k', String(i)));
  </script>
</body>
</html>
