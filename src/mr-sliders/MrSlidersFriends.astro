    .tix-card::before { content: ''; position: absolute; inset: -40% -40% auto auto; width: 70%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, rgba(240, 90, 37, .28), transparent 65%); filter: blur(30px); pointer-events: none; }
    .tix-card:hover { border-color: rgba(240, 90, 37, .5); transform: translateY(-4px); }
    .tix-card-top { display: flex; justify-content: space-between; align-items: baseline; color: var(--orange); }
