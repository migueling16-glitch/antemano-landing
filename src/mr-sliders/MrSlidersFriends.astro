    .tix-perks li { display: flex; align-items: center; gap: .8rem; }
    .tix-perks i { width: 6px; height: 6px; border-radius: 50%; background: var(--orange); flex: none; }
    .tix-link { display: inline-flex; gap: .5rem; margin-top: 1.6rem; color: var(--ink); }
