    .map-pin { position: absolute; left: 55%; top: 30%; width: 14px; height: 14px; border-radius: 50%; background: var(--orange); box-shadow: 0 0 0 0 rgba(240, 90, 37, .6); animation: pulse 2.2s var(--out) infinite; filter: blur(3px); }
    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(240, 90, 37, .6); } 100% { box-shadow: 0 0 0 40px rgba(240, 90, 37, 0); } }
    .reveal-body { position: relative; padding: 2rem; display: flex; flex-direction: column; gap: .6rem; }
