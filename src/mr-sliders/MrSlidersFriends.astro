    .reveal-card.flip .reveal-open { animation: flipIn .9s var(--out) both; }
    @keyframes flipIn { from { transform: rotateY(180deg); } to { transform: rotateY(0); } }

    .friends-sec { text-align: left; }
    .friends-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: 3rem; }
    .friends-note { color: var(--faint); margin-top: 2rem; }

    /* ── Footer ─────────────────────────────────────────────────────── */
    .foot { position: relative; z-index: 2; border-top: 1px solid var(--line); padding: 3rem 0 0; overflow: hidden; }
    .foot-grid { display: flex; justify-content: space-between; align-items: end; gap: 2rem; flex-wrap: wrap; }
    .foot-logo { width: 180px; color: var(--ink); }
    .foot-logo svg { width: 100%; height: auto; }
    .foot-meta { display: flex; gap: 1.6rem; flex-wrap: wrap; color: var(--faint); }
    .foot-meta a { color: var(--ink); }
    .foot-big { font-size: clamp(6rem, 24vw, 22rem); font-weight: 700; line-height: .78; color: var(--orange); transform: skewX(-5deg) translateY(.12em); white-space: nowrap; text-align: center; margin-top: 2rem; user-select: none; opacity: .95; }
    .foot-big span { display: inline-block; transition: transform .8s var(--out); }
    .foot-big:hover span { transform: translateY(-.04em); }

    /* Reduced motion: todo visible y sin animar. `?motion=1` en la URL lo ignora (demo/QA). */
    /* ── Móvil / touch: equivalentes táctiles del hover ─────────────── */
    .cd-group.wob .dg-col { animation: wob .5s var(--out); }
    .friends-word.wob .ch { animation: bounce .6s var(--out); animation-delay: calc(var(--i) * 40ms); }
    .reveal-locked.poke { border-color: rgba(240, 90, 37, .5); animation: nope .5s var(--out); }
    .reveal-locked.poke .reveal-tease span { opacity: 1; transform: none; }
    .crowd .head.wave svg { transform: rotate(-14deg) translateY(-6%) scale(1.15); }
    .stat.poke { background: var(--black-2); transform: translateY(-4px); }
    .stat.poke .stat-num { color: var(--orange); }
    .tix-card.poke { border-color: rgba(240, 90, 37, .5); transform: translateY(-4px); }
    .promo.poke { transform: scale(1.01); }
    .btn.poke::before { transform: scaleX(1); }
    .btn.poke span { transform: translateX(3px); }
    .btn-line.poke { color: var(--black); border-color: var(--orange); }
    .top-brand.poke { transform: rotate(-8deg) scale(1.08); }
    @media (pointer: coarse) {
      .aura { animation: breathe 6s ease-in-out infinite, drift 18s ease-in-out infinite alternate; }
      @keyframes drift { 0% { translate: -12vw -8vh; } 50% { translate: 18vw 10vh; } 100% { translate: -6vw 26vh; } }
      .hero-mascot-inner svg { transition: transform .35s var(--out); }
      .crowd .head { width: clamp(24px, 8.5vw, 34px); }
      .crowd { gap: .3rem; }
    }

    @media (prefers-reduced-motion: reduce) {
      html:not(.force-motion) *, html:not(.force-motion) *::before, html:not(.force-motion) *::after { animation: none !important; transition: none !important; }
