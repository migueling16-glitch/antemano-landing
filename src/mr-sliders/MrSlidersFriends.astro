    .tix-bar { height: 6px; border-radius: 999px; background: var(--line); overflow: hidden; margin-top: 1rem; }
    .tix-bar i { display: block; height: 100%; width: var(--p); background: linear-gradient(90deg, var(--orange), var(--orange-hi)); transform: scaleX(0); transform-origin: left; transition: transform 1.6s var(--out) .3s; }
    .tix-card.in .tix-bar i { transform: scaleX(1); }
    .tix-card-foot { display: flex; justify-content: space-between; color: var(--faint); margin-top: .8rem; }
