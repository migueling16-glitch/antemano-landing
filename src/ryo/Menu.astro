---
/**
 * Menú interactivo de Ryo Café.
 *
 * Es el mismo componente en la landing (sección 03) y en su propia página
 * (/ryocafe/menu), que es la que abre el QR de la barra. El menú oficial sale
 * de config.ts (MENU, tal cual el PDF); lo que ayuda a elegir sale de
 * menuGuia.ts, y los dibujos de vaso.ts.
 *
 * Está hecho con los seis principios de Made to Stick (Heath & Heath):
 * - Simple: cinco pestañas y, en cada una, una sola firma: "si solo pides
 *   una cosa". Cada clásico sin descripción trae una línea de qué es.
 * - Inesperado: cada bebida se ve por dentro, capa por capa, y el vaso se
 *   llena al abrirla. Cada sección abre con un dato que no se espera.
 * - Concreto: el dibujo y su leyenda dicen qué lleva y en qué orden; vapor =
 *   caliente, cubos = frío.
 * - Creíble: cifras y marcas que ya están en el menú (hecho en casa, Maldon,
 *   Cuero Viejo, 1800 Añejo). Nada inventado.
 * - Emocional: "¿Qué se te antoja?" en vez de categorías técnicas.
 * - Historia: "Primera vez" arma un recorrido de una firma por sección.
 *
 * Y lo de antes, que sigue: pestañas pegajosas (NN/g), buscador, enlaces
 * directos (#bar), deslizar entre secciones, compartir, y sin JS se lee
 * todo el menú seguido. Del PDF conserva el isotipo y el rótulo por página,
 * los nombres en mayúsculas, las descripciones en cursiva, el bar y los
 * mocktails en fondo oscuro y el slogan al cierre.
 */
import {
  NEGOCIO, MENU, MENU_TABS, MENU_ES_DEMO, MENU_MOSTRAR_PRECIOS, MENU_URL, type Item, type Grupo,
} from './config';
import { slug, guiaDe, GANCHOS, FIRMAS, ANTOJOS } from './menuGuia';
import { svgVaso, leyendaDe, spriteVasos, CSS_VASO, type Vaso } from './vaso';
import isotipoSvg from './assets/isotipo.svg?raw';

/** El isotipo se define una sola vez y cada página del menú lo llama con <use>. */
const isoInner = isotipoSvg.replace(/^<svg[^>]*>/, '').replace(/<\/svg>\s*$/, '');
const isoViewBox = '38 40 479 361';
/** "SOFT LIVING, DEEP SIPING." en dos renglones, como cierra cada página del PDF. */
const [slogan1, slogan2] = NEGOCIO.slogan.split(/(?<=,)\s+/);

const norm = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
/** El nombre del grupo también se busca ("mocktails", "toasts"), salvo "Sin café": buscar café no debe traer lo que no lo lleva. */
const buscableDe = (nombre: string) => (norm(nombre).includes('cafe') ? '' : nombre);

type Version = { etq?: string; precio?: string; vaso: Vaso };
type Fila = {
  id: string; nombre: string; precio?: string; variantes: string[]; texto?: string;
  versiones: Version[]; tags: string[]; buscar: string; grupo: string;
};

function filaDe(item: Item, g: Grupo): Fila {
  const guia = guiaDe(item.nombre);
  const id = slug(item.nombre);
  const precio = MENU_MOSTRAR_PRECIOS ? item.precio : undefined;
  const variantes = (item.variantes ?? []).filter((v) => MENU_MOSTRAR_PRECIOS || !v.precio);
  const precioFrio = variantes.find((v) => v.etiqueta === 'frío')?.precio;
  const versiones: Version[] = guia.vaso
    ? guia.frio
      ? [{ etq: 'Caliente', precio, vaso: guia.vaso }, { etq: 'Frío', precio: precioFrio ?? precio, vaso: guia.frio }]
      : [{ vaso: guia.vaso }]
    : [];
  const esBebidaSinAlcohol = g.tab !== 'bar' && g.tab !== 'cocina';
  const fria = esBebidaSinAlcohol && (!!guia.vaso?.hielo || !!guia.frio || variantes.some((v) => v.etiqueta.startsWith('frío')));
  const tags = [
    ...(guia.etiquetas ?? []),
    ...(fria ? ['frio'] : []),
    ...(FIRMAS[g.tab]?.item === id ? ['firma'] : []),
  ];
  const capas = versiones.flatMap((v) => leyendaDe(v.vaso).map((c) => c.nombre));
  return {
    id,
    nombre: item.nombre,
    precio,
    variantes: variantes.map((v) => `${v.etiqueta}${v.precio ? ` ${v.precio}` : ''}`),
    texto: item.desc ?? guia.que,
    versiones,
    tags,
    grupo: g.nombre,
    buscar: norm([item.nombre, item.desc, guia.que, buscableDe(g.nombre), ...variantes.map((v) => v.etiqueta), ...capas].filter(Boolean).join(' ')),
  };
}

const paneles = MENU_TABS.map((t) => {
  const grupos = MENU.filter((g) => g.tab === t.id).map((g) => ({ ...g, filas: g.items.map((it) => filaDe(it, g)) }));
  const filas = grupos.flatMap((g) => g.filas);
  const firma = FIRMAS[t.id];
  const hero = filas.find((f) => f.id === firma?.item);
  return { ...t, grupos, hero: hero ? { ...hero, gancho: firma.gancho } : undefined };
});

const todas = paneles.flatMap((p) => p.grupos.flatMap((g) => g.filas));
const cifras = [
  { n: paneles.filter((p) => p.id !== 'cocina').reduce((s, p) => s + p.grupos.reduce((t, g) => t + g.filas.length, 0), 0), que: 'bebidas' },
  { n: paneles.find((p) => p.id === 'cocina')?.grupos.reduce((t, g) => t + g.filas.length, 0) ?? 0, que: 'platillos' },
  { n: todas.filter((f) => f.tags.includes('casa')).length, que: 'llevan algo hecho en casa' },
];
const ETIQUETAS: Record<string, string> = { casa: 'Hecho en casa', 'sin-cafeina': 'Sin cafeína' };
---

<div class="menu" data-menu data-url={MENU_URL}>
  {/* Las tramas de los vasos: una sola vez por página. */}
  <Fragment set:html={spriteVasos()} />
  <Fragment set:html={`<style>${CSS_VASO}</style>`} />

  {MENU_ES_DEMO && (
    <p class="menu-aviso">Menú de muestra. Los nombres y precios definitivos están por confirmar.</p>
  )}

  <dl class="menu-cifras">
    {cifras.map((c) => (
      <div class="menu-cifra"><dt>{c.que}</dt><dd>{c.n}</dd></div>
    ))}
  </dl>
  <p class="menu-lema">Cada bebida, dibujada por dentro. <span>Toca una para ver qué lleva.</span></p>

  <div class="menu-antojos" data-menu-antojos>
    <p class="menu-etq" id="menu-antojos-etq">¿Qué se te antoja?</p>
    <div class="menu-chips" role="group" aria-labelledby="menu-antojos-etq">
      {ANTOJOS.map((a) => (
        <button type="button" class="menu-chip" aria-pressed="false" data-antojo={a.id} data-estado={a.estado}>{a.texto}</button>
      ))}
      <button type="button" class="menu-chip menu-chip-buscar" aria-expanded="false" aria-controls="menu-buscar" data-menu-abrir-buscar>
        Buscar
      </button>
    </div>
    <div class="menu-buscar" id="menu-buscar" data-menu-buscar hidden>
      <label class="menu-buscar-campo">
        <span class="sr">Buscar en el menú</span>
        <input
          type="search"
          data-menu-q
          placeholder="Avena, matcha, mezcal…"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
          enterkeyhint="search"
        />
      </label>
      <button type="button" class="menu-borrar" data-menu-borrar hidden>Borrar</button>
    </div>
  </div>

  <nav class="menu-tabs" role="tablist" aria-label="Secciones del menú" data-menu-tabs style={`--cols:${paneles.length}`}>
    {paneles.map((p, i) => (
      <a
        class="menu-tab"
        role="tab"
        id={`tab-${p.id}`}
        href={`#${p.id}`}
        aria-controls={p.id}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        data-tab={p.id}
      >
        <span class="menu-tab-nombre">{p.nombre}</span>
        <span class="menu-tab-n" data-n aria-hidden="true"></span>
      </a>
    ))}
  </nav>

  <div class="menu-estado" data-menu-estado-caja hidden>
    <p role="status" aria-live="polite" data-menu-estado></p>
    <button type="button" class="menu-borrar" data-menu-quitar>Ver todo</button>
  </div>

  <div class="menu-paneles" data-menu-paneles>
    <svg class="menu-sprite" aria-hidden="true" focusable="false">
      <symbol id="menu-iso" viewBox={isoViewBox} set:html={isoInner} />
    </svg>

    {paneles.map((p, i) => (
      <section
        class:list={['menu-panel', { inv: p.oscuro }]}
        role="tabpanel"
        id={p.id}
        aria-labelledby={`tab-${p.id}`}
        data-panel={p.id}
        data-activa={i === 0 ? '' : undefined}
        data-oscuro={p.oscuro ? '' : undefined}
        tabindex="0"
      >
        <header class="menu-panel-cab">
          <span class="menu-iso" aria-hidden="true"><svg viewBox={isoViewBox}><use href="#menu-iso" /></svg></span>
          <p class="menu-parte">{p.parte}</p>
          <p class="menu-gancho">{GANCHOS[p.id]}</p>
        </header>

        {p.hero && (
          <article class="menu-firma" data-hero aria-label={`La firma de ${p.nombre}: ${p.hero.nombre}`}>
            <div class:list={['menu-firma-in', { 'sin-vaso': !p.hero.versiones.length }]}>
              {p.hero.versiones[0] && (
                <div class="menu-firma-vaso vaso-llenar" set:html={svgVaso(p.hero.versiones[0].vaso, { recorte: true, numerar: true })} />
              )}
              <div class="menu-firma-texto">
                <p class="menu-firma-etq">La firma · {p.hero.grupo}</p>
                <h3 class="menu-firma-nombre">{p.hero.nombre}</h3>
                {p.hero.precio && <p class="menu-firma-precio">{p.hero.precio}</p>}
                <p class="menu-firma-gancho">{p.hero.gancho}</p>
                {p.hero.versiones[0] ? (
                  <ul class="mi-capas">
                    {leyendaDe(p.hero.versiones[0].vaso).map((c) => (
                      <li><span class="mi-capa-n" aria-hidden="true">{c.n ?? c.marca}</span><span>{c.nombre}</span></li>
                    ))}
                  </ul>
                ) : (
                  p.hero.texto && <p class="menu-firma-desc">{p.hero.texto}</p>
                )}
              </div>
            </div>
          </article>
        )}

        {p.grupos.map((g) => {
          return (
            <div class:list={['menu-grupo', { inv: g.oscuro }]} data-grupo data-oscuro={g.oscuro ? '' : undefined}>
              <h4 class="menu-grupo-nombre"><span>{g.nombre}</span><span class="menu-grupo-n" aria-hidden="true">{g.filas.length}</span></h4>
              <ul class="menu-items">
                {g.filas.map((f) => {
                  const tagsVisibles = f.tags.filter((t) => ETIQUETAS[t]);
                  const cuerpo = (
                    <>
                      <span class="mi-texto">
                        <span class="mi-nombre">{f.nombre}</span>
                        {f.variantes.length > 0 && <span class="mi-var">{f.variantes.join(' · ')}</span>}
                        {f.texto && <span class="mi-desc">{f.texto}</span>}
                        {(f.tags.includes('firma') || tagsVisibles.length > 0) && (
                          <span class="mi-tags">
                            {f.tags.includes('firma') && <span class="mi-tag mi-tag-firma">Firma</span>}
                            {tagsVisibles.map((t) => <span class="mi-tag">{ETIQUETAS[t]}</span>)}
                          </span>
                        )}
                      </span>
                      <span class="mi-precio">{f.precio}</span>
                    </>
                  );
                  return f.versiones.length ? (
                    <li class="menu-item" data-buscar={f.buscar} data-tags={f.tags.join(' ')}>
                      <details class="mi" name="menu-bebida">
                        <summary class="mi-fila">
                          <span class="mi-vaso" set:html={svgVaso(f.versiones[0].vaso)} />
                          {cuerpo}
                          <span class="mi-mas" aria-hidden="true"></span>
                        </summary>
                        <div class="mi-detalle">
                          <div class="mi-versiones" data-versiones={f.versiones.length}>
                            {f.versiones.map((v) => (
                              <figure class="mi-version">
                                <div class="mi-vaso-grande vaso-llenar" set:html={svgVaso(v.vaso, { recorte: true, numerar: true, espacioVapor: f.versiones.some((x) => x.vaso.caliente) })} />
                                <figcaption class="mi-version-texto">
                                  {v.etq && <span class="mi-version-etq">{v.etq}{v.precio && <b> {v.precio}</b>}</span>}
                                  <ul class="mi-capas">
                                    {leyendaDe(v.vaso).map((c) => (
                                      <li><span class="mi-capa-n" aria-hidden="true">{c.n ?? c.marca}</span><span>{c.nombre}</span></li>
                                    ))}
                                  </ul>
                                </figcaption>
                              </figure>
                            ))}
                          </div>
                        </div>
                      </details>
                    </li>
                  ) : (
                    <li class="menu-item menu-plato" data-buscar={f.buscar} data-tags={f.tags.join(' ')}>
                      <div class="mi-fila">{cuerpo}</div>
                    </li>
                  );
                })}
              </ul>
            </div>
          );
        })}
      </section>
    ))}
  </div>

  <div class="menu-vacio" data-menu-vacio hidden>
    <p class="menu-vacio-texto">No encontramos “<span data-menu-vacio-q></span>”.</p>
    <p class="menu-vacio-ayuda">Prueba con un ingrediente (avena, miel, mezcal) o el tipo de bebida.</p>
    <button type="button" class="menu-boton" data-menu-quitar>Ver todo el menú</button>
  </div>

  <div class="menu-pie">
    <p class="menu-slogan">{slogan1}<br />{slogan2}</p>
    <button type="button" class="menu-boton" data-menu-compartir>
      <span data-menu-compartir-texto>Compartir el menú</span>
    </button>
    <p class="menu-nota">Los dibujos muestran qué lleva cada bebida y en qué orden; el vaso puede variar.</p>
  </div>
</div>

<style>
  .menu { --menu-top: 64px; --vaso-fila: 46px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .menu-aviso {
    font-size: var(--fs-sm); font-style: italic;
    border: 1px solid var(--line); padding: var(--space-3); margin-bottom: var(--space-4);
  }

  /* ─── Cifras: lo creíble, en grande ─── */
  .menu-cifras {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--line); margin: 0;
  }
  .menu-cifra { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 2px; padding: 12px 12px 14px; min-width: 0; }
  .menu-cifra + .menu-cifra { border-left: 1px solid var(--line); }
  .menu-cifra dd { margin: 0; font-size: var(--fs-title); font-weight: 700; line-height: 1; font-variant-numeric: tabular-nums; }
  .menu-cifra dt { font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.08em; line-height: 1.3; }
  .menu-lema { margin: var(--space-3) 0 0; font-size: var(--fs-body); line-height: 1.45; }
  .menu-lema span { font-style: italic; }

  /* ─── ¿Qué se te antoja? ─── */
  .menu-antojos { margin: var(--space-4) 0 var(--space-3); }
  .menu-etq { font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: var(--space-2); }
  .menu-chips {
    display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none;
    margin-inline: calc(var(--gutter) * -1); padding: 2px var(--gutter);
    scroll-padding-inline: var(--gutter);
  }
  .menu-chips::-webkit-scrollbar { display: none; }
  .menu-chip {
    position: relative; isolation: isolate; flex: none;
    min-height: 44px; padding: 10px 14px;
    border: 1px solid var(--line);
    font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.1em; white-space: nowrap;
    transition: color 260ms var(--ease), transform 140ms var(--ease);
    -webkit-tap-highlight-color: transparent;
  }
  /* Elegido: se llena de abajo hacia arriba, como un vaso. */
  .menu-chip::before {
    content: ''; position: absolute; inset: 0; z-index: -1; background: var(--ink);
    clip-path: inset(100% 0 0 0); transition: clip-path 320ms var(--ease);
  }
  .menu-chip[aria-pressed='true'], .menu-chip[aria-expanded='true'] { color: var(--surface); font-weight: 700; }
  .menu-chip[aria-pressed='true']::before, .menu-chip[aria-expanded='true']::before { clip-path: inset(0); }
  .menu-chip:active { transform: scale(0.96); }
  .menu-chip:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }
  .menu-chip-buscar::after { content: '⌕'; margin-left: 6px; }
  :global(html.no-js) .menu-antojos { display: none; }

  .menu-buscar { display: flex; align-items: flex-end; gap: var(--space-3); margin-top: var(--space-3); }
  .menu-buscar[hidden] { display: none; }
  .menu-buscar-campo { flex: 1 1 auto; min-width: 0; }
  .menu-buscar input {
    width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--line); border-radius: 0;
    padding: 10px 0;
    /* 16 px como mínimo: así el iPhone no hace zoom al enfocar. */
    font: inherit; font-size: max(16px, var(--fs-body)); letter-spacing: inherit; color: inherit;
    -webkit-appearance: none; appearance: none;
  }
  .menu-buscar input::placeholder { color: var(--ink); opacity: 0.55; }
  .menu-buscar input:focus { outline: none; box-shadow: 0 1px 0 var(--ink); }
  .menu-buscar input::-webkit-search-cancel-button { display: none; }
  .menu-borrar {
    flex: none; min-height: 44px; padding: 0 var(--space-2);
    font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.14em;
    text-decoration: underline; text-underline-offset: 4px;
  }

  /* ─── Pestañas: una fila, fijas arriba, con indicador que se desliza ─── */
  .menu-tabs {
    position: sticky; top: var(--menu-top); z-index: 20;
    display: grid; grid-template-columns: repeat(var(--cols, 5), minmax(0, 1fr));
    background: var(--surface); border: 1px solid var(--line);
    isolation: isolate;
    transition: background-color 600ms var(--ease);
  }
  .menu-tabs::before {
    content: ''; position: absolute; inset: 0 auto 0 0;
    width: calc(100% / var(--cols, 5)); background: var(--ink);
    transform: translateX(calc(var(--idx, 0) * 100%));
    transition: transform 420ms var(--ease), opacity 200ms var(--ease);
    z-index: -1;
  }
  .menu[data-buscando='si'] .menu-tabs::before { opacity: 0; }
  .menu-tab {
    min-height: 52px; padding: 6px 2px;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
    text-decoration: none; text-align: center; line-height: 1.15;
    font-size: min(0.84rem, 3.3vw); letter-spacing: 0.02em; white-space: nowrap;
    transition: color 260ms var(--ease);
    -webkit-tap-highlight-color: transparent;
  }
  .menu-tab + .menu-tab { border-left: 1px solid var(--line); }
  .menu-tab[aria-selected='true'] { color: var(--surface); font-weight: 700; }
  .menu[data-buscando='si'] .menu-tab[aria-selected='true'] { color: var(--ink); font-weight: 400; }
  .menu-tab:active { transform: translateY(1px); }
  .menu-tab-n { font-size: 11px; line-height: 1; min-height: 11px; letter-spacing: 0; font-weight: 700; }
  .menu-tab[data-vacia='si'] { background: repeating-linear-gradient(135deg, var(--ink) 0 1px, transparent 1px 6px); }
  .menu-tab:focus-visible { outline: 2px solid var(--ink); outline-offset: -4px; }
  .menu-tab[aria-selected='true']:focus-visible { outline-color: var(--surface); }

  .menu-estado { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); margin-top: var(--space-2); }
  .menu-estado[hidden] { display: none; }
  .menu-estado p { font-size: var(--fs-sm); font-style: italic; }

  /* ─── Paneles: cada uno es una página del menú impreso ─── */
  :global(html:not(.no-js)) .menu-panel { display: none; }
  :global(html:not(.no-js)) .menu-panel[data-activa] { display: block; }
  :global(html:not(.no-js)) .menu[data-buscando='si'] .menu-panel { display: block; }
  :global(html:not(.no-js)) .menu[data-buscando='si'] .menu-panel[data-sin='si'] { display: none; }
  .menu[data-buscando='si'] [data-hero],
  .menu[data-buscando='si'] .menu-panel-cab { display: none; }
  .menu[data-buscando='si'] .menu-panel { padding-top: var(--space-3); }
  .menu-panel {
    padding-top: var(--space-5); padding-bottom: var(--space-4);
    scroll-margin-top: calc(var(--menu-top) + 64px);
    outline: none;
  }
  :global(html.no-js) .menu-panel + .menu-panel { border-top: 1px solid var(--line); }

  /* El bar (toda la página) y los mocktails (su banda) van en fondo oscuro hasta el borde, como en el PDF. */
  .menu-panel[data-oscuro],
  .menu-grupo[data-oscuro] {
    background: var(--surface); color: var(--ink);
    margin-inline: calc(var(--gutter) * -1); padding-inline: var(--gutter);
  }
  .menu-panel[data-oscuro] { padding-bottom: var(--space-5); }
  .menu-grupo[data-oscuro] { padding-block: var(--space-5); margin-top: var(--space-5); }

  /* La portada de cada sección: isotipo, rótulo y el dato que la hace distinta. */
  .menu-panel-cab { display: flex; flex-direction: column; align-items: center; gap: var(--space-2); margin-bottom: var(--space-4); text-align: center; }
  .menu-iso { display: block; width: 56px; color: var(--ink); }
  .menu-iso svg { display: block; width: 100%; height: auto; }
  .menu-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
  .menu-parte { font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.3em; padding-bottom: var(--space-2); position: relative; }
  .menu-parte::after { content: ''; position: absolute; left: 50%; bottom: 0; width: 36px; border-top: 1px solid var(--line); transform: translateX(-50%); }
  .menu-gancho { font-size: var(--fs-heading); font-style: italic; line-height: 1.4; max-width: 30ch; margin-top: var(--space-1); }

  /* ─── La firma: "si solo pides una cosa". Invertida respecto a su página. ─── */
  .menu-firma { --f-fondo: var(--ink); --f-tinta: var(--surface); margin-bottom: var(--space-5); }
  .menu-firma-in {
    --surface: var(--f-fondo); --ink: var(--f-tinta); --line: var(--f-tinta);
    background: var(--surface); color: var(--ink);
    display: grid; grid-template-columns: minmax(92px, 34%) minmax(0, 1fr); gap: var(--space-3);
    align-items: center;
    padding: var(--space-4) var(--space-3) var(--space-4) var(--space-2);
  }
  .menu-firma-in.sin-vaso { grid-template-columns: 1fr; padding-inline: var(--space-4); }
  .menu-firma-vaso { width: 100%; max-width: 150px; justify-self: center; }
  .menu-firma-texto { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .menu-firma-etq { font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.14em; }
  .menu-firma-nombre { font-size: clamp(1.35rem, 6vw, 1.9rem); font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em; line-height: 1.1; overflow-wrap: anywhere; }
  .menu-firma-precio { font-size: var(--fs-heading); font-weight: 700; font-variant-numeric: tabular-nums; }
  .menu-firma-gancho { font-size: var(--fs-body); font-style: italic; line-height: 1.45; }
  .menu-firma-desc { font-size: var(--fs-sm); font-style: italic; line-height: 1.5; }
  .menu-firma .mi-capas { margin-top: 6px; }

  /* ─── Grupo: título grande en negritas, como CLÁSICOS en el PDF ─── */
  .menu-grupo + .menu-grupo { margin-top: var(--space-5); }
  .menu-grupo[data-sin='si'] { display: none; }
  .menu-grupo-nombre {
    display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-3);
    font-size: clamp(1.35rem, 6vw, 1.75rem); font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em; line-height: 1.15;
    padding-bottom: var(--space-2); border-bottom: 2px solid var(--line);
  }
  .menu-grupo-n { font-size: var(--fs-label); font-weight: 400; letter-spacing: 0.1em; }

  /* ─── Cada bebida: vaso, nombre, qué es, precio. Al tocar, el vaso grande se llena. ─── */
  .menu-item[hidden] { display: none; }
  .mi > summary { list-style: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .mi > summary::-webkit-details-marker { display: none; }
  .mi-fila {
    display: grid; grid-template-columns: var(--vaso-fila) minmax(0, 1fr) auto 14px;
    gap: 0 12px; align-items: start;
    padding: 14px 0; border-bottom: 1px solid var(--line);
    text-align: left;
    transition: background-color 200ms var(--ease);
  }
  .menu-plato .mi-fila { grid-template-columns: minmax(0, 1fr) auto; }
  .mi-vaso { display: block; width: var(--vaso-fila); margin-top: -4px; }
  .mi-texto { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .mi-nombre { font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; line-height: 1.3; }
  .mi-var { font-size: var(--fs-sm); font-style: italic; }
  .mi-desc { font-size: var(--fs-sm); font-style: italic; line-height: 1.5; }
  .mi-precio { font-weight: 700; font-variant-numeric: tabular-nums; line-height: 1.3; }
  .mi-tags { display: flex; flex-wrap: wrap; gap: 4px 10px; margin-top: 3px; }
  .mi-tag { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.1em; line-height: 1.5; }
  .mi-tag::before { content: '■ '; font-size: 0.8em; }
  .mi-tag-firma { background: var(--ink); color: var(--surface); padding: 0 6px; font-weight: 700; }
  .mi-tag-firma::before { content: '◆ '; }
  /* El "+" que dice que se abre; abierto se vuelve "×". */
  .mi-mas { position: relative; width: 14px; height: 14px; margin-top: 4px; transition: transform 320ms var(--ease); }
  .mi-mas::before, .mi-mas::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; border-top: 1.5px solid currentColor; }
  .mi-mas::after { transform: rotate(90deg); }
  .mi[open] .mi-mas { transform: rotate(45deg); }
  .mi[open] > .mi-fila { border-bottom-color: transparent; }
  @media (hover: hover) { .mi > summary:hover .mi-nombre { text-decoration: underline; text-underline-offset: 4px; } }
  .mi > summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }

  .mi-detalle { padding: 4px 0 var(--space-4); border-bottom: 1px solid var(--line); }
  .mi-versiones { display: grid; grid-template-columns: repeat(var(--n, 1), minmax(0, 1fr)); gap: var(--space-3); }
  .mi-versiones[data-versiones='2'] { --n: 2; }
  .mi-version { margin: 0; display: grid; gap: var(--space-3); align-items: center; }
  .mi-versiones[data-versiones='1'] .mi-version { grid-template-columns: 116px minmax(0, 1fr); }
  .mi-versiones[data-versiones='2'] .mi-vaso-grande { max-width: 118px; }
  .mi-vaso-grande { width: 100%; }
  .mi-vaso-grande :global(.vaso), .menu-firma-vaso :global(.vaso) { max-height: 150px; }
  .mi-version-texto { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .mi-version-etq { font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.14em; }
  .mi-version-etq b { font-size: var(--fs-body); letter-spacing: 0.02em; margin-left: 4px; }
  .mi-capas { display: flex; flex-direction: column; gap: 6px; }
  .mi-capas li { display: grid; grid-template-columns: 1.4em minmax(0, 1fr); gap: 6px; align-items: baseline; font-size: var(--fs-sm); line-height: 1.35; }
  .mi-capa-n { font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }

  /* Abrir y cerrar con movimiento, donde el navegador lo sepa hacer. */
  @supports (interpolate-size: allow-keywords) {
    .menu { interpolate-size: allow-keywords; }
    .mi::details-content { height: 0; overflow: clip; transition: height 380ms var(--ease), content-visibility 380ms allow-discrete; }
    .mi[open]::details-content { height: auto; }
  }

  /* Al cambiar de sección, los platillos suben uno tras otro. */
  @keyframes menu-sube { from { opacity: 0; transform: translateY(10px); } }
  .menu-panel[data-entra] .menu-item { animation: menu-sube 520ms var(--ease) backwards; animation-delay: calc(min(var(--n, 0), 10) * 40ms); }
  .menu-panel[data-entra] .menu-panel-cab, .menu-panel[data-entra] .menu-grupo-nombre, .menu-panel[data-entra] .menu-firma { animation: menu-sube 420ms var(--ease) backwards; }

  /* ─── Sin resultados ─── */
  .menu-vacio { padding: var(--space-5) 0; display: flex; flex-direction: column; gap: var(--space-3); align-items: flex-start; }
  .menu-vacio[hidden] { display: none; }
  .menu-vacio-texto { font-size: var(--fs-heading); }
  .menu-vacio-ayuda { font-size: var(--fs-sm); font-style: italic; max-width: 40ch; }

  /* ─── Pie ─── */
  .menu-pie { margin-top: var(--space-5); display: flex; flex-direction: column; align-items: center; gap: var(--space-4); text-align: center; }
  .menu-slogan { font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.3em; line-height: 1.8; }
  .menu-nota { font-size: var(--fs-label); font-style: italic; max-width: 40ch; }
  .menu-boton {
    min-height: 52px; padding: 12px var(--space-4);
    border: 1px solid var(--line);
    font-size: var(--fs-label); text-transform: uppercase; letter-spacing: 0.14em;
    transition: background-color 200ms var(--ease), color 200ms var(--ease), transform 140ms var(--ease);
  }
  .menu-boton:hover { background: var(--ink); color: var(--surface); }
  .menu-boton:active { transform: scale(0.98); }

  @media (min-width: 720px) {
    .menu { --vaso-fila: 52px; }
    .mi-versiones[data-versiones='1'] .mi-version { grid-template-columns: 140px minmax(0, 1fr); }
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-tabs::before, .menu-tab, .menu-boton, .menu-chip::before, .mi-mas { transition: none; }
    .menu-panel[data-entra] .menu-item, .menu-panel[data-entra] .menu-panel-cab, .menu-panel[data-entra] .menu-grupo-nombre, .menu-panel[data-entra] .menu-firma { animation: none; }
  }

  /* Al imprimir se ve todo el menú seguido, sin controles. */
  @media print {
    .menu-antojos, .menu-tabs, .menu-estado, .menu-pie, .menu-vacio, .mi-mas { display: none !important; }
    .menu-panel { display: block !important; break-inside: avoid-page; }
  }
</style>

<script>
  /** Menú interactivo: pestañas, antojos, búsqueda, deslizar, compartir. Todo opcional: sin esto el menú se lee completo. */
  const norm = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();

  document.querySelectorAll<HTMLElement>('[data-menu]').forEach((menu) => {
    const tabs = [...menu.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const barra = menu.querySelector<HTMLElement>('[data-menu-tabs]')!;
    const paneles = [...menu.querySelectorAll<HTMLElement>('[data-panel]')];
    const campo = menu.querySelector<HTMLInputElement>('[data-menu-q]')!;
    const cajaBuscar = menu.querySelector<HTMLElement>('[data-menu-buscar]')!;
    const abrirBuscar = menu.querySelector<HTMLButtonElement>('[data-menu-abrir-buscar]')!;
    const antojos = [...menu.querySelectorAll<HTMLButtonElement>('[data-antojo]')];
    const estadoCaja = menu.querySelector<HTMLElement>('[data-menu-estado-caja]')!;
    const estado = menu.querySelector<HTMLElement>('[data-menu-estado]')!;
    const vacio = menu.querySelector<HTMLElement>('[data-menu-vacio]')!;
    const borrar = menu.querySelector<HTMLButtonElement>('[data-menu-borrar]')!;
    const lento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const idDe = (i: number) => tabs[i].dataset.tab!;
    const vibrar = (ms: number) => { if ('vibrate' in navigator) { try { navigator.vibrate(ms); } catch { /* sin vibración */ } } };
    let actual = 0;
    let antojo = '';
    let filtrando = false;

    /* La barra superior de la página (si existe) fija dónde se pegan las pestañas. */
    const encabezado = document.querySelector<HTMLElement>('.barra');
    const medirTope = () => menu.style.setProperty('--menu-top', `${encabezado?.offsetHeight ?? 0}px`);
    medirTope();
    window.addEventListener('resize', medirTope, { passive: true });
    if (encabezado && 'ResizeObserver' in window) new ResizeObserver(medirTope).observe(encabezado);

    const tope = () => (encabezado?.offsetHeight ?? 0) + barra.offsetHeight + 8;

    /** Si las pestañas ya van pegadas, al cambiar de sección se vuelve al inicio del panel. */
    const volverAlPanel = () => {
      const top = menu.querySelector<HTMLElement>('[data-menu-paneles]')!.getBoundingClientRect().top;
      if (top < tope()) window.scrollTo({ top: window.scrollY + top - tope(), behavior: lento ? 'auto' : 'smooth' });
    };

    /** Vuelve a correr el llenado del vaso (al abrir una bebida). */
    const llenar = (raiz: Element) => {
      raiz.querySelectorAll('.vaso-llenar').forEach((v) => { v.classList.remove('vaso-llenar'); void (v as HTMLElement).offsetWidth; v.classList.add('vaso-llenar'); });
    };

    const elegir = (i: number, { foco = false, scroll = true, hash = true } = {}) => {
      if (i < 0 || i >= tabs.length) return;
      const cambio = i !== actual;
      actual = i;
      tabs.forEach((t, n) => {
        t.setAttribute('aria-selected', String(n === i));
        t.tabIndex = n === i ? 0 : -1;
      });
      barra.style.setProperty('--idx', String(i));
      paneles.forEach((p, n) => {
        if (n === i) {
          p.setAttribute('data-activa', '');
          if (cambio && !lento) {
            p.setAttribute('data-entra', '');
            p.querySelectorAll<HTMLElement>('.menu-item').forEach((it, k) => it.style.setProperty('--n', String(k)));
            window.setTimeout(() => p.removeAttribute('data-entra'), 1100);
          }
        } else {
          p.removeAttribute('data-activa');
          p.removeAttribute('data-entra');
        }
      });
      if (foco) tabs[i].focus();
      if (hash) history.replaceState(null, '', `#${idDe(i)}`);
      if (cambio) {
        vibrar(6);
        if (scroll) volverAlPanel();
      }
    };

    /* ── Pestañas: clic, teclado y deslizar ── */
    tabs.forEach((t, i) => {
      t.addEventListener('click', (ev) => {
        ev.preventDefault();
        if (filtrando) {
          // Filtrando, las pestañas llevan a la sección donde hay resultados.
          const p = paneles[i];
          if (p.getAttribute('data-sin') === 'si') return;
          p.scrollIntoView({ behavior: lento ? 'auto' : 'smooth', block: 'start' });
          return;
        }
        elegir(i);
      });
      t.addEventListener('keydown', (ev) => {
        const sig = ev.key === 'ArrowRight' ? i + 1 : ev.key === 'ArrowLeft' ? i - 1 : ev.key === 'Home' ? 0 : ev.key === 'End' ? tabs.length - 1 : -1;
        if (sig < 0) return;
        ev.preventDefault();
        elegir((sig + tabs.length) % tabs.length, { foco: true, scroll: false });
      });
    });

    let x0 = 0, y0 = 0, t0 = 0, sigue = false;
    menu.addEventListener('touchstart', (ev) => {
      const t = ev.touches[0];
      const borde = t.clientX < 24 || t.clientX > window.innerWidth - 24;
      sigue = ev.touches.length === 1 && !filtrando && !borde && !(ev.target as HTMLElement).closest('input, button, a.menu-tab, .menu-chips');
      x0 = t.clientX; y0 = t.clientY; t0 = Date.now();
    }, { passive: true });
    menu.addEventListener('touchend', (ev) => {
      if (!sigue) return;
      sigue = false;
      const t = ev.changedTouches[0];
      const dx = t.clientX - x0, dy = t.clientY - y0;
      if (Math.abs(dx) < 70 || Math.abs(dx) < Math.abs(dy) * 1.8 || Date.now() - t0 > 700) return;
      elegir(actual + (dx < 0 ? 1 : -1));
    }, { passive: true });

    /* ── Abrir una bebida: el vaso grande se llena ── */
    menu.querySelectorAll<HTMLDetailsElement>('details.mi').forEach((d) => {
      d.addEventListener('toggle', () => { if (d.open) { llenar(d); vibrar(5); } });
    });

    /* ── Filtrar: un antojo y/o una búsqueda, en todo el menú a la vez ── */
    const filtrar = ({ subir = true } = {}) => {
      const q = norm(campo.value);
      filtrando = q.length > 0 || antojo !== '';
      if (filtrando) menu.setAttribute('data-buscando', 'si'); else menu.removeAttribute('data-buscando');
      borrar.hidden = q.length === 0;
      let total = 0;
      paneles.forEach((p, i) => {
        let n = 0;
        p.querySelectorAll<HTMLElement>('.menu-grupo').forEach((g) => {
          let enGrupo = 0;
          g.querySelectorAll<HTMLElement>('.menu-item').forEach((it) => {
            const tags = (it.dataset.tags ?? '').split(' ');
            const coincide = (!q || (it.dataset.buscar ?? '').includes(q)) && (!antojo || tags.includes(antojo));
            it.hidden = !coincide;
            if (coincide) enGrupo++;
          });
          if (enGrupo === 0) g.setAttribute('data-sin', 'si'); else g.removeAttribute('data-sin');
          n += enGrupo;
        });
        total += n;
        if (n === 0 && filtrando) p.setAttribute('data-sin', 'si'); else p.removeAttribute('data-sin');
        tabs[i].querySelector<HTMLElement>('[data-n]')!.textContent = filtrando ? String(n) : '';
        if (filtrando && n === 0) tabs[i].setAttribute('data-vacia', 'si'); else tabs[i].removeAttribute('data-vacia');
      });
      const texto = campo.value.trim();
      vacio.hidden = !(filtrando && total === 0);
      menu.querySelector<HTMLElement>('[data-menu-vacio-q]')!.textContent = texto || antojos.find((a) => a.dataset.antojo === antojo)?.textContent?.trim() || '';
      const chip = antojos.find((a) => a.dataset.antojo === antojo);
      estado.textContent = !filtrando || total === 0 ? '' : q
        ? `${total} resultado${total === 1 ? '' : 's'} para “${texto}”${chip ? ` · ${chip.textContent!.trim().toLowerCase()}` : ''}`
        : (chip?.dataset.estado ?? '').replace('{n}', String(total));
      estadoCaja.hidden = !filtrando || total === 0;
      if (filtrando && subir) volverAlPanel();
    };

    antojos.forEach((a) => a.addEventListener('click', () => {
      antojo = antojo === a.dataset.antojo ? '' : a.dataset.antojo!;
      antojos.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.antojo === antojo)));
      vibrar(6);
      filtrar();
    }));

    abrirBuscar.addEventListener('click', () => {
      const abrir = cajaBuscar.hidden;
      cajaBuscar.hidden = !abrir;
      abrirBuscar.setAttribute('aria-expanded', String(abrir));
      if (abrir) campo.focus({ preventScroll: true });
      else if (campo.value) { campo.value = ''; filtrar(); }
    });

    const quitarTodo = () => {
      campo.value = '';
      antojo = '';
      antojos.forEach((b) => b.setAttribute('aria-pressed', 'false'));
      filtrar({ subir: false });
    };
    campo.addEventListener('input', () => filtrar({ subir: false }));
    campo.addEventListener('keydown', (ev) => { if (ev.key === 'Escape' && campo.value) { campo.value = ''; filtrar({ subir: false }); } });
    borrar.addEventListener('click', () => { campo.value = ''; filtrar({ subir: false }); campo.focus({ preventScroll: true }); });
    menu.querySelectorAll('[data-menu-quitar]').forEach((b) => b.addEventListener('click', quitarTodo));

    /* ── Compartir (el enlace directo al menú, no a la landing) ── */
    const compartir = menu.querySelector<HTMLButtonElement>('[data-menu-compartir]');
    const etiqueta = menu.querySelector<HTMLElement>('[data-menu-compartir-texto]');
    compartir?.addEventListener('click', async () => {
      const url = menu.dataset.url || location.href.split('#')[0];
      const nav = navigator as Navigator & { share?: (d: ShareData) => Promise<void> };
      try {
        if (nav.share) { await nav.share({ title: 'Menú · Ryo Café', url }); return; }
        await navigator.clipboard.writeText(url);
        if (etiqueta) { etiqueta.textContent = 'Enlace copiado'; window.setTimeout(() => { etiqueta.textContent = 'Compartir el menú'; }, 2200); }
      } catch { /* cancelado */ }
    });

    /* ── Entrar directo a una sección: #matcha, #bar… ── */
    const deHash = () => {
      const i = tabs.findIndex((t) => t.dataset.tab === location.hash.slice(1));
      if (i >= 0) {
        elegir(i, { scroll: false, hash: false });
        // Dentro de la landing, el enlace directo también lleva al menú.
        if (document.getElementById('menu') && !document.querySelector('[data-solo-menu]')) menu.scrollIntoView({ block: 'start' });
      }
    };
    deHash();
    window.addEventListener('hashchange', deHash);
  });
</script>
