  .srch__f label { transition: color .3s ease, letter-spacing .5s var(--am-ease-out); }
  .srch__f:focus-within label { color: var(--am-red-hi); letter-spacing: .16em; }
  .srch__f .am-select { background-color: rgba(7, 7, 8, .55); }
