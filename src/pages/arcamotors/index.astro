  .srch__f::after {
    content: ''; position: absolute; left: 14px; right: 14px; bottom: 4px; height: 2px; border-radius: 2px;
    background: linear-gradient(90deg, var(--am-red), var(--am-red-hi)); box-shadow: 0 0 10px var(--am-neon);
    transform: scaleX(0); transform-origin: 0 50%; transition: transform .6s var(--am-ease-out);
  }
  .srch__f:hover { background: rgba(255, 255, 255, .03); }
  .srch__f:focus-within { background: rgba(227, 20, 31, .08); }
