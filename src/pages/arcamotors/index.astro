    -webkit-mask: url('/arca-motors/brand/arca-car-mono.svg') center / contain no-repeat;
    mask: url('/arca-motors/brand/arca-car-mono.svg') center / contain no-repeat;
  }
  .ticker__brands { --am-marquee-gap: 0px; padding: 14px 0 6px; }
  .ticker__brand {
    display: inline-flex; align-items: center; gap: clamp(24px, 3vw, 48px); padding-right: clamp(24px, 3vw, 48px);
    font-family: var(--am-display); font-weight: 800; font-stretch: 125%; font-size: clamp(52px, 9vw, 140px); line-height: 1; text-transform: uppercase; letter-spacing: -.01em;
    color: transparent; -webkit-text-stroke: 1px rgba(232, 234, 237, .3); transition: color .4s ease, -webkit-text-stroke-color .4s ease;
  }
  .ticker__brand:hover { color: var(--am-red); -webkit-text-stroke-color: transparent; }
  .ticker__dot { width: .12em; height: .12em; border-radius: 50%; background: var(--am-red-hi); box-shadow: 0 0 14px var(--am-neon); }
  .am-marquee:focus-within :global(.am-marquee__track) { animation-play-state: paused !important; }
   html:not(.am-anim) .ticker__row { transform: none; } 

  /* ---------- PROMESAS (bento) ---------- */
  .prom__head { margin-bottom: clamp(28px, 4vw, 48px); }
  .prom__h { font-size: clamp(32px, 5vw, 64px); }
  .bento { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .bento__c--1 { grid-column: 1 / 8; }
  .bento__c--2 { grid-column: 8 / 13; }
  .bento__c--3 { grid-column: 1 / 6; }
  .bento__c--4 { grid-column: 6 / 13; }
  .bento__c {
    position: relative; overflow: hidden; isolation: isolate; min-height: clamp(220px, 22vw, 280px);
    display: flex; flex-direction: column; justify-content: space-between; gap: 28px;
    padding: clamp(20px, 2.4vw, 30px); border-radius: 22px;
    background: radial-gradient(120% 90% at 100% 0%, rgba(227, 20, 31, .09), transparent 55%), linear-gradient(180deg, var(--am-surface2), var(--am-surface));
    border: 1px solid var(--am-line);
    transition: border-color .4s ease, box-shadow .5s ease;
  }
  .bento__c::before {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none; opacity: 0; transition: opacity .5s ease;
    background: radial-gradient(420px circle at var(--mx, 50%) var(--my, 50%), rgba(255, 42, 31, .16), transparent 60%);
  }
  .bento__c:hover { --am-lift: -4px; border-color: rgba(255, 74, 61, .3); box-shadow: 0 30px 60px -34px rgba(0, 0, 0, .95), 0 0 50px -26px var(--am-neon); }
  .bento__c:hover::before { opacity: 1; }
  .bento__n {
    position: absolute; right: clamp(14px, 2vw, 26px); top: clamp(6px, 1vw, 14px); z-index: -1;
    font-family: var(--am-display); font-weight: 800; font-stretch: 125%; font-size: clamp(84px, 10vw, 150px); line-height: 1; letter-spacing: -.03em;
    color: transparent; -webkit-text-stroke: 1px rgba(232, 234, 237, .16);
    background: linear-gradient(100deg, transparent 42%, rgba(255, 74, 61, .45) 50%, transparent 58%) 160% 0 / 260% 100% no-repeat;
    -webkit-background-clip: text; background-clip: text;
    transition: -webkit-text-stroke-color .4s ease;
  }
  .bento__c:hover .bento__n { -webkit-text-stroke-color: rgba(255, 74, 61, .55); }
  .bento__icon {
    width: 52px; height: 52px; border-radius: 16px; display: grid; place-items: center; color: var(--am-red-hi);
    background: rgba(227, 20, 31, .1); border: 1px solid rgba(227, 20, 31, .28); box-shadow: 0 0 30px -10px var(--am-neon);
    transition: background-color .4s ease, color .4s ease, transform .6s var(--am-ease-out);
  }
  .bento__c:hover .bento__icon { background: var(--am-red); color: #fff; transform: translateY(-2px); }
  .bento__body { max-width: 46ch; }
  .bento__t { margin: 0; font-family: var(--am-display); font-stretch: 112%; font-size: clamp(20px, 2vw, 26px); font-weight: 700; line-height: 1.1; }
  .bento__p { margin: 8px 0 0; color: var(--am-muted); font-size: 15px; line-height: 1.55; }
  
    html.am-anim .bento__n { animation: bento-sheen 7s var(--am-ease-io) infinite; }
    html.am-anim .bento__c--2 .bento__n { animation-delay: -1.7s; }
    html.am-anim .bento__c--3 .bento__n { animation-delay: -3.4s; }
    html.am-anim .bento__c--4 .bento__n { animation-delay: -5.1s; }
    html.am-anim .bento__c--1:hover .bento__icon :global(svg) { animation: ic-file .7s var(--am-ease-out); }
    html.am-anim .bento__c--2:hover .bento__icon :global(svg) { animation: ic-key .8s var(--am-ease-out); }
    html.am-anim .bento__c--3:hover .bento__icon :global(svg) { animation: ic-card .8s var(--am-ease-out); }
    html.am-anim .bento__c--4:hover .bento__icon :global(svg) { animation: ic-swap .8s var(--am-ease-out); }
  
  @keyframes bento-sheen { 0%, 55% { background-position: 160% 0; } 100% { background-position: -60% 0; } }
  @keyframes ic-file { 0% { transform: none; } 35% { transform: translateY(-5px) rotate(-8deg); } 70% { transform: translateY(1px) rotate(3deg); } 100% { transform: none; } }
  @keyframes ic-key { 0% { transform: none; } 30% { transform: rotate(-28deg); } 60% { transform: rotate(14deg); } 100% { transform: none; } }
  @keyframes ic-card { from { transform: perspective(200px) rotateY(0); } to { transform: perspective(200px) rotateY(360deg); } }
  @keyframes ic-swap { 0% { transform: none; } 30% { transform: translateX(4px); } 60% { transform: translateX(-4px) scaleX(-1); } 100% { transform: none; } }
  @media (max-width: 900px) {
