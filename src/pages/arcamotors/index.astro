    .srch__t br { display: none; }
    .srch__f:nth-of-type(1) { grid-column: 1 / -1; }
    .srch__go { grid-column: 1 / -1; margin: 6px 0 0; }
  }

  /* ---------- MARQUESINAS ---------- */
  .ticker { position: relative; margin-top: clamp(48px, 7vw, 88px); overflow: hidden; }
  .ticker__row { transform: skewX(var(--skew, 0deg)); }
  .ticker__cars { --am-marquee-gap: 26px; padding: 18px 0; border-block: 1px solid var(--am-line); background: linear-gradient(180deg, rgba(255, 255, 255, .02), transparent); }
  .ticker__cars .am-marquee__track { list-style: none; margin: 0; padding-left: 0; }
  .ticker__item { display: inline-flex; align-items: center; gap: 26px; }
  .ticker__link {
    display: inline-flex; align-items: center; gap: 14px; min-height: 44px;
    font-family: var(--am-display); font-stretch: 112%; transition: color .3s ease;
  }
  .ticker__name { font-weight: 700; font-size: clamp(18px, 2vw, 24px); text-transform: uppercase; letter-spacing: .02em; }
  .ticker__y { color: var(--am-dim); font-weight: 500; }
