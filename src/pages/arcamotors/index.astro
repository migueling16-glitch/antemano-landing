  }
  
    html.am-anim .rng { animation: rng-spin var(--rng-dur, 7s) linear infinite; animation-delay: var(--rng-d, 0s); }
  
  @keyframes rng-spin { to { --rng-a: 360deg; } }

  /* ---------- BUSCADOR ---------- */
  .srch { position: relative; z-index: 5; margin-top: -76px; }
  .srch__in {
    position: relative; border-radius: 22px; padding: 14px;
    display: grid; grid-template-columns: auto repeat(3, minmax(0, 1fr)) auto; gap: 6px; align-items: stretch;
    background: rgba(14, 14, 17, .66);
