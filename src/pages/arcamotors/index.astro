---
import ArcaLayout from '../../arca-motors/ArcaLayout.astro';
import CarCard from '../../arca-motors/components/CarCard.astro';
import Calculadora from '../../arca-motors/components/Calculadora.astro';
import Icon from '../../arca-motors/components/Icon.astro';
import HeroShowroom from '../../arca-motors/components/HeroShowroom.astro';
import { BASE, ASSETS, NEGOCIO, FINANCIAMIENTO, PROMESAS, PASOS, ACEPTA_A_CUENTA, wa, tel, telBonito } from '../../arca-motors/config';
import { enVenta, vendidos, marcas, urlAuto, dinero, ETIQUETA_CARROCERIA, type Carroceria } from '../../arca-motors/inventario';

const disponibles = enVenta();
const recientes = [...disponibles].sort((a, b) => b.ingreso.localeCompare(a.ingreso)).slice(0, 6);
const listaMarcas = marcas();
const tipos = (['suv', 'pickup', 'sedan', 'clasico'] as Carroceria[])
  .map((t) => ({ t, n: disponibles.filter((v) => v.carroceria === t).length }))
  .filter((x) => x.n);
const PROMESA_ICON = ['file', 'key', 'card', 'swap'];
const pad = (n: number) => String(n).padStart(2, '0');
const nTabs = ACEPTA_A_CUENTA ? 3 : 2;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  name: NEGOCIO.nombre,
  slogan: NEGOCIO.tagline,
  telephone: `+52${NEGOCIO.telefonos[0]}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Durango', addressRegion: 'Dgo.', addressCountry: 'MX' },
  sameAs: [`https://www.instagram.com/${NEGOCIO.instagram}/`, NEGOCIO.facebook],
  makesOffer: { '@type': 'Offer', name: 'Financiamiento directo hasta 48 meses' },
};
---
<ArcaLayout
  title="Arca Motors — Seminuevos en Durango con crédito directo"
  description="Camionetas y autos seminuevos seleccionados en Durango: único dueño, factura de agencia y financiamiento directo hasta 48 meses."
  active="inicio"
  jsonLd={jsonLd}
>
  <!-- HERO (componente propio: intro, escenario, tarjeta sincronizada, cámara) -->
  <HeroShowroom />

  <!-- BUSCADOR: barra de vidrio montada sobre el borde inferior del hero -->
  <form class="am-wrap srch" id="buscar" action={`${BASE}/catalogo/`} method="get" role="search" aria-label="Buscar en el catálogo">
    <div class="srch__in am-loop">
      <span class="rng" aria-hidden="true"></span>
      <p class="srch__t" aria-hidden="true"><Icon name="search" size={16} /> <span>Encuentra <br />el tuyo</span></p>
      <div class="am-field srch__f">
        <label for="h-tipo">Tipo</label>
        <select class="am-select" id="h-tipo" name="tipo">
          <option value="">Todos</option>
          {tipos.map(({ t, n }) => <option value={t}>{ETIQUETA_CARROCERIA[t]} ({n})</option>)}
        </select>
      </div>
      <div class="am-field srch__f">
        <label for="h-marca">Marca</label>
        <select class="am-select" id="h-marca" name="marca">
          <option value="">Todas</option>
          {listaMarcas.map((m) => <option value={m}>{m}</option>)}
        </select>
      </div>
      <div class="am-field srch__f">
        <label for="h-eng">Enganche</label>
        <select class="am-select" id="h-eng" name="eng">
          <option value="">Cualquiera</option>
          <option value="100000">Hasta $100 mil</option>
          <option value="200000">Hasta $200 mil</option>
          <option value="350000">Hasta $350 mil</option>
          <option value="500000">Hasta $500 mil</option>
        </select>
      </div>
      <button class="am-btn am-btn--red am-btn--lg srch__go" type="submit" data-magnetic="0.25"><Icon name="search" size={18} /> Buscar</button>
    </div>
  </form>

  <!-- MARQUESINAS: autos en venta + marcas en contorno (se inclinan con la velocidad del scroll) -->
  <section class="ticker" aria-label="Unidades en venta">
    <div class="ticker__row">
      <div class="am-marquee am-marquee--fade ticker__cars" data-marquee="70">
        <ul class="am-marquee__track">
          {disponibles.map((v) => (
            <li class="ticker__item">
              <a class="ticker__link" href={urlAuto(v)} data-cursor="Ver">
                <span class="ticker__name">{v.marca} {v.modelo} <span class="ticker__y">{v.anio}</span></span>
                <span class="ticker__eng">Enganche {dinero(v.enganche)}</span>
              </a>
              <span class="ticker__mark" aria-hidden="true"></span>
            </li>
          ))}
        </ul>
      </div>
    </div>
    <div class="ticker__row ticker__row--brands" aria-hidden="true">
      <div class="am-marquee am-marquee--reverse ticker__brands" data-marquee="38">
        <div class="am-marquee__track">
          {listaMarcas.map((m) => <span class="ticker__brand">{m}<span class="ticker__dot"></span></span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- PROMESAS: bento asimétrico -->
  <section class="am-section prom" aria-labelledby="t-prom">
    <div class="am-wrap">
      <div class="prom__head">
        <p class="am-kicker">Por qué Arca Motors</p>
        <h2 class="am-h2 prom__h" id="t-prom" data-split>Seminuevos,<br /><span class="am-silver-text">sin complicaciones.</span></h2>
      </div>
      <ul class="bento">
        {PROMESAS.map((p, i) => (
          <li class={`bento__c bento__c--${i + 1} am-reveal am-loop`} data-tilt="4">
            <span class="bento__n" aria-hidden="true">{pad(i + 1)}</span>
            <span class={`bento__icon bento__icon--${PROMESA_ICON[i]}`}><Icon name={PROMESA_ICON[i]} size={24} /></span>
            <div class="bento__body">
              <h3 class="bento__t">{p.titulo}</h3>
              <p class="bento__p">{p.texto}</p>
            </div>
            <span class="am-glare" aria-hidden="true"></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- RECIÉN LLEGADOS: en escritorio la sección se fija y avanza en horizontal; en móvil, carrusel -->
  <section class="rec" id="recientes" aria-labelledby="t-recientes" data-pin>
    <div class="rec__sticky">
      <span class="rec__ghost" aria-hidden="true" data-rec-ghost>Recién llegados</span>
      <div class="am-wrap rec__head">
        <div>
          <p class="am-kicker">Inventario</p>
          <h2 class="am-h2" id="t-recientes" data-split>Recién llegados</h2>
        </div>
        <a class="am-link" href={`${BASE}/catalogo/`}>Ver las {disponibles.length} unidades en venta <Icon name="arrow" size={16} /></a>
      </div>
      <div class="rec__vp" data-rec-vp>
        <ul class="rec__track" data-rec-track>
          {recientes.map((v) => <li class="rec__item"><CarCard v={v} /></li>)}
          <li class="rec__item rec__item--end">
            <a class="rec__end am-loop" href={`${BASE}/catalogo/`} data-cursor="Ver" data-tilt="5">
              <span class="rng" aria-hidden="true"></span>
              <span class="rec__end-mark" aria-hidden="true"></span>
              <span class="rec__end-n" data-count>{disponibles.length}</span>
              <span class="rec__end-t">unidades en venta</span>
              <span class="rec__end-go">Ver el catálogo <Icon name="arrowUpRight" size={18} /></span>
              <span class="am-glare" aria-hidden="true"></span>
            </a>
          </li>
        </ul>
      </div>
      <div class="am-wrap rec__foot" aria-hidden="true">
        <span class="rec__bar"><span class="rec__fill" data-rec-fill></span></span>
        <span class="rec__hint"><span class="rec__hint-pin">Sigue bajando</span><span class="rec__hint-swipe">Desliza</span> <Icon name="arrow" size={14} /></span>
      </div>
    </div>
  </section>
  <div class="am-wrap">
    <nav class="tipos" aria-label="Explorar por tipo y marca">
      {tipos.map(({ t, n }) => (
        <a class="chip" href={`${BASE}/catalogo/?tipo=${t}`} data-magnetic="0.2">{ETIQUETA_CARROCERIA[t]} <span>{n}</span></a>
      ))}
      <span class="tipos__sep" aria-hidden="true"></span>
      {listaMarcas.map((m) => <a class="chip chip--quiet" href={`${BASE}/catalogo/?marca=${encodeURIComponent(m)}`} data-magnetic="0.2">{m}</a>)}
    </nav>
  </div>

  <!-- FINANCIAMIENTO -->
  <section class="am-section fin" id="financiamiento" aria-labelledby="t-fin" data-spotlight>
    <span class="am-spotlight fin__spot" aria-hidden="true"></span>
    <div class="am-wrap fin__wrap">
      <p class="am-kicker">Financiamiento directo</p>
      <h2 class="fin__title" id="t-fin" data-split data-scrub>Estrena hoy.<br /><span class="am-red-text">Paga a tu ritmo.</span></h2>
      <div class="fin__in">
        <div class="fin__copy">
          <p class="am-lead">Directo con Arca Motors o con financiera desde 15% de enganche: sin complicaciones y con aprobación rápida. Elige el plan que te acomode.</p>
          <div class="fin__planes">
            {FINANCIAMIENTO.planes.map((p, i) => (
              <article class="plan am-reveal am-loop" data-tilt="5" style={`--rng-d:${i * -2.3}s`}>
                <span class="rng" aria-hidden="true"></span>
                <p class="plan__n">{p.nombre}</p>
                <p class="plan__t">{p.titulo}</p>
                <p class="plan__d">{p.detalle}</p>
                <span class="am-glare" aria-hidden="true"></span>
              </article>
            ))}
          </div>
          {FINANCIAMIENTO.requisitos.length > 0 && (
            <ul class="fin__req">
              {FINANCIAMIENTO.requisitos.map((r) => <li><Icon name="check" size={18} /> {r}</li>)}
            </ul>
          )}
        </div>
        <div class="fin__calc am-reveal am-loop">
          <span class="rng" aria-hidden="true" style="--rng-dur: 9s"></span>
          <Calculadora id="calc-home" />
        </div>
      </div>
    </div>
  </section>

  <!-- CÓMO COMPRAR -->
  <section class="am-section pasos" aria-labelledby="t-pasos">
    <div class="am-wrap">
      <p class="am-kicker">Así de fácil</p>
      <h2 class="am-h2" id="t-pasos" data-split>De la foto a tu cochera</h2>
      <ol class="pasos__grid" data-scrub>
        {PASOS.map((p, i) => (
          <li class="paso am-reveal" style={`--t:${(0.22 + (i * 0.25) / 2.6).toFixed(3)}`}>
            <span class="paso__dot" aria-hidden="true"></span>
            <span class="paso__n" data-n={pad(i + 1)} aria-hidden="true">{pad(i + 1)}</span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- VENDE / CAMBIA / CONSIGNA -->
  <section class="am-section vende" id="vende" aria-labelledby="t-vende" data-scrub>
    <span class="vende__car" aria-hidden="true"></span>
    <div class="am-wrap vende__in">
      <div>
        <p class="am-kicker">{ACEPTA_A_CUENTA ? 'Compra · Cambio · Consignación' : 'Compra · Consignación'}</p>
        <h2 class="am-h2" id="t-vende" data-split>¿Tienes un auto?<br /><span class="am-red-text">Lo convertimos en dinero.</span></h2>
        <p class="am-lead">Te lo compramos{ACEPTA_A_CUENTA ? ', lo tomamos a cuenta de otro' : ''} o lo vendemos por ti a consignación. Mándanos los datos y te respondemos por WhatsApp.</p>
        <p class="vende__nota">La oferta es preliminar y se confirma al revisar el auto en el lote.</p>
      </div>
      <form class="vende__form am-reveal" data-vende method="dialog">
        <fieldset class:list={['vende__tabs', { 'vende__tabs--2': !ACEPTA_A_CUENTA }]} style={`--n:${nTabs}`}>
          <legend class="sr-only">¿Qué quieres hacer?</legend>
          <span class="vende__ind" aria-hidden="true"></span>
          <label><input type="radio" name="modo" value="vender" checked /> <span>Vender</span></label>
          {ACEPTA_A_CUENTA && <label><input type="radio" name="modo" value="cambiar" /> <span>Cambiar</span></label>}
          <label><input type="radio" name="modo" value="consignar" /> <span>Consignar</span></label>
        </fieldset>
        <div class="vende__grid">
          <div class="am-field"><label for="v-auto">Marca y modelo</label><input class="am-input" id="v-auto" name="auto" placeholder="Ej. Nissan Frontier" autocomplete="off" aria-describedby="v-hint" /></div>
          <div class="am-field"><label for="v-anio">Año</label><input class="am-input" id="v-anio" name="anio" inputmode="numeric" placeholder="2020" maxlength="4" /></div>
          <div class="am-field"><label for="v-km">Kilometraje</label><input class="am-input" id="v-km" name="km" inputmode="numeric" placeholder="80,000" /></div>
          <div class="am-field"><label for="v-nombre">Tu nombre</label><input class="am-input" id="v-nombre" name="nombre" autocomplete="given-name" placeholder="Nombre" /></div>
        </div>
        <button class="am-btn am-btn--wa am-btn--lg am-btn--block" type="submit"><Icon name="whatsapp" size={20} /> Enviar por WhatsApp</button>
        <p class="vende__hint" id="v-hint" data-vende-hint role="status">Abre WhatsApp con tus datos listos. Ahí mismo puedes mandar fotos.</p>
        <noscript><a class="am-btn am-btn--ghost am-btn--block" href={wa('Hola Arca Motors, quiero vender mi auto.')}>Escríbenos directo por WhatsApp</a></noscript>
      </form>
    </div>
  </section>

  <!-- RECIÉN VENDIDOS: el sello se estampa al entrar -->
  <section class="am-section" aria-labelledby="t-vendidos">
    <div class="am-wrap">
      <div class="am-section__head">
        <div>
          <p class="am-kicker">Ya estrenaron</p>
          <h2 class="am-h2" id="t-vendidos" data-split>Recién vendidos</h2>
        </div>
        <p class="am-lead vendidos__lead">Cada auto vendido se queda aquí: así ves qué tan rápido se mueve el inventario.</p>
      </div>
      <div class="am-grid vend">
        {vendidos().slice(0, 6).map((v, i) => (
          <div class="vend__item" data-inview style={`--vd:${(i % 3) * 120}ms`}>
            <CarCard v={v} />
            <span class="vend__stamp" aria-hidden="true"><span class="vend__ink">Vendido</span></span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- INSTAGRAM + VISITA -->
  <section class="am-section--tight visita" aria-labelledby="t-visita">
    <div class="am-wrap visita__in">
      <a class="ig am-reveal am-loop" href={`https://instagram.com/${NEGOCIO.instagram}`} target="_blank" rel="noopener" data-tilt="4" data-cursor="Abrir">
        <span class="rng" aria-hidden="true" style="--rng-dur: 6s"></span>
        <span class="ig__avatar">
          <img src={`${ASSETS}/brand/arca-icon-512.png`} alt="" width="72" height="72" loading="lazy" />
        </span>
        <div>
          <p class="ig__h">@{NEGOCIO.instagram}</p>
          <p class="ig__s">{NEGOCIO.seguidores} seguidores · fotos y recorridos en video de las unidades</p>
        </div>
        <Icon name="instagram" size={26} />
        <span class="am-glare" aria-hidden="true"></span>
      </a>
      <div class="visita__card am-reveal">
        <h2 class="am-h2 visita__t" id="t-visita">Ven al lote</h2>
        <ul>
          <li><Icon name="map" size={18} /> {NEGOCIO.direccion || NEGOCIO.ciudad}</li>
          {NEGOCIO.horario.map((h) => <li><Icon name="clock" size={18} /> {h.dias}: {h.horas}</li>)}
          {NEGOCIO.telefonos.map((t) => <li><Icon name="phone" size={18} /> <a href={tel(t)}>{telBonito(t)}</a></li>)}
        </ul>
        <a class="am-btn am-btn--ghost" href={NEGOCIO.mapsUrl} target="_blank" rel="noopener" data-magnetic="0.25">Cómo llegar <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>
</ArcaLayout>

<script>
  import { NEGOCIO } from '../../arca-motors/config';

  const motionOK = () => !matchMedia(document.documentElement.classList.contains('am-anim') ? 'not all' : 'all').matches;
  const clamp = (n: number, a: number, b: number) => Math.min(b, Math.max(a, n));

  /* ---------------- Vende: arma el mensaje y abre WhatsApp ---------------- */
  const form = document.querySelector<HTMLFormElement>('[data-vende]');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const modo = String(d.get('modo'));
    const auto = String(d.get('auto') || '').trim();
    const hint = form.querySelector<HTMLElement>('[data-vende-hint]')!;
    const f = form.querySelector<HTMLInputElement>('#v-auto')!;
    if (!auto) {
      f.focus();
      f.setAttribute('aria-invalid', 'true');
      hint.textContent = 'Escribe al menos la marca y el modelo de tu auto.';
      hint.classList.add('is-error');
      return;
    }
    f.removeAttribute('aria-invalid');
    hint.classList.remove('is-error');
    hint.textContent = 'Listo: se abrió WhatsApp con tus datos. Ahí mismo puedes mandar fotos.';
    const verbo = { vender: 'vender', cambiar: 'dejar a cuenta', consignar: 'dejar a consignación' }[modo] ?? 'vender';
    const partes = [
      `Hola Arca Motors${d.get('nombre') ? ', soy ' + d.get('nombre') : ''}. Quiero ${verbo} mi auto:`,
      `• ${auto}${d.get('anio') ? ' ' + d.get('anio') : ''}`,
      d.get('km') ? `• ${d.get('km')} km` : '',
      'Les mando fotos por aquí.',
    ].filter(Boolean);
    window.open(`https://wa.me/52${NEGOCIO.telefonos[0]}?text=${encodeURIComponent(partes.join('\n'))}`, '_blank', 'noopener');
  });

  /* ---------------- Marquesinas: se inclinan con la velocidad del scroll ---------------- */
  const ticker = document.querySelector<HTMLElement>('.ticker');
  if (ticker && motionOK() && !document.documentElement.classList.contains('is-touch')) {
    let lastY = window.scrollY;
    let skew = 0;
    let raf = 0;
    let visible = false;
    const tick = () => {
      const y = window.scrollY;
      const v = y - lastY;
      lastY = y;
      const target = clamp(v * -0.22, -7, 7);
      skew += (target - skew) * 0.12;
      if (Math.abs(skew) < 0.02 && v === 0) {
        skew = 0;
        raf = 0;
        ticker.style.setProperty('--skew', '0deg');
        return;
      }
      ticker.style.setProperty('--skew', `${skew.toFixed(2)}deg`);
      raf = requestAnimationFrame(tick);
    };
    addEventListener('scroll', () => {
      if (!visible) { lastY = window.scrollY; return; }
      if (!raf) raf = requestAnimationFrame(tick);
    }, { passive: true });
    new IntersectionObserver((en) => { visible = en[0].isIntersecting; }).observe(ticker);
  }

  /* ---------------- Recién llegados: sección fija con avance horizontal ---------------- */
  const sec = document.querySelector<HTMLElement>('[data-pin]');
  if (sec) {
    const vp = sec.querySelector<HTMLElement>('[data-rec-vp]')!;
    const track = sec.querySelector<HTMLElement>('[data-rec-track]')!;
    const fill = sec.querySelector<HTMLElement>('[data-rec-fill]');
    const ghost = sec.querySelector<HTMLElement>('[data-rec-ghost]');
    const mq = matchMedia(document.documentElement.classList.contains('am-anim') ? '(min-width: 1000px) and (min-height: 740px)' : 'not all');
    let on = false;
    let dist = 0;
    let raf = 0;

    const frame = () => {
      raf = 0;
      if (!on) return;
      const r = sec.getBoundingClientRect();
      const total = r.height - window.innerHeight;
      const p = total > 0 ? clamp(-r.top / total, 0, 1) : 0;
      track.style.transform = `translate3d(${(-p * dist).toFixed(1)}px, 0, 0)`;
      if (fill) fill.style.transform = `scaleX(${p.toFixed(4)})`;
      if (ghost) ghost.style.transform = `translate3d(${(-p * dist * 0.35).toFixed(1)}px, 0, 0)`;
    };
    const measure = () => {
      on = mq.matches;
      sec.classList.toggle('is-pinned', on);
      if (!on) {
        sec.style.height = '';
        track.style.transform = '';
        if (ghost) ghost.style.transform = '';
        if (fill) fill.style.transform = '';
        return;
      }
      dist = Math.max(0, track.scrollWidth - vp.clientWidth);
      sec.style.height = `${Math.round(dist + window.innerHeight)}px`;
      frame();
    };
    addEventListener('scroll', () => { if (on && !raf) raf = requestAnimationFrame(frame); }, { passive: true });
    let rt = 0;
    addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(measure, 150); });
    mq.addEventListener?.('change', measure);
    document.fonts?.ready.then(measure);
    addEventListener('load', measure);
    measure();

    // Teclado: si el foco cae en una tarjeta que está fuera de cuadro, se baja hasta ella.
    track.addEventListener('focusin', (e) => {
      if (!on || dist <= 0) return;
      const item = (e.target as Element).closest<HTMLElement>('.rec__item');
      if (!item) return;
      const padL = parseFloat(getComputedStyle(track).paddingLeft) || 0;
      const p = clamp((item.offsetLeft - padL) / dist, 0, 1);
      const top = sec.getBoundingClientRect().top + window.scrollY + p * (sec.offsetHeight - window.innerHeight);
      const lenis = (window as any).arcaMotion?.lenis;
      if (lenis) lenis.scrollTo(top, { immediate: true, force: true });
      else window.scrollTo({ top, behavior: 'auto' });
      frame();
    });

    // Carrusel nativo (móvil / reduce): la barra sigue el desplazamiento horizontal.
    vp.addEventListener('scroll', () => {
      if (on || !fill) return;
      const max = vp.scrollWidth - vp.clientWidth;
      fill.style.transform = `scaleX(${max > 0 ? (vp.scrollLeft / max).toFixed(4) : 0})`;
    }, { passive: true });
  }
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* ---------- borde animado (conic que gira) para tarjetas: .rng dentro de un padre con radio ---------- */
  @property --rng-a { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
  .rng {
    position: absolute; inset: 0; z-index: 2; border-radius: inherit; padding: 1px; pointer-events: none;
    background: conic-gradient(from var(--rng-a), rgba(255, 255, 255, .1) 0deg, rgba(255, 255, 255, .1) 225deg, rgba(255, 74, 61, .9) 290deg, rgba(255, 236, 232, .95) 306deg, rgba(255, 74, 61, .35) 322deg, rgba(255, 255, 255, .1) 350deg);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
