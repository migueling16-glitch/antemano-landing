    .bento__c--1, .bento__c--2, .bento__c--3, .bento__c--4 { grid-column: auto; }
    .bento__c--1, .bento__c--4 { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .bento { grid-template-columns: 1fr; }
    .bento__c { min-height: 0; }
  }

  /* ---------- RECIÉN LLEGADOS ---------- */
  .rec {
    --rec-pad: max(var(--am-gutter), calc((100vw - 1240px) / 2 + var(--am-gutter)));
    position: relative; overflow-x: clip; padding: clamp(64px, 9vw, 120px) 0 24px;
  }
  .rec__sticky { position: relative; }
  .rec__ghost {
    position: absolute; left: 0; top: 50%; translate: var(--rec-pad) -50%; z-index: 0; pointer-events: none; white-space: nowrap;
    font-family: var(--am-display); font-weight: 800; font-stretch: 125%; font-size: clamp(110px, 17vw, 290px); line-height: .8; letter-spacing: -.02em; text-transform: uppercase;
    color: transparent; -webkit-text-stroke: 1px rgba(232, 234, 237, .07); user-select: none;
  }
  .rec__head { position: relative; z-index: 1; display: flex; align-items: end; justify-content: space-between; gap: 18px 24px; flex-wrap: wrap; margin-bottom: 26px; }
  .rec__vp {
    position: relative; z-index: 1; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline: var(--rec-pad);
    scrollbar-width: thin; scrollbar-color: rgba(255, 74, 61, .5) transparent;
  }
  .rec__track { list-style: none; margin: 0; display: flex; gap: clamp(14px, 2vw, 24px); width: max-content; padding: 10px var(--rec-pad) 26px; }
  .rec__item { flex: none; display: flex; width: var(--cw, min(80vw, 340px)); scroll-snap-align: start; }
  .rec__item > :global(.am-card) { width: 100%; }
  .rec__end {
    position: relative; overflow: hidden; isolation: isolate; width: 100%; min-height: 100%;
    display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; padding: 28px; border-radius: 18px; box-sizing: border-box;
    background: radial-gradient(90% 70% at 50% 0%, rgba(227, 20, 31, .22), transparent 70%), linear-gradient(180deg, #16080a, var(--am-surface));
    transition: box-shadow .5s ease;
  }
  .rec__end:hover { --am-lift: -4px; box-shadow: 0 0 60px -20px var(--am-neon); }
  .rec__end-mark {
    position: absolute; left: 50%; top: 30%; width: 80%; aspect-ratio: 594 / 216; translate: -50% -50%; z-index: -1;
    background: linear-gradient(180deg, rgba(255, 255, 255, .14), rgba(255, 255, 255, .02));
    -webkit-mask: url('/arca-motors/brand/arca-car-mono.svg') center / contain no-repeat;
    mask: url('/arca-motors/brand/arca-car-mono.svg') center / contain no-repeat;
    transition: transform .9s var(--am-ease-out);
  }
  .rec__end:hover .rec__end-mark { transform: translateX(6%); }
  .rec__end-n { font-family: var(--am-display); font-weight: 800; font-stretch: 125%; font-size: clamp(72px, 7vw, 110px); line-height: .9; background: var(--am-silver); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .rec__end-t { font-family: var(--am-display); font-stretch: 112%; font-weight: 600; font-size: 18px; color: var(--am-muted); }
  .rec__end-go { display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; font-weight: 700; font-size: 16px; color: var(--am-red-hi); }
  .rec__foot { position: relative; z-index: 1; display: flex; align-items: center; gap: 16px; color: var(--am-dim); font-size: 12px; letter-spacing: .2em; text-transform: uppercase; font-family: var(--am-display); font-weight: 600; }
  .rec__bar { position: relative; flex: 1; max-width: 360px; height: 2px; border-radius: 2px; background: var(--am-line2); overflow: hidden; }
  .rec__fill { position: absolute; inset: 0; background: linear-gradient(90deg, var(--am-red), var(--am-red-hi)); box-shadow: 0 0 10px var(--am-neon); transform: scaleX(0); transform-origin: 0 50%; }
  .rec__hint { display: inline-flex; align-items: center; gap: 8px; }
  .rec__hint-pin { display: none; }
  .rec.is-pinned .rec__hint-pin { display: inline; }
  .rec.is-pinned .rec__hint-swipe { display: none; }
  
    html.am-anim .rec__hint :global(svg) { animation: rec-nudge 1.8s var(--am-ease-io) infinite; }
  
  @keyframes rec-nudge { 0%, 100% { transform: none; } 50% { transform: translateX(5px); } }

  /* Modo fijado (lo activa el script en ≥1000px y sin reduce) */
  .rec.is-pinned { --cw: clamp(250px, calc((100vh - 470px) * .8), 400px); padding: 0; }
  .rec.is-pinned .rec__sticky {
    position: sticky; top: 0; height: 100vh; box-sizing: border-box; overflow: hidden;
    display: flex; flex-direction: column; justify-content: center; padding-top: var(--am-header-h);
  }
  .rec.is-pinned .rec__vp { overflow: visible; scroll-snap-type: none; }
  .rec.is-pinned .rec__track { will-change: transform; }
  .rec.is-pinned .rec__ghost { translate: 0 -50%; left: var(--rec-pad); }

  /* CHIPS */
  .tipos { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; align-items: center; }
  .tipos__sep { width: 1px; height: 24px; background: var(--am-line2); margin-inline: 6px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--am-line2); background: var(--am-surface); font-size: 14px; font-weight: 600; transition: border-color .25s, background-color .25s, color .25s; }
  .chip span { color: var(--am-dim); font-weight: 500; }
  .chip:hover { border-color: rgba(255, 74, 61, .55); background: rgba(227, 20, 31, .1); color: #fff; }
  .chip--quiet { font-weight: 500; color: var(--am-muted); }

  /* ---------- FINANCIAMIENTO ---------- */
  .fin { overflow: hidden; isolation: isolate; background: radial-gradient(60% 60% at 10% 30%, rgba(227, 20, 31, .08), transparent 70%), var(--am-bg2); border-block: 1px solid var(--am-line); margin-top: clamp(64px, 9vw, 120px); }
  .fin__spot { --am-spot-size: min(80vmax, 900px); opacity: .7; }
  .fin__wrap { position: relative; z-index: 1; }
  .fin__title {
    margin: 0 0 clamp(28px, 4vw, 52px); font-family: var(--am-display); font-weight: 800; font-stretch: 118%;
    font-size: clamp(40px, 7.4vw, 104px); line-height: .95; letter-spacing: -.02em;
  }
  
    /* El ancho (wdth) crece mientras el titular sube por la pantalla: --p lo pone data-scrub. */
    :global(html.am-anim.js) .fin__title { font-variation-settings: 'wdth' calc(78 + min(var(--p, .6) * 1.8, 1) * 47); }
  
  .fin__in { display: grid; grid-template-columns: 1fr minmax(0, 520px); gap: clamp(32px, 5vw, 72px); align-items: start; }
  .fin__copy .am-lead { margin-top: 0; }
  .fin__planes { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; margin-top: 30px; }
  .plan {
    position: relative; overflow: hidden; isolation: isolate; padding: 22px 20px; border-radius: 16px;
    background: radial-gradient(100% 80% at 0% 0%, rgba(227, 20, 31, .1), transparent 60%), linear-gradient(180deg, var(--am-surface2), var(--am-surface));
    transition: box-shadow .5s ease;
  }
  .plan:hover { --am-lift: -4px; box-shadow: 0 24px 50px -28px rgba(0, 0, 0, .95), 0 0 40px -18px var(--am-neon); }
  .plan__n { margin: 0; font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--am-dim); font-weight: 600; }
  .plan__t { margin: 10px 0 6px; font-family: var(--am-display); font-stretch: 115%; font-weight: 800; font-size: 26px; line-height: 1.05; }
  .plan__d { margin: 0; color: var(--am-muted); font-size: 14px; }
  .fin__req { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 10px; color: #cfd2d6; font-size: 15px; }
  .fin__req li { display: flex; gap: 10px; align-items: center; }
  .fin__req :global(svg) { color: var(--am-red-hi); }
  .fin__calc { position: relative; border-radius: 19px; }
  .fin__calc::before {
    content: ''; position: absolute; inset: 10% -6% -8%; z-index: -1; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(255, 42, 31, .2), transparent); filter: blur(30px);
  }
  .fin__calc .rng { inset: -1px; }
  @media (max-width: 900px) { .fin__in { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .fin__planes { grid-template-columns: 1fr; } }

  /* ---------- PASOS ---------- */
  .pasos__grid { list-style: none; padding: 0; margin: clamp(40px, 5vw, 64px) 0 0; position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(20px, 3vw, 44px); }
  .pasos__grid::before, .pasos__grid::after { content: ''; position: absolute; left: 0; right: 0; top: 7px; height: 2px; border-radius: 2px; }
  .pasos__grid::before { background: var(--am-line2); }
  .pasos__grid::after {
    background: linear-gradient(90deg, var(--am-red-lo), var(--am-red) 40%, var(--am-red-hi)); box-shadow: 0 0 14px var(--am-neon);
    transform-origin: 0 50%; transform: scaleX(clamp(0, calc((var(--p, 1) - .22) * 2.6), 1));
  }
  .paso { position: relative; padding-top: 40px; }
  .paso__dot { position: absolute; left: 0; top: 0; z-index: 1; width: 16px; height: 16px; border-radius: 50%; box-sizing: border-box; background: var(--am-bg); border: 2px solid var(--am-line2); }
  .paso__dot::after {
    content: ''; position: absolute; inset: -2px; border-radius: 50%; background: var(--am-red); border: 2px solid var(--am-red-hi);
    box-shadow: 0 0 0 5px rgba(227, 20, 31, .18), 0 0 18px var(--am-neon);
    opacity: clamp(0, calc((var(--p, 1) - var(--t, 0)) * 30), 1);
  }
  .paso__n {
    position: relative; display: inline-block; font-family: var(--am-display); font-weight: 800; font-stretch: 125%;
    font-size: clamp(72px, 8vw, 128px); line-height: .9; letter-spacing: -.03em;
    color: transparent; -webkit-text-stroke: 1px rgba(255, 74, 61, .7);
  }
  .paso__n::after {
    content: attr(data-n); position: absolute; inset: 0; -webkit-text-stroke: 0;
    background: linear-gradient(180deg, var(--am-red-hi), var(--am-red) 50%, var(--am-red-lo)); -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 18px rgba(255, 42, 31, .35));
  }
  
    :global(html.am-anim.js) .paso__n::after { clip-path: inset(100% 0 0 0); transition: clip-path 1.3s var(--am-ease-out) calc(var(--am-delay, 0ms) + .35s); }
    :global(html.am-anim.js) .paso.is-in .paso__n::after { clip-path: inset(0 0 0 0); }
  
  .paso h3 { margin: 16px 0 6px; font-family: var(--am-display); font-stretch: 112%; font-size: 22px; font-weight: 700; }
  .paso p { margin: 0; color: var(--am-muted); font-size: 15px; max-width: 32ch; }
  @media (max-width: 999px) {
    .pasos__grid { grid-template-columns: 1fr; gap: 34px; }
    .pasos__grid::before, .pasos__grid::after { left: 7px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .pasos__grid::after { transform-origin: 50% 0; transform: scaleY(clamp(0, calc((var(--p, 1) - .22) * 2.6), 1)); }
    .paso { padding: 0 0 0 44px; }
    .paso__dot { top: 6px; }
    .paso__n { font-size: clamp(64px, 18vw, 96px); }
  }

  /* ---------- VENDE ---------- */
  .vende { overflow: hidden; isolation: isolate; background: linear-gradient(180deg, transparent, rgba(227, 20, 31, .05) 50%, transparent); }
