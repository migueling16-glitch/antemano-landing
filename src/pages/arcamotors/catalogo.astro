---
import ArcaLayout from '../../arca-motors/ArcaLayout.astro';
import CarCard from '../../arca-motors/components/CarCard.astro';
import Icon from '../../arca-motors/components/Icon.astro';
import { wa } from '../../arca-motors/config';
import { enVenta, marcas, ETIQUETA_CARROCERIA, type Carroceria } from '../../arca-motors/inventario';

const autos = [...enVenta()].sort((a, b) => b.ingreso.localeCompare(a.ingreso));
const tipos = (['suv', 'pickup', 'sedan', 'clasico'] as Carroceria[]).filter((t) => autos.some((v) => v.carroceria === t));
const anios = [...new Set(autos.map((v) => v.anio))].sort((a, b) => b - a);
---
<ArcaLayout
  title="Catálogo de seminuevos — Arca Motors Durango"
  description="Todas las unidades disponibles en Arca Motors con enganche, mensualidad, fotos y kilometraje."
  active="catalogo"
>
  <section class="cat">
    <div class="am-wrap">
      <header class="cat__head">
        <div>
          <p class="am-kicker">Catálogo</p>
          <h1 class="am-h2">Autos y camionetas disponibles</h1>
        </div>
        <p class="cat__count" aria-live="polite"><strong data-count>{autos.length}</strong> <span data-count-label>unidades</span></p>
      </header>

      <div class="cat__chips" role="group" aria-label="Tipo de vehículo">
        <button type="button" class="chip" data-tipo="" aria-pressed="true">Todos</button>
        {tipos.map((t) => <button type="button" class="chip" data-tipo={t} aria-pressed="false">{ETIQUETA_CARROCERIA[t]}</button>)}
        <button type="button" class="chip chip--fav" data-only-favs aria-pressed="false"><Icon name="heart" size={16} /> Favoritos <span data-fav-count></span></button>
      </div>

      <div class="cat__layout">
        <aside class="cat__filters" id="filtros" aria-label="Filtros">
          <div class="cat__filters-head">
            <h2>Filtros</h2>
            <button type="button" class="cat__x" data-close-filters aria-label="Cerrar filtros"><Icon name="close" size={22} /></button>
          </div>
          <form class="cat__form" data-filters>
            <div class="am-field">
              <label for="f-q">Buscar</label>
              <input class="am-input" id="f-q" name="q" type="search" placeholder="Tahoe, diésel, 2021…" autocomplete="off" />
            </div>
            <div class="am-field">
              <label for="f-marca">Marca</label>
              <select class="am-select" id="f-marca" name="marca">
                <option value="">Todas</option>
                {marcas().map((m) => <option value={m}>{m}</option>)}
              </select>
            </div>
            <div class="am-field">
              <label for="f-eng">Enganche hasta</label>
              <select class="am-select" id="f-eng" name="eng">
                <option value="">Cualquiera</option>
                <option value="100000">$100,000</option>
                <option value="200000">$200,000</option>
                <option value="350000">$350,000</option>
                <option value="500000">$500,000</option>
                <option value="800000">$800,000</option>
              </select>
            </div>
            <div class="am-field">
              <label for="f-mes">Mensualidad hasta</label>
              <select class="am-select" id="f-mes" name="mes">
                <option value="">Cualquiera</option>
                <option value="5000">$5,000 al mes</option>
                <option value="10000">$10,000 al mes</option>
                <option value="15000">$15,000 al mes</option>
                <option value="25000">$25,000 al mes</option>
              </select>
            </div>
            <div class="am-field">
              <label for="f-anio">Año desde</label>
              <select class="am-select" id="f-anio" name="anio">
                <option value="">Cualquiera</option>
                {anios.map((a) => <option value={a}>{a}</option>)}
              </select>
            </div>
            <label class="cat__check"><input type="checkbox" name="apartados" checked /> <span>Mostrar apartados</span></label>
            <input type="hidden" name="tipo" />
            <div class="cat__form-actions">
              <button type="reset" class="am-btn am-btn--ghost">Limpiar</button>
              <button type="button" class="am-btn am-btn--red cat__apply" data-close-filters>Ver <span data-count-btn>{autos.length}</span></button>
            </div>
          </form>
        </aside>

        <div class="cat__results">
          <div class="cat__bar">
            <button class="am-btn am-btn--ghost cat__open" type="button" data-open-filters aria-expanded="false" aria-controls="filtros">
              <Icon name="sliders" size={18} /> Filtros <span class="cat__badge" data-active-n hidden></span>
            </button>
            <label class="cat__sort">
              <span class="am-label">Ordenar</span>
              <select class="am-select" data-sort aria-label="Ordenar resultados">
                <option value="recientes">Recién llegados</option>
                <option value="eng-asc">Enganche: menor a mayor</option>
                <option value="eng-desc">Enganche: mayor a menor</option>
                <option value="mes-asc">Mensualidad más baja</option>
                <option value="anio-desc">Más nuevos</option>
              </select>
            </label>
          </div>
          <div class="am-grid" data-results>
            {autos.map((v, i) => <CarCard v={v} eager={i < 3} hLevel="h2" />)}
          </div>
          <div class="cat__empty" data-empty hidden>
            <h2>No tenemos esa unidad hoy</h2>
            <p>Nos llegan unidades seguido. Dinos qué buscas y te escribimos si entra una.</p>
            <div class="cat__empty-ctas">
              <a class="am-btn am-btn--wa" data-empty-wa href={wa('Hola, busco un auto que no vi en su catálogo.')} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Avísame cuando llegue</a>
              <button type="button" class="am-btn am-btn--ghost" data-reset>Quitar filtros</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <div class="cat__scrim" data-close-filters hidden></div>
</ArcaLayout>

<script>
  import { NEGOCIO } from '../../arca-motors/config';
  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const grid = document.querySelector<HTMLElement>('[data-results]')!;
  const cards = [...grid.querySelectorAll<HTMLElement>('[data-car]')];
  const sortSel = document.querySelector<HTMLSelectElement>('[data-sort]')!;
  // Ojo: las tarjetas también llevan data-tipo; los chips se buscan solo en su grupo.
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.cat__chips [data-tipo]')];
  const favBtn = document.querySelector<HTMLButtonElement>('[data-only-favs]')!;
  const tipoIn = form.querySelector<HTMLInputElement>('input[name="tipo"]')!;
  const empty = document.querySelector<HTMLElement>('[data-empty]')!;
  const panel = document.getElementById('filtros')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-open-filters]')!;
  const scrim = document.querySelector<HTMLElement>('.cat__scrim')!;
  const norm = (s: string) => s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  let soloFavs = false;

  // Prellenar desde la URL (?tipo=pickup&marca=Jeep&eng=500000)
  const params = new URLSearchParams(location.search);
  for (const [k, val] of params) {
    const el = form.elements.namedItem(k) as HTMLInputElement | HTMLSelectElement | null;
    if (el && 'value' in el) el.value = val;
  }
  const orden = params.get('orden');
  if (orden && [...sortSel.options].some((o) => o.value === orden)) sortSel.value = orden;

  function apply() {
    const d = new FormData(form);
    const q = norm(String(d.get('q') || '').trim());
    const marca = String(d.get('marca') || '');
    const eng = Number(d.get('eng') || 0);
    const mes = Number(d.get('mes') || 0);
    const anio = Number(d.get('anio') || 0);
    const tipo = String(d.get('tipo') || '');
    const apartados = d.get('apartados') === 'on';
    const favs: string[] = (window as any).arcaFavs?.() ?? [];
    let n = 0;
    for (const c of cards) {
      const s = c.dataset;
      const ok =
        (!q || q.split(/\s+/).every((w) => norm(s.texto!).includes(w))) &&
        (!marca || s.marca === marca) &&
        (!eng || Number(s.eng) <= eng) &&
        (!mes || Number(s.mes) <= mes) &&
        (!anio || Number(s.anio) >= anio) &&
        (!tipo || s.tipo === tipo) &&
        (apartados || s.estatus !== 'apartado') &&
        (!soloFavs || favs.includes(s.folio!));
      c.hidden = !ok;
      if (ok) n++;
    }
    chips.forEach((b) => b.setAttribute('aria-pressed', String(!soloFavs && b.dataset.tipo === tipo)));
    favBtn.setAttribute('aria-pressed', String(soloFavs));
    document.querySelector('[data-count]')!.textContent = String(n);
    document.querySelector('[data-count-label]')!.textContent = n === 1 ? 'unidad' : 'unidades';
    document.querySelector('[data-count-btn]')!.textContent = `${n} ${n === 1 ? 'auto' : 'autos'}`;
    empty.hidden = n > 0;
    grid.hidden = n === 0;
    // WhatsApp del estado vacío con lo que se buscó
    const busca = [tipo && (chips.find((b) => b.dataset.tipo === tipo)?.textContent ?? ''), marca, q && `"${q}"`, eng && `con enganche hasta $${eng.toLocaleString('es-MX')}`].filter(Boolean).join(', ');
    document.querySelector<HTMLAnchorElement>('[data-empty-wa]')!.href =
      `https://wa.me/52${NEGOCIO.telefonos[0]}?text=${encodeURIComponent(`Hola Arca Motors, busco ${busca || 'un auto'} y no lo vi en el catálogo. ¿Me avisan si les llega uno?`)}`;
    const activos = ['q', 'marca', 'eng', 'mes', 'anio'].filter((k) => d.get(k)).length + (apartados ? 0 : 1);
    const badge = document.querySelector<HTMLElement>('[data-active-n]')!;
    badge.hidden = !activos;
    badge.textContent = String(activos);
    // Reflejar en la URL para poder compartir la búsqueda
    const u = new URLSearchParams();
    for (const k of ['q', 'tipo', 'marca', 'eng', 'mes', 'anio']) if (d.get(k)) u.set(k, String(d.get(k)));
    if (sortSel.value !== 'recientes') u.set('orden', sortSel.value);
    history.replaceState(null, '', u.toString() ? `?${u}` : location.pathname);
  }

  function sort() {
    const [k, dir] = sortSel.value.split('-');
    const key = { recientes: 'ingreso', eng: 'eng', mes: 'mes', anio: 'anio' }[k] as string;
    const num = key !== 'ingreso';
    const sorted = [...cards].sort((a, b) => {
      const x = a.dataset[key]!, y = b.dataset[key]!;
      const c = num ? Number(x) - Number(y) : x.localeCompare(y);
      return k === 'recientes' || dir === 'desc' ? -c : c;
    });
    sorted.forEach((c) => grid.appendChild(c));
  }

  form.addEventListener('input', apply);
  form.addEventListener('change', apply);
  form.addEventListener('submit', (e) => e.preventDefault());
  form.addEventListener('reset', () => setTimeout(() => { tipoIn.value = ''; soloFavs = false; apply(); }));
  document.querySelector('[data-reset]')!.addEventListener('click', () => form.reset());
  sortSel.addEventListener('change', () => { sort(); apply(); });
  chips.forEach((b) => b.addEventListener('click', () => { tipoIn.value = b.dataset.tipo!; soloFavs = false; apply(); }));
  favBtn.addEventListener('click', () => { soloFavs = !soloFavs; if (soloFavs) tipoIn.value = ''; apply(); });
  document.addEventListener('arca:favs', () => { if (soloFavs) apply(); });

  // Panel de filtros como hoja (diálogo modal) en móvil
  const mq = matchMedia('(max-width: 900px)');
  const closeBtn = panel.querySelector<HTMLButtonElement>('.cat__x')!;
  let isOpen = false;
  const setOpen = (open: boolean) => {
    if (open === isOpen) return;
    isOpen = open;
    panel.classList.toggle('is-open', open);
    scrim.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) { panel.setAttribute('role', 'dialog'); panel.setAttribute('aria-modal', 'true'); closeBtn.focus(); }
    else { panel.removeAttribute('role'); panel.removeAttribute('aria-modal'); openBtn.focus(); }
  };
  openBtn.addEventListener('click', () => setOpen(true));
  document.querySelectorAll('[data-close-filters]').forEach((b) => b.addEventListener('click', () => setOpen(false)));
  addEventListener('keydown', (e) => {
    if (!isOpen) return;
    if (e.key === 'Escape') { setOpen(false); return; }
    if (e.key !== 'Tab') return;
    // Mantener el foco dentro de la hoja
    const f = [...panel.querySelectorAll<HTMLElement>('button, input, select, a[href]')].filter((el) => el.offsetParent !== null);
    if (!f.length) return;
    const first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });
  mq.addEventListener('change', () => { if (!mq.matches) setOpen(false); });

  sort();
  apply();
</script>

<style>
  .cat { padding: clamp(32px, 5vw, 56px) 0 40px; }
  .cat__head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; }
  .cat__count { margin: 0; color: var(--am-muted); font-size: 15px; }
  .cat__count strong { font-family: var(--am-display); font-stretch: 112%; font-size: 30px; color: var(--am-text); margin-right: 4px; }
  .cat__chips { display: flex; gap: 8px; flex-wrap: wrap; margin: 26px 0 26px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--am-line2); background: var(--am-surface); color: var(--am-text); font: 600 14px var(--am-body); cursor: pointer; transition: border-color .2s, background .2s; }
  .chip:hover { border-color: rgba(255,74,61,.5); }
  .chip[aria-pressed='true'] { background: var(--am-red); border-color: var(--am-red); color: #fff; }
  .chip--fav[aria-pressed='true'] :global(svg) { fill: currentColor; }
  .chip [data-fav-count]:not(:empty)::before { content: '· '; }

  .cat__layout { display: grid; grid-template-columns: 270px 1fr; gap: 28px; align-items: start; }
  .cat__open { display: none; }
  .cat__filters { position: sticky; top: 92px; padding: 20px; border-radius: 16px; border: 1px solid var(--am-line); background: var(--am-surface); }
  .cat__filters-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px; }
  .cat__filters-head h2 { margin: 0; font-family: var(--am-display); font-stretch: 112%; font-size: 18px; font-weight: 650; }
  .cat__x { display: none; }
  .cat__form { display: grid; gap: 16px; }
  .cat__check { display: flex; gap: 10px; align-items: center; font-size: 14.5px; color: #cfd2d6; cursor: pointer; min-height: 40px; }
  .cat__check input { width: 20px; height: 20px; accent-color: var(--am-red); }
  .cat__form-actions { display: grid; grid-template-columns: 1fr; gap: 8px; }
  .cat__apply { display: none; }
  .cat__bar { display: flex; justify-content: flex-end; margin-bottom: 16px; }
  .cat__sort { display: flex; align-items: center; gap: 12px; }
  .cat__sort .am-select { min-height: 42px; width: auto; }
  .cat__results .am-grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 270px), 1fr)); }
  .cat__empty { text-align: center; padding: 64px 20px; border: 1px dashed var(--am-line2); border-radius: 18px; }
  .cat__empty h2 { margin: 0; font-family: var(--am-display); font-stretch: 112%; font-size: 26px; }
  .cat__empty p { color: var(--am-muted); margin: 10px auto 24px; max-width: 46ch; }
  .cat__empty-ctas { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .cat__badge { min-width: 20px; height: 20px; border-radius: 999px; background: var(--am-red); color: #fff; font-size: 12px; display: inline-grid; place-items: center; padding: 0 6px; }
  .cat__scrim { position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 55; }

  @media (max-width: 900px) {
    .cat__layout { grid-template-columns: 1fr; gap: 0; }
    .cat__open { display: inline-flex; min-height: 44px; }
    .cat__bar { justify-content: space-between; align-items: center; gap: 10px; }
    .cat__sort .am-label { display: none; }
    .cat__sort .am-select { min-height: 44px; max-width: 210px; }
    .cat__chips { margin-bottom: 16px; }
    .cat__filters {
      position: fixed; left: 0; right: 0; bottom: 0; top: auto; z-index: 60; max-height: 86vh; overflow-y: auto;
      border-radius: 20px 20px 0 0; padding: 20px 16px calc(20px + env(safe-area-inset-bottom));
      transform: translateY(105%); visibility: hidden;
      transition: transform .3s cubic-bezier(.2,.7,.2,1), visibility 0s linear .3s;
    }
    .cat__filters.is-open { transform: none; visibility: visible; transition: transform .3s cubic-bezier(.2,.7,.2,1), visibility 0s; }
    .cat__x { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--am-line2); background: transparent; color: var(--am-text); cursor: pointer; }
    .cat__form-actions { grid-template-columns: 1fr 1.4fr; position: sticky; bottom: 0; background: var(--am-surface); padding-top: 8px; }
    .cat__apply { display: inline-flex; }
  }
</style>
