    html.am-anim .gal.is-zoom .gal__hint--zoom { opacity: 0; transform: translateY(6px); }
  }
  @media (pointer: coarse) {
    .gal.is-ready .gal__hint--swipe { display: inline-flex; }
  }
  .gal.has-moved .gal__hint--swipe { opacity: 0; transform: translateY(6px); }

  /* lupa */
  .gal__lens {
