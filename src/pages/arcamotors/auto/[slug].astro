  .crumbs [aria-current] { color: var(--am-text); }
  .crumbs__sep { width: 14px; height: 1px; background: var(--am-line2); }

  .vdp__grid { display: grid; grid-template-columns: minmax(0, 1fr) 400px; column-gap: 40px; row-gap: 36px; margin-top: 10px; align-items: start; }
  .vdp__grid > * { min-width: 0; grid-column: 1; }
  .vdp__grid > .buy { grid-column: 2; grid-row: 1 / span 3; }
