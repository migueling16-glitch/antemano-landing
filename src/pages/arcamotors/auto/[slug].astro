    pointer-events: none; opacity: 0; scale: .5; background-color: #0b0b0c; background-repeat: no-repeat;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, .45), 0 0 0 7px rgba(255, 74, 61, .22), 0 0 44px -4px var(--am-neon), 0 30px 60px -20px rgba(0, 0, 0, .9);
