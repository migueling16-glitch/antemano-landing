  .gal__main :global(.am-visual--frame) { display: flex; align-items: center; justify-content: center; transform-origin: 50% 45%; }
  .gal__main :global(.am-visual__img) { width: auto; height: 100%; max-width: 100%; object-fit: contain; }
  /* Ken Burns sutil siempre activo (se pausa con la lupa y fuera de pantalla). */
  
    html.am-anim .gal__main :global(.am-visual--frame) { animation: vdp-kb 22s var(--am-ease-io) infinite alternate; }
    html.am-anim .gal.is-zoom .gal__main :global(.am-visual--frame) { animation-play-state: paused; }
  
  @keyframes vdp-kb { from { transform: scale(1); } to { transform: scale(1.07) translate3d(-1.2%, -1%, 0); } }
  .vdp-page.is-sold .gal__main :global(.am-visual__img) { filter: grayscale(.55); }

  /* capa entrante del barrido (la crea el script) */
  .gal :global(.gal__incoming) { position: absolute; inset: 0; z-index: 1; display: flex; align-items: center; justify-content: center; overflow: hidden; background: #0b0b0c; will-change: clip-path; }
  .gal :global(.gal__inc-blur) { position: absolute; inset: -8%; width: 116%; height: 116%; max-width: none; object-fit: cover; filter: blur(28px) brightness(.45) saturate(1.2); transform: scale(1.05); }
  .gal :global(.gal__inc-img) { position: relative; width: auto; height: 100%; max-width: 100%; object-fit: contain; }
  .gal :global(.gal__edge) {
