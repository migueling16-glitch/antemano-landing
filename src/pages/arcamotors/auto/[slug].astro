---
import ArcaLayout from '../../../arca-motors/ArcaLayout.astro';
import CarVisual from '../../../arca-motors/components/CarVisual.astro';
import CarCard from '../../../arca-motors/components/CarCard.astro';
import Calculadora from '../../../arca-motors/components/Calculadora.astro';
import Icon from '../../../arca-motors/components/Icon.astro';
import { BASE, NEGOCIO, FINANCIAMIENTO, ACEPTA_A_CUENTA, wa, tel, telBonito } from '../../../arca-motors/config';
import {
  INVENTARIO, slug, nombre, nombreCompleto, dinero, kms, mensajeWa,
  recienLlegado, foto, ETIQUETA_CARROCERIA, type Vehiculo,
} from '../../../arca-motors/inventario';

export function getStaticPaths() {
  return INVENTARIO.map((v) => ({ params: { slug: slug(v) }, props: { v } }));
}
interface Props { v: Vehiculo }
const { v } = Astro.props;

const vendido = v.estatus === 'vendido';
const apartado = v.estatus === 'apartado';
const vt = `car-${v.folio.toLowerCase()}`;
// Fotos del carrusel de su post (sin el flyer). Sin fotos: placeholder con la lista de tomas ideal.
const TOMAS = ['3/4 frontal', 'Lateral', '3/4 trasera', 'Interior', 'Tablero y km', 'Asientos traseros', 'Cajuela', 'Motor', 'Llantas'];
const slides = v.nFotos ? Array.from({ length: v.nFotos }, (_, i) => `Foto ${i + 1}`) : TOMAS;
const nFotos = slides.length;
const pad = (n: number) => String(n).padStart(2, '0');
// "Papeles y servicio": solo lo que la unidad trae según su post.
const tiene = (t: string) => v.destacados.some((d) => d.toLowerCase().includes(t));
const papeles = [
  v.facturaAgencia && { i: 'file', t: 'Factura de agencia', d: 'Pídela a la vista cuando vengas al lote' },
  { i: 'user', t: v.duenos === 1 ? 'Único dueño' : `${v.duenos} dueños`, d: 'Según la factura de la unidad' },
  tiene('llave') && { i: 'key', t: 'Duplicado de llaves', d: 'Se entrega con sus dos llaves' },
  tiene('servicio') && { i: 'wrench', t: 'Servicios de agencia', d: 'Pregunta por su historial de servicio' },
].filter(Boolean) as { i: string; t: string; d: string }[];
const specs = [
  { k: 'Año', v: String(v.anio), i: 'calendar' },
  { k: 'Kilometraje', v: v.km != null ? kms(v.km) : 'Pregúntanos', i: 'gauge', count: v.km != null },
  v.transmision && { k: 'Transmisión', v: v.transmision, i: 'gear' },
  v.combustible && { k: 'Combustible', v: v.combustible, i: 'fuel' },
  v.motor && { k: 'Motor', v: v.motor, i: 'wrench' },
  v.traccion && { k: 'Tracción', v: v.traccion, i: 'road' },
  v.color && { k: 'Color', v: v.color, i: 'tag' },
  { k: 'Dueños', v: v.duenos === 1 ? 'Único dueño' : `${v.duenos} dueños`, i: 'user' },
  { k: 'Factura', v: v.facturaAgencia ? 'De agencia' : 'Por confirmar', i: 'file' },
].filter(Boolean) as { k: string; v: string; i: string; count?: boolean }[];
// Bento: Año y Kilometraje son mosaicos grandes; el resto llena filas completas
// (6 columnas en escritorio, 2 en el celular) sin dejar huecos.
const chicos = specs.length - 2;
const bento = specs.map((s, i) => {
  if (i < 2) return { ...s, big: true, c6: 3, c2: 1 };
  const j = i - 2;
  const resto6 = chicos % 3;
  const c6 = j >= chicos - resto6 ? (resto6 === 1 ? 6 : 3) : 2;
  const c2 = chicos % 2 === 1 && j === chicos - 1 ? 2 : 1;
  return { ...s, big: false, c6, c2 };
});

const similares = INVENTARIO.filter((x) => x.folio !== v.folio && x.estatus !== 'vendido')
  .sort((a, b) => (a.carroceria === v.carroceria ? 0 : 1) - (b.carroceria === v.carroceria ? 0 : 1) || Math.abs(a.enganche - v.enganche) - Math.abs(b.enganche - v.enganche))
  .slice(0, 3);

// Numeración de las secciones (solo las que se muestran).
const hayEq = !!(v.equipamiento && v.equipamiento.length > 0);
const secciones = ['dest', 'ficha', hayEq && 'eq', 'docs', !vendido && 'fin'].filter(Boolean) as string[];
const num = (id: string) => pad(secciones.indexOf(id) + 1);

const msgPrueba = `Hola Arca Motors, quiero agendar una prueba de manejo del ${nombreCompleto(v)} (${v.folio}). ¿Qué día tienen disponible?`;
const msgApartar = `Hola Arca Motors, quiero apartar el ${nombreCompleto(v)} (${v.folio}). ¿Cómo le hago?`;
const msgContado = `Hola Arca Motors, ¿cuál es el precio de contado del ${nombreCompleto(v)} (${v.folio})?`;
const msgSimilar = `Hola Arca Motors, vi que ya vendieron el ${nombreCompleto(v)} (${v.folio}). Busco uno similar, ¿me avisan si les llega?`;
const msgPrincipal = vendido ? msgSimilar : mensajeWa(v);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Car',
  name: nombreCompleto(v),
  brand: { '@type': 'Brand', name: v.marca },
  model: v.modelo,
  vehicleModelDate: String(v.anio),
  mileageFromOdometer: v.km != null ? { '@type': 'QuantitativeValue', value: v.km, unitCode: 'KMT' } : undefined,
  image: v.nFotos ? [new URL(foto(v, 0, 1280), 'https://antemano.com.mx').href] : undefined,
  url: new URL(`${BASE}/auto/${slug(v)}/`, 'https://antemano.com.mx').href,
  vehicleTransmission: v.transmision,
  fuelType: v.combustible,
  color: v.color,
  numberOfPreviousOwners: v.duenos,
  sku: v.folio,
  itemCondition: 'https://schema.org/UsedCondition',
  offers: {
    '@type': 'Offer',
    ...(v.precio ? { price: v.precio, priceCurrency: 'MXN' } : {}),
    availability: vendido ? 'https://schema.org/SoldOut' : apartado ? 'https://schema.org/LimitedAvailability' : 'https://schema.org/InStock',
    seller: { '@type': 'AutoDealer', name: NEGOCIO.nombre, telephone: `+52${NEGOCIO.telefonos[0]}` },
  },
};
---
<ArcaLayout
  title={`${nombreCompleto(v)} ${vendido ? '(vendido)' : '· enganche ' + dinero(v.enganche)} — Arca Motors`}
  description={`${nombreCompleto(v)}${v.km != null ? ', ' + kms(v.km) : ''}. ${v.destacados.join(', ')}. Enganche ${dinero(v.enganche)} y mensualidad ${dinero(v.mensualidad)}. Seminuevo en ${NEGOCIO.ciudad}.`}
  active="catalogo"
  jsonLd={jsonLd}
  waMensaje={msgPrincipal}
  ownBar
>
  <div class:list={['vdp-page', { 'is-sold': vendido }]}>
    <!-- Ambiente: retícula técnica + foco rojo que deriva solo (decorativo). -->
    <div class="vdp__amb" data-spotlight aria-hidden="true">
      <span class="am-spotlight"></span>
      <span class="am-spotlight am-spotlight--white vdp__amb-w"></span>
    </div>

    <div class="am-wrap vdp">
      <nav class="crumbs am-reveal" aria-label="Migas de pan">
        <a href={`${BASE}/catalogo/`}><Icon name="arrowLeft" size={16} /> Catálogo</a>
        <span aria-hidden="true" class="crumbs__sep"></span>
        <span>{ETIQUETA_CARROCERIA[v.carroceria]}</span>
        <span aria-hidden="true" class="crumbs__sep"></span>
        <span aria-current="page">{nombre(v)}</span>
      </nav>

      <!-- Orden del DOM = orden en el celular. En escritorio .buy se coloca en la columna derecha. -->
      <div class="vdp__grid">
        <!-- GALERÍA -->
        <section class="gal" aria-label="Fotos" data-gal>
          <div class="gal__stage" data-gal-stage>
            <div class="gal__main" data-gal-main>
              <CarVisual v={v} toma={v.nFotos ? undefined : TOMAS[0]} eager big vt={vt} sizes="(max-width: 900px) 100vw, 760px" />
            </div>
            <div class="gal__segs" aria-hidden="true">
              {slides.map((_, i) => <span class:list={{ 'is-on': i === 0 }} data-gal-seg></span>)}
            </div>
            <div class="gal__badges">
              {apartado && <span class="am-badge am-badge--held">Apartado</span>}
              {vendido && <span class="am-badge am-badge--sold">Vendido</span>}
              {!vendido && !apartado && recienLlegado(v) && <span class="am-badge am-badge--new">Recién llegado</span>}
            </div>
            {!vendido && (
              <button class="am-fav gal__fav" type="button" data-fav={v.folio} aria-pressed="false" aria-label="Guardar en favoritos" data-cursor=""><Icon name="heart" size={18} /></button>
            )}
            {nFotos > 1 && (
              <>
                <button class="gal__nav gal__nav--prev" type="button" data-gal-prev aria-label="Foto anterior" data-cursor=""><Icon name="arrowLeft" size={20} /></button>
                <button class="gal__nav gal__nav--next" type="button" data-gal-next aria-label="Foto siguiente" data-cursor=""><Icon name="arrow" size={20} /></button>
              </>
            )}
            <span class="gal__count">
              <Icon name="camera" size={15} />
              <span class="gal__n-w"><span class="gal__n" data-gal-n>{pad(1)}</span></span>
              <span class="gal__of">/{pad(nFotos)}</span>
            </span>
            <span class="gal__hint gal__hint--zoom" aria-hidden="true"><Icon name="search" size={14} /> Pasa el cursor para ver de cerca</span>
            <span class="gal__hint gal__hint--swipe" aria-hidden="true"><Icon name="swap" size={14} /> Desliza</span>
            <span class="gal__lens" data-gal-lens aria-hidden="true"></span>
          </div>
          <div class="gal__rail" data-gal-rail>
            <span class="gal__ind" data-gal-ind aria-hidden="true"></span>
            <ul class="gal__thumbs" aria-label="Miniaturas">
              {slides.map((t, i) => (
                <li>
                  <button
                    type="button"
                    class="gal__thumb"
                    data-gal-i={i}
                    data-toma={t}
                    data-full={v.nFotos ? foto(v, i, 1280) : undefined}
                    aria-label={v.nFotos ? `Ver foto ${i + 1} de ${nFotos}` : `Ver toma: ${t}`}
                    aria-pressed={i === 0 ? 'true' : 'false'}
                  >
                    <CarVisual v={v} i={i} sizes="96px" />
                    <span class="gal__tn" aria-hidden="true">{v.nFotos ? pad(i + 1) : t}</span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
          <a class="gal__ig" href={v.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={15} /> Fotos del post de Instagram <Icon name="arrowUpRight" size={14} /></a>
        </section>

        <!-- TÍTULO: nombre gigante (palabras con máscara + ancho cinético en el modelo) y el año en contorno detrás -->
        <header class="vdp__title">
          <span class="vdp__year" data-inview data-parallax="-0.06" aria-hidden="true">{v.anio}</span>
          <p class="am-kicker am-reveal">{ETIQUETA_CARROCERIA[v.carroceria]} · Folio {v.folio}</p>
          <h1 class="vdp__name" data-split>
            <span class="vdp__marca">{v.marca}</span>
            <span class="vdp__modelo am-silver-text" data-kinetic data-kinetic-max="125" data-kinetic-radius="320" data-split-done="1">{v.modelo}</span>
            <span class="vdp__ver">{v.version} {v.anio}</span>
          </h1>
          <ul class="vdp__chips">
            {v.km != null && <li class="am-reveal">{kms(v.km)}</li>}{v.transmision && <li class="am-reveal">{v.transmision}</li>}{v.traccion && <li class="am-reveal">{v.traccion}</li>}{v.combustible && <li class="am-reveal">{v.combustible}</li>}{v.color && <li class="am-reveal">{v.color}</li>}
          </ul>
        </header>

        <!-- PRECIO (columna fija en escritorio) -->
        <aside class="buy" aria-label="Precio y contacto">
          <div class="buy__card am-reveal am-loop" style="--am-delay: 120ms">
            <span class="buy__ring" aria-hidden="true"></span>
            <div class="buy__in" data-spotlight>
              <span class="am-spotlight buy__spot" aria-hidden="true"></span>
              <p class="buy__estado" data-estado={v.estatus}>
                <span class="buy__dot" aria-hidden="true"></span>{vendido ? 'Vendido' : apartado ? 'Apartado · pregunta si se libera' : 'Disponible'}
              </p>
              {vendido ? (
                <p class="buy__sold">Esta unidad ya encontró dueño. Dinos qué buscas y te escribimos si entra una parecida.</p>
              ) : (
                <>
                  <p class="am-label">Enganche</p>
                  <p class="buy__price"><span class="am-silver-text" data-count data-count-dur="1800">{dinero(v.enganche)}</span></p>
                  <p class="buy__mes">Mensualidad <strong><span data-count data-count-dur="1800">{dinero(v.mensualidad)}</span>*</strong> <a href="#t-fin">Otras opciones</a></p>
                  <p class="buy__fin">{v.precio ? <>Precio de contado: <strong>{dinero(v.precio)}</strong></> : <a href={wa(msgContado)} target="_blank" rel="noopener">Pregunta el precio de contado</a>}</p>
                </>
              )}
              <div class="buy__ctas">
                <a class="am-btn am-btn--wa am-btn--lg am-btn--block buy__wa" href={wa(msgPrincipal)} target="_blank" rel="noopener" data-magnetic>
                  <Icon name="whatsapp" size={20} /> {vendido ? 'Busco uno similar' : apartado ? 'Avísame si se libera' : 'Me interesa'}
                </a>
                {!vendido && (
                  <div class="buy__row">
                    <a class="am-btn am-btn--ghost" href={wa(msgPrueba)} target="_blank" rel="noopener"><Icon name="calendar" size={17} /> Prueba de manejo</a>
                    {!apartado && <a class="am-btn am-btn--ghost" href={wa(msgApartar)} target="_blank" rel="noopener"><Icon name="key" size={17} /> Apartar</a>}
                  </div>
                )}
                <a class="buy__tel" href={tel()}><Icon name="phone" size={16} /> o llámanos al {telBonito(NEGOCIO.telefonos[0])}</a>
              </div>
              <ul class="buy__trust">
                {v.facturaAgencia && <li><span class="buy__ti"><Icon name="file" size={15} /></span> Factura de agencia</li>}
                {v.duenos === 1 && <li><span class="buy__ti"><Icon name="user" size={15} /></span> Único dueño</li>}
                <li><span class="buy__ti"><Icon name="card" size={15} /></span> Crédito directo o con financiera</li>
                {ACEPTA_A_CUENTA && <li><span class="buy__ti"><Icon name="swap" size={15} /></span> Recibimos tu auto a cuenta</li>}
              </ul>
            </div>
          </div>
          <p class="buy__folio">Folio {v.folio} · menciónalo al escribirnos</p>
        </aside>

        <div class="vdp__rest">
          <!-- DESTACADOS -->
          <section class="block" aria-labelledby="t-dest">
            <div class="block__head">
              <span class="block__n" aria-hidden="true">{num('dest')}</span>
              <h2 class="block__t" id="t-dest" data-split>Lo que lo hace especial</h2>
              <span class="am-rule block__rule" data-inview aria-hidden="true"></span>
            </div>
            <ul class="dest">
              {v.destacados.map((d) => <li class="am-reveal"><span class="dest__i"><Icon name="check" size={16} /></span> {d}</li>)}
            </ul>
          </section>

          <!-- FICHA (bento) -->
          <section class="block" aria-labelledby="t-ficha">
            <div class="block__head">
              <span class="block__n" aria-hidden="true">{num('ficha')}</span>
              <h2 class="block__t" id="t-ficha" data-split>Ficha técnica</h2>
              <span class="am-rule block__rule" data-inview aria-hidden="true"></span>
            </div>
            <dl class="bento">
              {bento.map((s) => (
                <div class:list={['bento__it', 'am-reveal', { 'bento__it--big': s.big }]} style={`--c6: span ${s.c6}; --c2: span ${s.c2}; --len: ${Math.max(s.v.length, 4)}`} data-tilt="4">
                  <dt><span class="bento__ico"><Icon name={s.i} size={18} /></span>{s.k}</dt>
                  <dd>{s.count ? <span data-count>{s.v}</span> : s.v}<span class="am-glare bento__glare" aria-hidden="true"></span></dd>
                </div>
              ))}
            </dl>
          </section>

          {hayEq && (
            <section class="block" aria-labelledby="t-eq">
              <div class="block__head">
                <span class="block__n" aria-hidden="true">{num('eq')}</span>
                <h2 class="block__t" id="t-eq" data-split>Equipamiento</h2>
                <span class="am-rule block__rule" data-inview aria-hidden="true"></span>
              </div>
              <ul class="eq">{v.equipamiento!.map((e) => <li class="am-reveal">{e}</li>)}</ul>
            </section>
          )}

          <!-- CONFIANZA -->
          <section class="block" aria-labelledby="t-docs">
            <div class="block__head">
              <span class="block__n" aria-hidden="true">{num('docs')}</span>
              <h2 class="block__t" id="t-docs" data-split>Papeles y servicio</h2>
              <span class="am-rule block__rule" data-inview aria-hidden="true"></span>
            </div>
            <ul class="docs">
              {papeles.map((x) => <li class="am-reveal"><span class="docs__i"><Icon name={x.i} size={20} /></span><div><strong>{x.t}</strong><span>{x.d}</span></div></li>)}
            </ul>
          </section>

          <a class="igv am-reveal" href={v.instagram} target="_blank" rel="noopener" data-cursor="Abrir">
            <span class="igv__play"><Icon name="instagram" size={22} /></span>
            <div><strong>Velo en Instagram</strong><span>El post original de esta unidad, con todas sus fotos</span></div>
            <span class="igv__go"><Icon name="arrowUpRight" size={20} /></span>
          </a>

          {!vendido && (
            <section class="block" aria-labelledby="t-fin">
              <div class="block__head">
                <span class="block__n" aria-hidden="true">{num('fin')}</span>
                <h2 class="block__t" id="t-fin" data-split>Formas de pago</h2>
                <span class="am-rule block__rule" data-inview aria-hidden="true"></span>
              </div>
              <ul class="planes">
                <li class="planes__pub am-reveal">
                  <p class="planes__n"><span class="am-pulse-dot" aria-hidden="true"></span> Plan publicado</p>
                  <p class="planes__t"><span data-count>{dinero(v.enganche)}</span> <small>de enganche</small></p>
                  <p class="planes__d">y {dinero(v.mensualidad)} al mes*</p>
                </li>
                {FINANCIAMIENTO.planes.map((p) => (
                  <li class="am-reveal">
                    <p class="planes__n">{p.nombre}</p>
                    <p class="planes__t">{p.titulo}</p>
                    <p class="planes__d">{p.detalle}</p>
                  </li>
                ))}
              </ul>
              <a class="am-btn am-btn--ghost planes__cta" href={wa(`Hola Arca Motors, quiero cotizar el ${nombreCompleto(v)} (${v.folio}) con otro enganche o plazo.`)} target="_blank" rel="noopener">
                <Icon name="whatsapp" size={18} /> Cotizar con otro enganche o plazo
              </a>
              {v.precio && <div class="planes__calc"><Calculadora precio={v.precio} auto={`${nombreCompleto(v)} (${v.folio})`} id="calc-vdp" /></div>}
            </section>
          )}
        </div>
      </div>
    </div>

    {similares.length > 0 && (
      <>
        <!-- Tipografía como layout: el nombre de la unidad en una marquesina (decorativa). -->
        <div class="vdp-band am-marquee am-marquee--fade" data-marquee="55" aria-hidden="true">
          <div class="am-marquee__track">
            <span class="vdp-band__it"><span class="am-outline-text">{nombre(v)}</span><span class="am-carmark"></span></span>
            <span class="vdp-band__it"><span class="am-silver-text">{v.version ? `${v.version} ${v.anio}` : v.anio}</span><span class="am-carmark"></span></span>
            <span class="vdp-band__it"><span class="am-outline-text am-outline-text--red">{v.folio}</span><span class="am-carmark"></span></span>
          </div>
        </div>

        <div class="am-wrap vdp-sim">
          <section class="am-section--tight" aria-labelledby="t-sim">
            <div class="am-section__head">
              <div>
                <p class="am-kicker am-reveal">Sigue viendo</p>
                <h2 class="am-h2" id="t-sim" data-split>También te puede gustar</h2>
              </div>
              <a class="am-link" href={`${BASE}/catalogo/?tipo=${v.carroceria}`}>Ver más {ETIQUETA_CARROCERIA[v.carroceria]} <Icon name="arrow" size={16} /></a>
            </div>
            <div class="am-grid">{similares.map((s) => <CarCard v={s} />)}</div>
          </section>
        </div>
      </>
    )}
  </div>

  <div class="vbar" slot="bar">
    <div class="vbar__p">
      {vendido ? <strong>Vendido</strong> : <><span>Enganche</span><strong>{dinero(v.enganche)}</strong><span>{dinero(v.mensualidad)}/mes*</span></>}
    </div>
    <a class="am-btn am-btn--ghost vbar__tel" href={tel()} aria-label="Llamar"><Icon name="phone" size={18} /></a>
    <a class="am-btn am-btn--wa" href={wa(msgPrincipal)} target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> {vendido ? 'Similar' : 'Me interesa'}</a>
  </div>
</ArcaLayout>

<script>
  /*
   * Galería de la ficha:
   *  - miniaturas (aria-pressed), flechas ← → con la galería enfocada, botones anterior/siguiente
   *  - cambio de foto con barrido (clip-path) + línea neón; sin movimiento reducido: cambio directo
   *  - deslizar en táctil (la foto sigue al dedo), lupa que sigue al cursor con puntero fino
   *  - indicador activo que se desliza entre miniaturas y contador que rueda
   */
  const reduceMQ = matchMedia(document.documentElement.classList.contains('am-anim') ? 'not all' : 'all');
  const fineMQ = matchMedia('(hover: hover) and (pointer: fine)');
  const motionOK = () => !reduceMQ.matches;
  const EASE_IO = 'cubic-bezier(.65,0,.35,1)';
  const EASE_OUT = 'cubic-bezier(.16,1,.3,1)';
  const wait = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
  const pad = (n: number) => String(n).padStart(2, '0');

  const gal = document.querySelector<HTMLElement>('[data-gal]');
  if (gal) initGal(gal);

  function initGal(gal: HTMLElement) {
    const stage = gal.querySelector<HTMLElement>('[data-gal-stage]')!;
    const main = gal.querySelector<HTMLElement>('[data-gal-main]')!;
    const frame = main.querySelector<HTMLElement>('.am-visual--frame');
    const mainImg = main.querySelector<HTMLImageElement>('.am-visual__img');
    const blur = main.querySelector<HTMLImageElement>('.am-visual__blur');
    const n = gal.querySelector<HTMLElement>('[data-gal-n]');
    const rail = gal.querySelector<HTMLElement>('[data-gal-rail]');
    const ind = gal.querySelector<HTMLElement>('[data-gal-ind]');
    const lens = gal.querySelector<HTMLElement>('[data-gal-lens]');
    const segs = [...gal.querySelectorAll<HTMLElement>('[data-gal-seg]')];
    const thumbs = [...gal.querySelectorAll<HTMLButtonElement>('[data-gal-i]')];
    if (!stage || !main || !thumbs.length) return;
    let cur = 0;
    let gen = 0;

    /* ---------- indicador de miniatura activa ---------- */
    function placeIndicator() {
      const b = thumbs[cur];
      if (!ind || !b || !b.offsetWidth) return;
      ind.style.width = `${b.offsetWidth}px`;
      ind.style.height = `${b.offsetHeight}px`;
      ind.style.transform = `translate3d(${b.offsetLeft}px, ${b.offsetTop}px, 0)`;
    }
    function scrollRail() {
      const b = thumbs[cur];
      if (!rail || !b) return;
      const left = b.offsetLeft - (rail.clientWidth - b.offsetWidth) / 2;
      rail.scrollTo({ left: Math.max(0, left), behavior: motionOK() ? 'smooth' : 'auto' });
    }
    placeIndicator();
    if (rail && 'ResizeObserver' in window) new ResizeObserver(placeIndicator).observe(rail);
    document.fonts?.ready.then(placeIndicator);
    requestAnimationFrame(() => gal.classList.add('is-ready'));

    /* ---------- cambio de foto ---------- */
    function commitTo(t: HTMLButtonElement) {
      const src = t.querySelector<HTMLImageElement>('img');
      if (!src || !mainImg) return;
      mainImg.srcset = src.getAttribute('srcset') || '';
      mainImg.src = src.getAttribute('src') || src.src;
      mainImg.alt = src.alt;
      if (blur) blur.src = src.getAttribute('src') || src.src;
    }

    function swap(i: number, d: number) {
      const t = thumbs[i];
      const label = main.querySelector('.am-visual__toma');
      if (label) label.textContent = t.dataset.toma || '';
      if (lens && t.dataset.full) lens.style.backgroundImage = `url("${t.dataset.full}")`;
      const src = t.querySelector<HTMLImageElement>('img');
      const my = ++gen;
      // Sin foto (estudio) o sin movimiento: cambio directo.
      // En táctil: cambio directo con fundido corto (el barrido crea otra capa desenfocada y anima clip-path).
      if (!src || !mainImg || !frame || !motionOK() || document.documentElement.classList.contains('is-touch') || typeof mainImg.animate !== 'function') {
        commitTo(t);
        if (motionOK()) main.animate?.([{ opacity: 0.4 }, { opacity: 1 }], { duration: 300 });
        return;
      }
      // Una capa nueva (foto + su fondo desenfocado) entra con un barrido sobre la actual.
      const s = src.getAttribute('src') || src.src;
      const inc = document.createElement('div');
      inc.className = 'gal__incoming';
      inc.setAttribute('aria-hidden', 'true');
      const ib = document.createElement('img');
      ib.className = 'gal__inc-blur';
      ib.alt = '';
      ib.src = s;
      const ii = document.createElement('img');
      ii.className = 'gal__inc-img';
      ii.alt = '';
      ii.sizes = mainImg.sizes;
      ii.srcset = src.getAttribute('srcset') || '';
      ii.src = s;
      const from = d > 0 ? 'inset(0 0 0 100%)' : 'inset(0 100% 0 0)';
      inc.style.clipPath = from;
      inc.append(ib, ii);
      const edge = document.createElement('span');
      edge.className = 'gal__edge';
      edge.setAttribute('aria-hidden', 'true');
      frame.append(inc, edge);

      Promise.race([ii.decode().catch(() => {}), wait(700)]).then(() => {
        if (my !== gen) { inc.remove(); edge.remove(); return; }
        // La capa anterior se quita hasta que la nueva ya decodificó: así no reaparece la foto original.
        frame.querySelectorAll('.gal__incoming, .gal__edge').forEach((el) => { if (el !== inc && el !== edge) el.remove(); });
        mainImg.getAnimations().forEach((a) => a.cancel());
        const W = frame.clientWidth;
        const dur = 820;
        const wipe = inc.animate([{ clipPath: from }, { clipPath: 'inset(0 0 0 0)' }], { duration: dur, easing: EASE_IO, fill: 'forwards' });
        ii.animate([{ transform: `translateX(${d * 7}%) scale(1.05)` }, { transform: 'none' }], { duration: dur + 300, easing: EASE_OUT });
        mainImg.animate(
          [{ transform: 'none', opacity: 1 }, { transform: `translateX(${-d * 6}%) scale(.96)`, opacity: 0.25 }],
          { duration: dur, easing: EASE_IO, fill: 'forwards' },
        );
        edge.animate(
          [{ transform: `translateX(${d > 0 ? W : 0}px)`, opacity: 1 }, { transform: `translateX(${d > 0 ? 0 : W}px)`, opacity: 1 }],
          { duration: dur, easing: EASE_IO, fill: 'forwards' },
        );
        wipe.finished
          .then(async () => {
            if (my !== gen) return;
            commitTo(t);
            await Promise.race([mainImg.decode().catch(() => {}), wait(500)]);
            if (my !== gen) return;
            mainImg.getAnimations().forEach((a) => a.cancel());
            edge.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 260, fill: 'forwards' }).finished.then(() => edge.remove(), () => edge.remove());
            inc.remove();
          })
          .catch(() => {});
      });
    }

    function go(target: number, dir?: number) {
      const len = thumbs.length;
      const i = ((target % len) + len) % len;
      if (i === cur) return;
      const d = dir ?? (i > cur ? 1 : -1);
      cur = i;
      gal.classList.add('has-moved');
      thumbs.forEach((x, k) => x.setAttribute('aria-pressed', String(k === i)));
      segs.forEach((s, k) => { s.classList.toggle('is-on', k === i); s.classList.toggle('is-past', k < i); });
      if (n) {
        n.textContent = pad(i + 1);
        if (motionOK()) n.animate?.([{ transform: `translateY(${d * 100}%)`, opacity: 0 }, { transform: 'none', opacity: 1 }], { duration: 520, easing: EASE_OUT });
      }
      placeIndicator();
      scrollRail();
      swap(i, d);
      // precarga la siguiente
      const nxt = thumbs[(i + 1) % len]?.querySelector('img');
      if (nxt && mainImg) { const im = new Image(); im.sizes = mainImg.sizes; im.srcset = nxt.getAttribute('srcset') || ''; }
    }

    thumbs.forEach((t, k) => t.addEventListener('click', () => go(k)));
    gal.querySelector('[data-gal-prev]')?.addEventListener('click', () => go(cur - 1, -1));
    gal.querySelector('[data-gal-next]')?.addEventListener('click', () => go(cur + 1, 1));

    // Flechas del teclado cuando el foco está dentro de la galería.
    gal.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      if (e.altKey || e.ctrlKey || e.metaKey) return;
      const tgt = e.target as Element;
      e.preventDefault();
      const d = e.key === 'ArrowRight' ? 1 : -1;
      go(cur + d, d);
      if (tgt?.matches?.('[data-gal-i]')) thumbs[cur].focus({ preventScroll: true });
    });

    /* ---------- deslizar en táctil (la foto sigue al dedo) ---------- */
    let sx = 0;
    let sy = 0;
    let dx = 0;
    let dragging = false;
    let axis: '' | 'x' | 'y' = '';
    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' || (e.target as Element).closest('button, a')) return;
      sx = e.clientX; sy = e.clientY; dx = 0; axis = ''; dragging = true;
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging || e.pointerType === 'mouse') return;
      const mx = e.clientX - sx;
      const my = e.clientY - sy;
      if (!axis) {
        if (Math.abs(mx) + Math.abs(my) < 8) return;
        axis = Math.abs(mx) > Math.abs(my) ? 'x' : 'y';
      }
      if (axis !== 'x') return;
      dx = mx;
      if (motionOK()) main.style.translate = `${(dx * 0.4).toFixed(1)}px 0`;
    });
    const endDrag = () => {
      if (!dragging) return;
      dragging = false;
      const moved = dx;
      dx = 0;
      if (main.style.translate) {
        const fromT = main.style.translate;
        main.style.translate = '';
        main.animate?.([{ translate: fromT }, { translate: '0px 0px' }], { duration: 520, easing: EASE_OUT });
      }
      if (axis === 'x' && Math.abs(moved) > 45) {
        const d = moved < 0 ? 1 : -1;
        go(cur + d, d);
      }
    };
    stage.addEventListener('pointerup', endDrag);
    stage.addEventListener('pointercancel', endDrag);

    /* ---------- lupa (solo puntero fino y sin movimiento reducido) ---------- */
    if (lens && mainImg && fineMQ.matches && motionOK()) {
      const ZOOM = 2.5;
      const html = document.documentElement;
      let raf = 0;
      let px = 0;
      let py = 0;
      let over = false;
      let overUi = false;
      const first = thumbs[0]?.dataset.full;
      if (first) lens.style.backgroundImage = `url("${first}")`;
      const setOn = (on: boolean) => {
        lens.classList.toggle('is-on', on);
        gal.classList.toggle('is-zoom', on);
        html.classList.toggle('vdp-zoom', on);
      };
      const paint = () => {
        raf = 0;
        if (!over || overUi) return setOn(false);
        const nw = mainImg.naturalWidth;
        const nh = mainImg.naturalHeight;
        if (!nw || !nh) return setOn(false);
        const sr = stage.getBoundingClientRect();
        const ir = mainImg.getBoundingClientRect();
        // Caja real de la foto dentro del <img> (object-fit: contain).
        const k = Math.min(ir.width / nw, ir.height / nh);
        const cw = nw * k;
        const ch = nh * k;
        const cx = ir.left + (ir.width - cw) / 2;
        const cy = ir.top + (ir.height - ch) / 2;
        const rx = px - cx;
        const ry = py - cy;
        if (rx < 0 || ry < 0 || rx > cw || ry > ch) return setOn(false);
        const L = lens.offsetWidth || 200;
        lens.style.transform = `translate3d(${(px - sr.left).toFixed(1)}px, ${(py - sr.top).toFixed(1)}px, 0)`;
        lens.style.backgroundSize = `${(cw * ZOOM).toFixed(1)}px ${(ch * ZOOM).toFixed(1)}px`;
        lens.style.backgroundPosition = `${(-(rx * ZOOM - L / 2)).toFixed(1)}px ${(-(ry * ZOOM - L / 2)).toFixed(1)}px`;
        setOn(true);
      };
      const kick = () => { if (!raf) raf = requestAnimationFrame(paint); };
      stage.addEventListener('pointerenter', (e) => {
        if (e.pointerType !== 'mouse') return;
        over = true;
        const full = thumbs[cur]?.dataset.full;
        if (full) { const im = new Image(); im.src = full; }
      });
      stage.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        over = true;
        px = e.clientX;
        py = e.clientY;
        overUi = !!(e.target as Element).closest('button, a');
        kick();
      });
      stage.addEventListener('pointerleave', () => { over = false; kick(); });
      addEventListener('scroll', () => { if (over) kick(); }, { passive: true });
    }
  }
</script>

<style>
