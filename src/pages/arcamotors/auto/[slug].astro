  /* ---------- galería: escenario vertical con fondo desenfocado ---------- */
  .gal { position: relative; }
  .gal__stage {
    position: relative; isolation: isolate; overflow: hidden;
    height: clamp(440px, calc(100vh - 230px), 780px); height: clamp(440px, calc(100svh - 230px), 780px);
    border-radius: 22px; border: 1px solid var(--am-line2); background: #0b0b0c;
    box-shadow: 0 50px 90px -50px rgba(0, 0, 0, .95), 0 0 70px -40px var(--am-neon-soft);
