---
/**
 * /aldolugo/ — landing de Mesa de Lumbre (DEMO), v2: una historia en escenas
 * (Chef Aldo Lugo/04_Docs/GUION_LANDING_v2.md). Primero se siente, luego se presenta al guía,
 * al final se explica cómo se contrata. Escenas: src/aldo-lugo/v2/Escenas.astro · movimiento: v2/movimiento.ts
 * Formulario (sin cambios): src/aldo-lugo/solicitud.ts
 */
import AldoLayout from '../../aldo-lugo/AldoLayout.astro';
import '../../aldo-lugo/landing.css';
import Escenas from '../../aldo-lugo/v2/Escenas.astro';
import HojaSolicitud from '../../aldo-lugo/components/HojaSolicitud.astro';
import Barra from '../../aldo-lugo/components/Barra.astro';
import { SITIO } from '../../aldo-lugo/config';
---
<AldoLayout title={SITIO.seo.title} description={SITIO.seo.description} variante="landing">
  <Escenas />
  <HojaSolicitud />
  <Fragment slot="barra"><Barra /></Fragment>
</AldoLayout>
