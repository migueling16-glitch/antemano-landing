---
/**
 * /aldolugo/cuestionario/?k=TOKEN — cuestionario interactivo para el chef (34 preguntas de PREGUNTAS_CHEF.md).
 *
 * Pantallas (hash): #inicio · #P1…#P34 · #resumen · #gracias. Todo se pinta aquí en el build; el cliente
 * (src/aldo-lugo/cuestionario-cliente.ts) solo muestra/oculta, lee y guarda. Datos: src/aldo-lugo/cuestionario.ts.
 * Guardado: src/aldo-lugo/almacen.ts (teléfono siempre; Supabase si config.ts trae SUPABASE_URL y SUPABASE_KEY).
 * Sin token válido = vista previa: guarda solo en el teléfono y lo avisa.
 */
import AldoLayout from '../../aldo-lugo/AldoLayout.astro';
import Campo from '../../aldo-lugo/components/cuestionario/Campo.astro';
import Fotos from '../../aldo-lugo/components/cuestionario/Fotos.astro';
import { SITIO, SUPABASE_URL, SUPABASE_KEY } from '../../aldo-lugo/config';
import {
  PREGUNTAS, BLOQUES, PRIORIDADES, TEXTOS, TOTAL, CUENTA, modeloCliente, textosCliente, type Prioridad,
} from '../../aldo-lugo/cuestionario';

// config.ts manda; si está vacío, se aceptan las variables de entorno PUBLIC_ALDO_SUPABASE_URL / _KEY
// (Vercel → Settings → Environment Variables). Las dos son públicas por diseño (llave publicable).
const conexion = {
  url: SUPABASE_URL || import.meta.env.PUBLIC_ALDO_SUPABASE_URL || '',
  key: SUPABASE_KEY || import.meta.env.PUBLIC_ALDO_SUPABASE_KEY || '',
};
const datos = JSON.stringify({ modelo: modeloCliente(), textos: textosCliente(), conexion }).replace(/</g, '\\u003c');

const bloque = Object.fromEntries(BLOQUES.map((b) => [b.id, b]));
const prioridades = Object.keys(PRIORIDADES) as Prioridad[];
const bloquesDe = (pr: Prioridad) => BLOQUES.filter((b) => b.prioridad === pr);
const preguntasDe = (b: string) => PREGUNTAS.filter((p) => p.bloque === b);
const T = TEXTOS;
const modos = Object.entries(T.modos);
---
<AldoLayout title={SITIO.cuestionario.title} description={SITIO.cuestionario.description} variante="cuestionario">
  <Fragment slot="head">
    <!-- El enlace lleva el token (?k=): que no viaje como referrer a otros sitios. -->
    <meta name="referrer" content="no-referrer" />
  </Fragment>

  <div class="cq" id="cq" data-actual="inicio">
    <script type="application/json" id="cq-datos" set:html={datos} />

    <!-- Barra fija: prioridad, posición, guardado y progreso (un segmento por pregunta) -->
    <div class="cq-barra" data-tema="noche">
      <div class="cq-barra__in">
        <div class="cq-barra__fila">
          <p class="al-label cq-barra__cont"><span data-cq-prio>P0</span><span aria-hidden="true"> · </span><span data-cq-contador>1 de {TOTAL}</span></p>
          <p class="cq-barra__estado" data-cq-estado data-estado="local">
            <span class="cq-barra__punto" aria-hidden="true"></span><span data-cq-estado-txt>{T.estado.local}</span>
          </p>
        </div>
        <ol class="cq-progreso" aria-hidden="true">
          {PREGUNTAS.map((p, i) => (
            <li class:list={['cq-seg', i > 0 && PREGUNTAS[i - 1].prioridad !== p.prioridad && 'cq-seg--corte']} data-seg={p.id} data-estado-de={p.id}></li>
          ))}
        </ol>
      </div>
    </div>

    <div class="cq-cuerpo" data-tema="dia">
      <!-- Índice (escritorio) -->
      <nav class="cq-indice" aria-label="Índice de preguntas">
        {prioridades.map((pr) => (
          <div class="cq-indice__grupo">
            <p class="al-label cq-indice__prio">{pr} · {PRIORIDADES[pr].titulo}</p>
            {bloquesDe(pr).map((b) => (
              <>
                <p class="cq-indice__bloque">{b.titulo}</p>
                <ol class="cq-indice__lista">
                  {preguntasDe(b.id).map((p) => (
                    <li>
                      <a href={`#${p.id}`} data-ind={p.id}>
                        <span class="cq-punto" data-estado-de={p.id} aria-hidden="true"></span>
                        <span class="cq-indice__n">{p.n}</span> {p.titulo}
                      </a>
                    </li>
                  ))}
                </ol>
              </>
            ))}
          </div>
        ))}
      </nav>

      <div class="cq-pantallas">
        <!-- ============================== Bienvenida ============================== -->
        <section class="cq-pantalla cq-inicio is-activa" data-pantalla="inicio" aria-labelledby="cq-inicio-t">
          <div class="cq-col">
            <p class="al-label cq-eyebrow">{T.etiqueta}</p>
            <h1 class="al-h1 cq-inicio__t" id="cq-inicio-t" tabindex="-1">{T.bienvenida.titulo}</h1>
            <p class="al-lead cq-inicio__lead">{T.bienvenida.lead}</p>
            <ul class="cq-puntos">
              {T.bienvenida.puntos.map((t) => <li>{t}</li>)}
            </ul>
            <p class="cq-ya" data-cq-ya-enviado hidden></p>
            <div class="cq-acciones">
              <a class="al-btn al-btn--primario al-btn--bloque" href="#P1" data-cq-empezar>{T.bienvenida.empezar}</a>
              <a class="al-btn al-btn--secundario al-btn--bloque" href="#resumen">{T.bienvenida.resumen}</a>
            </div>
            <div class="cq-modo" data-cq-modo>
              {modos.map(([id, texto]) => <p data-modo={id} hidden>{texto}</p>)}
            </div>
            <p class="cq-plazo">{T.bienvenida.plazo}</p>
            <dl class="cq-prios">
              {prioridades.map((pr) => (
                <div>
                  <dt><span class="cq-prio">{pr}</span> {PRIORIDADES[pr].rango}</dt>
                  <dd><b>{PRIORIDADES[pr].titulo}.</b> {PRIORIDADES[pr].ayuda}{pr === 'P0' && ' P3, P20 y P22 tienen respuesta por defecto y no frenan el lanzamiento.'}</dd>
                </div>
              ))}
            </dl>
            <p class="al-small al-muted">{T.bienvenida.fotos}</p>
          </div>
        </section>

        <!-- ============================== Preguntas ============================== -->
        {PREGUNTAS.map((p) => (
          <section class="cq-pantalla cq-preg" data-pantalla={p.id} id={`cq-${p.id}`} aria-labelledby={`cq-${p.id}-t`}>
            <div class="cq-col">
              <p class="cq-preg__meta">
                <span class="cq-prio">{p.prioridad}</span>
                <span class="al-label">{bloque[p.bloque].titulo}</span>
              </p>
              <div class="cq-preg__cab">
                <span class="cq-preg__n" aria-hidden="true">{p.n}</span>
                <span class="cq-chip-estado" data-estado-de={p.id}>{T.estados.pendiente}</span>
              </div>
              <h2 class="cq-preg__t" id={`cq-${p.id}-t`} tabindex="-1"><span class="al-sr">Pregunta {p.n}. </span>{p.pregunta}</h2>
              {p.intro && <p class="cq-preg__intro">{p.intro}</p>}
              {p.siNoContesta && <p class="cq-defecto">{p.siNoContesta}</p>}
              {p.cita && (
                <blockquote class="cq-cita">
                  {p.cita.lineas.map((l) => <p>{l}</p>)}
                  {p.cita.firma && <footer>{p.cita.firma}</footer>}
                </blockquote>
              )}
              {p.listas?.map((l) => (
                <div class="cq-lista">
                  {l.titulo && <p class="cq-lista__t">{l.titulo}</p>}
                  {l.numerada ? <ol>{l.items.map((i) => <li>{i}</li>)}</ol> : <ul>{l.items.map((i) => <li>{i}</li>)}</ul>}
                </div>
              ))}
              {p.fotos && <Fotos fotos={p.fotos} />}
              {p.contexto && (
                <details class="cq-contexto">
                  <summary>{T.pregunta.contexto}</summary>
                  <ul>{p.contexto.map((c) => <li>{c}</li>)}</ul>
                </details>
              )}
              <div class="cq-campos">
                {p.campos.map((c) => <Campo campo={c} />)}
              </div>
              {p.noSe && (
                <div class="cq-nose">
                  <button type="button" class="cq-nose__btn" data-nose={p.id} aria-pressed="false">{T.pregunta.noSe}</button>
                  <span class="cq-nose__ayuda">{T.pregunta.noSeAyuda}</span>
                </div>
              )}
            </div>
          </section>
        ))}

        <!-- ============================== Resumen ============================== -->
        <section class="cq-pantalla cq-res" data-pantalla="resumen" aria-labelledby="cq-resumen-t">
          <div class="cq-col">
            <p class="al-label cq-eyebrow">{T.resumen.titulo}</p>
            <h2 class="cq-h" id="cq-resumen-t" tabindex="-1">Tus respuestas</h2>
            <p class="cq-res__cuenta" data-cq-cuenta>{T.resumen.cuenta(0, TOTAL)}</p>
            <ul class="cq-res__prios">
              {prioridades.map((pr) => (
                <li><span class="cq-prio">{pr}</span> <span data-cq-cuenta-prio={pr}>0 de {CUENTA[pr]}</span></li>
              ))}
            </ul>
            <p class="cq-res__lead">{T.resumen.lead}</p>
            <p class="cq-enviado" data-cq-enviado hidden></p>
            <div class="cq-modo" data-cq-modo>
              {modos.map(([id, texto]) => <p data-modo={id} hidden>{texto}</p>)}
            </div>

            <div class="cq-enviar">
              <button type="button" class="al-btn al-btn--primario al-btn--bloque" data-cq-enviar>{T.resumen.enviar}</button>
              <div class="cq-faltan" data-cq-faltan hidden tabindex="-1" role="region" aria-label="Preguntas que faltan">
                <p class="cq-faltan__t" data-cq-faltan-texto></p>
                <p class="cq-faltan__lista" data-cq-faltan-lista></p>
                <p class="al-small al-muted">{T.resumen.faltanAyuda}</p>
                <div class="cq-faltan__acc">
                  <a class="al-btn al-btn--secundario" href="#P1" data-cq-ir-falta>{T.resumen.irA(1)}</a>
                  <button type="button" class="al-btn al-btn--fantasma" data-cq-enviar-asi>{T.resumen.enviarAsi}</button>
                </div>
              </div>
              <div class="cq-copia" data-cq-copia>
                <button type="button" class="al-btn al-btn--fantasma al-btn--bloque" data-cq-copiar>{T.resumen.copiar}</button>
                <p class="al-small al-muted">{T.resumen.copiarAyuda}</p>
                <textarea class="cq-input cq-copia__area" readonly rows="10" data-cq-copia-area hidden aria-label="Todas tus respuestas"></textarea>
              </div>
            </div>

            <nav class="cq-chips" aria-label="Ir a un bloque">
              {BLOQUES.map((b) => (
                <button type="button" class="al-chip cq-chips__b" data-ir-bloque={b.id}>
                  {b.corto} <span class="cq-chips__n" data-cuenta-bloque={b.id}></span>
                </button>
              ))}
            </nav>

            {prioridades.map((pr) => (
              <div class="cq-res__grupo">
                <h3 class="cq-res__prio-t"><span class="cq-prio">{pr}</span> {PRIORIDADES[pr].titulo}</h3>
                {bloquesDe(pr).map((b) => (
                  <section class="cq-res__bloque" id={`cq-b-${b.id}`} aria-labelledby={`cq-b-${b.id}-t`}>
                    <h4 class="al-label cq-res__bloque-t" id={`cq-b-${b.id}-t`}>{b.titulo}</h4>
                    <ol class="cq-res__lista">
                      {preguntasDe(b.id).map((p) => (
                        <li>
                          <a class="cq-res__item" href={`#${p.id}`} data-res={p.id}>
                            <span class="cq-res__n" aria-hidden="true">{p.n}</span>
                            <span class="cq-res__cuerpo">
                              <span class="cq-res__titulo"><span class="al-sr">Pregunta {p.n}: </span>{p.titulo}</span>
                              <span class="cq-chip-estado" data-estado-de={p.id}>{T.estados.pendiente}</span>
                              <span class="cq-res__txt" data-res-texto>{T.resumen.sinRespuesta}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ol>
                  </section>
                ))}
              </div>
            ))}

            <div class="cq-res__fin">
              <button type="button" class="al-btn al-btn--secundario al-btn--bloque" data-cq-enviar>{T.resumen.enviar}</button>
              <div class="cq-copia" data-cq-copia>
                <button type="button" class="al-btn al-btn--fantasma al-btn--bloque" data-cq-copiar>{T.resumen.copiar}</button>
                <textarea class="cq-input cq-copia__area" readonly rows="10" data-cq-copia-area hidden aria-label="Todas tus respuestas"></textarea>
              </div>
            </div>
          </div>
        </section>

        <!-- ============================== Envío ============================== -->
        <section class="cq-pantalla cq-gracias" data-pantalla="gracias" aria-label="Envío">
          <div class="cq-col">
            <div data-gracias="ok" hidden>
              <span class="al-sello cq-gracias__sello" aria-hidden="true">{T.gracias.sello}</span>
              <h2 class="cq-h" tabindex="-1">{T.gracias.titulo}</h2>
              <p class="al-lead">{T.gracias.texto}</p>
              <p>{T.gracias.cambios}</p>
            </div>
            <div data-gracias="pendiente" hidden>
              <h2 class="cq-h" tabindex="-1">{T.gracias.pendienteTitulo}</h2>
              <p class="al-lead">{T.gracias.pendienteTexto}</p>
            </div>
            <div data-gracias="local" hidden>
              <h2 class="cq-h" tabindex="-1">{T.gracias.localTitulo}</h2>
              <p class="al-lead">{T.gracias.localTexto}</p>
            </div>
            <div data-gracias="error" hidden>
              <h2 class="cq-h" tabindex="-1">{T.gracias.errorTitulo}</h2>
              <p class="al-lead">{T.gracias.errorTexto}</p>
            </div>
            <div class="cq-copia" data-cq-copia>
              <button type="button" class="al-btn al-btn--fantasma al-btn--bloque" data-cq-copiar>{T.resumen.copiar}</button>
              <textarea class="cq-input cq-copia__area" readonly rows="10" data-cq-copia-area hidden aria-label="Todas tus respuestas"></textarea>
            </div>
            <a class="al-btn al-btn--secundario al-btn--bloque" href="#resumen">{T.gracias.volver}</a>
          </div>
        </section>
      </div>
    </div>

    <!-- Navegación inferior (preguntas) -->
    <nav class="cq-nav" data-tema="noche" aria-label="Preguntas" data-cq-nav>
      <div class="cq-nav__in">
        <a class="cq-nav__btn cq-nav__atras" href="#inicio" data-cq-atras aria-label={T.nav.atras}><span aria-hidden="true">←</span><span class="cq-nav__txt" aria-hidden="true">{T.nav.atras}</span></a>
        <a class="cq-nav__btn" href="#resumen">{T.nav.resumen}</a>
        <a class="al-btn al-btn--primario cq-nav__sig" href="#P2" data-cq-siguiente><span data-cq-siguiente-txt>{T.nav.siguiente}</span> <span aria-hidden="true">→</span></a>
      </div>
    </nav>
  </div>

  <noscript><p class="cq-sinjs">{T.sinJs}</p></noscript>

  <script is:inline>
    // Antes del primer pintado: abre la pantalla del hash (#P5, #resumen) para que no parpadee la bienvenida.
    // Si el módulo del cliente no carga, este mismo bloque mantiene la navegación por hash.
    (function () {
      var c = document.getElementById('cq');
      if (!c) return;
      function abrir() {
        if (window.__cqListo) return;
        var h = decodeURIComponent(location.hash.slice(1)) || 'inicio';
        if (h === 'gracias') h = 'resumen';
        var s = c.querySelector('[data-pantalla="' + h.replace(/[^A-Za-z0-9_-]/g, '') + '"]');
        if (!s) return;
        var a = c.querySelectorAll('.cq-pantalla.is-activa');
        for (var i = 0; i < a.length; i++) a[i].classList.remove('is-activa');
        s.classList.add('is-activa');
        c.setAttribute('data-actual', h);
      }
      abrir();
      window.addEventListener('hashchange', abrir);
    })();
  </script>
  <script>
    import { iniciar } from '../../aldo-lugo/cuestionario-cliente';
    iniciar();
  </script>
</AldoLayout>

<style is:global>
  /* =====================================================================
     CUESTIONARIO (.cq-*) — móvil primero. Tokens --al-* del layout.
     Tema: cuerpo "dia" (hueso, lectura larga); barra y navegación "noche".
     ===================================================================== */
  .cq {
    --cq-campo: #f7f2e7; /* fondo de controles sobre hueso */
    --cq-borde: var(--al-tizne); /* 5.6:1 sobre hueso: bordes de controles (WCAG 1.4.11) */
    --cq-borde-suave: rgba(20, 20, 20, .2);
    --cq-barra-h: 58px;
    position: relative;
  }
  .cq [hidden] { display: none !important; }
  .cq fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  .cq legend { padding: 0; }
  .cq ul, .cq ol { margin: 0; padding: 0; }
  html.al-js .cq-pantalla:not(.is-activa) { display: none; }
  html:not(.al-js) .cq-barra, html:not(.al-js) .cq-nav { display: none; }
  .cq a.al-btn--primario { color: var(--al-hueso); } /* el layout hereda color en <a> */
  .cq-sinjs { max-width: 40rem; margin: 16px auto; padding: 16px var(--al-margen); color: var(--al-hueso); }

  .cq-cuerpo { min-height: calc(100vh - var(--cq-barra-h) - 72px); min-height: calc(100svh - var(--cq-barra-h) - 72px); }
  .cq-col { max-width: 40rem; margin-inline: auto; padding: var(--al-sp-5) var(--al-margen) var(--al-sp-8); }
  .cq-eyebrow { color: var(--al-fg-2); }
  .cq-h { font-family: var(--al-f-display); font-weight: 560; font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.75rem); line-height: 1.08; letter-spacing: -.01em; margin: 8px 0 0; text-wrap: balance; }
  .cq-h:focus, .cq-preg__t:focus, .cq-inicio__t:focus { outline: none; }
  .cq-prio {
    display: inline-flex; align-items: center; justify-content: center; min-width: 2.1em; height: 1.45em; padding: 0 .4em;
    border: 1px solid currentColor; border-radius: var(--al-r-1);
    font: 600 .75rem/1 var(--al-f-label); letter-spacing: .08em;
  }

  /* ---------- Barra ---------- */
  .cq-barra { position: sticky; top: 0; z-index: 25; border-bottom: 1px solid var(--al-carbon-3); }
  .cq[data-actual='inicio'] .cq-barra, .cq[data-actual='gracias'] .cq-barra { display: none; }
  .cq-barra__in { max-width: var(--al-max); margin-inline: auto; padding: 8px var(--al-margen) 10px; }
  .cq-barra__fila { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 2px 12px; min-height: 24px; }
  .cq-barra__cont { color: var(--al-hueso); font-size: .8125rem; white-space: nowrap; }
  .cq-barra__estado { display: inline-flex; align-items: center; gap: 7px; color: var(--al-ceniza); font-size: .8125rem; line-height: 1.3; }
  .cq-barra__punto { width: 7px; height: 7px; border-radius: 50%; background: var(--al-ceniza); flex: none; }
  .cq-barra__estado[data-estado='guardado'] { color: var(--al-hueso); }
  .cq-barra__estado[data-estado='guardado'] .cq-barra__punto { background: var(--al-hueso); }
  .cq-barra__estado[data-estado='guardando'] .cq-barra__punto { background: var(--al-brasa); }
  .cq-barra__estado[data-estado='sin-conexion'] .cq-barra__punto,
  .cq-barra__estado[data-estado='reintentando'] .cq-barra__punto,
  .cq-barra__estado[data-estado='error'] .cq-barra__punto,
  .cq-barra__estado[data-estado='sin-almacen'] .cq-barra__punto { background: transparent; box-shadow: inset 0 0 0 1.5px var(--al-ceniza); }
  .cq-barra__estado[data-estado='error'], .cq-barra__estado[data-estado='sin-almacen'] { color: var(--al-hueso); }
  .cq-progreso { display: flex; gap: 2px; margin-top: 8px; list-style: none; }
  .cq-seg { flex: 1 1 0; height: 6px; border-radius: 1px; background: rgba(237, 230, 214, .16); }
  .cq-seg--corte { margin-left: 5px; }
  .cq-seg[data-estado='completa'] { background: var(--al-hueso); }
  .cq-seg[data-estado='nose'] { background: var(--al-ceniza); }
  .cq-seg[data-estado='parcial'] { background: rgba(237, 230, 214, .5); }
  .cq-seg.is-actual { background: var(--al-brasa); box-shadow: 0 0 0 1px var(--al-brasa); }

  /* ---------- Navegación inferior ---------- */
  .cq-nav {
    position: sticky; bottom: 0; z-index: 25; border-top: 1px solid var(--al-carbon-3);
    padding: 10px var(--al-margen) calc(10px + env(safe-area-inset-bottom));
  }
  .cq:not([data-actual^='P']) .cq-nav { display: none; }
  .cq[data-escribiendo] .cq-nav { display: none; }
  .cq-nav__in { display: grid; grid-template-columns: auto auto 1fr; gap: 8px; max-width: 40rem; margin-inline: auto; }
  .cq-nav__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: .35em; min-height: var(--al-btn-h-2); padding: 0 12px;
    border: 1px solid var(--al-linea); border-radius: var(--al-r-1); color: var(--al-hueso); text-decoration: none;
    font: 600 .9375rem/1.1 var(--al-f-text); -webkit-tap-highlight-color: transparent; touch-action: manipulation;
  }
  .cq-nav__btn:hover { border-color: var(--al-ceniza); }
  .cq-nav__sig { min-height: var(--al-btn-h-2); padding: 0 14px; white-space: nowrap; }
