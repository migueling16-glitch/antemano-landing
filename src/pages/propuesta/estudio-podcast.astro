---
// Propuesta privada: estudio de podcast de Antemano (proyecto ejecutivo para socios).
// noindex: URL privada, no se enlaza desde el sitio.
// Todo el contenido sale de src/data/estudio-podcast.json (investigación verificada, 13-nov-2026).
import d from '../../data/estudio-podcast.json';
import EnCorto from '../../components/propuesta/EnCorto.astro';
import CapNav from '../../components/propuesta/CapNav.astro';

const D: any = d;
const mxn = (n: unknown) =>
  typeof n === 'number' && isFinite(n) ? '$' + Math.round(n).toLocaleString('es-MX') : '—';
const corto = (n: unknown) => {
  if (typeof n !== 'number' || !isFinite(n)) return '—';
  if (Math.abs(n) >= 1e6) return '$' + (n / 1e6).toLocaleString('es-MX', { maximumFractionDigits: 1 }) + ' M';
  if (Math.abs(n) >= 1e3) return '$' + Math.round(n / 1e3).toLocaleString('es-MX') + ' mil';
  return '$' + Math.round(n).toLocaleString('es-MX');
};
const host = (u: string) => {
  try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return 'fuente'; }
};

const niveles: any[] = D.equipo_niveles || [];
const iRec = Math.max(0, niveles.findIndex((n) => /recom/i.test(n.nivel || '')));
const recomendada = (D.opciones || []).find((o: any) => o.recomendada) || (D.opciones || [])[0];
const escenarios: any[] = (D.finanzas && D.finanzas.escenarios) || [];
const escMedio = escenarios[Math.min(1, escenarios.length - 1)] || {};
const minManual = (D.flujo || []).reduce((s: number, f: any) => s + (f.min_humanos_manual || 0), 0);
const minIa = (D.flujo || []).reduce((s: number, f: any) => s + (f.min_humanos_con_ia || 0), 0);
const F: any = D.finanzas || {};
const capital: any = F.capital || { tramos: [] };
const fc: any = F.flujo_caja || { serie: [] };
const serieCaja: any[] = fc.serie || [];
const iCruce = serieCaja.findIndex((s: any) => s.acumulado > 0);
const iBajo = serieCaja.reduce((m: number, s: any, i: number) => (s.acumulado < serieCaja[m].acumulado ? i : m), 0);

const capitulos = [
  { id: 'por-que', n: '01', t: 'Por qué ahora', p: 0, d: 'Lo que dicen los datos del formato y la ventana electoral de Durango.' },
  { id: 'casos', n: '02', t: 'Quién ya lo hace', p: 0, d: `${(D.casos || []).length} casos reales y qué aprendemos de cada uno.` },
  { id: 'caminos', n: '03', t: 'Tres caminos', p: 0, d: 'Las tres estrategias que compitieron y por qué gana la mezcla.' },
  { id: 'propuesta', n: '04', t: 'Lo que vendemos', p: 1, d: `La propuesta de valor y los ${(D.paquetes || []).length} paquetes con su precio.` },
  { id: 'mvp', n: '05', t: 'El arranque', p: 1, d: 'El equipo en tres niveles, qué cambia del equipo pensado y el espacio.' },
  { id: 'opera', n: '06', t: 'Cómo opera', p: 1, d: 'Un episodio paso a paso, con y sin IA, y las herramientas.' },
  { id: 'personas', n: '07', t: 'Quién lo hace', p: 1, d: 'El equipo por fase, los socios y las horas de Miguel.' },
  { id: 'hitos', n: '08', t: 'Hitos', p: 1, d: `Las ${(D.hitos || []).length} pruebas que liberan cada inversión, en una línea de tiempo.` },
  { id: 'numeros', n: '09', t: 'Los números', p: 2, d: 'Simulador del mes: precios, costos, escenarios y capacidad.' },
  { id: 'dinero', n: '10', t: 'El dinero del socio', p: 2, d: 'Capital por tramos, curva de la caja, reparto y reglas de cierre.' },
  { id: 'politica', n: '11', t: 'El nicho político', p: 3, d: 'La oportunidad, el calendario electoral y las reglas del INE.' },
  { id: 'durango', n: '12', t: 'Durango', p: 3, d: 'El mercado en cifras y los nichos en orden de ataque.' },
  { id: 'escalar', n: '13', t: 'Casa de medios', p: 3, d: 'Cómo crece la infraestructura, etapa por etapa.' },
  { id: 'riesgos', n: '14', t: 'Riesgos', p: 4, d: `Los ${(D.riesgos || []).length} riesgos en una matriz y qué hacemos con cada uno.` },
  { id: 'decidir', n: '15', t: 'Lo que decidimos', p: 4, d: `${(D.decisiones || []).length} decisiones para votar y mandar.` },
  { id: 'fuentes', n: '16', t: 'Fuentes', p: 4, d: `Las ${(D.fuentes || []).length} fuentes de cada dato.` },
];
const partes = ['La oportunidad', 'El negocio', 'El dinero', 'El contexto', 'Riesgos y decisiones'];
const sigDe = (id: string) => { const i = capitulos.findIndex((c) => c.id === id); return capitulos[i + 1] || null; };

// ── Datos del resumen ──
const paq = (nombre: string) => (D.paquetes || []).find((p: any) => p.nombre === nombre) || {};
const pVoz = paq('Voz (iguala)'), pVP = paq('Voz Pública (iguala)'), pEp = paq('Episodio listo'), pCamp = paq('Sprint de campaña'), pJor = paq('Jornada de contenido');
const escNom = (n: string) => escenarios.find((e: any) => e.nombre === n) || {};
const maxUtil = Math.max(1, ...escenarios.map((e: any) => e.utilidad_mes_mxn || 0));
const ordenR = (r: any) => ['alta', 'media', 'baja'].indexOf(r.probabilidad) * 3 + (2 - ['bajo', 'medio', 'alto'].indexOf(r.impacto));
const riesgosTop = [...(D.riesgos || [])].sort((a: any, b: any) => ordenR(a) - ordenR(b));
const tituloRiesgo = (t: string) => String(t).split(/[:.(]/)[0].trim();
const opRec = (D.opciones || []).find((o: any) => o.recomendada) || {};
const opsOrden = [...(D.opciones || [])].sort((a: any, b: any) => b.puntaje - a.puntaje);
const nivelRec = niveles[iRec] || {};
const hm: any = D.horas_miguel || { serie: [] };
const fijosMvp = (D.personas || []).filter((p: any) => /mvp/i.test(p.fase || '') && typeof p.costo_mes_mxn === 'number').reduce((s: number, p: any) => s + p.costo_mes_mxn, 0);
const horasEp = (m: number) => (m / 60).toLocaleString('es-MX', { maximumFractionDigits: 1 });
const ahorroIa = minManual ? Math.round((1 - minIa / minManual) * 100) : 0;

// Hitos en la línea de tiempo: meses desde nov-2026 (0) hasta jul-2028 (20), según el plazo de cada hito
const mesesEje = ['nov', 'dic', 'ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic', 'ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul'];
const anios = [{ t: '’26', a: 0, b: 1 }, { t: '2027', a: 2, b: 13 }, { t: '2028', a: 14, b: 20 }];
const gantt: Record<string, [number, number, boolean?]> = {
  H1: [0, 1], H2: [0, 3], H3: [2, 3], H4: [3, 3], H5: [4, 4], H6: [5, 7], H7: [8, 10], H8: [8, 20, true], H9: [12, 13], H10: [14, 20],
};
const marcaHito: Record<string, string> = { H4: 'libera el tramo 2', H8: 'libera el local' };
const gruposPaq = [
  { t: 'Igualas mensuales', d: 'El centro del negocio: ingreso que se repite cada mes.', n: ['Voz (iguala)', 'Voz Pública (iguala)', 'Comunidad y pauta (extra)'] },
  { t: 'Por proyecto', d: 'Para empezar con un cliente o llenar huecos de agenda.', n: ['Diagnóstico de voz', 'Episodio listo', 'Jornada de contenido', 'Informe de labores'] },
  { t: 'Campañas', d: 'Solo dentro de las fechas legales, cobrado por adelantado.', n: ['Sprint de precampaña', 'Sprint de campaña'] },
  { t: 'Cuando haya local y vitrina', d: 'Ingresos extra de la etapa 2 en adelante.', n: ['Renta de set en horas valle', 'Patrocinio de la vitrina'] },
];
const enGrupos = new Set(gruposPaq.flatMap((g) => g.n));
if ((D.paquetes || []).some((p: any) => !enGrupos.has(p.nombre))) throw new Error('Paquete sin grupo');

// ── "En corto" de cada capítulo (sale de los datos de abajo, sin cifras nuevas) ──
const enCorto: Record<string, { frase: string; puntos: string[] }> = {
  'por-que': {
    frase: 'El podcast ya es video, los clips son lo que trae alcance y Durango tiene elecciones casi sin pausa hasta 2028.',
    puntos: [
      'YouTube pasó de 1,000 millones de usuarios de podcast al mes; en México más de 27 millones escuchan podcasts en Spotify.',
      'El 89% de los oyentes ve clips en redes y la mitad de los podcasts no pasa de 6 episodios: la constancia es el problema que resolvemos.',
      '2027: 29 diputaciones en Durango. 2028: gubernatura y 39 ayuntamientos.',
    ],
  },
  casos: {
    frase: 'Los que ganan cobran igualas mensuales, no horas de estudio, y escalan con procesos, no con metros cuadrados.',
    puntos: [
      'Ashmedia: el cliente graba unas 3 horas al mes y la agencia hace todo lo demás.',
      'Authentic Exposure (Austin): un fundador, 4 igualas de US$5,000 o más al mes.',
      'Carpa (León): el mismo equipo que pensamos, a $2,999 por episodio con 3 clips.',
    ],
  },
  caminos: {
    frase: `Recomendamos el híbrido (${opRec.puntaje}/100): la agencia por iguala, con el menú de estudio y una vitrina propia quincenal.`,
    puntos: [
      `Puntajes: ${opsOrden.map((o: any) => `${o.corto} ${o.puntaje}`).join(' · ')}.`,
      'Gana en probabilidad de éxito y en escalabilidad.',
      'Pierde un poco frente a la agencia sola en tiempo de socios y en riesgo.',
    ],
  },
  propuesta: {
    frase: 'Vendemos la voz pública de personas ocupadas: el cliente graba unas 3 horas al mes y nosotros hacemos todo lo demás.',
    puntos: [
      `Voz: ${mxn(pVoz.precio_mxn)} al mes (profesionistas, universidades, regidores). Voz Pública: ${mxn(pVP.precio_mxn)} al mes, con narrativa y cumplimiento ante el INE.`,
      `Por proyecto: Episodio listo ${mxn(pEp.precio_mxn)}, Jornada de contenido ${mxn(pJor.precio_mxn)}, Sprint de campaña ${mxn(pCamp.precio_mxn)}.`,
      'Precios sin IVA, calibrados con tarifas reales de León, Querétaro, CDMX y Morelia; se validan en las entrevistas.',
    ],
  },
  mvp: {
    frase: 'Arrancamos con un kit portátil de 4 cámaras y sin local: el local llega cuando las horas vendidas lo pagan.',
    puntos: [
      `Nivel recomendado: ${mxn(nivelRec.total_mxn)} (3 Sony FX30, la A7 IV de Miguel, 4 micrófonos dinámicos, corte en vivo y luz).`,
      'Cambio al equipo pensado: la ZV-E10 II no tiene ventilador y se apaga por calor en sesiones largas; la FX30 sí aguanta.',
      'Local propio solo con 40 horas vendidas al mes durante 2 meses seguidos.',
    ],
  },
  opera: {
    frase: `La IA baja el trabajo humano por episodio de ${horasEp(minManual)} a ${horasEp(minIa)} horas (${ahorroIa}% menos), pero no reemplaza al editor.`,
    puntos: [
      'DaVinci Resolve 21.1 con Claude Code hace la sincronía, el multicámara, el audio y los subtítulos.',
      'Una persona elige los clips, sobre todo con políticos.',
      'El costo de IA es de pocos pesos por episodio: lo caro es la hora humana.',
    ],
  },
  personas: {
    frase: 'Una sola persona de planta; lo demás se paga por pieza o por hora.',
    puntos: [
      `En el arranque, unos ${mxn(fijosMvp)} al mes en personas fijas.`,
      `Miguel: de 7 a 9 horas por semana al principio y unas ${hm.meta} desde abril de 2027.`,
      'El socio inversionista: 1 a 2 horas por semana para decidir tramos, presupuesto y cierre.',
    ],
  },
  hitos: {
    frase: 'No se escala por fecha: cada inversión se libera solo cuando se cumple una prueba medible.',
    puntos: [
      'H1 · Validar sin gastar: 10 o más entrevistas antes del 15 de diciembre.',
      'H4 · Igualas que cubran los costos fijos ($57,600 al mes): libera el tramo 2.',
      'H8 · 40 horas vendidas al mes durante 2 meses: libera el local.',
    ],
  },
  numeros: {
    frase: `Con 3 o 4 igualas se cubre el mes; el escenario base deja ${mxn(escNom('Base').utilidad_mes_mxn)} de utilidad al mes.`,
    puntos: [
      'Punto de equilibrio: unos $75,000 de ingreso al mes, sin local.',
      `Lento: ${mxn(escNom('Lento').utilidad_mes_mxn)} al mes. Fuerte: ${mxn(escNom('Fuerte').utilidad_mes_mxn)} al mes.`,
      'Mueve el simulador para probar tu propia mezcla.',
    ],
  },
  dinero: {
    frase: `El socio pone hasta ${mxn(capital.maximo)} por tramos; en el escenario base la caja vuelve a positivo en el mes ${iCruce + 1}.`,
    puntos: [
      `Tramo 1: ${mxn(capital.tramos[0] && capital.tramos[0].mxn)} para validar y arrancar. Tramo 2: ${mxn(capital.tramos[1] && capital.tramos[1].mxn)}, solo con igualas firmadas.`,
      `Lo más bajo de la caja: ${mxn(serieCaja[iBajo] && serieCaja[iBajo].acumulado).replace('$-', '−$')} en ${serieCaja[iBajo] && serieCaja[iBajo].mes}.`,
      'Las reglas para cerrar se firman desde el principio: pérdida máxima estimada de $210,000 a $280,000.',
    ],
  },
  politica: {
    frase: 'La demanda política no para hasta 2028, pero tiene reglas que convertimos en parte del producto.',
    puntos: [
      'Registro en el Registro Nacional de Proveedores del INE para venderle a partidos y candidatos.',
      'Factura con complemento INE y lo cobrado en campaña cuenta como gasto de campaña.',
      'Cero cortesías: una empresa no puede aportar en especie. Mismo precio para todos los partidos.',
    ],
  },
  durango: {
    frase: 'Un mercado más chico y con menos ingreso que el promedio, pero plural y sin un estudio dedicado a la vista.',
    puntos: [
      'El ingreso de un hogar de Durango está 10.6% abajo del promedio nacional.',
      'Mercado plural: los municipios se reparten entre tres bloques y el cabildo de la capital tiene regidores de cinco partidos.',
      'Nichos en orden: funcionarios en funciones, aspirantes a 2028, candidatos de 2027 y profesionistas.',
    ],
  },
  escalar: {
    frase: 'Cada compra la paga la anterior: de kit portátil a casa de medios en seis etapas.',
    puntos: [
      'Etapa 2 · Estudio propio, con la caja del negocio (no antes de julio de 2027).',
      'Etapa 3 · Salir del estudio y servidor de equipo (2028).',
      'Etapas 4 y 5 · Productora comercial y casa de medios (2028 en adelante).',
    ],
  },
  riesgos: {
    frase: `Identificamos ${(D.riesgos || []).length} riesgos; el más serio es depender demasiado de Miguel.`,
    puntos: riesgosTop.slice(0, 3).map((r: any) => tituloRiesgo(r.riesgo) + '.'),
  },
  decidir: {
    frase: `${(D.decisiones || []).length} decisiones para tomar juntos: vota en cada una y mándale tus respuestas a Miguel.`,
    puntos: [
      'Qué camino tomamos y cuánto cobramos por Voz Pública.',
      'Cómo repartimos entre el capital y el trabajo, y qué figura legal usamos.',
      'Cuándo cerramos si no funciona.',
    ],
  },
};
// Recomendación: primera oración visible, el resto en "Por qué"
const corte = (t: string): [string, string] => {
  const s = String(t || '').trim();
  const primerP = s.split('\n')[0];
  // corta en el primer punto seguido de mayúscula (no en "S.A. de C.V.")
  const m = primerP.match(/^.{6,}?[.](?=\s+[A-ZÁÉÍÓÚÑ¿(]|$)/);
  const a = m ? m[0] : primerP;
  return [a, s.slice(a.length).trim()];
};
const nCap = (id: string) => (capitulos.find((c) => c.id === id) || { n: '' }).n;

// Al navegador solo va lo que usan las vistas interactivas (lo demás ya está en el HTML)
const { opciones, equipo_niveles, personas, paquetes, finanzas, riesgos, decisiones, horas_miguel } = D;
const datosCliente = JSON.stringify({ opciones, equipo_niveles, personas, paquetes, finanzas, riesgos, decisiones, horas_miguel }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#1A1A1A" />
  <title>Voz Durango · Proyecto ejecutivo</title>
  <meta name="description" content="Proyecto ejecutivo privado para socios: agencia de podcast por iguala con consultoría de narrativa y operación apalancada en IA, Durango." />
  <link rel="icon" href="/logo-a.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      var h = document.documentElement;
      h.classList.add('js');
      try {
        var m = localStorage.getItem('ep-mov');
        var reducido = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (m === '1' || (m !== '0' && !reducido)) h.classList.add('anim');
      } catch (e) {
        if (!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) h.classList.add('anim');
      }
    })();
  </script>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --c: #1A1A1A;
      --c2: #2A2A2A;
      --w: #FAFAFA;
      --ww: #FFFFFF;
      --g: #F3F3F1;
      --mid: #5F6670;
      --soft: #8A9099;
      --line: rgba(26,26,26,.12);
      --line-d: rgba(255,255,255,.12);
      --amber: #C8963E;
      --amber-t: #8A6420;   /* ámbar para texto sobre claro (contraste AA) */
      --s-manual: #3F6FAA;  /* serie "sin IA" (validada) */
      --s-ia: #B8822A;      /* serie "con IA" (validada) */
      --ease: cubic-bezier(0.16,1,0.3,1);
      --r: 14px;
    }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; scroll-padding-top: 72px; }
    body {
      background: var(--ww); color: var(--c);
      font-family: 'Inter', system-ui, sans-serif; font-size: 16px; line-height: 1.55;
      -webkit-font-smoothing: antialiased; overflow-x: hidden;
    }
    a { color: inherit; }
    button { font: inherit; color: inherit; }
    ::selection { background: var(--c); color: #fff; }
    :focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 6px; }
    .si { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; letter-spacing: -.005em; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
    @media (min-width: 720px) { .wrap { padding: 0 32px; } }

    /* ── Barra superior ───────────────────────── */
    .top {
      position: fixed; inset: 0 0 auto 0; z-index: 50; height: 56px;
      display: flex; align-items: center; color: #fff;
      background: rgba(26,26,26,.88); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line-d);
    }
    .top .wrap { display: flex; align-items: center; gap: 12px; width: 100%; }
    .top-logo { display: flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 900; letter-spacing: -.03em; font-size: 1.15rem; }
    .top-logo img { width: 22px; height: 22px; }
    .top-cap { flex: 1; min-width: 0; font-size: .78rem; color: rgba(255,255,255,.6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .top-cap b { color: #fff; font-weight: 600; }
    .top-btn {
      border: 1px solid rgba(255,255,255,.28); background: transparent; border-radius: 999px;
      padding: 7px 14px; font-size: .8rem; font-weight: 700; cursor: pointer; color: #fff; white-space: nowrap;
    }
    .top-btn:hover { border-color: #fff; }
    .top-prog { position: absolute; left: 0; bottom: -1px; height: 2px; background: var(--amber); width: 0; }

    .indice {
      position: fixed; inset: 56px 0 auto auto; z-index: 49; width: min(360px, 100%);
      max-height: calc(100svh - 56px); overflow: auto; background: var(--c); color: #fff;
      border-left: 1px solid var(--line-d); border-bottom: 1px solid var(--line-d);
      padding: 8px 0 16px; display: none;
    }
    .indice.abierto { display: block; }
    .indice a { display: flex; gap: 14px; padding: 11px 20px; text-decoration: none; font-weight: 600; font-size: .95rem; }
    .indice a span { color: rgba(255,255,255,.4); font-variant-numeric: tabular-nums; width: 22px; }
    .indice a:hover, .indice a.actual { background: rgba(255,255,255,.06); }
    .indice a.actual span { color: var(--amber); }
    .indice .mov { margin: 10px 20px 0; padding-top: 14px; border-top: 1px solid var(--line-d); display: flex; justify-content: space-between; align-items: center; font-size: .82rem; color: rgba(255,255,255,.65); }

    /* ── Portada ──────────────────────────────── */
    .portada { background: var(--c); color: #fff; padding: 112px 0 56px; position: relative; overflow: hidden; }
    .eyebrow { font-size: .72rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: rgba(255,255,255,.5); display: flex; align-items: center; gap: 10px; }
    .eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; opacity: .6; }
    .eyebrow.osc { color: var(--mid); }
    .portada h1 { font-size: clamp(2.2rem, 6.6vw, 4.9rem); font-weight: 900; line-height: 1.0; letter-spacing: -.035em; margin: 22px 0 18px; max-width: 17ch; }
    .portada .aviso { margin-top: 18px; font-size: .85rem; color: rgba(255,255,255,.5); max-width: 66ch; border-left: 2px solid var(--amber); padding-left: 12px; }
    .portada h1 .si { color: var(--amber); }
    .portada .sub { font-size: clamp(1.05rem, 2.2vw, 1.3rem); color: rgba(255,255,255,.72); max-width: 54ch; }
    .portada .tesis { margin-top: 20px; font-size: 1rem; color: rgba(255,255,255,.6); max-width: 60ch; }
    .acciones { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 999px; font-weight: 700; font-size: .92rem; text-decoration: none; cursor: pointer; border: 1.5px solid transparent; transition: transform .2s var(--ease); }
    .btn:active { transform: scale(.97); }
    .btn-claro { background: #fff; color: var(--c); }
    .btn-linea { border-color: rgba(255,255,255,.35); color: #fff; background: transparent; }
    .btn-osc { background: var(--c); color: #fff; }
    .btn-linea-osc { border-color: var(--line); background: #fff; color: var(--c); }

    .onda { display: flex; align-items: flex-end; gap: 3px; height: 64px; margin-top: 44px; opacity: .9; }
    .onda i { flex: 1; max-width: 6px; background: rgba(255,255,255,.22); border-radius: 3px; height: var(--h); transform-origin: bottom; }
    .onda i.a { background: var(--amber); }
    html.anim .onda i { animation: onda 2.6s var(--ease) infinite alternate; animation-delay: var(--dl); }
    @keyframes onda { from { transform: scaleY(.35); } to { transform: scaleY(1); } }

    .resumen { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line-d); border: 1px solid var(--line-d); border-radius: var(--r); overflow: hidden; margin-top: 36px; }
    @media (min-width: 820px) { .resumen { grid-template-columns: repeat(4, 1fr); } }
    .resumen div { background: var(--c); padding: 18px 16px; }
    .resumen b { display: block; font-size: clamp(1.35rem, 3.4vw, 2rem); font-weight: 900; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    .resumen span { font-size: .8rem; color: rgba(255,255,255,.55); }

    /* ── Secciones ───────────────────────────── */
    .sec { padding: 72px 0; border-top: 1px solid var(--line); }
    @media (min-width: 820px) { .sec { padding: 104px 0; } }
    .sec.osc { background: var(--c); color: #fff; border-top-color: var(--line-d); }
    .sec.gris { background: var(--g); }
    .cap-n { font-size: .78rem; font-weight: 800; letter-spacing: .14em; color: var(--amber-t); text-transform: uppercase; }
    .osc .cap-n { color: var(--amber); }
    .sec h2 { font-size: clamp(1.9rem, 5vw, 3.4rem); font-weight: 900; line-height: 1.04; letter-spacing: -.03em; margin: 12px 0 14px; max-width: 20ch; }
    .sec h2 .si { font-size: 1.06em; }
    .lead { font-size: 1.08rem; color: var(--mid); max-width: 62ch; }
    .osc .lead { color: rgba(255,255,255,.68); }
    .sec h3 { font-size: 1.15rem; font-weight: 800; letter-spacing: -.01em; margin-bottom: 8px; }
    .bloque { margin-top: 40px; }
    .nota { font-size: .82rem; color: var(--soft); }
    .osc .nota { color: rgba(255,255,255,.5); }
    .fuente { font-size: .75rem; color: var(--soft); text-decoration: none; border-bottom: 1px solid var(--line); }
    .fuente:hover { color: var(--c); }
    .osc .fuente { color: rgba(255,255,255,.5); border-color: var(--line-d); }
    .osc .fuente:hover { color: #fff; }

    .rejilla { display: grid; gap: 12px; grid-template-columns: 1fr; }
    @media (min-width: 640px) { .rejilla.r2 { grid-template-columns: repeat(2, 1fr); } .rejilla.r3 { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 960px) { .rejilla.r3 { grid-template-columns: repeat(3, 1fr); } .rejilla.r4 { grid-template-columns: repeat(4, 1fr); } }
    @media (min-width: 640px) and (max-width: 959px) { .rejilla.r4 { grid-template-columns: repeat(2, 1fr); } }
    .tarjeta { background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 20px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .gris .tarjeta { background: #fff; }
    .osc .tarjeta { background: var(--c2); border-color: var(--line-d); }
    .tarjeta p { font-size: .95rem; }
    .tarjeta .pie { margin-top: auto; padding-top: 6px; }

    .cifra { font-size: clamp(1.9rem, 5vw, 2.6rem); font-weight: 900; letter-spacing: -.035em; line-height: 1; font-variant-numeric: tabular-nums; }
    .osc .cifra { color: #fff; }
    .cifra-chica { font-size: 1.5rem; }

    .lista { list-style: none; display: grid; gap: 10px; }
    .lista li { position: relative; padding-left: 20px; font-size: .97rem; }
    .lista li::before { content: ''; position: absolute; left: 2px; top: .62em; width: 7px; height: 7px; border-radius: 50%; background: var(--c); }
    .osc .lista li::before { background: var(--amber); }
    .lista.mas li::before { background: var(--s-manual); }
    .lista.menos li::before { background: transparent; border: 1.5px solid var(--c); }

    /* Controles segmentados y chips */
    .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; padding: 4px; border-radius: 24px; background: var(--g); border: 1px solid var(--line); max-width: 100%; }
    .osc .seg { background: rgba(255,255,255,.06); border-color: var(--line-d); }
    .seg button { border: 0; background: transparent; padding: 9px 16px; border-radius: 999px; font-weight: 700; font-size: .88rem; cursor: pointer; color: var(--mid); min-height: 40px; }
    .osc .seg button { color: rgba(255,255,255,.65); }
    .seg button[aria-pressed="true"] { background: var(--c); color: #fff; }
    .osc .seg button[aria-pressed="true"] { background: #fff; color: var(--c); }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 8px 14px; font-size: .85rem; font-weight: 600; cursor: pointer; min-height: 40px; }
    .chip[aria-pressed="true"] { background: var(--c); color: #fff; border-color: var(--c); }
    .etq { display: inline-block; font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--mid); width: fit-content; }
    .etq.oro { background: var(--amber); border-color: var(--amber); color: var(--c); }
    .osc .etq { border-color: var(--line-d); color: rgba(255,255,255,.7); }
    .osc .etq.oro { color: var(--c); }

    /* Pros y contras */
    .balanza { display: grid; gap: 12px; }
    @media (min-width: 760px) { .balanza { grid-template-columns: 1fr 1fr; } }

    /* Caminos */
    .camino { margin-top: 22px; display: grid; gap: 16px; }
    @media (min-width: 900px) { .camino { grid-template-columns: 1.1fr .9fr; } }
    .barras { display: grid; gap: 12px; }
    .barra { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; font-size: .88rem; }
    .barra .pista { grid-column: 1 / -1; height: 8px; border-radius: 4px; background: rgba(255,255,255,.1); overflow: hidden; }
    .barra .pista i { display: block; height: 100%; border-radius: 4px; background: var(--amber); width: var(--v); transition: width .6s var(--ease); }
    .barra b { font-variant-numeric: tabular-nums; }

    /* Paquetes */
    .precio { font-size: 1.9rem; font-weight: 900; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    .precio small { font-size: .85rem; font-weight: 600; color: var(--mid); letter-spacing: 0; }
    .mini { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: .8rem; color: var(--mid); border-top: 1px solid var(--line); padding-top: 10px; margin-top: 4px; }

    /* Equipo */
    .equipo-cab { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px; margin-top: 24px; }
    .total-grande { text-align: right; }
    .total-grande b { display: block; font-size: clamp(2rem, 6vw, 3rem); font-weight: 900; letter-spacing: -.035em; font-variant-numeric: tabular-nums; }
    .tabla { width: 100%; border-collapse: collapse; font-size: .92rem; }
    .tabla th { text-align: left; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--soft); font-weight: 700; padding: 10px 8px; border-bottom: 1px solid var(--line); }
    .tabla td { padding: 12px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
    .tabla td.num, .tabla th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .tabla .cat td { font-weight: 800; background: var(--g); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }
    .tabla small { display: block; color: var(--mid); font-size: .82rem; margin-top: 2px; }
    .desliza { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    @media (max-width: 640px) {
      .tabla.apila thead { display: none; }
      .tabla.apila tr { display: grid; grid-template-columns: 1fr auto; border-bottom: 1px solid var(--line); padding: 10px 0; }
      .tabla.apila td { border: 0; padding: 2px 0; }
      .tabla.apila td.ocultar { display: none; }
      .tabla.apila .cat { display: block; padding: 0; border: 0; }
      .tabla.apila .cat td { display: block; padding: 8px 10px; }
    }

    /* Flujo */
    .leyenda { display: flex; flex-wrap: wrap; gap: 16px; font-size: .85rem; color: var(--mid); margin: 18px 0 8px; }
    .leyenda span { display: inline-flex; align-items: center; gap: 8px; }
    .leyenda i { width: 14px; height: 8px; border-radius: 4px; display: inline-block; }
    .flujo { display: grid; gap: 4px; margin-top: 8px; }
    .paso { border: 1px solid var(--line); border-radius: 12px; background: #fff; }
    .paso summary { list-style: none; cursor: pointer; padding: 14px 16px; display: grid; grid-template-columns: 28px 1fr auto; gap: 4px 12px; align-items: center; }
    .paso summary::-webkit-details-marker { display: none; }
    .paso .num { font-size: .78rem; font-weight: 800; color: var(--soft); font-variant-numeric: tabular-nums; }
    .paso .nom { font-weight: 700; font-size: .97rem; }
    .paso .min { font-size: .82rem; color: var(--mid); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .paso .barras2 { grid-column: 2 / -1; display: grid; gap: 3px; }
    .paso .barras2 i { display: block; height: 6px; border-radius: 3px; min-width: 3px; transition: width .7s var(--ease); }
    .paso .cuerpo { padding: 0 16px 16px 56px; font-size: .92rem; color: var(--mid); display: grid; gap: 6px; }
    @media (max-width: 560px) { .paso .cuerpo { padding-left: 16px; } }
    .auto { font-size: .66rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; padding: 3px 7px; border-radius: 999px; border: 1px solid var(--line); }
    .auto.total { background: var(--c); color: #fff; border-color: var(--c); }
    .auto.parcial { border-color: var(--c); }
    .ahorro { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; margin-top: 18px; }
    @media (min-width: 760px) { .ahorro { grid-template-columns: repeat(3, 1fr); } }

    /* Personas */
    .personas { margin-top: 20px; }
    .rol .ded { font-size: .82rem; font-weight: 700; color: var(--amber-t); }
    .rol.nuevo { border-color: var(--c); }

    /* Hitos */
    .hitos { margin-top: 28px; position: relative; display: grid; gap: 10px; }
    .hito { border: 1px solid var(--line); border-radius: 12px; background: #fff; }
    .hito summary { list-style: none; cursor: pointer; padding: 16px; display: grid; grid-template-columns: auto 1fr auto; gap: 4px 14px; align-items: center; }
    .hito summary::-webkit-details-marker { display: none; }
    .hito .hid { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-weight: 900; font-size: .8rem; background: var(--c); color: #fff; }
    .hito .hn { font-weight: 800; }
    .hito .hp { font-size: .8rem; color: var(--mid); }
    .hito .mas { font-size: 1.3rem; color: var(--soft); transition: transform .3s var(--ease); }
    .hito[open] .mas { transform: rotate(45deg); }
    .hito .cuerpo { padding: 0 16px 18px; display: grid; gap: 12px; font-size: .94rem; }
    @media (min-width: 640px) { .hito .cuerpo { padding-left: 68px; } }
    .criterio { border-left: 3px solid var(--amber); padding: 6px 0 6px 12px; }
    .criterio b { display: block; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--amber-t); }

    /* Simulador */
    .sim { display: grid; gap: 16px; margin-top: 26px; }
    @media (min-width: 960px) { .sim { grid-template-columns: 1.15fr .85fr; align-items: start; } }
    .sim-lado { position: sticky; top: 72px; }
    .paquete-sim { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line-d); }
    .paquete-sim .n { font-weight: 700; }
    .paquete-sim small { color: rgba(255,255,255,.55); font-size: .8rem; }
    .paso-n { display: inline-flex; align-items: center; border: 1px solid var(--line-d); border-radius: 999px; }
    .paso-n button { width: 44px; height: 44px; border: 0; background: transparent; font-size: 1.2rem; font-weight: 700; cursor: pointer; color: #fff; }
    .paso-n output { min-width: 28px; text-align: center; font-weight: 800; font-variant-numeric: tabular-nums; }
    .res { display: grid; gap: 1px; background: var(--line-d); border-radius: var(--r); overflow: hidden; border: 1px solid var(--line-d); }
    .res div { background: var(--c2); padding: 16px 18px; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
    .res span { font-size: .88rem; color: rgba(255,255,255,.65); }
    .res b { font-size: 1.25rem; font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .res .grande b { font-size: 2rem; letter-spacing: -.03em; }
    .res .grande.pos b { color: var(--amber); }
    .capacidad { height: 8px; background: rgba(255,255,255,.1); border-radius: 4px; overflow: hidden; margin-top: 8px; }
    .capacidad i { display: block; height: 100%; background: #fff; width: 0; transition: width .5s var(--ease); border-radius: 4px; }
    .capacidad.lleno i { background: var(--amber); }

    /* Calendario político */
    .linea { display: grid; gap: 0; margin-top: 20px; border-left: 2px solid var(--line-d); padding-left: 18px; }
    .linea .ev { position: relative; padding: 0 0 22px; }
    .linea .ev::before { content: ''; position: absolute; left: -25px; top: 5px; width: 12px; height: 12px; border-radius: 50%; background: var(--c); border: 2px solid var(--amber); }
    .linea .fecha { font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--amber); }
    .linea .que { font-weight: 700; }
    .linea .sig { font-size: .9rem; color: rgba(255,255,255,.6); }

    /* Escalera */
    .escalera { display: grid; gap: 10px; margin-top: 26px; }
    .peldano { display: grid; grid-template-columns: 48px 1fr; gap: 14px; background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 18px; }
    @media (min-width: 900px) { .peldano { margin-left: calc(var(--i) * 44px); } }
    .peldano .pn { width: 48px; height: 48px; border-radius: 12px; background: var(--c); color: #fff; display: grid; place-items: center; font-weight: 900; }
    .peldano .disp { font-size: .85rem; border-top: 1px dashed var(--line); padding-top: 8px; margin-top: 6px; }
    .peldano .disp b { color: var(--amber-t); }

    /* Matriz de riesgos */
    .matriz-wrap { display: grid; gap: 20px; margin-top: 24px; }
    @media (min-width: 900px) { .matriz-wrap { grid-template-columns: 380px 1fr; align-items: start; } }
    .matriz { display: grid; grid-template-columns: 70px repeat(3, 1fr); gap: 4px; font-size: .75rem; }
    .matriz .eje { display: grid; place-items: center; color: var(--mid); font-weight: 700; text-align: center; }
    .celda { aspect-ratio: 1; border-radius: 10px; border: 1px solid var(--line); background: #fff; cursor: pointer; display: grid; place-items: center; font-weight: 900; font-size: 1.3rem; }
    .celda[data-n="0"] { color: var(--line); cursor: default; }
    .celda.w1 { background: #F3E7D0; }
    .celda.w2 { background: #E5C68D; }
    .celda.w3 { background: var(--amber); }
    .celda[aria-pressed="true"] { outline: 3px solid var(--c); outline-offset: 1px; }
    .riesgo { border-bottom: 1px solid var(--line); padding: 14px 0; display: grid; gap: 4px; }
    .riesgo .rt { font-weight: 700; }
    .riesgo .rm { font-size: .92rem; color: var(--mid); }
    .riesgo .rm b { color: var(--c); }

    /* Decisiones */
    .decision { background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 20px; display: grid; gap: 12px; }
    .decision .rec { font-size: .86rem; color: var(--mid); }
    .decision .rec b { color: var(--amber-t); }
    .barra-dec { position: sticky; bottom: 12px; margin-top: 18px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; background: var(--c); color: #fff; border-radius: 999px; padding: 8px 8px 8px 18px; z-index: 5; }
    .barra-dec span { font-size: .85rem; }

    /* Fuentes */
    .fuentes { columns: 1; column-gap: 32px; font-size: .86rem; margin-top: 20px; }
    @media (min-width: 760px) { .fuentes { columns: 2; } }
    .fuentes li { break-inside: avoid; margin: 0 0 8px 18px; }
    .fuentes a { text-decoration: none; border-bottom: 1px solid var(--line); }
    .fuentes a:hover { border-color: var(--c); }
    .fuentes small { color: var(--soft); }

    .pie-pag { background: var(--c); color: rgba(255,255,255,.6); padding: 48px 0; font-size: .85rem; }
    .pie-pag b { color: #fff; }

    /* Movimiento (solo con html.anim; sin JS todo se ve) */
    html.js.anim .rv { opacity: 0; transform: translateY(18px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
    html.js.anim .rv.ok { opacity: 1; transform: none; }
    html:not(.anim) * { transition-duration: 0s !important; animation: none !important; }
    /* ── Lectura: cuerpo más grande, gris con más contraste ── */
    body { font-size: 17px; line-height: 1.65; }
    :root { --soft: #6E757E; }
    .lead { font-size: 1.14rem; line-height: 1.6; }
    .tarjeta p, .lista li { font-size: 1rem; line-height: 1.6; }
    .nota { font-size: .86rem; line-height: 1.55; }
    .sec h3 { font-size: 1.22rem; }

    /* En corto */
    .encorto { margin: 22px 0 26px; padding: 20px 22px; background: var(--g); border-left: 4px solid var(--amber); border-radius: 0 var(--r) var(--r) 0; max-width: 820px; }
    .gris .encorto { background: #fff; }
    .osc .encorto { background: rgba(255,255,255,.06); }
    .encorto-t { font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--amber-t); }
    .osc .encorto-t { color: var(--amber); }
    .encorto-f { font-size: clamp(1.15rem, 2.4vw, 1.35rem); font-weight: 700; line-height: 1.4; letter-spacing: -.01em; margin: 6px 0 12px; }
    .encorto-p { list-style: none; counter-reset: ec; display: grid; gap: 8px; }
    .encorto-p li { counter-increment: ec; position: relative; padding-left: 34px; font-size: 1rem; line-height: 1.55; }
    .encorto-p li::before { content: counter(ec); position: absolute; left: 0; top: 1px; width: 22px; height: 22px; border-radius: 50%; background: var(--c); color: #fff; font-size: .75rem; font-weight: 800; display: grid; place-items: center; }
    .osc .encorto-p li::before { background: var(--amber); color: var(--c); }

    /* Navegación entre capítulos */
    .capnav { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); }
    .osc .capnav { border-color: var(--line-d); }
    .capnav a { text-decoration: none; }
    .capnav-ind { font-size: .88rem; font-weight: 700; color: var(--mid); }
    .osc .capnav-ind { color: rgba(255,255,255,.65); }
    .capnav-sig { display: grid; text-align: right; padding: 12px 18px; border: 1px solid var(--line); border-radius: var(--r); background: #fff; margin-left: auto; }
    .osc .capnav-sig { background: var(--c2); border-color: var(--line-d); }
    .capnav-sig span { font-size: .75rem; color: var(--soft); text-transform: uppercase; letter-spacing: .1em; font-weight: 700; }
    .capnav-sig b { font-size: 1rem; }
    .capnav-sig:hover { border-color: var(--c); }

    /* Introducción */
    .intro-grid { display: grid; gap: 28px; margin-top: 26px; }
    @media (min-width: 900px) { .intro-grid { grid-template-columns: 1.3fr 1fr; gap: 48px; } }
    .intro .texto { display: grid; gap: 16px; font-size: 1.1rem; line-height: 1.7; max-width: 62ch; }
    .aviso-claro { font-size: .95rem; color: var(--mid); border-left: 3px solid var(--amber); padding-left: 14px; }
    .como-leer { background: var(--c); color: #fff; border-radius: var(--r); padding: 24px; align-self: start; }
    .como-leer h3 { color: #fff; }
    .como-leer ol { list-style: none; counter-reset: cl; display: grid; gap: 10px; margin: 14px 0; }
    .como-leer li { counter-increment: cl; }
    .como-leer a { display: grid; grid-template-columns: 34px 1fr; gap: 2px 12px; text-decoration: none; padding: 12px; border-radius: 12px; background: rgba(255,255,255,.06); }
    .como-leer a:hover { background: rgba(255,255,255,.12); }
    .como-leer a::before { content: counter(cl); grid-row: span 2; width: 34px; height: 34px; border-radius: 50%; background: var(--amber); color: var(--c); font-weight: 900; display: grid; place-items: center; }
    .como-leer a span { font-size: .9rem; color: rgba(255,255,255,.65); }
    .como-leer .nota { color: rgba(255,255,255,.6); }

    /* Resumen ejecutivo */
    .rbloque { margin-top: 22px; background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 22px; }
    @media (min-width: 820px) { .rbloque { padding: 28px 32px; } }
    .rcab { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .rcab h3 { margin: 0; }
    .rn { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--amber); color: var(--c); font-weight: 900; font-size: .85rem; display: grid; place-items: center; }
    .rfrase { font-size: clamp(1.15rem, 2.6vw, 1.45rem); line-height: 1.45; max-width: 46ch; letter-spacing: -.01em; }
    .rnota { margin-top: 14px; font-size: .92rem; color: var(--mid); }
    .rnota a { color: var(--c); font-weight: 700; text-decoration: none; border-bottom: 1.5px solid var(--amber); }
    .modelo { display: grid; gap: 10px; margin-top: 20px; align-items: stretch; }
    @media (min-width: 900px) { .modelo { grid-template-columns: 1fr auto 1.6fr auto 1fr; } }
    .mpaso { border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: grid; gap: 4px; align-content: start; }
    .mpaso b { font-size: 1.05rem; line-height: 1.35; }
    .mnos { background: var(--c); color: #fff; border-color: var(--c); }
    .mt { font-size: .7rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--amber-t); }
    .mnos .mt { color: var(--amber); }
    .ms { font-size: .88rem; color: var(--mid); }
    .mchips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
    .mchips span { font-size: .82rem; font-weight: 600; padding: 5px 10px; border-radius: 999px; background: rgba(255,255,255,.1); }
    .mchips span:last-child { background: var(--amber); color: var(--c); }
    .mflecha { display: grid; place-items: center; font-size: 1.4rem; color: var(--amber-t); transform: rotate(90deg); }
    @media (min-width: 900px) { .mflecha { transform: none; } }
    .rstats, .rgente { display: grid; gap: 1px; grid-template-columns: 1fr 1fr; background: var(--line); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
    @media (min-width: 820px) { .rstats, .rgente { grid-template-columns: repeat(4, 1fr); } }
    .rstats div, .rgente div { background: #fff; padding: 16px; display: grid; gap: 4px; align-content: start; }
    .rstats b, .rgente b { font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 900; letter-spacing: -.035em; line-height: 1; font-variant-numeric: tabular-nums; }
    .rstats span, .rgente span { font-size: .9rem; color: var(--mid); line-height: 1.45; }
    .rprecios { display: grid; gap: 10px; grid-template-columns: 1fr 1fr; }
    @media (min-width: 820px) { .rprecios { grid-template-columns: repeat(4, 1fr); } }
    .rprecios div { border: 1px solid var(--line); border-radius: 12px; padding: 16px; display: grid; gap: 2px; }
    .rprecios div:nth-child(2) { background: var(--c); color: #fff; border-color: var(--c); }
    .rpn { font-weight: 700; font-size: .95rem; }
    .rprecios b { font-size: clamp(1.4rem, 3.6vw, 1.9rem); font-weight: 900; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    .rpu { font-size: .82rem; color: var(--mid); }
    .rprecios div:nth-child(2) .rpu { color: rgba(255,255,255,.6); }
    .rdinero { display: grid; gap: 22px; }
    @media (min-width: 820px) { .rdinero { grid-template-columns: 1fr 1fr; align-items: center; } }
    .rbarra { display: flex; gap: 3px; height: 18px; margin-bottom: 14px; }
    .rbarra i { display: block; border-radius: 5px; background: var(--amber); }
    .rbarra i + i { background: var(--c); }
    .rtramo { display: grid; grid-template-columns: auto 1fr; gap: 0 12px; align-items: baseline; padding: 8px 0; border-bottom: 1px solid var(--line); }
    .rtramo b { font-size: 1.5rem; font-weight: 900; letter-spacing: -.03em; font-variant-numeric: tabular-nums; border-left: 4px solid var(--amber); padding-left: 10px; }
    .rtramo.dos b { border-color: var(--c); }
    .rtramo span { font-size: .92rem; color: var(--mid); }
    .rcurva { color: var(--c); }
    .rcurva svg { width: 100%; height: auto; display: block; }
    .rcurva-lee { display: grid; gap: 6px; margin-top: 10px; font-size: .92rem; color: var(--mid); }
    .rcurva-lee b { color: var(--c); font-size: 1.05rem; margin-right: 4px; }
    .rescs { display: grid; gap: 12px; }
    .resc { display: grid; grid-template-columns: 70px 1fr auto; gap: 12px; align-items: center; }
    .ren { font-weight: 700; }
    .rep { height: 22px; background: var(--g); border-radius: 0 6px 6px 0; overflow: hidden; }
    .rep i { display: block; height: 100%; background: var(--c); border-radius: 0 5px 5px 0; }
    .resc:nth-child(2) .rep i { background: var(--amber); }
    .resc b { font-variant-numeric: tabular-nums; font-size: 1.05rem; min-width: 84px; text-align: right; }
    .rpasos { list-style: none; display: grid; gap: 0; position: relative; }
    @media (min-width: 900px) { .rpasos { grid-template-columns: repeat(5, 1fr); gap: 12px; } }
    .rpasos li { display: grid; gap: 2px; padding: 12px 0 12px 22px; border-left: 2px solid var(--line); position: relative; }
    .rpasos li::before { content: ''; position: absolute; left: -7px; top: 17px; width: 12px; height: 12px; border-radius: 50%; background: var(--amber); }
    @media (min-width: 900px) {
      .rpasos li { border-left: 0; border-top: 2px solid var(--line); padding: 18px 0 0; }
      .rpasos li::before { left: 0; top: -7px; }
    }
    .rpf { font-size: .74rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--amber-t); }
    .rpasos b { font-size: 1rem; }
    .rpasos span:last-child { font-size: .9rem; color: var(--mid); }
    .rdos { display: grid; gap: 26px; }
    @media (min-width: 820px) { .rdos { grid-template-columns: 1fr 1fr; } }
    .rlista { list-style: none; display: grid; gap: 8px; }
    .rlista li { padding: 10px 12px; border-radius: 10px; background: var(--g); font-weight: 600; font-size: .97rem; line-height: 1.45; }

    /* Índice */
    .partes { display: grid; gap: 28px; margin-top: 28px; }
    .parte-t { display: flex; align-items: baseline; gap: 12px; font-size: 1.15rem; font-weight: 800; margin-bottom: 10px; }
    .parte-t span { font-size: .72rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; color: var(--amber-t); }
    .parte-caps { display: grid; gap: 8px; }
    @media (min-width: 760px) { .parte-caps { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1040px) { .parte-caps { grid-template-columns: repeat(3, 1fr); } }
    .cap-card { display: grid; grid-template-columns: 44px 1fr auto; gap: 12px; align-items: center; padding: 16px; border: 1px solid var(--line); border-radius: var(--r); text-decoration: none; background: #fff; transition: border-color .2s; }
    .cap-card:hover { border-color: var(--c); }
    .cap-card .cn { font-size: 1.5rem; font-weight: 900; letter-spacing: -.04em; color: var(--amber-t); font-variant-numeric: tabular-nums; }
    .cap-card .ct { display: grid; gap: 2px; }
    .cap-card .ct b { font-size: 1.02rem; }
    .cap-card .ct span { font-size: .88rem; color: var(--mid); line-height: 1.45; }
    .cap-card .cf { color: var(--soft); }

    /* Caminos: comparación */
    .comp { display: grid; gap: 12px; max-width: 760px; }
    .comp-f { display: grid; grid-template-columns: 1fr 36px; gap: 4px 12px; align-items: center; }
    .comp-f .comp-n { grid-column: 1 / -1; }
    @media (min-width: 640px) { .comp-f { grid-template-columns: 210px 1fr 36px; } .comp-f .comp-n { grid-column: auto; } }
    .comp-n { font-weight: 700; font-size: .95rem; }
    .comp-p { height: 14px; background: rgba(255,255,255,.1); border-radius: 0 7px 7px 0; overflow: hidden; }
    .comp-p i { display: block; height: 100%; background: rgba(255,255,255,.75); border-radius: 0 6px 6px 0; }
    .comp-f.rec .comp-p i { background: var(--amber); }
    .comp-f b { font-variant-numeric: tabular-nums; text-align: right; font-size: 1.1rem; }
    .comp .nota { margin-top: 4px; }

    /* Paquetes por grupo */
    .grupo-paq { margin-top: 30px; }
    .grupo-t { display: grid; gap: 2px; border-left: 4px solid var(--amber); padding-left: 12px; }
    .grupo-t b { font-size: 1.15rem; }
    .grupo-t span { color: var(--mid); font-size: .95rem; }

    /* Línea de tiempo de hitos */
    .gantt { border: 1px solid var(--line); border-radius: var(--r); padding: 12px 16px 16px; background: #fff; }
    .g-fila { display: grid; gap: 6px; padding: 10px 0; border-bottom: 1px solid var(--line); text-decoration: none; align-items: center; }
    .g-fila:last-of-type { border-bottom: 0; }
    a.g-fila:hover .g-lab b { color: var(--amber-t); }
    @media (min-width: 760px) { .g-fila { grid-template-columns: 260px 1fr; gap: 16px; } }
    .g-lab { font-size: .92rem; line-height: 1.35; }
    .g-lab b { display: inline-block; min-width: 30px; }
    .g-lab em { font-style: normal; color: var(--amber-t); font-weight: 700; }
    .g-eje .g-lab { display: none; }
    @media (min-width: 760px) { .g-eje .g-lab { display: block; } }
    .g-pista { display: grid; grid-template-columns: repeat(21, 1fr); align-items: center; min-height: 16px; background: repeating-linear-gradient(90deg, transparent 0 calc(100% / 21 - 1px), var(--line) calc(100% / 21 - 1px) calc(100% / 21)); }
    .g-eje .g-pista { background: none; row-gap: 2px; }
    .g-anio { grid-row: 1; font-size: .72rem; font-weight: 800; color: var(--c); border-left: 2px solid var(--c); padding-left: 4px; }
    .g-mes { grid-row: 2; font-size: .64rem; color: var(--soft); text-align: center; text-transform: uppercase; }
    .g-barra { grid-row: 1; height: 12px; border-radius: 6px; background: var(--c); }
    .g-barra.clave { background: var(--amber); }
    .g-barra.punto { width: 12px; height: 12px; justify-self: center; border-radius: 2px; transform: rotate(45deg); }
    .g-barra.abierta { background: repeating-linear-gradient(90deg, var(--amber) 0 8px, transparent 8px 12px); }

    .pl { white-space: pre-line; }
    @media (max-width: 639px) {
      .carr { display: flex !important; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin-left: -16px; margin-right: -16px; padding: 2px 16px 10px; scrollbar-width: none; }
      .carr::-webkit-scrollbar { display: none; }
      .carr > * { flex: 0 0 86%; scroll-snap-align: center; }
    }
    .desliza-hint { display: none; font-size: .8rem; color: var(--soft); margin-top: 6px; }
    @media (max-width: 639px) { .desliza-hint { display: block; } }
    .ver-mas { border: 0; background: none; font-weight: 700; font-size: .88rem; cursor: pointer; padding: 8px 0 2px; text-decoration: underline; text-underline-offset: 3px; width: fit-content; min-height: 40px; }
    .osc .ver-mas { color: #fff; }

    /* ── Dinero del socio ── */
    .tramos { display: grid; gap: 12px; margin-top: 24px; }
    @media (min-width: 820px) { .tramos { grid-template-columns: 1fr 1fr 1fr; } }
    .tramo .grande { font-size: clamp(2rem, 6vw, 2.8rem); font-weight: 900; letter-spacing: -.035em; font-variant-numeric: tabular-nums; line-height: 1; }
    .tramo .disp { font-size: .86rem; color: var(--mid); border-top: 1px dashed var(--line); padding-top: 10px; }
    .tramo table { width: 100%; border-collapse: collapse; font-size: .86rem; }
    .tramo td { padding: 5px 0; border-bottom: 1px solid var(--line); }
    .tramo td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; padding-left: 10px; }
    .proporcion { display: flex; gap: 2px; height: 14px; margin-top: 18px; }
    .proporcion i { display: block; height: 100%; }
    .proporcion i:first-child { border-radius: 4px 0 0 4px; }
    .proporcion i:last-child { border-radius: 0 4px 4px 0; }
    .grafica { position: relative; margin-top: 16px; }
    .grafica svg { display: block; width: 100%; height: auto; overflow: visible; }
    .grafica .eje-t { font-size: 11px; fill: var(--soft); font-family: 'Inter', sans-serif; }
    .grafica .rej { stroke: var(--line); stroke-width: 1; }
    .grafica .cero { stroke: var(--c); stroke-width: 1; }
    .grafica .anota { font-size: 12px; font-weight: 700; fill: var(--c); font-family: 'Inter', sans-serif; }
    .grafica .anota.suave { font-weight: 500; fill: var(--mid); }
    .tip { position: absolute; pointer-events: none; background: var(--c); color: #fff; border-radius: 10px; padding: 8px 11px; font-size: .8rem; line-height: 1.35; white-space: nowrap; transform: translate(-50%, calc(-100% - 12px)); opacity: 0; transition: opacity .15s; z-index: 3; }
    .tip.ver { opacity: 1; }
    .tip b { font-variant-numeric: tabular-nums; }
    .ver-tabla { margin-top: 12px; font-size: .86rem; }
    .ver-tabla summary { cursor: pointer; font-weight: 700; width: fit-content; }
    .ver-tabla table { margin-top: 8px; }
    .multiplos { display: grid; gap: 14px; margin-top: 16px; }
    .mult { display: grid; grid-template-columns: 64px 1fr; gap: 4px 12px; align-items: center; font-size: .9rem; }
    .mult .pista { position: relative; height: 26px; background: var(--g); border-radius: 0 6px 6px 0; }
    .mult .pista i { position: absolute; inset: 0 auto 0 0; background: var(--c); border-radius: 0 4px 4px 0; width: var(--v); transition: width .6s var(--ease); }
    .mult .pista .uno { position: absolute; top: -5px; bottom: -5px; width: 0; border-left: 2px dashed var(--amber-t); left: var(--u); }
    .mult .val { grid-column: 2; font-size: .82rem; color: var(--mid); }
    .mult .val b { color: var(--c); font-variant-numeric: tabular-nums; }
    .cierre { border-left: 3px solid var(--c); }
    .cierre .cuando { font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--amber-t); }
    .oculto { display: none !important; }
    .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  </style>
</head>
<body>
  <script type="application/json" id="datos" set:html={datosCliente}></script>

  <header class="top">
    <div class="wrap">
      <a class="top-logo" href="#inicio"><img src="/logo-a.png" alt="" />antemano</a>
      <div class="top-cap" id="top-cap"><b>Voz Durango</b> · proyecto ejecutivo</div>
      <button class="top-btn" id="btn-indice" aria-expanded="false" aria-controls="indice">Capítulos</button>
    </div>
    <div class="top-prog" id="top-prog"></div>
  </header>
  <nav class="indice" id="indice" aria-label="Capítulos">
    <a href="#intro" data-cap="intro"><span>·</span>Introducción</a>
    <a href="#resumen" data-cap="resumen"><span>·</span>Resumen ejecutivo</a>
    <a href="#indice-doc" data-cap="indice-doc"><span>·</span>Índice</a>
    {capitulos.map((c) => <a href={`#${c.id}`} data-cap={c.id}><span>{c.n}</span>{c.t}</a>)}
    <div class="mov"><span>Animaciones</span><button class="top-btn" id="btn-mov" type="button">—</button></div>
  </nav>

  <main>
    <!-- Portada -->
    <section class="portada" id="inicio">
      <div class="wrap">
        <p class="eyebrow">Proyecto ejecutivo para socios · Durango · 13-nov-2026</p>
        <h1 set:html={(D.h1 || D.titular || 'Voz Durango').replace(/[&<>]/g, (c: string) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' } as any)[c]).replace(/\*(.+?)\*/g, '<span class="si">$1</span>')}></h1>
        {D.bajada && <p class="sub">{D.bajada}</p>}
        <div class="acciones">
          <a class="btn btn-claro" href="#intro">Empezar a leer →</a>
          <a class="btn btn-linea" href="#resumen">Ir al resumen (3 min)</a>
        </div>
        <div class="onda" aria-hidden="true">
          {Array.from({ length: 64 }).map((_, i) => {
            const h = 18 + Math.round(70 * Math.abs(Math.sin(i * 0.37) * Math.cos(i * 0.11)));
            return <i class={i % 9 === 4 ? 'a' : ''} style={`--h:${h}%;--dl:${(i % 16) * 0.09}s`}></i>;
          })}
        </div>
        <div class="resumen">
          <div><b>{corto(capital.tramos[0] && capital.tramos[0].mxn)}</b><span>para validar y arrancar (tramo 1)</span></div>
          <div><b>+{corto(capital.tramos[1] && capital.tramos[1].mxn)}</b><span>solo con igualas firmadas (tramo 2)</span></div>
          <div><b>{minManual ? Math.round((1 - minIa / minManual) * 100) + '%' : '—'}</b><span>menos horas humanas por episodio con IA</span></div>
          <div><b>{iCruce >= 0 ? 'Mes ' + (iCruce + 1) : '—'}</b><span>la caja acumulada vuelve a positivo (escenario {(escMedio.nombre || 'base').toLowerCase()})</span></div>
        </div>
      </div>
    </section>

    <!-- Introducción -->
    <section class="sec intro" id="intro">
      <div class="wrap">
        <p class="cap-n">Introducción</p>
        <h2>Qué es <span class="si">este documento.</span></h2>
        <div class="intro-grid">
          <div class="texto">
            <p>Es la propuesta para crear en Durango una <b>agencia de podcast y comunicación</b>: grabamos, editamos, publicamos y asesoramos la narrativa de personas ocupadas, empezando por la clase política y abriéndonos después al trabajo comercial.</p>
            <p>La idea de fondo: <b>no vendemos horas de estudio, vendemos la voz pública de personas ocupadas.</b> El cliente graba unas 3 horas al mes y nosotros hacemos todo lo demás.</p>
            <p>Se armó con una investigación de <b>{(D.fuentes || []).length} fuentes</b> al 13 de noviembre de 2026. Cada dato pasó por un verificador que intentó tumbarlo. Lo que dice <i>estimado</i> es cálculo nuestro y lo que no se sabe dice <i>por confirmar</i>.</p>
            {D.subtitulo && <p class="aviso-claro">{D.subtitulo.replace(/^Proyecto ejecutivo para socios · Durango · [^·]+· /, '').split('. ')[0]}.</p>}
          </div>
          <div class="como-leer">
            <h3>Cómo leerlo</h3>
            <ol>
              <li><a href="#resumen"><b>El resumen</b><span>Todo el proyecto en 3 minutos.</span></a></li>
              <li><a href="#indice-doc"><b>El índice</b><span>{capitulos.length} capítulos en 5 partes; ve al que te interese.</span></a></li>
              <li><a href="#decidir"><b>Las decisiones</b><span>Al final votas {(D.decisiones || []).length} decisiones y se las mandas a Miguel.</span></a></li>
            </ol>
            <p class="nota">Cada capítulo empieza con un recuadro <b>En corto</b>: si solo lees esos, ya tienes lo esencial.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Resumen ejecutivo -->
    <section class="sec gris" id="resumen">
      <div class="wrap">
        <p class="cap-n">Resumen ejecutivo · 3 minutos</p>
        <h2>El proyecto <span class="si">en una página.</span></h2>

        <div class="rbloque">
          <div class="rcab"><span class="rn">1</span><h3>La idea</h3></div>
          <p class="rfrase">Vendemos la voz pública de personas ocupadas. <b>El cliente graba unas 3 horas al mes y nosotros hacemos todo lo demás.</b></p>
          <div class="modelo" role="img" aria-label="El cliente graba 3 horas al mes, nosotros hacemos narrativa, grabación, edición con IA, clips, publicación y reporte, y el resultado son episodios y clips publicados cada mes">
            <div class="mpaso"><span class="mt">El cliente</span><b>Graba unas 3 horas al mes</b><span class="ms">en una sola sesión, en su oficina o en el set</span></div>
            <span class="mflecha" aria-hidden="true">→</span>
            <div class="mpaso mnos"><span class="mt">Nosotros</span>
              <div class="mchips"><span>Narrativa</span><span>Grabación con 4 cámaras</span><span>Edición con IA</span><span>Clips verticales</span><span>Publicación</span><span>Reporte</span><span>Cumplimiento INE</span></div>
            </div>
            <span class="mflecha" aria-hidden="true">→</span>
            <div class="mpaso"><span class="mt">El resultado</span><b>4 episodios y 16 a 20 clips al mes</b><span class="ms">publicados con constancia en sus redes y YouTube</span></div>
          </div>
        </div>

        <div class="rbloque">
          <div class="rcab"><span class="rn">2</span><h3>Por qué ahora</h3></div>
          <div class="rstats">
            <div><b>29</b><span>diputaciones en juego en Durango en 2027</span></div>
            <div><b>39 + 1</b><span>ayuntamientos y gubernatura en 2028</span></div>
            <div><b>89%</b><span>de los oyentes de podcast ve clips en redes</span></div>
            <div><b>52.8%</b><span>de los podcasts no pasa de 6 episodios: falta constancia</span></div>
          </div>
        </div>

        <div class="rbloque">
          <div class="rcab"><span class="rn">3</span><h3>Qué vendemos</h3></div>
          <div class="rprecios">
            {[pVoz, pVP, pEp, pCamp].map((p: any) => (
              <div><span class="rpn">{p.nombre}</span><b>{mxn(p.precio_mxn)}</b><span class="rpu">{p.unidad} · sin IVA</span></div>
            ))}
          </div>
          <p class="rnota">Las igualas mensuales son el centro del negocio; lo demás llena huecos de agenda. <a href="#propuesta">Ver los {(D.paquetes || []).length} paquetes →</a></p>
        </div>

        <div class="rbloque">
          <div class="rcab"><span class="rn">4</span><h3>Cuánto se pone y cuándo regresa</h3></div>
          <div class="rdinero">
            <div class="rtramos">
              <div class="rbarra" aria-hidden="true">
                <i style={`flex:${capital.tramos[0] && capital.tramos[0].mxn}`}></i>
                <i style={`flex:${capital.tramos[1] && capital.tramos[1].mxn}`}></i>
