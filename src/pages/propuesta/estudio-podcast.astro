              <div class="rtramo dos"><b>+{mxn(capital.tramos[1] && capital.tramos[1].mxn)}</b><span>Tramo 2 · solo con igualas firmadas que cubran los costos fijos</span></div>
              <p class="rnota">El local y las etapas siguientes se pagan con la caja del negocio.</p>
            </div>
            <div class="rcurva">
              {(() => {
                const W = 320, H = 130, pad = 8;
                const vals = serieCaja.map((s: any) => s.acumulado);
                const mn = Math.min(0, ...vals), mx = Math.max(0, ...vals);
                const x = (i: number) => pad + (i * (W - 2 * pad)) / Math.max(1, vals.length - 1);
                const y = (v: number) => pad + ((mx - v) * (H - 2 * pad)) / Math.max(1, mx - mn);
                const pts = vals.map((v: number, i: number) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
                return (
                  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Caja acumulada: baja hasta ${mxn(vals[iBajo])} y vuelve a positivo en el mes ${iCruce + 1}`}>
                    <line x1={pad} x2={W - pad} y1={y(0)} y2={y(0)} stroke="currentColor" stroke-opacity=".35" />
                    <polyline points={pts} fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round" />
                    <circle cx={x(iBajo)} cy={y(vals[iBajo])} r="4.5" fill="#C8963E" />
                    {iCruce >= 0 && <circle cx={x(iCruce)} cy={y(vals[iCruce])} r="4.5" fill="#C8963E" />}
                  </svg>
                );
              })()}
              <div class="rcurva-lee">
                <span><b>{corto(serieCaja[iBajo] && serieCaja[iBajo].acumulado).replace('$-', '−$')}</b> lo más bajo ({serieCaja[iBajo] && serieCaja[iBajo].mes})</span>
                <span><b>Mes {iCruce + 1}</b> la caja vuelve a positivo (escenario base)</span>
              </div>
            </div>
          </div>
