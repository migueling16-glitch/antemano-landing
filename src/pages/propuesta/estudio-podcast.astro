---
// Propuesta privada: estudio de podcast de Antemano (proyecto ejecutivo para socios).
// noindex: URL privada, no se enlaza desde el sitio.
// Todo el contenido sale de src/data/estudio-podcast.json (investigación verificada, 13-nov-2026).
import d from '../../data/estudio-podcast.json';

const D: any = d;
const mxn = (n: unknown) =>
  typeof n === 'number' && isFinite(n) ? '$' + Math.round(n).toLocaleString('es-MX') : '—';
const corto = (n: unknown) => {
  if (typeof n !== 'number' || !isFinite(n)) return '—';
  if (Math.abs(n) >= 1e6) return '$' + (n / 1e6).toLocaleString('es-MX', { maximumFractionDigits: 1 }) + ' M';
  if (Math.abs(n) >= 1e3) return '$' + Math.round(n / 1e3).toLocaleString('es-MX') + ' mil';
  return '$' + Math.round(n).toLocaleString('es-MX');
};
const host = (u: string) => {
  try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return 'fuente'; }
};

const niveles: any[] = D.equipo_niveles || [];
const iRec = Math.max(0, niveles.findIndex((n) => /recom/i.test(n.nivel || '')));
const recomendada = (D.opciones || []).find((o: any) => o.recomendada) || (D.opciones || [])[0];
const escenarios: any[] = (D.finanzas && D.finanzas.escenarios) || [];
const escMedio = escenarios[Math.min(1, escenarios.length - 1)] || {};
const minManual = (D.flujo || []).reduce((s: number, f: any) => s + (f.min_humanos_manual || 0), 0);
const minIa = (D.flujo || []).reduce((s: number, f: any) => s + (f.min_humanos_con_ia || 0), 0);
const F: any = D.finanzas || {};
const capital: any = F.capital || { tramos: [] };
const fc: any = F.flujo_caja || { serie: [] };
const serieCaja: any[] = fc.serie || [];
const iCruce = serieCaja.findIndex((s: any) => s.acumulado > 0);
const iBajo = serieCaja.reduce((m: number, s: any, i: number) => (s.acumulado < serieCaja[m].acumulado ? i : m), 0);

const capitulos = [
  { id: 'por-que', n: '01', t: 'Por qué ahora' },
  { id: 'casos', n: '02', t: 'Quién ya lo hace' },
  { id: 'caminos', n: '03', t: 'Tres caminos' },
  { id: 'propuesta', n: '04', t: 'Lo que vendemos' },
  { id: 'mvp', n: '05', t: 'El arranque' },
  { id: 'opera', n: '06', t: 'Cómo opera' },
  { id: 'personas', n: '07', t: 'Quién lo hace' },
  { id: 'hitos', n: '08', t: 'Hitos' },
  { id: 'numeros', n: '09', t: 'Los números' },
  { id: 'dinero', n: '10', t: 'El dinero del socio' },
  { id: 'politica', n: '11', t: 'El nicho político' },
  { id: 'durango', n: '12', t: 'Durango' },
  { id: 'escalar', n: '13', t: 'Casa de medios' },
  { id: 'riesgos', n: '14', t: 'Riesgos' },
  { id: 'decidir', n: '15', t: 'Lo que decidimos' },
  { id: 'fuentes', n: '16', t: 'Fuentes' },
];
// Recomendación: primera oración visible, el resto en "Por qué"
const corte = (t: string): [string, string] => {
  const s = String(t || '').trim();
  const primerP = s.split('\n')[0];
  // corta en el primer punto seguido de mayúscula (no en "S.A. de C.V.")
  const m = primerP.match(/^.{6,}?[.](?=\s+[A-ZÁÉÍÓÚÑ¿(]|$)/);
  const a = m ? m[0] : primerP;
  return [a, s.slice(a.length).trim()];
};
const nCap = (id: string) => (capitulos.find((c) => c.id === id) || { n: '' }).n;

// Al navegador solo va lo que usan las vistas interactivas (lo demás ya está en el HTML)
const { opciones, equipo_niveles, personas, paquetes, finanzas, riesgos, decisiones, horas_miguel } = D;
const datosCliente = JSON.stringify({ opciones, equipo_niveles, personas, paquetes, finanzas, riesgos, decisiones, horas_miguel }).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#1A1A1A" />
  <title>Voz Durango · Proyecto ejecutivo</title>
  <meta name="description" content="Proyecto ejecutivo privado para socios: agencia de podcast por iguala con consultoría de narrativa y operación apalancada en IA, Durango." />
  <link rel="icon" href="/logo-a.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
  <script is:inline>
    (function () {
      var h = document.documentElement;
      h.classList.add('js');
      try {
        var m = localStorage.getItem('ep-mov');
        var reducido = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (m === '1' || (m !== '0' && !reducido)) h.classList.add('anim');
      } catch (e) {
        if (!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)) h.classList.add('anim');
      }
    })();
  </script>
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root {
      --c: #1A1A1A;
      --c2: #2A2A2A;
      --w: #FAFAFA;
      --ww: #FFFFFF;
      --g: #F3F3F1;
      --mid: #5F6670;
      --soft: #8A9099;
      --line: rgba(26,26,26,.12);
      --line-d: rgba(255,255,255,.12);
      --amber: #C8963E;
      --amber-t: #8A6420;   /* ámbar para texto sobre claro (contraste AA) */
      --s-manual: #3F6FAA;  /* serie "sin IA" (validada) */
      --s-ia: #B8822A;      /* serie "con IA" (validada) */
      --ease: cubic-bezier(0.16,1,0.3,1);
      --r: 14px;
    }
    html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; scroll-padding-top: 72px; }
    body {
      background: var(--ww); color: var(--c);
      font-family: 'Inter', system-ui, sans-serif; font-size: 16px; line-height: 1.55;
      -webkit-font-smoothing: antialiased; overflow-x: hidden;
    }
    a { color: inherit; }
    button { font: inherit; color: inherit; }
    ::selection { background: var(--c); color: #fff; }
    :focus-visible { outline: 2px solid var(--amber); outline-offset: 3px; border-radius: 6px; }
    .si { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; letter-spacing: -.005em; }
    .wrap { max-width: 1120px; margin: 0 auto; padding: 0 16px; }
    @media (min-width: 720px) { .wrap { padding: 0 32px; } }

    /* ── Barra superior ───────────────────────── */
    .top {
      position: fixed; inset: 0 0 auto 0; z-index: 50; height: 56px;
      display: flex; align-items: center; color: #fff;
      background: rgba(26,26,26,.88); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      border-bottom: 1px solid var(--line-d);
    }
    .top .wrap { display: flex; align-items: center; gap: 12px; width: 100%; }
    .top-logo { display: flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 900; letter-spacing: -.03em; font-size: 1.15rem; }
    .top-logo img { width: 22px; height: 22px; }
    .top-cap { flex: 1; min-width: 0; font-size: .78rem; color: rgba(255,255,255,.6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .top-cap b { color: #fff; font-weight: 600; }
    .top-btn {
      border: 1px solid rgba(255,255,255,.28); background: transparent; border-radius: 999px;
      padding: 7px 14px; font-size: .8rem; font-weight: 700; cursor: pointer; color: #fff; white-space: nowrap;
    }
    .top-btn:hover { border-color: #fff; }
    .top-prog { position: absolute; left: 0; bottom: -1px; height: 2px; background: var(--amber); width: 0; }

    .indice {
      position: fixed; inset: 56px 0 auto auto; z-index: 49; width: min(360px, 100%);
      max-height: calc(100svh - 56px); overflow: auto; background: var(--c); color: #fff;
      border-left: 1px solid var(--line-d); border-bottom: 1px solid var(--line-d);
      padding: 8px 0 16px; display: none;
    }
    .indice.abierto { display: block; }
    .indice a { display: flex; gap: 14px; padding: 11px 20px; text-decoration: none; font-weight: 600; font-size: .95rem; }
    .indice a span { color: rgba(255,255,255,.4); font-variant-numeric: tabular-nums; width: 22px; }
    .indice a:hover, .indice a.actual { background: rgba(255,255,255,.06); }
    .indice a.actual span { color: var(--amber); }
    .indice .mov { margin: 10px 20px 0; padding-top: 14px; border-top: 1px solid var(--line-d); display: flex; justify-content: space-between; align-items: center; font-size: .82rem; color: rgba(255,255,255,.65); }

    /* ── Portada ──────────────────────────────── */
    .portada { background: var(--c); color: #fff; padding: 112px 0 56px; position: relative; overflow: hidden; }
    .eyebrow { font-size: .72rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: rgba(255,255,255,.5); display: flex; align-items: center; gap: 10px; }
    .eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; opacity: .6; }
    .eyebrow.osc { color: var(--mid); }
    .portada h1 { font-size: clamp(2.2rem, 6.6vw, 4.9rem); font-weight: 900; line-height: 1.0; letter-spacing: -.035em; margin: 22px 0 18px; max-width: 17ch; }
    .portada .aviso { margin-top: 18px; font-size: .85rem; color: rgba(255,255,255,.5); max-width: 66ch; border-left: 2px solid var(--amber); padding-left: 12px; }
    .portada h1 .si { color: var(--amber); }
    .portada .sub { font-size: clamp(1.05rem, 2.2vw, 1.3rem); color: rgba(255,255,255,.72); max-width: 54ch; }
    .portada .tesis { margin-top: 20px; font-size: 1rem; color: rgba(255,255,255,.6); max-width: 60ch; }
    .acciones { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 13px 22px; border-radius: 999px; font-weight: 700; font-size: .92rem; text-decoration: none; cursor: pointer; border: 1.5px solid transparent; transition: transform .2s var(--ease); }
    .btn:active { transform: scale(.97); }
    .btn-claro { background: #fff; color: var(--c); }
    .btn-linea { border-color: rgba(255,255,255,.35); color: #fff; background: transparent; }
    .btn-osc { background: var(--c); color: #fff; }
    .btn-linea-osc { border-color: var(--line); background: #fff; color: var(--c); }

    .onda { display: flex; align-items: flex-end; gap: 3px; height: 64px; margin-top: 44px; opacity: .9; }
    .onda i { flex: 1; max-width: 6px; background: rgba(255,255,255,.22); border-radius: 3px; height: var(--h); transform-origin: bottom; }
    .onda i.a { background: var(--amber); }
    html.anim .onda i { animation: onda 2.6s var(--ease) infinite alternate; animation-delay: var(--dl); }
    @keyframes onda { from { transform: scaleY(.35); } to { transform: scaleY(1); } }

    .resumen { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line-d); border: 1px solid var(--line-d); border-radius: var(--r); overflow: hidden; margin-top: 36px; }
    @media (min-width: 820px) { .resumen { grid-template-columns: repeat(4, 1fr); } }
    .resumen div { background: var(--c); padding: 18px 16px; }
    .resumen b { display: block; font-size: clamp(1.35rem, 3.4vw, 2rem); font-weight: 900; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    .resumen span { font-size: .8rem; color: rgba(255,255,255,.55); }

    /* ── Secciones ───────────────────────────── */
    .sec { padding: 72px 0; border-top: 1px solid var(--line); }
    @media (min-width: 820px) { .sec { padding: 104px 0; } }
    .sec.osc { background: var(--c); color: #fff; border-top-color: var(--line-d); }
    .sec.gris { background: var(--g); }
    .cap-n { font-size: .78rem; font-weight: 800; letter-spacing: .14em; color: var(--amber-t); text-transform: uppercase; }
    .osc .cap-n { color: var(--amber); }
    .sec h2 { font-size: clamp(1.9rem, 5vw, 3.4rem); font-weight: 900; line-height: 1.04; letter-spacing: -.03em; margin: 12px 0 14px; max-width: 20ch; }
    .sec h2 .si { font-size: 1.06em; }
    .lead { font-size: 1.08rem; color: var(--mid); max-width: 62ch; }
    .osc .lead { color: rgba(255,255,255,.68); }
    .sec h3 { font-size: 1.15rem; font-weight: 800; letter-spacing: -.01em; margin-bottom: 8px; }
    .bloque { margin-top: 40px; }
    .nota { font-size: .82rem; color: var(--soft); }
    .osc .nota { color: rgba(255,255,255,.5); }
    .fuente { font-size: .75rem; color: var(--soft); text-decoration: none; border-bottom: 1px solid var(--line); }
    .fuente:hover { color: var(--c); }
    .osc .fuente { color: rgba(255,255,255,.5); border-color: var(--line-d); }
    .osc .fuente:hover { color: #fff; }

    .rejilla { display: grid; gap: 12px; grid-template-columns: 1fr; }
    @media (min-width: 640px) { .rejilla.r2 { grid-template-columns: repeat(2, 1fr); } .rejilla.r3 { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 960px) { .rejilla.r3 { grid-template-columns: repeat(3, 1fr); } .rejilla.r4 { grid-template-columns: repeat(4, 1fr); } }
    @media (min-width: 640px) and (max-width: 959px) { .rejilla.r4 { grid-template-columns: repeat(2, 1fr); } }
    .tarjeta { background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 20px; display: flex; flex-direction: column; gap: 8px; min-width: 0; }
    .gris .tarjeta { background: #fff; }
    .osc .tarjeta { background: var(--c2); border-color: var(--line-d); }
    .tarjeta p { font-size: .95rem; }
    .tarjeta .pie { margin-top: auto; padding-top: 6px; }

    .cifra { font-size: clamp(1.9rem, 5vw, 2.6rem); font-weight: 900; letter-spacing: -.035em; line-height: 1; font-variant-numeric: tabular-nums; }
    .osc .cifra { color: #fff; }
    .cifra-chica { font-size: 1.5rem; }

    .lista { list-style: none; display: grid; gap: 10px; }
    .lista li { position: relative; padding-left: 20px; font-size: .97rem; }
    .lista li::before { content: ''; position: absolute; left: 2px; top: .62em; width: 7px; height: 7px; border-radius: 50%; background: var(--c); }
    .osc .lista li::before { background: var(--amber); }
    .lista.mas li::before { background: var(--s-manual); }
    .lista.menos li::before { background: transparent; border: 1.5px solid var(--c); }

    /* Controles segmentados y chips */
    .seg { display: inline-flex; flex-wrap: wrap; gap: 6px; padding: 4px; border-radius: 24px; background: var(--g); border: 1px solid var(--line); max-width: 100%; }
    .osc .seg { background: rgba(255,255,255,.06); border-color: var(--line-d); }
    .seg button { border: 0; background: transparent; padding: 9px 16px; border-radius: 999px; font-weight: 700; font-size: .88rem; cursor: pointer; color: var(--mid); min-height: 40px; }
    .osc .seg button { color: rgba(255,255,255,.65); }
    .seg button[aria-pressed="true"] { background: var(--c); color: #fff; }
    .osc .seg button[aria-pressed="true"] { background: #fff; color: var(--c); }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { border: 1px solid var(--line); background: #fff; border-radius: 999px; padding: 8px 14px; font-size: .85rem; font-weight: 600; cursor: pointer; min-height: 40px; }
    .chip[aria-pressed="true"] { background: var(--c); color: #fff; border-color: var(--c); }
    .etq { display: inline-block; font-size: .68rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; border: 1px solid var(--line); color: var(--mid); width: fit-content; }
    .etq.oro { background: var(--amber); border-color: var(--amber); color: var(--c); }
    .osc .etq { border-color: var(--line-d); color: rgba(255,255,255,.7); }
    .osc .etq.oro { color: var(--c); }

    /* Pros y contras */
    .balanza { display: grid; gap: 12px; }
    @media (min-width: 760px) { .balanza { grid-template-columns: 1fr 1fr; } }

    /* Caminos */
    .camino { margin-top: 22px; display: grid; gap: 16px; }
    @media (min-width: 900px) { .camino { grid-template-columns: 1.1fr .9fr; } }
    .barras { display: grid; gap: 12px; }
    .barra { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; font-size: .88rem; }
    .barra .pista { grid-column: 1 / -1; height: 8px; border-radius: 4px; background: rgba(255,255,255,.1); overflow: hidden; }
    .barra .pista i { display: block; height: 100%; border-radius: 4px; background: var(--amber); width: var(--v); transition: width .6s var(--ease); }
    .barra b { font-variant-numeric: tabular-nums; }

    /* Paquetes */
    .precio { font-size: 1.9rem; font-weight: 900; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
    .precio small { font-size: .85rem; font-weight: 600; color: var(--mid); letter-spacing: 0; }
    .mini { display: flex; flex-wrap: wrap; gap: 6px 14px; font-size: .8rem; color: var(--mid); border-top: 1px solid var(--line); padding-top: 10px; margin-top: 4px; }

    /* Equipo */
    .equipo-cab { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 16px; margin-top: 24px; }
    .total-grande { text-align: right; }
    .total-grande b { display: block; font-size: clamp(2rem, 6vw, 3rem); font-weight: 900; letter-spacing: -.035em; font-variant-numeric: tabular-nums; }
    .tabla { width: 100%; border-collapse: collapse; font-size: .92rem; }
    .tabla th { text-align: left; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--soft); font-weight: 700; padding: 10px 8px; border-bottom: 1px solid var(--line); }
    .tabla td { padding: 12px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
    .tabla td.num, .tabla th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .tabla .cat td { font-weight: 800; background: var(--g); font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; }
    .tabla small { display: block; color: var(--mid); font-size: .82rem; margin-top: 2px; }
    .desliza { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    @media (max-width: 640px) {
      .tabla.apila thead { display: none; }
      .tabla.apila tr { display: grid; grid-template-columns: 1fr auto; border-bottom: 1px solid var(--line); padding: 10px 0; }
      .tabla.apila td { border: 0; padding: 2px 0; }
      .tabla.apila td.ocultar { display: none; }
      .tabla.apila .cat { display: block; padding: 0; border: 0; }
      .tabla.apila .cat td { display: block; padding: 8px 10px; }
    }

    /* Flujo */
    .leyenda { display: flex; flex-wrap: wrap; gap: 16px; font-size: .85rem; color: var(--mid); margin: 18px 0 8px; }
    .leyenda span { display: inline-flex; align-items: center; gap: 8px; }
    .leyenda i { width: 14px; height: 8px; border-radius: 4px; display: inline-block; }
    .flujo { display: grid; gap: 4px; margin-top: 8px; }
    .paso { border: 1px solid var(--line); border-radius: 12px; background: #fff; }
    .paso summary { list-style: none; cursor: pointer; padding: 14px 16px; display: grid; grid-template-columns: 28px 1fr auto; gap: 4px 12px; align-items: center; }
    .paso summary::-webkit-details-marker { display: none; }
    .paso .num { font-size: .78rem; font-weight: 800; color: var(--soft); font-variant-numeric: tabular-nums; }
    .paso .nom { font-weight: 700; font-size: .97rem; }
    .paso .min { font-size: .82rem; color: var(--mid); font-variant-numeric: tabular-nums; white-space: nowrap; }
    .paso .barras2 { grid-column: 2 / -1; display: grid; gap: 3px; }
    .paso .barras2 i { display: block; height: 6px; border-radius: 3px; min-width: 3px; transition: width .7s var(--ease); }
    .paso .cuerpo { padding: 0 16px 16px 56px; font-size: .92rem; color: var(--mid); display: grid; gap: 6px; }
    @media (max-width: 560px) { .paso .cuerpo { padding-left: 16px; } }
    .auto { font-size: .66rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; padding: 3px 7px; border-radius: 999px; border: 1px solid var(--line); }
    .auto.total { background: var(--c); color: #fff; border-color: var(--c); }
    .auto.parcial { border-color: var(--c); }
    .ahorro { display: grid; gap: 12px; grid-template-columns: 1fr 1fr; margin-top: 18px; }
    @media (min-width: 760px) { .ahorro { grid-template-columns: repeat(3, 1fr); } }

    /* Personas */
    .personas { margin-top: 20px; }
    .rol .ded { font-size: .82rem; font-weight: 700; color: var(--amber-t); }
    .rol.nuevo { border-color: var(--c); }

    /* Hitos */
    .hitos { margin-top: 28px; position: relative; display: grid; gap: 10px; }
    .hito { border: 1px solid var(--line); border-radius: 12px; background: #fff; }
    .hito summary { list-style: none; cursor: pointer; padding: 16px; display: grid; grid-template-columns: auto 1fr auto; gap: 4px 14px; align-items: center; }
    .hito summary::-webkit-details-marker { display: none; }
    .hito .hid { width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; font-weight: 900; font-size: .8rem; background: var(--c); color: #fff; }
    .hito .hn { font-weight: 800; }
    .hito .hp { font-size: .8rem; color: var(--mid); }
    .hito .mas { font-size: 1.3rem; color: var(--soft); transition: transform .3s var(--ease); }
    .hito[open] .mas { transform: rotate(45deg); }
    .hito .cuerpo { padding: 0 16px 18px; display: grid; gap: 12px; font-size: .94rem; }
    @media (min-width: 640px) { .hito .cuerpo { padding-left: 68px; } }
    .criterio { border-left: 3px solid var(--amber); padding: 6px 0 6px 12px; }
    .criterio b { display: block; font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--amber-t); }

    /* Simulador */
    .sim { display: grid; gap: 16px; margin-top: 26px; }
    @media (min-width: 960px) { .sim { grid-template-columns: 1.15fr .85fr; align-items: start; } }
    .sim-lado { position: sticky; top: 72px; }
    .paquete-sim { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--line-d); }
    .paquete-sim .n { font-weight: 700; }
    .paquete-sim small { color: rgba(255,255,255,.55); font-size: .8rem; }
    .paso-n { display: inline-flex; align-items: center; border: 1px solid var(--line-d); border-radius: 999px; }
    .paso-n button { width: 44px; height: 44px; border: 0; background: transparent; font-size: 1.2rem; font-weight: 700; cursor: pointer; color: #fff; }
    .paso-n output { min-width: 28px; text-align: center; font-weight: 800; font-variant-numeric: tabular-nums; }
    .res { display: grid; gap: 1px; background: var(--line-d); border-radius: var(--r); overflow: hidden; border: 1px solid var(--line-d); }
    .res div { background: var(--c2); padding: 16px 18px; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
    .res span { font-size: .88rem; color: rgba(255,255,255,.65); }
    .res b { font-size: 1.25rem; font-weight: 800; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .res .grande b { font-size: 2rem; letter-spacing: -.03em; }
    .res .grande.pos b { color: var(--amber); }
    .capacidad { height: 8px; background: rgba(255,255,255,.1); border-radius: 4px; overflow: hidden; margin-top: 8px; }
    .capacidad i { display: block; height: 100%; background: #fff; width: 0; transition: width .5s var(--ease); border-radius: 4px; }
    .capacidad.lleno i { background: var(--amber); }

    /* Calendario político */
    .linea { display: grid; gap: 0; margin-top: 20px; border-left: 2px solid var(--line-d); padding-left: 18px; }
    .linea .ev { position: relative; padding: 0 0 22px; }
    .linea .ev::before { content: ''; position: absolute; left: -25px; top: 5px; width: 12px; height: 12px; border-radius: 50%; background: var(--c); border: 2px solid var(--amber); }
    .linea .fecha { font-size: .78rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--amber); }
    .linea .que { font-weight: 700; }
    .linea .sig { font-size: .9rem; color: rgba(255,255,255,.6); }

    /* Escalera */
    .escalera { display: grid; gap: 10px; margin-top: 26px; }
    .peldano { display: grid; grid-template-columns: 48px 1fr; gap: 14px; background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 18px; }
    @media (min-width: 900px) { .peldano { margin-left: calc(var(--i) * 44px); } }
    .peldano .pn { width: 48px; height: 48px; border-radius: 12px; background: var(--c); color: #fff; display: grid; place-items: center; font-weight: 900; }
    .peldano .disp { font-size: .85rem; border-top: 1px dashed var(--line); padding-top: 8px; margin-top: 6px; }
    .peldano .disp b { color: var(--amber-t); }

    /* Matriz de riesgos */
    .matriz-wrap { display: grid; gap: 20px; margin-top: 24px; }
    @media (min-width: 900px) { .matriz-wrap { grid-template-columns: 380px 1fr; align-items: start; } }
    .matriz { display: grid; grid-template-columns: 70px repeat(3, 1fr); gap: 4px; font-size: .75rem; }
    .matriz .eje { display: grid; place-items: center; color: var(--mid); font-weight: 700; text-align: center; }
    .celda { aspect-ratio: 1; border-radius: 10px; border: 1px solid var(--line); background: #fff; cursor: pointer; display: grid; place-items: center; font-weight: 900; font-size: 1.3rem; }
    .celda[data-n="0"] { color: var(--line); cursor: default; }
    .celda.w1 { background: #F3E7D0; }
    .celda.w2 { background: #E5C68D; }
    .celda.w3 { background: var(--amber); }
    .celda[aria-pressed="true"] { outline: 3px solid var(--c); outline-offset: 1px; }
    .riesgo { border-bottom: 1px solid var(--line); padding: 14px 0; display: grid; gap: 4px; }
    .riesgo .rt { font-weight: 700; }
    .riesgo .rm { font-size: .92rem; color: var(--mid); }
    .riesgo .rm b { color: var(--c); }

    /* Decisiones */
    .decision { background: #fff; border: 1px solid var(--line); border-radius: var(--r); padding: 20px; display: grid; gap: 12px; }
    .decision .rec { font-size: .86rem; color: var(--mid); }
    .decision .rec b { color: var(--amber-t); }
    .barra-dec { position: sticky; bottom: 12px; margin-top: 18px; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; background: var(--c); color: #fff; border-radius: 999px; padding: 8px 8px 8px 18px; z-index: 5; }
    .barra-dec span { font-size: .85rem; }

    /* Fuentes */
    .fuentes { columns: 1; column-gap: 32px; font-size: .86rem; margin-top: 20px; }
    @media (min-width: 760px) { .fuentes { columns: 2; } }
    .fuentes li { break-inside: avoid; margin: 0 0 8px 18px; }
    .fuentes a { text-decoration: none; border-bottom: 1px solid var(--line); }
    .fuentes a:hover { border-color: var(--c); }
    .fuentes small { color: var(--soft); }

    .pie-pag { background: var(--c); color: rgba(255,255,255,.6); padding: 48px 0; font-size: .85rem; }
    .pie-pag b { color: #fff; }

    /* Movimiento (solo con html.anim; sin JS todo se ve) */
    html.js.anim .rv { opacity: 0; transform: translateY(18px); transition: opacity .8s var(--ease), transform .8s var(--ease); }
    html.js.anim .rv.ok { opacity: 1; transform: none; }
    html:not(.anim) * { transition-duration: 0s !important; animation: none !important; }
    .pl { white-space: pre-line; }
    @media (max-width: 639px) {
      .carr { display: flex !important; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin-left: -16px; margin-right: -16px; padding: 2px 16px 10px; scrollbar-width: none; }
      .carr::-webkit-scrollbar { display: none; }
      .carr > * { flex: 0 0 86%; scroll-snap-align: center; }
    }
    .desliza-hint { display: none; font-size: .8rem; color: var(--soft); margin-top: 6px; }
    @media (max-width: 639px) { .desliza-hint { display: block; } }
    .ver-mas { border: 0; background: none; font-weight: 700; font-size: .88rem; cursor: pointer; padding: 8px 0 2px; text-decoration: underline; text-underline-offset: 3px; width: fit-content; min-height: 40px; }
    .osc .ver-mas { color: #fff; }

    /* ── Dinero del socio ── */
    .tramos { display: grid; gap: 12px; margin-top: 24px; }
    @media (min-width: 820px) { .tramos { grid-template-columns: 1fr 1fr 1fr; } }
    .tramo .grande { font-size: clamp(2rem, 6vw, 2.8rem); font-weight: 900; letter-spacing: -.035em; font-variant-numeric: tabular-nums; line-height: 1; }
    .tramo .disp { font-size: .86rem; color: var(--mid); border-top: 1px dashed var(--line); padding-top: 10px; }
    .tramo table { width: 100%; border-collapse: collapse; font-size: .86rem; }
    .tramo td { padding: 5px 0; border-bottom: 1px solid var(--line); }
    .tramo td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; padding-left: 10px; }
    .proporcion { display: flex; gap: 2px; height: 14px; margin-top: 18px; }
    .proporcion i { display: block; height: 100%; }
    .proporcion i:first-child { border-radius: 4px 0 0 4px; }
    .proporcion i:last-child { border-radius: 0 4px 4px 0; }
    .grafica { position: relative; margin-top: 16px; }
    .grafica svg { display: block; width: 100%; height: auto; overflow: visible; }
    .grafica .eje-t { font-size: 11px; fill: var(--soft); font-family: 'Inter', sans-serif; }
    .grafica .rej { stroke: var(--line); stroke-width: 1; }
    .grafica .cero { stroke: var(--c); stroke-width: 1; }
    .grafica .anota { font-size: 12px; font-weight: 700; fill: var(--c); font-family: 'Inter', sans-serif; }
    .grafica .anota.suave { font-weight: 500; fill: var(--mid); }
    .tip { position: absolute; pointer-events: none; background: var(--c); color: #fff; border-radius: 10px; padding: 8px 11px; font-size: .8rem; line-height: 1.35; white-space: nowrap; transform: translate(-50%, calc(-100% - 12px)); opacity: 0; transition: opacity .15s; z-index: 3; }
    .tip.ver { opacity: 1; }
    .tip b { font-variant-numeric: tabular-nums; }
    .ver-tabla { margin-top: 12px; font-size: .86rem; }
    .ver-tabla summary { cursor: pointer; font-weight: 700; width: fit-content; }
    .ver-tabla table { margin-top: 8px; }
    .multiplos { display: grid; gap: 14px; margin-top: 16px; }
    .mult { display: grid; grid-template-columns: 64px 1fr; gap: 4px 12px; align-items: center; font-size: .9rem; }
    .mult .pista { position: relative; height: 26px; background: var(--g); border-radius: 0 6px 6px 0; }
    .mult .pista i { position: absolute; inset: 0 auto 0 0; background: var(--c); border-radius: 0 4px 4px 0; width: var(--v); transition: width .6s var(--ease); }
    .mult .pista .uno { position: absolute; top: -5px; bottom: -5px; width: 0; border-left: 2px dashed var(--amber-t); left: var(--u); }
    .mult .val { grid-column: 2; font-size: .82rem; color: var(--mid); }
    .mult .val b { color: var(--c); font-variant-numeric: tabular-nums; }
    .cierre { border-left: 3px solid var(--c); }
    .cierre .cuando { font-size: .72rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; color: var(--amber-t); }
    .oculto { display: none !important; }
    .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  </style>
</head>
<body>
  <script type="application/json" id="datos" set:html={datosCliente}></script>

  <header class="top">
    <div class="wrap">
      <a class="top-logo" href="#inicio"><img src="/logo-a.png" alt="" />antemano</a>
      <div class="top-cap" id="top-cap"><b>Voz Durango</b> · proyecto ejecutivo</div>
      <button class="top-btn" id="btn-indice" aria-expanded="false" aria-controls="indice">Capítulos</button>
    </div>
    <div class="top-prog" id="top-prog"></div>
  </header>
  <nav class="indice" id="indice" aria-label="Capítulos">
    {capitulos.map((c) => <a href={`#${c.id}`} data-cap={c.id}><span>{c.n}</span>{c.t}</a>)}
    <div class="mov"><span>Animaciones</span><button class="top-btn" id="btn-mov" type="button">—</button></div>
  </nav>

  <main>
    <!-- Portada -->
    <section class="portada" id="inicio">
      <div class="wrap">
        <p class="eyebrow">Proyecto ejecutivo para socios · Durango · 13-nov-2026</p>
        <h1 set:html={(D.h1 || D.titular || 'Voz Durango').replace(/[&<>]/g, (c: string) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' } as any)[c]).replace(/\*(.+?)\*/g, '<span class="si">$1</span>')}></h1>
        {D.bajada && <p class="sub">{D.bajada}</p>}
        <p class="tesis">{D.tesis}</p>
        {D.subtitulo && <p class="aviso">{D.subtitulo.replace(/^Proyecto ejecutivo para socios · Durango · [^·]+· /, '')}</p>}
        <div class="acciones">
          <a class="btn btn-claro" href="#por-que">Empezar el recorrido →</a>
          <a class="btn btn-linea" href="#dinero">Ir al dinero del socio</a>
        </div>
        <div class="onda" aria-hidden="true">
          {Array.from({ length: 64 }).map((_, i) => {
            const h = 18 + Math.round(70 * Math.abs(Math.sin(i * 0.37) * Math.cos(i * 0.11)));
            return <i class={i % 9 === 4 ? 'a' : ''} style={`--h:${h}%;--dl:${(i % 16) * 0.09}s`}></i>;
          })}
        </div>
        <div class="resumen">
          <div><b>{corto(capital.tramos[0] && capital.tramos[0].mxn)}</b><span>para validar y arrancar (tramo 1)</span></div>
          <div><b>+{corto(capital.tramos[1] && capital.tramos[1].mxn)}</b><span>solo con igualas firmadas (tramo 2)</span></div>
          <div><b>{minManual ? Math.round((1 - minIa / minManual) * 100) + '%' : '—'}</b><span>menos horas humanas por episodio con IA</span></div>
          <div><b>{iCruce >= 0 ? 'Mes ' + (iCruce + 1) : '—'}</b><span>la caja acumulada vuelve a positivo (escenario {(escMedio.nombre || 'base').toLowerCase()})</span></div>
        </div>
      </div>
    </section>

    <!-- 01 Por qué ahora -->
    <section class="sec" id="por-que">
      <div class="wrap">
        <p class="cap-n">01 · Por qué ahora</p>
        <h2>El podcast ya no se escucha: <span class="si">se ve.</span></h2>
        <p class="lead">Lo que dicen los datos del formato, con su fuente. Toca cualquier fuente para abrirla.</p>
        <div class="rejilla r3 bloque carr">
          {(D.por_que_ahora || []).map((p: any) => (
            <article class="tarjeta rv">
              <div class="cifra">{p.cifra}</div>
              <p>{p.texto}</p>
              <div class="pie"><a class="fuente" href={p.url} target="_blank" rel="noopener">{p.fuente || host(p.url)}{p.fecha ? ` · ${p.fecha}` : ''}</a></div>
            </article>
          ))}
        </div>
<p class="desliza-hint" aria-hidden="true">Desliza para ver más →</p>
        <div class="balanza bloque">
          <div class="tarjeta rv"><h3>Lo bueno del formato</h3><ul class="lista mas" data-max="4">{(D.pros_formato || []).map((x: string) => <li>{x}</li>)}</ul></div>
          <div class="tarjeta rv"><h3>Lo que cuesta</h3><ul class="lista menos" data-max="4">{(D.contras_formato || []).map((x: string) => <li>{x}</li>)}</ul></div>
        </div>
      </div>
    </section>

    <!-- 02 Casos -->
    <section class="sec gris" id="casos">
      <div class="wrap">
        <p class="cap-n">02 · Quién ya lo hace</p>
        <h2>Casos reales y <span class="si">qué nos enseñan.</span></h2>
        <p class="lead">Estudios, agencias, medios y productoras que recorrieron parte de este camino. Filtra por tipo.</p>
        <div class="chips bloque" id="filtro-casos" role="group" aria-label="Filtrar casos"></div>
        <div class="rejilla r3 carr" id="casos-lista" style="margin-top:16px">
          {(D.casos || []).map((c: any) => (
            <article class="tarjeta" data-tipo={(c.tipo || '').toLowerCase()}>
              <span class="etq">{c.tipo}{c.lugar ? ` · ${c.lugar}` : ''}</span>
              <h3>{c.nombre}</h3>
              {c.modelo && <p class="nota">{c.modelo}</p>}
              {c.numeros && <p><b>{c.numeros}</b></p>}
              <p>{c.leccion}</p>
              <div class="pie"><a class="fuente" href={c.url} target="_blank" rel="noopener">{host(c.url)}</a></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 Caminos -->
    <section class="sec osc" id="caminos">
      <div class="wrap">
        <p class="cap-n">03 · Tres caminos</p>
        <h2>Probamos la idea <span class="si">desde tres lados.</span></h2>
        <p class="lead">Tres equipos diseñaron un camino cada uno con la misma investigación. Un juez los puntuó y armó una mezcla con lo mejor de cada uno. Compara.</p>
        <div class="bloque"><div class="seg" id="seg-caminos" role="group" aria-label="Caminos"></div></div>
        <div class="camino" id="camino-panel" aria-live="polite"></div>
        <div class="tarjeta bloque rv" style="border-color:var(--amber)">
          <span class="etq oro">Recomendación</span>
          <p style="font-size:1.05rem" class="pl">{D.recomendacion}</p>
        </div>
      </div>
    </section>

    <!-- 04 Propuesta -->
    <section class="sec" id="propuesta">
      <div class="wrap">
        <p class="cap-n">04 · Lo que vendemos</p>
        <h2>No vendemos horas de estudio: <span class="si">vendemos la voz pública.</span></h2>
        <div class="rejilla r3 bloque carr">
          <div class="tarjeta rv"><h3>Para el cliente</h3><ul class="lista" data-max="4">{((D.propuesta_valor && D.propuesta_valor.cliente) || []).map((x: string) => <li>{x}</li>)}</ul></div>
          <div class="tarjeta rv"><h3>Para su público</h3><ul class="lista" data-max="4">{((D.propuesta_valor && D.propuesta_valor.publico) || []).map((x: string) => <li>{x}</li>)}</ul></div>
          <div class="tarjeta rv"><h3>Por qué nosotros</h3><ul class="lista" data-max="4">{((D.propuesta_valor && D.propuesta_valor.diferenciadores) || []).map((x: string) => <li>{x}</li>)}</ul></div>
        </div>
<p class="desliza-hint" aria-hidden="true">Desliza para ver más →</p>
        <h3 class="bloque">Paquetes</h3>
        <p class="lead">Precios propuestos para arrancar en Durango, sin IVA. El margen sale del costo directo estimado de cada uno; toca "Cómo se calculó" para ver de dónde sale el precio.</p>
        <div class="rejilla r3 carr" style="margin-top:16px">
          {(D.paquetes || []).map((p: any) => {
            const margen = typeof p.costo_directo_mxn === 'number' && p.precio_mxn ? Math.round((1 - p.costo_directo_mxn / p.precio_mxn) * 100) : null;
            return (
              <article class="tarjeta rv">
                <h3>{p.nombre}</h3>
                {p.para_quien && <p class="nota" style="margin-top:-4px">Para: {p.para_quien}</p>}
                <div class="precio">{mxn(p.precio_mxn)} <small>{p.unidad}</small></div>
                <ul class="lista">{(p.incluye || []).map((x: string) => <li>{x}</li>)}</ul>
                <div class="mini pie">
                  {margen !== null && <span>Margen bruto ≈ <b>{margen}%</b></span>}
                  {typeof p.horas_humanas === 'number' && <span><b>{p.horas_humanas} h</b> humanas</span>}
                </div>
                {p.nota_precio && <details class="ver-tabla"><summary>Cómo se calculó</summary><p class="nota" style="margin-top:6px">{p.nota_precio}</p></details>}
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 05 MVP -->
    <section class="sec gris" id="mvp">
      <div class="wrap">
        <p class="cap-n">05 · El arranque</p>
        <h2>El mínimo que se ve <span class="si">de primer nivel.</span></h2>
        <p class="lead">Tres niveles de equipo. Elige uno: el total alimenta el simulador de números.</p>
        <div class="equipo-cab">
          <div class="seg" id="seg-nivel" role="group" aria-label="Nivel de equipo">
            {niveles.map((n: any, i: number) => <button type="button" data-i={i} aria-pressed={i === iRec ? 'true' : 'false'}>{n.nivel}</button>)}
          </div>
          <div class="total-grande"><span class="nota">Total del equipo</span><b id="equipo-total">{mxn(niveles[iRec] && niveles[iRec].total_mxn)}</b></div>
        </div>
        <p class="nota" id="equipo-resumen" style="margin-top:10px">{niveles[iRec] && niveles[iRec].resumen}</p>
        <div class="tarjeta" style="margin-top:16px;padding:8px 16px">
          <table class="tabla apila" id="equipo-tabla">
            <thead><tr><th>Equipo</th><th class="num">Cant.</th><th class="num">Subtotal</th></tr></thead>
            <tbody></tbody>
          </table>
        </div>
        <div class="rejilla r2 bloque">
          <div class="tarjeta rv"><h3>Sobre el equipo que pensamos</h3><ul class="lista" data-max="3">{(D.sobre_el_equipo_pensado || []).map((x: string) => <li>{x}</li>)}</ul></div>
          <div class="tarjeta rv"><h3>El espacio</h3><ul class="lista" data-max="3">{(D.espacio || []).map((x: string) => <li>{x}</li>)}</ul></div>
        </div>
      </div>
    </section>

    <!-- 06 Opera -->
    <section class="sec" id="opera">
      <div class="wrap">
        <p class="cap-n">06 · Cómo opera</p>
        <h2>Un episodio, de la agenda <span class="si">a las redes.</span></h2>
        <p class="lead">Cada paso con sus minutos de trabajo humano sin IA y con IA. Toca un paso para ver qué pasa y con qué herramienta.</p>
        <div class="ahorro">
          <div class="tarjeta"><span class="nota">Sin IA, por episodio</span><div class="cifra cifra-chica">{(minManual / 60).toLocaleString('es-MX', { maximumFractionDigits: 1 })} h</div></div>
          <div class="tarjeta"><span class="nota">Con IA, por episodio</span><div class="cifra cifra-chica">{(minIa / 60).toLocaleString('es-MX', { maximumFractionDigits: 1 })} h</div></div>
          <div class="tarjeta"><span class="nota">Ahorro</span><div class="cifra cifra-chica">{minManual ? Math.round((1 - minIa / minManual) * 100) : 0}%</div></div>
        </div>
        <div class="leyenda"><span><i style="background:var(--s-manual)"></i>Sin IA</span><span><i style="background:var(--s-ia)"></i>Con IA</span></div>
        <div class="flujo" id="flujo">
          {(D.flujo || []).map((f: any, i: number) => {
            const max = Math.max(1, ...(D.flujo || []).map((x: any) => x.min_humanos_manual || 0));
            return (
              <details class="paso">
                <summary>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="nom">{f.paso}</span>
                  <span class="min">{f.min_humanos_manual} → <b>{f.min_humanos_con_ia}</b> min</span>
                  <span class="barras2" aria-hidden="true">
                    <i style={`background:var(--s-manual);width:${(100 * (f.min_humanos_manual || 0)) / max}%`}></i>
                    <i style={`background:var(--s-ia);width:${(100 * (f.min_humanos_con_ia || 0)) / max}%`}></i>
                  </span>
                </summary>
                <div class="cuerpo">
                  <span class={`auto ${f.automatizacion}`} style="width:fit-content">{f.automatizacion === 'total' ? 'Automático' : f.automatizacion === 'parcial' ? 'IA + revisión humana' : 'Humano'}</span>
                  <p>{f.que_pasa}</p>
                  <p><b>Herramienta:</b> {f.herramienta}</p>
                </div>
              </details>
            );
          })}
        </div>

        <h3 class="bloque">El stack de IA</h3>
        <details class="tarjeta ver-tabla" style="margin-top:12px;padding:14px 16px">
          <summary>Ver las {(D.stack_ia || []).length} herramientas y lo que cuestan al mes</summary>
          <table class="tabla apila">
            <thead><tr><th>Para qué</th><th>Herramienta</th><th class="num">Al mes</th></tr></thead>
            <tbody>
              {(D.stack_ia || []).map((s: any) => (
                <tr>
                  <td><b>{s.categoria}</b><small>{s.uso}</small></td>
                  <td>{s.url ? <a href={s.url} target="_blank" rel="noopener">{s.herramienta}</a> : s.herramienta}{s.alternativa && <small>Alternativa: {s.alternativa}</small>}</td>
                  <td class="num">{typeof s.precio_mes_mxn === 'number' ? (s.precio_mes_mxn > 0 ? mxn(s.precio_mes_mxn) : 'Incluido') : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>

        <div class="rejilla r2 bloque">
          <div class="tarjeta rv">
            <span class="etq oro">Claude Code</span>
            <h3>Lo que habilita</h3>
            <ul class="lista" data-max="3">{((D.claude_code && D.claude_code.que_habilita) || []).map((x: string) => <li>{x}</li>)}</ul>
            <h3 style="margin-top:12px">Sus límites</h3>
            <ul class="lista menos" data-max="3">{((D.claude_code && D.claude_code.limites) || []).map((x: string) => <li>{x}</li>)}</ul>
          </div>
          <div class="tarjeta rv">
            <span class="etq">Real contra humo</span>
            <ul class="lista" data-max="4">{((D.claude_code && D.claude_code.hype_vs_real) || []).map((x: string) => <li>{x}</li>)}</ul>
            {D.claude_code && D.claude_code.laptop_actual && <p class="nota" style="margin-top:8px"><b>La laptop de hoy:</b> {D.claude_code.laptop_actual}</p>}
          </div>
        </div>
        <h3 class="bloque">¿Servidor propio? Por etapas</h3>
        <div class="rejilla r3 carr" style="margin-top:12px">
          {((D.claude_code && D.claude_code.servidor) || []).map((s: any) => (
            <article class="tarjeta rv">
              <span class="etq">{s.etapa}</span>
              <h3>{s.hardware}</h3>
              <div class="precio" style="font-size:1.4rem">{typeof s.costo_mxn === 'number' ? (s.costo_mxn > 0 ? mxn(s.costo_mxn) : 'Sin costo extra') : 'Por cotizar'}</div>
              <p class="nota">{s.cuando}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 07 Personas -->
    <section class="sec gris" id="personas">
      <div class="wrap">
        <p class="cap-n">07 · Quién lo hace</p>
        <h2>Plantilla mínima, <span class="si">capacidad alta.</span></h2>
        <p class="lead">Quién hace qué en cada fase. Cambia de fase para ver cómo crece el equipo.</p>
        <div class="bloque" style="display:flex;flex-wrap:wrap;gap:16px;align-items:center;justify-content:space-between">
          <div class="seg" id="seg-fase" role="group" aria-label="Fase">
            <button type="button" data-f="0" aria-pressed="true">Arranque</button>
            <button type="button" data-f="1" aria-pressed="false">Tracción</button>
            <button type="button" data-f="2" aria-pressed="false">Escala</button>
          </div>
          <div class="nota" id="nomina">—</div>
        </div>
        <div class="rejilla r3 personas" id="personas-lista"></div>
        {D.horas_miguel && (
          <div class="tarjeta bloque">
            <span class="etq">¿De verdad es un negocio paralelo?</span>
            <h3 style="margin-top:6px">Horas de Miguel por semana</h3>
            <p class="nota" style="color:var(--mid)">La meta es quedar abajo de {D.horas_miguel.meta} horas por semana. {D.horas_miguel.nota}</p>
            <div class="grafica" id="g-horas" role="img" aria-label="Horas de Miguel por semana, de noviembre de 2026 a diciembre de 2027"></div>
            <details class="ver-tabla"><summary>Ver la tabla</summary>
              <table class="tabla"><thead><tr><th>Mes</th><th class="num">Horas por semana</th></tr></thead>
                <tbody>{D.horas_miguel.serie.map((s: any) => <tr><td>{s.mes}</td><td class="num">{s.h.toLocaleString('es-MX')}</td></tr>)}</tbody></table>
            </details>
          </div>
        )}
        <h3 class="bloque">Los socios</h3>
        <div class="rejilla r2" style="margin-top:12px">
          {(D.socios || []).map((s: any) => (
            <article class="tarjeta rv">
              <h3>{s.quien}</h3>
              <p class="nota" style="margin-top:-4px"><b>Horas por semana:</b> {s.horas_semana}</p>
              <p><b>Aporta:</b> {s.aporta}</p>
              <p class="nota"><b>Decide:</b> {s.decide}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 08 Hitos -->
    <section class="sec" id="hitos">
      <div class="wrap">
        <p class="cap-n">08 · Hitos</p>
        <h2>No se escala por fecha: <span class="si">se escala por prueba.</span></h2>
        <p class="lead">Cada hito tiene una condición medible. Si no se cumple, no se invierte en el siguiente. Toca uno para ver el detalle.</p>
        <div class="hitos">
          {(D.hitos || []).map((h: any, i: number) => (
            <details class="hito rv" open={i === 0}>
              <summary>
                <span class="hid">{h.id}</span>
                <span><span class="hn">{h.nombre}</span><br /><span class="hp">{h.fase}{h.plazo ? ` · ${h.plazo}` : ''}{typeof h.inversion_mxn === 'number' && h.inversion_mxn > 0 ? ` · ${corto(h.inversion_mxn)}` : ''}</span></span>
                <span class="mas" aria-hidden="true">+</span>
              </summary>
              <div class="cuerpo">
                <div class="criterio"><b>Para pasar</b>{h.criterio}</div>
                {h.kpis && h.kpis.length > 0 && <ul class="lista">{h.kpis.map((k: string) => <li>{k}</li>)}</ul>}
                <p><b>Desbloquea:</b> {h.desbloquea}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- 09 Números -->
    <section class="sec osc" id="numeros">
      <div class="wrap">
        <p class="cap-n">09 · Los números</p>
        <h2>Juega con <span class="si">el mes.</span></h2>
        <p class="lead">Elige un escenario o mueve cuántos paquetes se venden al mes. El simulador usa el precio, el costo directo y las horas de cada paquete, los costos fijos de la fase y el equipo que elegiste en el capítulo 5.</p>
        <div class="bloque" style="display:grid;gap:12px">
          <div><span class="nota" style="display:block;margin-bottom:6px">Escenario</span><div class="seg" id="seg-esc" role="group" aria-label="Escenarios"></div></div>
          <div><span class="nota" style="display:block;margin-bottom:6px">Costos fijos de la fase</span><div class="seg" id="seg-fijos" role="group" aria-label="Costos fijos de la fase"></div></div>
        </div>
        <p class="nota" id="esc-nota" style="margin-top:12px"></p>
        <div class="sim">
          <div id="sim-paquetes"></div>
          <div class="sim-lado">
            <div class="res" id="sim-res"></div>
            <p class="nota" id="sim-pie" style="margin-top:8px"></p>
            <div style="margin-top:14px">
              <span class="nota" id="cap-txt">Horas humanas al mes</span>
              <div class="capacidad" id="cap-barra"><i></i></div>
            </div>
          </div>
        </div>
        <div class="rejilla r2 bloque">
          <div class="tarjeta"><h3>Costos fijos al mes (etapa 1, sin local)</h3>
            <table class="tabla" style="color:#fff"><tbody>
              {((D.finanzas && D.finanzas.costos_fijos_mes) || []).map((c: any) => <tr><td style="border-color:var(--line-d)">{c.concepto}</td><td class="num" style="border-color:var(--line-d)">{mxn(c.mxn)}</td></tr>)}
            </tbody></table>
          </div>
          <div class="tarjeta"><h3>Supuestos</h3><ul class="lista" data-max="3">{((D.finanzas && D.finanzas.supuestos) || []).map((x: string) => <li>{x}</li>)}</ul>
            {D.finanzas && D.finanzas.punto_equilibrio && <p class="nota" style="margin-top:8px"><b>Punto de equilibrio:</b> {D.finanzas.punto_equilibrio}</p>}
          </div>
        </div>
      </div>
    </section>

    <!-- 10 Dinero del socio -->
    <section class="sec" id="dinero">
      <div class="wrap">
        <p class="cap-n">{nCap('dinero')} · El dinero del socio</p>
        <h2>Cuánto se pone <span class="si">y cuándo regresa.</span></h2>
        <p class="lead">El capital entra por tramos y cada tramo tiene su condición. Si una condición no se cumple, no se pone el siguiente peso.</p>
        <div class="tramos">
          {capital.tramos.map((t: any, i: number) => (
            <article class="tarjeta tramo rv">
              <span class={`etq ${i === 0 ? 'oro' : ''}`}>{t.nombre} · {t.cuando}</span>
              <div class="grande">{mxn(t.mxn)}</div>
              <h3>{t.para}</h3>
              <table><tbody>{(t.partes || []).map((p: any) => <tr><td>{p.concepto}</td><td class="num">{mxn(p.mxn)}</td></tr>)}</tbody></table>
              <p class="disp"><b>Condición:</b> {t.disparador}</p>
            </article>
          ))}
          <article class="tarjeta tramo rv">
            <span class="etq">De la caja del negocio</span>
            <div class="grande">{mxn((capital.de_la_caja || []).reduce((s: number, c: any) => s + (c.mxn || 0), 0))}</div>
            <h3>Lo que ya no pone el socio</h3>
            <table><tbody>{(capital.de_la_caja || []).map((p: any) => <tr><td>{p.concepto}</td><td class="num">{mxn(p.mxn)}</td></tr>)}</tbody></table>
            <p class="disp">{capital.nota}</p>
          </article>
        </div>
        <p class="nota" style="margin-top:14px">Capital máximo del inversionista: <b style="color:var(--c)">{mxn(capital.maximo)}</b> en los escenarios base y fuerte, y {mxn(capital.maximo_lento)} en el lento (estimado).</p>

        <h3 class="bloque">La curva de la caja</h3>
        <p class="lead">Lo que lleva puesto el negocio, mes a mes, en el escenario base: cae mientras se compra y se arranca, toca fondo y sube con las igualas. Pasa el dedo o el cursor por la curva.</p>
        <div class="tarjeta" style="margin-top:14px">
          {serieCaja.length > 0 && (
            <div class="rejilla r3" style="gap:8px">
              <div><span class="nota">Punto más bajo</span><div class="cifra cifra-chica">{mxn(serieCaja[iBajo].acumulado).replace('$-', '−$')}</div><span class="nota">{serieCaja[iBajo].mes}: es lo máximo que está en riesgo</span></div>
              <div><span class="nota">Vuelve a positivo</span><div class="cifra cifra-chica">{iCruce >= 0 ? serieCaja[iCruce].mes : '—'}</div><span class="nota">mes {iCruce + 1}, antes de impuestos</span></div>
              <div><span class="nota">A dic-2028</span><div class="cifra cifra-chica">+{mxn(serieCaja[serieCaja.length - 1].acumulado)}</div><span class="nota">acumulado (supuesto)</span></div>
            </div>
          )}
          <div class="grafica" id="g-caja" role="img" aria-label="Caja acumulada del escenario base de noviembre de 2026 a diciembre de 2028"></div>
          <div class="leyenda" style="margin:10px 0 0"><span><i style="background:var(--c)"></i>Estimado mes a mes</span><span><i style="background:repeating-linear-gradient(90deg,var(--c) 0 4px,transparent 4px 7px)"></i>Supuesto 2028</span></div>
          <p class="nota" style="margin-top:8px">{fc.nota}</p>
          <details class="ver-tabla"><summary>Ver la tabla</summary>
            <div class="desliza"><table class="tabla"><thead><tr><th>Mes</th><th class="num">Acumulado</th><th>Tipo</th></tr></thead>
              <tbody>{serieCaja.map((s: any) => <tr><td>{s.mes}</td><td class="num">{(s.acumulado < 0 ? '−' : '') + mxn(Math.abs(s.acumulado))}</td><td>{s.tipo}</td></tr>)}</tbody></table></div>
          </details>
        </div>
        <div class="rejilla r2" style="margin-top:12px">
          {(fc.otros || []).map((o: any) => <article class="tarjeta rv"><span class="etq">Escenario {o.nombre.toLowerCase()}</span><p>{o.texto}</p></article>)}
        </div>

        {F.reparto && (
          <div>
            <h3 class="bloque">¿Cuánto recibe el inversionista a 3 años?</h3>
            <p class="lead">Tres maneras de repartir entre el capital y el trabajo. Elige una para ver lo que recibiría en cada escenario, en veces su capital. La línea punteada es recuperar lo que puso.</p>
            <div style="margin-top:16px"><div class="seg" id="seg-reparto" role="group" aria-label="Estructura de reparto"></div></div>
            <div class="tarjeta" style="margin-top:14px">
              <p id="reparto-regla" style="font-weight:600"></p>
              <div class="multiplos" id="reparto-barras" aria-live="polite"></div>
              <p class="nota" style="margin-top:8px">{F.reparto.nota}</p>
              <p class="nota">{F.reparto.despues}</p>
            </div>
          </div>
        )}

        {(F.criterios_cierre || []).length > 0 && (
          <div>
            <h3 class="bloque">Cuándo se cierra, por escrito</h3>
            <p class="lead">Las reglas para parar se firman desde el principio, en el acuerdo de socios.</p>
            <div class="rejilla r3" style="margin-top:14px">
              {F.criterios_cierre.map((c: any) => (
                <article class="tarjeta cierre rv">
                  <span class="cuando">{c.cuando}</span>
                  <p><b>Si</b> {c.si.charAt(0).toLowerCase() + c.si.slice(1)}</p>
                  <p class="nota" style="color:var(--mid)"><b>Entonces:</b> {c.entonces}</p>
                </article>
              ))}
            </div>
            {fc.perdida_cierre && <p class="nota" style="margin-top:12px">{fc.perdida_cierre}</p>}
          </div>
        )}
      </div>
    </section>

    <!-- 11 Política -->
    <section class="sec osc" id="politica" style="border-top:1px solid var(--line-d)">
      <div class="wrap">
        <p class="cap-n">{nCap('politica')} · El nicho político</p>
        <h2>La oportunidad <span class="si">y sus reglas.</span></h2>
        <p class="lead pl">{D.politica && D.politica.oportunidad}</p>
        <div class="rejilla r2 bloque carr">
          {((D.politica && D.politica.evidencia) || []).map((e: any) => (
            <article class="tarjeta rv"><p>{e.texto}</p><div class="pie"><a class="fuente" href={e.url} target="_blank" rel="noopener">{host(e.url)}</a></div></article>
          ))}
        </div>
        <div class="rejilla r2 bloque" style="align-items:start">
          <div>
            <h3>El calendario</h3>
            <div class="linea">
              {((D.politica && D.politica.calendario) || []).map((c: any) => (
                <div class="ev"><div class="fecha">{c.fecha}</div><div class="que">{c.evento}</div>{c.que_significa && <div class="sig">{c.que_significa}</div>}</div>
              ))}
            </div>
          </div>
          <div>
            <h3>Las reglas que nos tocan</h3>
            <div style="display:grid;gap:10px;margin-top:14px">
              {((D.politica && D.politica.reglas) || []).map((r: any) => (
                <details class="tarjeta" style="padding:16px">
                  <summary style="cursor:pointer;font-weight:700">{r.regla}</summary>
                  <p style="margin-top:8px;color:rgba(255,255,255,.75)">{r.que_implica}</p>
                  {r.url && <a class="fuente" href={r.url} target="_blank" rel="noopener">{host(r.url)}</a>}
                </details>
              ))}
            </div>
          </div>
        </div>
        <div class="balanza bloque">
          <div class="tarjeta"><h3>Riesgos de trabajar con políticos</h3><ul class="lista" data-max="4">{((D.politica && D.politica.riesgos) || []).map((x: string) => <li>{x}</li>)}</ul></div>
          <div class="tarjeta"><h3>Cómo los cuidamos</h3><ul class="lista" data-max="4">{((D.politica && D.politica.mitigacion) || []).map((x: string) => <li>{x}</li>)}</ul></div>
        </div>
      </div>
    </section>

    <!-- 11 Durango -->
    <section class="sec" id="durango">
      <div class="wrap">
        <p class="cap-n">{nCap('durango')} · Durango</p>
        <h2>El mercado <span class="si">que tenemos enfrente.</span></h2>
        <div class="rejilla r3 bloque carr">
          {(D.mercado_durango || []).map((m: any) => (
            <article class="tarjeta rv"><div class="cifra cifra-chica">{m.cifra}</div><p>{m.texto}</p>{m.url && <div class="pie"><a class="fuente" href={m.url} target="_blank" rel="noopener">{host(m.url)}</a></div>}</article>
          ))}
        </div>
        <h3 class="bloque">Nichos, en orden de ataque</h3>
        <ol class="rejilla r2" style="list-style:none;margin-top:12px">
          {[...(D.nichos || [])].sort((a: any, b: any) => (a.prioridad || 9) - (b.prioridad || 9)).map((n: any, i: number) => (
            <li class="tarjeta rv" style="flex-direction:row;gap:14px;align-items:flex-start">
              <span class="hid" style="flex:none;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--c);color:#fff;font-weight:900;font-size:.85rem">{i + 1}</span>
              <span><b>{n.nicho}</b><br /><span class="nota" style="color:var(--mid)">{n.por_que}</span></span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 12 Escalar -->
    <section class="sec gris" id="escalar">
      <div class="wrap">
        <p class="cap-n">{nCap('escalar')} · De estudio a casa de medios</p>
        <h2>Cada compra <span class="si">la paga la anterior.</span></h2>
        <p class="lead">La infraestructura crece por disparadores medibles, no por ganas.</p>
        <div class="escalera">
          {(D.escalamiento || []).map((e: any, i: number) => (
            <article class="peldano rv" style={`--i:${i}`}>
              <span class="pn">{i + 1}</span>
              <div>
                <span class="etq">{e.etapa}{typeof e.costo_mxn === 'number' && e.costo_mxn > 0 ? ` · ${corto(e.costo_mxn)}` : ''}</span>
                <h3 style="margin-top:8px">{e.adquiere}</h3>
                <p>{e.habilita}</p>
                <p class="disp"><b>Disparador:</b> {e.disparador}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 13 Riesgos -->
    <section class="sec" id="riesgos">
      <div class="wrap">
        <p class="cap-n">{nCap('riesgos')} · Riesgos</p>
        <h2>Lo que puede salir mal <span class="si">y qué hacemos.</span></h2>
        <p class="lead">Toca una celda de la matriz para ver sus riesgos. Entre más oscura, más riesgos caen ahí.</p>
        <div class="matriz-wrap">
          <div>
            <div class="matriz" id="matriz" role="group" aria-label="Matriz de riesgos: probabilidad por impacto"></div>
            <p class="nota" style="margin-top:8px;text-align:center">Impacto →</p>
          </div>
          <div id="riesgos-lista" aria-live="polite"></div>
        </div>
        <h3 class="bloque">Cómo subimos la probabilidad de éxito</h3>
        <div class="rejilla r2" style="margin-top:12px">
          {(D.palancas_exito || []).map((p: string, i: number) => (
            <div class="tarjeta rv" style="flex-direction:row;gap:14px"><span class="cap-n" style="flex:none">{String(i + 1).padStart(2, '0')}</span><p>{p}</p></div>
          ))}
        </div>
      </div>
    </section>

    <!-- 14 Decidir -->
    <section class="sec gris" id="decidir">
      <div class="wrap">
        <p class="cap-n">{nCap('decidir')} · Lo que decidimos juntos</p>
        <h2>Tu voto, <span class="si">pregunta por pregunta.</span></h2>
        <p class="lead">Elige una opción en cada decisión. Se guarda en este teléfono; al final puedes copiar tus respuestas y mandárselas a Miguel.</p>
        <div class="rejilla r2 bloque" id="decisiones">
          {(D.decisiones || []).map((q: any, i: number) => (
            <div class="decision" data-q={i}>
              <span class="cap-n">Decisión {i + 1}</span>
              <h3>{q.pregunta}</h3>
              <div class="chips" role="group" aria-label={q.pregunta}>
                {(q.opciones || []).map((o: string) => <button type="button" class="chip" data-op={o} aria-pressed="false">{o}</button>)}
              </div>
              {q.recomendacion && <p class="rec"><b>Recomendación:</b> {corte(q.recomendacion)[0]}</p>}
              {q.recomendacion && corte(q.recomendacion)[1] && <details class="ver-tabla"><summary>Por qué</summary><p class="rec pl" style="margin-top:6px">{corte(q.recomendacion)[1]}</p></details>}
            </div>
          ))}
        </div>
        <div class="barra-dec"><span id="dec-cuenta">0 de {(D.decisiones || []).length} decididas</span><button class="btn btn-claro" type="button" id="dec-copiar" style="padding:10px 18px">Copiar mis respuestas</button></div>

        <h3 class="bloque">La estructura legal</h3>
        <details class="ver-tabla" style="margin-top:8px"><summary>Ver los {(D.estructura_legal || []).length} temas legales y fiscales</summary>
        <div class="rejilla r2" style="margin-top:12px">
          {(D.estructura_legal || []).map((e: any) => (
            <article class="tarjeta rv"><h3>{e.tema}</h3><p>{e.recomendacion}</p>{e.url && <div class="pie"><a class="fuente" href={e.url} target="_blank" rel="noopener">{host(e.url)}</a></div>}</article>
          ))}
        </div>
        </details>
        {(D.por_confirmar || []).length > 0 && (
          <div class="tarjeta bloque">
            <span class="etq">Por confirmar</span>
            <p class="nota" style="color:var(--mid)">Lo que la investigación no pudo confirmar y hay que averiguar antes de firmar.</p>
            <ul class="lista" data-max="5">{D.por_confirmar.map((x: string) => <li>{x}</li>)}</ul>
          </div>
        )}
      </div>
    </section>

    <!-- 15 Fuentes -->
    <section class="sec" id="fuentes">
      <div class="wrap">
        <p class="cap-n">{nCap('fuentes')} · Fuentes</p>
        <h2>De dónde sale <span class="si">cada número.</span></h2>
        <p class="lead">{(D.fuentes || []).length} fuentes. Cada dato pasó por un verificador que intentó refutarlo; lo que no se pudo confirmar se corrigió, se descartó o quedó marcado como estimación.</p>
        <details class="ver-tabla" style="margin-top:16px"><summary>Ver las {(D.fuentes || []).length} fuentes</summary>
        <ol class="fuentes">
          {(D.fuentes || []).map((f: any) => <li><a href={f.url} target="_blank" rel="noopener">{f.titulo}</a> <small>{host(f.url)}</small></li>)}
        </ol>
        </details>
      </div>
    </section>
  </main>

  <footer class="pie-pag">
    <div class="wrap">
      <p>Preparado por <b>antemano</b> · Taller Creativo · Durango, México</p>
      <p style="margin-top:6px">Documento privado para socios. "Voz Durango" es un nombre de trabajo para una empresa nueva, separada de Antemano. Investigación al 13 de noviembre de 2026: los precios y las reglas cambian, hay que confirmarlos antes de decidir.</p>
    </div>
  </footer>

  <script>
    const d = JSON.parse(document.getElementById('datos')!.textContent || '{}');
    const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T | null;
    const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<HTMLElement>(s));
    const mxn = (n: number) => (n < 0 ? '−$' : '$') + Math.round(Math.abs(n)).toLocaleString('es-MX');
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const guardar = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
    const leer = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };

    function segmentado(cont: HTMLElement, alElegir: (b: HTMLElement) => void) {
      cont.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button');
        if (!b || !cont.contains(b)) return;
        $$('button', cont).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        alElegir(b as HTMLElement);
      });
    }

    /* ── Barra superior, índice y progreso ── */
    const indice = $('#indice')!, btnIndice = $('#btn-indice')!;
    btnIndice.addEventListener('click', () => {
      const ab = indice.classList.toggle('abierto');
      btnIndice.setAttribute('aria-expanded', String(ab));
    });
    indice.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) { indice.classList.remove('abierto'); btnIndice.setAttribute('aria-expanded', 'false'); } });
    const btnMov = $('#btn-mov')!;
    const pintarMov = () => (btnMov.textContent = document.documentElement.classList.contains('anim') ? 'Encendidas' : 'Apagadas');
    pintarMov();
    btnMov.addEventListener('click', () => {
      const on = document.documentElement.classList.toggle('anim');
      guardar('ep-mov', on ? '1' : '0');
      if (on) $$('.rv').forEach((el) => el.classList.add('ok'));
      pintarMov();
    });
    const prog = $('#top-prog')!, cap = $('#top-cap')!;
    const secciones = $$('main section[id]');
    const nombres: Record<string, string> = {};
    $$('#indice a').forEach((a) => (nombres[a.dataset.cap!] = a.textContent!.replace(/^\d+/, '')));
    let ticking = false;
    function alScroll() {
      ticking = false;
      const h = document.documentElement;
      prog.style.width = (100 * h.scrollTop) / Math.max(1, h.scrollHeight - h.clientHeight) + '%';
      let actual = 'inicio';
      for (const s of secciones) if (s.getBoundingClientRect().top < 120) actual = s.id;
      cap.innerHTML = actual === 'inicio' ? '<b>Voz Durango</b> · proyecto ejecutivo' : `<b>${esc(nombres[actual] || '')}</b>`;
      $$('#indice a').forEach((a) => a.classList.toggle('actual', a.dataset.cap === actual));
    }
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(alScroll); } }, { passive: true });
    alScroll();

    /* ── Listas largas: primeras N y "Ver más" (sin JS se ve todo) ── */
    function acortarListas(raiz: ParentNode) { $$('ul.lista[data-max]', raiz).forEach((ul) => {
      const max = +ul.dataset.max!, lis = Array.from(ul.children) as HTMLElement[];
      if (lis.length <= max + 1) return;
      const resto = lis.slice(max);
      resto.forEach((li) => li.classList.add('oculto'));
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'ver-mas'; b.setAttribute('aria-expanded', 'false');
      const txt = () => (b.getAttribute('aria-expanded') === 'true' ? 'Ver menos' : `Ver ${resto.length} más`);
      b.textContent = txt();
      b.addEventListener('click', () => {
        const abrir = b.getAttribute('aria-expanded') !== 'true';
        resto.forEach((li) => li.classList.toggle('oculto', !abrir));
        b.setAttribute('aria-expanded', String(abrir)); b.textContent = txt();
      });
      ul.after(b);
    }); }
    acortarListas(document);

    /* ── Aparición suave ── */
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('ok'); io.unobserve(en.target); } }), { rootMargin: '0px 0px -8% 0px' });
      $$('.rv').forEach((el) => io.observe(el));
    } else $$('.rv').forEach((el) => el.classList.add('ok'));

    /* ── Casos: filtro por tipo ── */
    const casos = $$('#casos-lista > article');
    const tipos = Array.from(new Set(casos.map((c) => c.dataset.tipo || '').filter(Boolean)));
    const filtro = $('#filtro-casos')!;
    filtro.innerHTML = ['todos', ...tipos].map((t, i) => `<button type="button" class="chip" data-t="${esc(t)}" aria-pressed="${i === 0}">${esc(t === 'todos' ? `Todos (${casos.length})` : t[0].toUpperCase() + t.slice(1))}</button>`).join('');
    filtro.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      $$('button', filtro).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const t = b.dataset.t;
      casos.forEach((c) => c.classList.toggle('oculto', t !== 'todos' && c.dataset.tipo !== t));
    });

    /* ── Caminos ── */
    const ops: any[] = d.opciones || [];
    const segCam = $('#seg-caminos')!, panelCam = $('#camino-panel')!;
    const iOp = Math.max(0, ops.findIndex((o) => o.recomendada));
    segCam.innerHTML = ops.map((o, i) => `<button type="button" data-i="${i}" aria-pressed="${i === iOp}">${esc(o.id)} · ${esc(o.corto || o.nombre)}${o.recomendada ? ' ★' : ''}</button>`).join('');
    const criterios: [string, string][] = [['probabilidad_exito', 'Probabilidad de éxito'], ['tiempo_socios', 'Poco tiempo de socios'], ['recurrencia', 'Ingreso recurrente'], ['riesgo', 'Riesgo controlado'], ['escalabilidad', 'Escalabilidad']];
    function pintarCamino(i: number) {
      const o = ops[i]; if (!o) return;
      const p = o.puntajes || {};
      panelCam.innerHTML = `
        <div class="tarjeta">
          ${o.recomendada ? '<span class="etq oro">Recomendado</span>' : '<span class="etq">Alternativa</span>'}
          <h3 style="font-size:1.5rem;margin-top:6px">${esc(o.nombre)}</h3>
          <p style="color:rgba(255,255,255,.78)">${esc(o.tesis)}</p>
          <div class="balanza" style="margin-top:10px">
            <div><b>A favor</b><ul class="lista" data-max="3" style="margin-top:8px">${(o.pros || []).map((x: string) => `<li>${esc(x)}</li>`).join('')}</ul></div>
            <div><b>En contra</b><ul class="lista" data-max="3" style="margin-top:8px">${(o.contras || []).map((x: string) => `<li>${esc(x)}</li>`).join('')}</ul></div>
          </div>
        </div>
        <div class="tarjeta">
          <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px">
            <span class="nota">Puntaje del juez</span><span class="cifra">${Math.round(o.puntaje)}<small style="font-size:1rem;color:rgba(255,255,255,.5)">/100</small></span>
          </div>
          ${typeof o.inversion_mxn === 'number' ? `<p class="nota">Inversión inicial ≈ <b style="color:#fff">${mxn(o.inversion_mxn)}</b></p>` : ''}
          <div class="barras" style="margin-top:10px">
            ${criterios.filter(([k]) => typeof p[k] === 'number').map(([k, t]) => `<div class="barra"><span>${t}</span><b>${Math.round(p[k])}</b><span class="pista"><i style="--v:${Math.max(0, Math.min(100, p[k]))}%"></i></span></div>`).join('')}
          </div>
        </div>`;
    }
    segmentado(segCam, (b) => { pintarCamino(+b.dataset.i!); acortarListas(panelCam); });
    pintarCamino(iOp); acortarListas(panelCam);

    /* ── Equipo por nivel ── */
    const niveles: any[] = d.equipo_niveles || [];
    let nivel = Math.max(0, niveles.findIndex((n) => /recom/i.test(n.nivel || '')));
    const totalNivel = (n: any) => (n.items || []).reduce((s: number, it: any) => s + (it.cantidad || 0) * (it.precio_unit_mxn || 0), 0) || n.total_mxn || 0;
    function pintarEquipo() {
      const n = niveles[nivel]; if (!n) return;
      const grupos: Record<string, any[]> = {};
      (n.items || []).forEach((it: any) => (grupos[it.categoria || 'Otros'] ||= []).push(it));
      $('#equipo-tabla tbody')!.innerHTML = Object.entries(grupos).map(([cat, its]) =>
        `<tr class="cat"><td colspan="3">${esc(cat)}</td></tr>` + its.map((it) => `
          <tr><td>${it.url ? `<a href="${esc(it.url)}" target="_blank" rel="noopener">${esc(it.item)}</a>` : esc(it.item)}${it.por_que ? `<small>${esc(it.por_que)}</small>` : ''}</td>
          <td class="num">${it.cantidad} × ${mxn(it.precio_unit_mxn || 0)}</td>
          <td class="num"><b>${mxn((it.cantidad || 0) * (it.precio_unit_mxn || 0))}</b></td></tr>`).join('')).join('');
      $('#equipo-total')!.textContent = mxn(totalNivel(n));
      $('#equipo-resumen')!.textContent = n.resumen || '';
      pintarSim();
    }
    segmentado($('#seg-nivel')!, (b) => { nivel = +b.dataset.i!; pintarEquipo(); });

    /* ── Personas por fase ── */
    const personas: any[] = d.personas || [];
    const ordenFase = (f: string) => (/escala/i.test(f) ? 2 : /tracc/i.test(f) ? 1 : 0);
    function pintarPersonas(f: number) {
      const entran = personas.filter((p) => ordenFase(p.fase || '') <= f);
      const reemplazados = new Set(entran.map((p) => p.reemplaza).filter(Boolean));
      const activos = entran.filter((p) => !reemplazados.has(p.rol));
      $('#personas-lista')!.innerHTML = activos.map((p) => `
        <article class="tarjeta rol ${ordenFase(p.fase || '') === f && f > 0 ? 'nuevo' : ''}">
          <span class="etq">${esc(p.fase)}${ordenFase(p.fase || '') === f && f > 0 ? ' · entra aquí' : ''}</span>
          <h3>${esc(p.rol)}</h3>
          <span class="ded">${esc(p.dedicacion)}</span>
          <ul class="lista">${(p.hace || []).map((x: string) => `<li>${esc(x)}</li>`).join('')}</ul>
          ${p.perfil ? `<p class="nota">${esc(p.perfil)}</p>` : ''}
          ${typeof p.costo_mes_mxn === 'number' ? `<p class="nota pie">≈ ${mxn(p.costo_mes_mxn)} al mes</p>` : ''}
        </article>`).join('');
      const nom = activos.reduce((s, p) => s + (typeof p.costo_mes_mxn === 'number' ? p.costo_mes_mxn : 0), 0);
      const porPieza = activos.filter((p) => typeof p.costo_mes_mxn !== 'number').length;
      $('#nomina')!.innerHTML = `<b>${activos.length}</b> roles · ≈ <b>${mxn(nom)}</b> al mes fijos${porPieza ? ` + ${porPieza} que cobran por pieza o por hora` : ''}`;
    }
    segmentado($('#seg-fase')!, (b) => pintarPersonas(+b.dataset.f!));
    pintarPersonas(0);

    /* ── Simulador ── */
    const paquetes: any[] = d.paquetes || [];
    const fin: any = d.finanzas || {};
    const fasesFijos: any[] = fin.fijos_por_fase || [{ nombre: 'Etapa 1', mxn: (fin.costos_fijos_mes || []).reduce((s: number, c: any) => s + (c.mxn || 0), 0) }];
    let iFijos = Math.max(0, fasesFijos.findIndex((x) => /etapa 1/i.test(x.nombre)));
    const segFijos = $('#seg-fijos')!;
    segFijos.innerHTML = fasesFijos.map((x, i) => `<button type="button" data-i="${i}" aria-pressed="${i === iFijos}">${esc(x.nombre)} · ${mxn(x.mxn)}</button>`).join('');
    const marcarFijos = () => $$('button', segFijos).forEach((x, i) => x.setAttribute('aria-pressed', String(i === iFijos)));
    segmentado(segFijos, (b) => { iFijos = +b.dataset.i!; pintarSim(); });
    // Capital: lo que no es equipo (sociedad, accesorios, estación, arranque) + el equipo del nivel elegido
    const capMax: number = (fin.capital && fin.capital.maximo) || 0;
    const cant: number[] = paquetes.map(() => 0);
    const HORAS_MES = 160;
    const simP = $('#sim-paquetes')!;
    simP.innerHTML = paquetes.map((p, i) => `
      <div class="paquete-sim">
        <div><span class="n">${esc(p.nombre)}</span><br><small>${mxn(p.precio_mxn)} ${esc(p.unidad || '')}${typeof p.horas_humanas === 'number' ? ` · ${p.horas_humanas} h` : ''}</small></div>
        <div class="paso-n"><button type="button" data-i="${i}" data-d="-1" aria-label="Menos ${esc(p.nombre)}">−</button><output id="cant-${i}">0</output><button type="button" data-i="${i}" data-d="1" aria-label="Más ${esc(p.nombre)}">+</button></div>
      </div>`).join('');
    simP.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      const i = +b.dataset.i!; cant[i] = Math.max(0, Math.min(60, cant[i] + +b.dataset.d!));
      $$('#seg-esc button').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      $('#esc-nota')!.textContent = 'Mezcla libre.';
      pintarSim();
    });
    function pintarSim() {
      if (!simP) return;
      let ingreso = 0, directo = 0, horas = 0;
      paquetes.forEach((p, i) => {
        ingreso += cant[i] * (p.precio_mxn || 0);
        directo += cant[i] * (p.costo_directo_mxn || 0);
        horas += cant[i] * (p.horas_humanas || 0);
        const o = document.getElementById('cant-' + i); if (o) o.textContent = String(cant[i]);
      });
      const fijos = fasesFijos[iFijos] ? fasesFijos[iFijos].mxn : 0;
      const util = ingreso - directo - fijos;
      const iR = Math.max(0, niveles.findIndex((n) => /recom/i.test(n.nivel || '')));
      const equipo = niveles[nivel] ? totalNivel(niveles[nivel]) : 0;
      const inv = capMax ? capMax - (niveles[iR] ? totalNivel(niveles[iR]) : 0) + equipo : equipo;
      const rec = util > 0 ? Math.ceil(inv / util) : null;
      $('#sim-res')!.innerHTML = `
        <div><span>Ingreso al mes</span><b>${mxn(ingreso)}</b></div>
        <div><span>Costos directos</span><b>${mxn(-directo)}</b></div>
        <div><span>Costos fijos (${esc(fasesFijos[iFijos] ? fasesFijos[iFijos].nombre.toLowerCase() : '')})</span><b>${mxn(-fijos)}</b></div>
        <div class="grande ${util > 0 ? 'pos' : ''}"><span>Utilidad al mes</span><b>${mxn(util)}</b></div>
        <div><span>Capital con equipo ${esc(niveles[nivel] ? niveles[nivel].nivel.toLowerCase() : '')}</span><b>${mxn(inv)}</b></div>
        <div><span>Meses de utilidad para cubrirlo</span><b>${rec ? rec + (rec === 1 ? ' mes' : ' meses') : 'aún no'}</b></div>`;
      $('#sim-pie')!.textContent = 'A este ritmo estable. La curva real tarda más porque los primeros meses no llegan a este ritmo: en el escenario base la caja vuelve a positivo en el mes 19 (capítulo 10).';
      const pc = Math.min(100, (100 * horas) / HORAS_MES);
      $('#cap-txt')!.innerHTML = `<b style="color:#fff">${Math.round(horas)} h</b> humanas al mes · ${Math.round((100 * horas) / HORAS_MES)}% de una persona de tiempo completo`;
      const cb = $('#cap-barra')!; cb.classList.toggle('lleno', horas > HORAS_MES); ($('i', cb) as HTMLElement).style.width = pc + '%';
    }
    // Escenarios: botones que reparten la mezcla para llegar al ingreso de cada escenario
    const escs: any[] = (d.finanzas && d.finanzas.escenarios) || [];
    const segEsc = $('#seg-esc')!;
    segEsc.innerHTML = escs.map((e, i) => `<button type="button" data-i="${i}" aria-pressed="false">${esc(e.nombre)}</button>`).join('');
    function aplicarEscenario(i: number) {
      const e = escs[i]; if (!e) return;
      // cantidades: cuántos de cada paquete al mes (mismo orden que d.paquetes)
      paquetes.forEach((_, k) => (cant[k] = (e.cantidades && +e.cantidades[k]) || 0));
      if (typeof e.fase_fijos === 'number' && fasesFijos[e.fase_fijos]) { iFijos = e.fase_fijos; marcarFijos(); }
      $('#esc-nota')!.textContent = e.mezcla || '';
      pintarSim();
    }
    segmentado(segEsc, (b) => aplicarEscenario(+b.dataset.i!));
    pintarEquipo();
    if (escs.length) { const m = Math.min(1, escs.length - 1); segEsc.querySelectorAll('button')[m]?.setAttribute('aria-pressed', 'true'); aplicarEscenario(m); }

    /* ── Matriz de riesgos ── */
    const riesgos: any[] = d.riesgos || [];
    const P = ['alta', 'media', 'baja'], I = ['bajo', 'medio', 'alto'];
    const matriz = $('#matriz')!;
    let celdas = '';
    P.forEach((p) => {
      celdas += `<div class="eje">Prob. ${p}</div>`;
      I.forEach((im) => {
        const n = riesgos.filter((r) => r.probabilidad === p && r.impacto === im).length;
        const w = n === 0 ? '' : n === 1 ? 'w1' : n === 2 ? 'w2' : 'w3';
        celdas += `<button type="button" class="celda ${w}" data-p="${p}" data-im="${im}" data-n="${n}" aria-pressed="false" aria-label="Probabilidad ${p}, impacto ${im}: ${n} riesgos" ${n === 0 ? 'disabled' : ''}>${n || '·'}</button>`;
      });
    });
    celdas += '<div></div>' + I.map((im) => `<div class="eje">${im[0].toUpperCase() + im.slice(1)}</div>`).join('');
    matriz.innerHTML = celdas;
    const lista = $('#riesgos-lista')!;
    const pintarRiesgos = (rs: any[], titulo: string, max = 0) => {
      const fila = (r: any, oculto: boolean) => `
        <div class="riesgo${oculto ? ' oculto' : ''}"><span class="rt">${esc(r.riesgo)}</span><span class="nota">Probabilidad ${esc(r.probabilidad)} · impacto ${esc(r.impacto)}</span><span class="rm"><b>Qué hacemos:</b> ${esc(r.mitigacion)}</span></div>`;
      const corta = max > 0 && rs.length > max + 1;
      lista.innerHTML = `<p class="nota">${esc(titulo)}</p>` + rs.map((r, i) => fila(r, corta && i >= max)).join('') +
        (corta ? `<button type="button" class="ver-mas" id="riesgos-mas">Ver los ${rs.length - max} restantes</button>` : '');
      $('#riesgos-mas')?.addEventListener('click', (e) => { $$('.riesgo.oculto', lista).forEach((x) => x.classList.remove('oculto')); (e.currentTarget as HTMLElement).remove(); });
    };
    const orden = (r: any) => P.indexOf(r.probabilidad) * 3 + (2 - I.indexOf(r.impacto));
    pintarRiesgos([...riesgos].sort((a, b) => orden(a) - orden(b)), `Los ${riesgos.length} riesgos, del más serio al menor`, 6);
    matriz.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.celda') as HTMLElement | null; if (!b || b.dataset.n === '0') return;
      const ya = b.getAttribute('aria-pressed') === 'true';
      $$('.celda', matriz).forEach((c) => c.setAttribute('aria-pressed', 'false'));
      if (ya) return pintarRiesgos([...riesgos].sort((a, c) => orden(a) - orden(c)), `Los ${riesgos.length} riesgos, del más serio al menor`, 6);
      b.setAttribute('aria-pressed', 'true');
      pintarRiesgos(riesgos.filter((r) => r.probabilidad === b.dataset.p && r.impacto === b.dataset.im), `Probabilidad ${b.dataset.p}, impacto ${b.dataset.im}`);
    });

    /* ── Gráficas (SVG a la medida del contenedor, con tooltip) ── */
    const NS = 'http://www.w3.org/2000/svg';
    const miles = (n: number) => (n < 0 ? '−' : '') + '$' + Math.round(Math.abs(n) / 1000).toLocaleString('es-MX') + ' mil';
    function tooltip(cont: HTMLElement) {
      let t = cont.querySelector('.tip') as HTMLElement | null;
      if (!t) { t = document.createElement('div'); t.className = 'tip'; t.setAttribute('aria-hidden', 'true'); cont.appendChild(t); }
      const tip = t;
      return {
        ver(html: string, px: number, py: number) {
          tip.innerHTML = html; tip.classList.add('ver');
          const w = tip.offsetWidth, W = cont.clientWidth;
          tip.style.left = Math.max(w / 2, Math.min(W - w / 2, px)) + 'px';
          tip.style.top = py + 'px';
        },
        ocultar() { tip.classList.remove('ver'); },
      };
    }
    function graficaCaja() {
      const cont = $('#g-caja'); const serie: any[] = (fin.flujo_caja && fin.flujo_caja.serie) || [];
      if (!cont || !serie.length) return;
      const W = Math.max(280, cont.clientWidth), chico = W < 560, H = chico ? 250 : 310;
      const ml = chico ? 58 : 70, mr = 14, mt = 28, mb = 30;
      const vals = serie.map((s) => s.acumulado);
      const yMin = Math.floor(Math.min(0, ...vals) / 100000) * 100000 - 100000, yMax = Math.ceil(Math.max(0, ...vals) / 100000) * 100000;
      const x = (i: number) => ml + (i * (W - ml - mr)) / (serie.length - 1);
      const y = (v: number) => mt + ((yMax - v) * (H - mt - mb)) / (yMax - yMin);
      const lineas: string[] = [];
      for (let v = Math.ceil(yMin / 200000) * 200000; v <= yMax; v += 200000) {
        lineas.push(`<line class="${v === 0 ? 'cero' : 'rej'}" x1="${ml}" x2="${W - mr}" y1="${y(v)}" y2="${y(v)}"/><text class="eje-t" x="${ml - 8}" y="${y(v) + 4}" text-anchor="end">${v === 0 ? '$0' : miles(v)}</text>`);
      }
      const k = chico ? 6 : 3;
      const etiquetas = serie.map((s, i) => (i % k === 0 ? `<text class="eje-t" x="${x(i)}" y="${H - 8}" text-anchor="middle">${esc(s.mes)}</text>` : '')).join('');
      const ultimoEst = serie.reduce((m, s, i) => (s.tipo === 'estimado' ? i : m), 0);
      const tramo = (a: number, b: number) => serie.slice(a, b + 1).map((s, j) => `${j ? 'L' : 'M'}${x(a + j).toFixed(1)},${y(s.acumulado).toFixed(1)}`).join('');
      const iB = vals.indexOf(Math.min(...vals)), iC = vals.findIndex((v) => v > 0);
      const anota = (i: number, txt: string, sub: string, arriba: boolean, ancla: string) => {
        const ax = x(i), ay = y(vals[i]), dy = arriba ? -14 : 20, dx = ancla === 'start' ? 10 : ancla === 'end' ? -10 : 0;
        const linea2 = sub ? `<text class="anota suave" x="${ax + dx}" y="${ay + dy + (arriba ? -14 : 14)}" text-anchor="${ancla}">${sub}</text>` : '';
        return `<circle cx="${ax}" cy="${ay}" r="5" fill="var(--c)" stroke="#fff" stroke-width="2"/>
          <text class="anota" x="${ax + dx}" y="${ay + dy}" text-anchor="${ancla}">${txt}</text>${linea2}`;
      };
      cont.innerHTML = `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" aria-hidden="true">
        ${lineas.join('')}${etiquetas}
        <path d="${tramo(0, ultimoEst)}" fill="none" stroke="var(--c)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
        <path d="${tramo(ultimoEst, serie.length - 1)}" fill="none" stroke="var(--c)" stroke-width="2" stroke-dasharray="5 4" stroke-linecap="round"/>
        ${anota(iB, miles(vals[iB]) + ' · ' + esc(serie[iB].mes), '', false, 'start')}
        ${iC >= 0 ? anota(iC, 'Mes ' + (iC + 1), 'vuelve a positivo', true, 'end') : ''}
        <line id="caja-cruz" x1="0" x2="0" y1="${mt}" y2="${H - mb}" stroke="var(--soft)" stroke-width="1" opacity="0"/>
        <circle id="caja-punto" r="5" fill="var(--amber)" stroke="#fff" stroke-width="2" opacity="0"/>
        <rect x="${ml}" y="0" width="${W - ml - mr}" height="${H}" fill="transparent" id="caja-hit"/>
      </svg>`;
      const t = tooltip(cont), cruz = cont.querySelector('#caja-cruz')!, punto = cont.querySelector('#caja-punto')!, hit = cont.querySelector('#caja-hit')!;
      const mover = (ev: PointerEvent) => {
        const r = (cont.querySelector('svg') as SVGSVGElement).getBoundingClientRect();
        const i = Math.max(0, Math.min(serie.length - 1, Math.round(((ev.clientX - r.left - ml) / (W - ml - mr)) * (serie.length - 1))));
        const s = serie[i], px = x(i), py = y(s.acumulado);
        cruz.setAttribute('x1', String(px)); cruz.setAttribute('x2', String(px)); cruz.setAttribute('opacity', '1');
        punto.setAttribute('cx', String(px)); punto.setAttribute('cy', String(py)); punto.setAttribute('opacity', '1');
        const delta = i > 0 ? s.acumulado - serie[i - 1].acumulado : s.acumulado;
        t.ver(`<b>${esc(s.mes)}</b> · ${s.tipo}<br>Acumulado: <b>${mxn(s.acumulado)}</b><br>En el mes: ${mxn(delta)}`, px, py);
      };
      hit.addEventListener('pointermove', mover as EventListener);
      hit.addEventListener('pointerdown', mover as EventListener);
      hit.addEventListener('pointerleave', () => { t.ocultar(); cruz.setAttribute('opacity', '0'); punto.setAttribute('opacity', '0'); });
    }
    function graficaHoras() {
      const cont = $('#g-horas'); const hm = d.horas_miguel;
      if (!cont || !hm || !hm.serie) return;
      const s: any[] = hm.serie;
      const W = Math.max(280, cont.clientWidth), chico = W < 560, H = 210;
      const ml = 34, mr = 8, mt = 22, mb = 28, yMax = 10;
      const banda = (W - ml - mr) / s.length, bw = Math.min(30, banda * 0.68);
      const y = (v: number) => mt + ((yMax - v) * (H - mt - mb)) / yMax;
      const y0 = y(0);
      const barras = s.map((p, i) => {
        const bx = ml + i * banda + (banda - bw) / 2, by = y(p.h), r = Math.min(4, bw / 2, y0 - by);
        return `<path d="M${bx},${y0}V${by + r}Q${bx},${by} ${bx + r},${by}H${bx + bw - r}Q${bx + bw},${by} ${bx + bw},${by + r}V${y0}Z" fill="var(--c)"/>`;
      }).join('');
      const k = chico ? 3 : 1;
      const etiquetas = s.map((p, i) => (i % k === 0 ? `<text class="eje-t" x="${ml + i * banda + banda / 2}" y="${H - 9}" text-anchor="middle">${esc(chico ? p.mes : p.mes.slice(0, 3))}</text>` : '')).join('');
      const rej = [0, 5, 10].map((v) => `<line class="${v === 0 ? 'cero' : 'rej'}" x1="${ml}" x2="${W - mr}" y1="${y(v)}" y2="${y(v)}"/><text class="eje-t" x="${ml - 6}" y="${y(v) + 4}" text-anchor="end">${v} h</text>`).join('');
      const extremos = [0, s.length - 1].map((i) => `<text class="anota" x="${ml + i * banda + banda / 2}" y="${y(s[i].h) - 6}" text-anchor="middle">${s[i].h.toLocaleString('es-MX')} h</text>`).join('');
      const hits = s.map((p, i) => `<rect x="${ml + i * banda}" y="${mt}" width="${banda}" height="${H - mt - mb}" fill="transparent" data-i="${i}"/>`).join('');
      cont.innerHTML = `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" aria-hidden="true">
        ${rej}${barras}${etiquetas}${extremos}
        <line x1="${ml}" x2="${W - mr}" y1="${y(hm.meta)}" y2="${y(hm.meta)}" stroke="var(--amber-t)" stroke-width="1.5" stroke-dasharray="5 4"/>
        <text class="anota" x="${W - mr}" y="${y(hm.meta) - 6}" text-anchor="end" style="fill:var(--amber-t)">meta: menos de ${hm.meta} h</text>
        ${hits}
      </svg>`;
      const t = tooltip(cont);
      cont.querySelectorAll('rect[data-i]').forEach((r) => {
        const ver = () => { const i = +(r as SVGRectElement).dataset.i!; t.ver(`<b>${esc(s[i].mes)}</b><br>${s[i].h.toLocaleString('es-MX')} h por semana`, ml + i * banda + banda / 2, y(s[i].h)); };
        r.addEventListener('pointerenter', ver); r.addEventListener('pointerdown', ver);
        r.addEventListener('pointerleave', () => t.ocultar());
      });
    }
    graficaCaja(); graficaHoras();
    let anchoPrevio = innerWidth, tRes = 0;
    addEventListener('resize', () => { if (innerWidth === anchoPrevio) return; anchoPrevio = innerWidth; clearTimeout(tRes); tRes = window.setTimeout(() => { graficaCaja(); graficaHoras(); }, 150); });

    /* ── Reparto entre capital y trabajo ── */
    const rep: any = fin.reparto;
    const segRep = $('#seg-reparto');
    if (rep && segRep) {
      const ests: any[] = rep.estructuras || [];
      const escNombres = ['Lento', 'Base', 'Fuerte'];
      const maxX = Math.max(1.2, ...ests.flatMap((e) => escNombres.map((n) => (e.recibe[n] || [0, 0])[1]))) * 1.1;
      let iRep = Math.max(0, ests.findIndex((e) => e.recomendada));
      segRep.innerHTML = ests.map((e, i) => `<button type="button" data-i="${i}" aria-pressed="${i === iRep}">${esc(e.id)} · ${esc(e.nombre)}${e.recomendada ? ' ★' : ''}</button>`).join('');
      const pintarRep = () => {
        const e = ests[iRep]; if (!e) return;
        $('#reparto-regla')!.textContent = e.regla + (e.recomendada ? ' Es la recomendada como base para negociar.' : '');
        $('#reparto-barras')!.innerHTML = escNombres.map((n) => {
          const [m, xv] = e.recibe[n] || [0, 0];
          const cap = (rep.capital && rep.capital[n]) || 0;
          return `<div class="mult"><span><b>${n}</b></span>
            <div class="pista" style="--v:${(100 * xv) / maxX}%;--u:${100 / maxX}%"><i></i><span class="uno" title="Recupera su capital"></span></div>
            <span class="val"><b>${xv.toLocaleString('es-MX', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} veces</b> su capital · recibe ${mxn(m)} de ${mxn(cap)} que puso</span></div>`;
        }).join('');
      };
      segmentado(segRep, (b) => { iRep = +b.dataset.i!; pintarRep(); });
      pintarRep();
    }

    /* ── Decisiones ── */
    const decs: any[] = d.decisiones || [];
    const votos: Record<string, string> = (() => { try { return JSON.parse(leer('ep-votos') || '{}'); } catch { return {}; } })();
    function pintarVotos() {
      $$('.decision').forEach((el) => {
        const q = el.dataset.q!;
        $$('.chip', el).forEach((c) => c.setAttribute('aria-pressed', String(votos[q] === c.dataset.op)));
      });
      $('#dec-cuenta')!.textContent = `${Object.keys(votos).filter((k) => votos[k]).length} de ${decs.length} decididas`;
    }
    $('#decisiones')!.addEventListener('click', (e) => {
      const c = (e.target as HTMLElement).closest('.chip') as HTMLElement | null; if (!c) return;
      const q = (c.closest('.decision') as HTMLElement).dataset.q!;
      votos[q] = votos[q] === c.dataset.op ? '' : c.dataset.op!;
      guardar('ep-votos', JSON.stringify(votos));
      pintarVotos();
    });
    $('#dec-copiar')!.addEventListener('click', async () => {
      const txt = 'Voz Durango · mis respuestas\n\n' + decs.map((q, i) => `${i + 1}. ${q.pregunta}\n   → ${votos[i] || '(sin decidir)'}`).join('\n');
      const b = $('#dec-copiar')!;
      try {
        if (navigator.share && matchMedia('(pointer: coarse)').matches) await navigator.share({ text: txt });
        else { await navigator.clipboard.writeText(txt); b.textContent = 'Copiado ✓'; setTimeout(() => (b.textContent = 'Copiar mis respuestas'), 1800); }
      } catch { /* el usuario canceló */ }
    });
    pintarVotos();
  </script>
</body>
</html>
