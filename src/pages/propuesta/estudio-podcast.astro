          <details class="ver-tabla"><summary>Ver la tabla</summary>
            <div class="desliza"><table class="tabla"><thead><tr><th>Mes</th><th class="num">Acumulado</th><th>Tipo</th></tr></thead>
              <tbody>{serieCaja.map((s: any) => <tr><td>{s.mes}</td><td class="num">{(s.acumulado < 0 ? '−' : '') + mxn(Math.abs(s.acumulado))}</td><td>{s.tipo}</td></tr>)}</tbody></table></div>
          </details>
        </div>
        <div class="rejilla r2" style="margin-top:12px">
