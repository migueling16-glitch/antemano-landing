  </main>

  <footer class="pie-pag">
    <div class="wrap">
      <p>Preparado por <b>antemano</b> · Taller Creativo · Durango, México</p>
      <p style="margin-top:6px">Documento privado para socios. "Voz Durango" es un nombre de trabajo para una empresa nueva, separada de Antemano. Investigación al 13 de noviembre de 2026: los precios y las reglas cambian, hay que confirmarlos antes de decidir.</p>
    </div>
  </footer>

  <script>
    const d = JSON.parse(document.getElementById('datos')!.textContent || '{}');
    const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector(s) as T | null;
    const $$ = (s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<HTMLElement>(s));
    const mxn = (n: number) => (n < 0 ? '−$' : '$') + Math.round(Math.abs(n)).toLocaleString('es-MX');
    const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
    const guardar = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
    const leer = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };

    function segmentado(cont: HTMLElement, alElegir: (b: HTMLElement) => void) {
      cont.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest('button');
        if (!b || !cont.contains(b)) return;
        $$('button', cont).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        alElegir(b as HTMLElement);
      });
    }

    /* ── Barra superior, índice y progreso ── */
    const indice = $('#indice')!, btnIndice = $('#btn-indice')!;
    btnIndice.addEventListener('click', () => {
      const ab = indice.classList.toggle('abierto');
      btnIndice.setAttribute('aria-expanded', String(ab));
    });
    indice.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) { indice.classList.remove('abierto'); btnIndice.setAttribute('aria-expanded', 'false'); } });
    const btnMov = $('#btn-mov')!;
    const pintarMov = () => (btnMov.textContent = document.documentElement.classList.contains('anim') ? 'Encendidas' : 'Apagadas');
    pintarMov();
    btnMov.addEventListener('click', () => {
      const on = document.documentElement.classList.toggle('anim');
      guardar('ep-mov', on ? '1' : '0');
      if (on) $$('.rv').forEach((el) => el.classList.add('ok'));
      pintarMov();
    });
    const prog = $('#top-prog')!, cap = $('#top-cap')!;
    const secciones = $$('main section[id]');
    const nombres: Record<string, string> = {};
    $$('#indice a').forEach((a) => (nombres[a.dataset.cap!] = a.textContent!.replace(/^[\d·]+/, '')));
    let ticking = false;
    function alScroll() {
      ticking = false;
      const h = document.documentElement;
      prog.style.width = (100 * h.scrollTop) / Math.max(1, h.scrollHeight - h.clientHeight) + '%';
      let actual = 'inicio';
      for (const s of secciones) if (s.getBoundingClientRect().top < 120) actual = s.id;
      cap.innerHTML = actual === 'inicio' ? '<b>Voz Durango</b> · proyecto ejecutivo' : `<b>${esc(nombres[actual] || '')}</b>`;
      $$('#indice a').forEach((a) => a.classList.toggle('actual', a.dataset.cap === actual));
    }
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(alScroll); } }, { passive: true });
    alScroll();

    /* ── Listas largas: primeras N y "Ver más" (sin JS se ve todo) ── */
    function acortarListas(raiz: ParentNode) { $$('ul.lista[data-max]', raiz).forEach((ul) => {
      const max = +ul.dataset.max!, lis = Array.from(ul.children) as HTMLElement[];
      if (lis.length <= max + 1) return;
      const resto = lis.slice(max);
      resto.forEach((li) => li.classList.add('oculto'));
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'ver-mas'; b.setAttribute('aria-expanded', 'false');
      const txt = () => (b.getAttribute('aria-expanded') === 'true' ? 'Ver menos' : `Ver ${resto.length} más`);
      b.textContent = txt();
      b.addEventListener('click', () => {
        const abrir = b.getAttribute('aria-expanded') !== 'true';
        resto.forEach((li) => li.classList.toggle('oculto', !abrir));
        b.setAttribute('aria-expanded', String(abrir)); b.textContent = txt();
      });
      ul.after(b);
    }); }
    acortarListas(document);

    /* ── Línea de tiempo de hitos: abre el hito que se toca ── */
    $$('.gantt a.g-fila[data-hito]').forEach((a) => a.addEventListener('click', () => {
      const det = document.getElementById('hito-' + a.dataset.hito) as HTMLDetailsElement | null;
      if (det) det.open = true;
    }));

    /* ── Aparición suave ── */
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((ents) => ents.forEach((en) => { if (en.isIntersecting) { en.target.classList.add('ok'); io.unobserve(en.target); } }), { rootMargin: '0px 0px -8% 0px' });
      $$('.rv').forEach((el) => io.observe(el));
    } else $$('.rv').forEach((el) => el.classList.add('ok'));

    /* ── Casos: filtro por tipo ── */
    const casos = $$('#casos-lista > article');
    const tipos = Array.from(new Set(casos.map((c) => c.dataset.tipo || '').filter(Boolean)));
    const filtro = $('#filtro-casos')!;
    filtro.innerHTML = ['todos', ...tipos].map((t, i) => `<button type="button" class="chip" data-t="${esc(t)}" aria-pressed="${i === 0}">${esc(t === 'todos' ? `Todos (${casos.length})` : t[0].toUpperCase() + t.slice(1))}</button>`).join('');
    filtro.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      $$('button', filtro).forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const t = b.dataset.t;
      casos.forEach((c) => c.classList.toggle('oculto', t !== 'todos' && c.dataset.tipo !== t));
    });

    /* ── Caminos ── */
    const ops: any[] = d.opciones || [];
    const segCam = $('#seg-caminos')!, panelCam = $('#camino-panel')!;
    const iOp = Math.max(0, ops.findIndex((o) => o.recomendada));
    segCam.innerHTML = ops.map((o, i) => `<button type="button" data-i="${i}" aria-pressed="${i === iOp}">${esc(o.id)} · ${esc(o.corto || o.nombre)}${o.recomendada ? ' ★' : ''}</button>`).join('');
    const criterios: [string, string][] = [['probabilidad_exito', 'Probabilidad de éxito'], ['tiempo_socios', 'Poco tiempo de socios'], ['recurrencia', 'Ingreso recurrente'], ['riesgo', 'Riesgo controlado'], ['escalabilidad', 'Escalabilidad']];
    function pintarCamino(i: number) {
      const o = ops[i]; if (!o) return;
      const p = o.puntajes || {};
      panelCam.innerHTML = `
        <div class="tarjeta">
          ${o.recomendada ? '<span class="etq oro">Recomendado</span>' : '<span class="etq">Alternativa</span>'}
          <h3 style="font-size:1.5rem;margin-top:6px">${esc(o.nombre)}</h3>
          <p style="color:rgba(255,255,255,.78)">${esc(o.tesis)}</p>
          <div class="balanza" style="margin-top:10px">
            <div><b>A favor</b><ul class="lista" data-max="3" style="margin-top:8px">${(o.pros || []).map((x: string) => `<li>${esc(x)}</li>`).join('')}</ul></div>
            <div><b>En contra</b><ul class="lista" data-max="3" style="margin-top:8px">${(o.contras || []).map((x: string) => `<li>${esc(x)}</li>`).join('')}</ul></div>
          </div>
        </div>
        <div class="tarjeta">
          <div style="display:flex;justify-content:space-between;align-items:baseline;gap:10px">
            <span class="nota">Puntaje del juez</span><span class="cifra">${Math.round(o.puntaje)}<small style="font-size:1rem;color:rgba(255,255,255,.5)">/100</small></span>
          </div>
          ${typeof o.inversion_mxn === 'number' ? `<p class="nota">Inversión inicial ≈ <b style="color:#fff">${mxn(o.inversion_mxn)}</b></p>` : ''}
          <div class="barras" style="margin-top:10px">
            ${criterios.filter(([k]) => typeof p[k] === 'number').map(([k, t]) => `<div class="barra"><span>${t}</span><b>${Math.round(p[k])}</b><span class="pista"><i style="--v:${Math.max(0, Math.min(100, p[k]))}%"></i></span></div>`).join('')}
          </div>
        </div>`;
    }
    segmentado(segCam, (b) => { pintarCamino(+b.dataset.i!); acortarListas(panelCam); });
    pintarCamino(iOp); acortarListas(panelCam);

    /* ── Equipo por nivel ── */
    const niveles: any[] = d.equipo_niveles || [];
    let nivel = Math.max(0, niveles.findIndex((n) => /recom/i.test(n.nivel || '')));
    const totalNivel = (n: any) => (n.items || []).reduce((s: number, it: any) => s + (it.cantidad || 0) * (it.precio_unit_mxn || 0), 0) || n.total_mxn || 0;
    function pintarEquipo() {
      const n = niveles[nivel]; if (!n) return;
      const grupos: Record<string, any[]> = {};
      (n.items || []).forEach((it: any) => (grupos[it.categoria || 'Otros'] ||= []).push(it));
      $('#equipo-tabla tbody')!.innerHTML = Object.entries(grupos).map(([cat, its]) =>
        `<tr class="cat"><td colspan="3">${esc(cat)}</td></tr>` + its.map((it) => `
          <tr><td>${it.url ? `<a href="${esc(it.url)}" target="_blank" rel="noopener">${esc(it.item)}</a>` : esc(it.item)}${it.por_que ? `<small>${esc(it.por_que)}</small>` : ''}</td>
          <td class="num">${it.cantidad} × ${mxn(it.precio_unit_mxn || 0)}</td>
          <td class="num"><b>${mxn((it.cantidad || 0) * (it.precio_unit_mxn || 0))}</b></td></tr>`).join('')).join('');
      $('#equipo-total')!.textContent = mxn(totalNivel(n));
      $('#equipo-resumen')!.textContent = n.resumen || '';
      pintarSim();
    }
    segmentado($('#seg-nivel')!, (b) => { nivel = +b.dataset.i!; pintarEquipo(); });

    /* ── Personas por fase ── */
    const personas: any[] = d.personas || [];
    const ordenFase = (f: string) => (/escala/i.test(f) ? 2 : /tracc/i.test(f) ? 1 : 0);
    function pintarPersonas(f: number) {
      const entran = personas.filter((p) => ordenFase(p.fase || '') <= f);
      const reemplazados = new Set(entran.map((p) => p.reemplaza).filter(Boolean));
      const activos = entran.filter((p) => !reemplazados.has(p.rol));
      $('#personas-lista')!.innerHTML = activos.map((p) => `
        <article class="tarjeta rol ${ordenFase(p.fase || '') === f && f > 0 ? 'nuevo' : ''}">
          <span class="etq">${esc(p.fase)}${ordenFase(p.fase || '') === f && f > 0 ? ' · entra aquí' : ''}</span>
          <h3>${esc(p.rol)}</h3>
          <span class="ded">${esc(p.dedicacion)}</span>
          <ul class="lista">${(p.hace || []).map((x: string) => `<li>${esc(x)}</li>`).join('')}</ul>
          ${p.perfil ? `<p class="nota">${esc(p.perfil)}</p>` : ''}
          ${typeof p.costo_mes_mxn === 'number' ? `<p class="nota pie">≈ ${mxn(p.costo_mes_mxn)} al mes</p>` : ''}
        </article>`).join('');
      const nom = activos.reduce((s, p) => s + (typeof p.costo_mes_mxn === 'number' ? p.costo_mes_mxn : 0), 0);
      const porPieza = activos.filter((p) => typeof p.costo_mes_mxn !== 'number').length;
      $('#nomina')!.innerHTML = `<b>${activos.length}</b> roles · ≈ <b>${mxn(nom)}</b> al mes fijos${porPieza ? ` + ${porPieza} que cobran por pieza o por hora` : ''}`;
    }
    segmentado($('#seg-fase')!, (b) => pintarPersonas(+b.dataset.f!));
    pintarPersonas(0);

    /* ── Simulador ── */
    const paquetes: any[] = d.paquetes || [];
    const fin: any = d.finanzas || {};
    const fasesFijos: any[] = fin.fijos_por_fase || [{ nombre: 'Etapa 1', mxn: (fin.costos_fijos_mes || []).reduce((s: number, c: any) => s + (c.mxn || 0), 0) }];
    let iFijos = Math.max(0, fasesFijos.findIndex((x) => /etapa 1/i.test(x.nombre)));
    const segFijos = $('#seg-fijos')!;
    segFijos.innerHTML = fasesFijos.map((x, i) => `<button type="button" data-i="${i}" aria-pressed="${i === iFijos}">${esc(x.nombre)} · ${mxn(x.mxn)}</button>`).join('');
    const marcarFijos = () => $$('button', segFijos).forEach((x, i) => x.setAttribute('aria-pressed', String(i === iFijos)));
    segmentado(segFijos, (b) => { iFijos = +b.dataset.i!; pintarSim(); });
    // Capital: lo que no es equipo (sociedad, accesorios, estación, arranque) + el equipo del nivel elegido
    const capMax: number = (fin.capital && fin.capital.maximo) || 0;
    const cant: number[] = paquetes.map(() => 0);
    const HORAS_MES = 160;
    const simP = $('#sim-paquetes')!;
    simP.innerHTML = paquetes.map((p, i) => `
      <div class="paquete-sim">
        <div><span class="n">${esc(p.nombre)}</span><br><small>${mxn(p.precio_mxn)} ${esc(p.unidad || '')}${typeof p.horas_humanas === 'number' ? ` · ${p.horas_humanas} h` : ''}</small></div>
        <div class="paso-n"><button type="button" data-i="${i}" data-d="-1" aria-label="Menos ${esc(p.nombre)}">−</button><output id="cant-${i}">0</output><button type="button" data-i="${i}" data-d="1" aria-label="Más ${esc(p.nombre)}">+</button></div>
      </div>`).join('');
    simP.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button'); if (!b) return;
      const i = +b.dataset.i!; cant[i] = Math.max(0, Math.min(60, cant[i] + +b.dataset.d!));
      $$('#seg-esc button').forEach((x) => x.setAttribute('aria-pressed', 'false'));
      $('#esc-nota')!.textContent = 'Mezcla libre.';
      pintarSim();
    });
    function pintarSim() {
      if (!simP) return;
      let ingreso = 0, directo = 0, horas = 0;
      paquetes.forEach((p, i) => {
        ingreso += cant[i] * (p.precio_mxn || 0);
        directo += cant[i] * (p.costo_directo_mxn || 0);
        horas += cant[i] * (p.horas_humanas || 0);
        const o = document.getElementById('cant-' + i); if (o) o.textContent = String(cant[i]);
      });
      const fijos = fasesFijos[iFijos] ? fasesFijos[iFijos].mxn : 0;
      const util = ingreso - directo - fijos;
      const iR = Math.max(0, niveles.findIndex((n) => /recom/i.test(n.nivel || '')));
      const equipo = niveles[nivel] ? totalNivel(niveles[nivel]) : 0;
      const inv = capMax ? capMax - (niveles[iR] ? totalNivel(niveles[iR]) : 0) + equipo : equipo;
      const rec = util > 0 ? Math.ceil(inv / util) : null;
      $('#sim-res')!.innerHTML = `
        <div><span>Ingreso al mes</span><b>${mxn(ingreso)}</b></div>
        <div><span>Costos directos</span><b>${mxn(-directo)}</b></div>
        <div><span>Costos fijos (${esc(fasesFijos[iFijos] ? fasesFijos[iFijos].nombre.toLowerCase() : '')})</span><b>${mxn(-fijos)}</b></div>
        <div class="grande ${util > 0 ? 'pos' : ''}"><span>Utilidad al mes</span><b>${mxn(util)}</b></div>
        <div><span>Capital con equipo ${esc(niveles[nivel] ? niveles[nivel].nivel.toLowerCase() : '')}</span><b>${mxn(inv)}</b></div>
        <div><span>Meses de utilidad para cubrirlo</span><b>${rec ? rec + (rec === 1 ? ' mes' : ' meses') : 'aún no'}</b></div>`;
      $('#sim-pie')!.textContent = 'A este ritmo estable. La curva real tarda más porque los primeros meses no llegan a este ritmo: en el escenario base la caja vuelve a positivo en el mes 19 (capítulo 10).';
      const pc = Math.min(100, (100 * horas) / HORAS_MES);
      $('#cap-txt')!.innerHTML = `<b style="color:#fff">${Math.round(horas)} h</b> humanas al mes · ${Math.round((100 * horas) / HORAS_MES)}% de una persona de tiempo completo`;
      const cb = $('#cap-barra')!; cb.classList.toggle('lleno', horas > HORAS_MES); ($('i', cb) as HTMLElement).style.width = pc + '%';
    }
    // Escenarios: botones que reparten la mezcla para llegar al ingreso de cada escenario
    const escs: any[] = (d.finanzas && d.finanzas.escenarios) || [];
    const segEsc = $('#seg-esc')!;
    segEsc.innerHTML = escs.map((e, i) => `<button type="button" data-i="${i}" aria-pressed="false">${esc(e.nombre)}</button>`).join('');
    function aplicarEscenario(i: number) {
      const e = escs[i]; if (!e) return;
      // cantidades: cuántos de cada paquete al mes (mismo orden que d.paquetes)
      paquetes.forEach((_, k) => (cant[k] = (e.cantidades && +e.cantidades[k]) || 0));
      if (typeof e.fase_fijos === 'number' && fasesFijos[e.fase_fijos]) { iFijos = e.fase_fijos; marcarFijos(); }
      $('#esc-nota')!.textContent = e.mezcla || '';
      pintarSim();
    }
    segmentado(segEsc, (b) => aplicarEscenario(+b.dataset.i!));
    pintarEquipo();
    if (escs.length) { const m = Math.min(1, escs.length - 1); segEsc.querySelectorAll('button')[m]?.setAttribute('aria-pressed', 'true'); aplicarEscenario(m); }

    /* ── Matriz de riesgos ── */
    const riesgos: any[] = d.riesgos || [];
    const P = ['alta', 'media', 'baja'], I = ['bajo', 'medio', 'alto'];
    const matriz = $('#matriz')!;
    let celdas = '';
    P.forEach((p) => {
      celdas += `<div class="eje">Prob. ${p}</div>`;
      I.forEach((im) => {
        const n = riesgos.filter((r) => r.probabilidad === p && r.impacto === im).length;
        const w = n === 0 ? '' : n === 1 ? 'w1' : n === 2 ? 'w2' : 'w3';
        celdas += `<button type="button" class="celda ${w}" data-p="${p}" data-im="${im}" data-n="${n}" aria-pressed="false" aria-label="Probabilidad ${p}, impacto ${im}: ${n} riesgos" ${n === 0 ? 'disabled' : ''}>${n || '·'}</button>`;
      });
    });
    celdas += '<div></div>' + I.map((im) => `<div class="eje">${im[0].toUpperCase() + im.slice(1)}</div>`).join('');
    matriz.innerHTML = celdas;
    const lista = $('#riesgos-lista')!;
    const pintarRiesgos = (rs: any[], titulo: string, max = 0) => {
      const fila = (r: any, oculto: boolean) => `
        <div class="riesgo${oculto ? ' oculto' : ''}"><span class="rt">${esc(r.riesgo)}</span><span class="nota">Probabilidad ${esc(r.probabilidad)} · impacto ${esc(r.impacto)}</span><span class="rm"><b>Qué hacemos:</b> ${esc(r.mitigacion)}</span></div>`;
      const corta = max > 0 && rs.length > max + 1;
      lista.innerHTML = `<p class="nota">${esc(titulo)}</p>` + rs.map((r, i) => fila(r, corta && i >= max)).join('') +
        (corta ? `<button type="button" class="ver-mas" id="riesgos-mas">Ver los ${rs.length - max} restantes</button>` : '');
      $('#riesgos-mas')?.addEventListener('click', (e) => { $$('.riesgo.oculto', lista).forEach((x) => x.classList.remove('oculto')); (e.currentTarget as HTMLElement).remove(); });
    };
    const orden = (r: any) => P.indexOf(r.probabilidad) * 3 + (2 - I.indexOf(r.impacto));
    pintarRiesgos([...riesgos].sort((a, b) => orden(a) - orden(b)), `Los ${riesgos.length} riesgos, del más serio al menor`, 6);
    matriz.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.celda') as HTMLElement | null; if (!b || b.dataset.n === '0') return;
      const ya = b.getAttribute('aria-pressed') === 'true';
      $$('.celda', matriz).forEach((c) => c.setAttribute('aria-pressed', 'false'));
      if (ya) return pintarRiesgos([...riesgos].sort((a, c) => orden(a) - orden(c)), `Los ${riesgos.length} riesgos, del más serio al menor`, 6);
      b.setAttribute('aria-pressed', 'true');
      pintarRiesgos(riesgos.filter((r) => r.probabilidad === b.dataset.p && r.impacto === b.dataset.im), `Probabilidad ${b.dataset.p}, impacto ${b.dataset.im}`);
    });

    /* ── Gráficas (SVG a la medida del contenedor, con tooltip) ── */
    const NS = 'http://www.w3.org/2000/svg';
    const miles = (n: number) => (n < 0 ? '−' : '') + '$' + Math.round(Math.abs(n) / 1000).toLocaleString('es-MX') + ' mil';
    function tooltip(cont: HTMLElement) {
      let t = cont.querySelector('.tip') as HTMLElement | null;
      if (!t) { t = document.createElement('div'); t.className = 'tip'; t.setAttribute('aria-hidden', 'true'); cont.appendChild(t); }
      const tip = t;
      return {
        ver(html: string, px: number, py: number) {
          tip.innerHTML = html; tip.classList.add('ver');
          const w = tip.offsetWidth, W = cont.clientWidth;
          tip.style.left = Math.max(w / 2, Math.min(W - w / 2, px)) + 'px';
          tip.style.top = py + 'px';
        },
        ocultar() { tip.classList.remove('ver'); },
      };
    }
    function graficaCaja() {
      const cont = $('#g-caja'); const serie: any[] = (fin.flujo_caja && fin.flujo_caja.serie) || [];
      if (!cont || !serie.length) return;
      const W = Math.max(280, cont.clientWidth), chico = W < 560, H = chico ? 250 : 310;
      const ml = chico ? 58 : 70, mr = 14, mt = 28, mb = 30;
      const vals = serie.map((s) => s.acumulado);
      const yMin = Math.floor(Math.min(0, ...vals) / 100000) * 100000 - 100000, yMax = Math.ceil(Math.max(0, ...vals) / 100000) * 100000;
      const x = (i: number) => ml + (i * (W - ml - mr)) / (serie.length - 1);
      const y = (v: number) => mt + ((yMax - v) * (H - mt - mb)) / (yMax - yMin);
      const lineas: string[] = [];
      for (let v = Math.ceil(yMin / 200000) * 200000; v <= yMax; v += 200000) {
        lineas.push(`<line class="${v === 0 ? 'cero' : 'rej'}" x1="${ml}" x2="${W - mr}" y1="${y(v)}" y2="${y(v)}"/><text class="eje-t" x="${ml - 8}" y="${y(v) + 4}" text-anchor="end">${v === 0 ? '$0' : miles(v)}</text>`);
      }
      const k = chico ? 6 : 3;
      const etiquetas = serie.map((s, i) => (i % k === 0 ? `<text class="eje-t" x="${x(i)}" y="${H - 8}" text-anchor="middle">${esc(s.mes)}</text>` : '')).join('');
      const ultimoEst = serie.reduce((m, s, i) => (s.tipo === 'estimado' ? i : m), 0);
      const tramo = (a: number, b: number) => serie.slice(a, b + 1).map((s, j) => `${j ? 'L' : 'M'}${x(a + j).toFixed(1)},${y(s.acumulado).toFixed(1)}`).join('');
      const iB = vals.indexOf(Math.min(...vals)), iC = vals.findIndex((v) => v > 0);
      const anota = (i: number, txt: string, sub: string, arriba: boolean, ancla: string) => {
        const ax = x(i), ay = y(vals[i]), dy = arriba ? -14 : 20, dx = ancla === 'start' ? 10 : ancla === 'end' ? -10 : 0;
        const linea2 = sub ? `<text class="anota suave" x="${ax + dx}" y="${ay + dy + (arriba ? -14 : 14)}" text-anchor="${ancla}">${sub}</text>` : '';
        return `<circle cx="${ax}" cy="${ay}" r="5" fill="var(--c)" stroke="#fff" stroke-width="2"/>
          <text class="anota" x="${ax + dx}" y="${ay + dy}" text-anchor="${ancla}">${txt}</text>${linea2}`;
      };
      cont.innerHTML = `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" aria-hidden="true">
        ${lineas.join('')}${etiquetas}
        <path d="${tramo(0, ultimoEst)}" fill="none" stroke="var(--c)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
        <path d="${tramo(ultimoEst, serie.length - 1)}" fill="none" stroke="var(--c)" stroke-width="2" stroke-dasharray="5 4" stroke-linecap="round"/>
        ${anota(iB, miles(vals[iB]) + ' · ' + esc(serie[iB].mes), '', false, 'start')}
        ${iC >= 0 ? anota(iC, 'Mes ' + (iC + 1), 'vuelve a positivo', true, 'end') : ''}
        <line id="caja-cruz" x1="0" x2="0" y1="${mt}" y2="${H - mb}" stroke="var(--soft)" stroke-width="1" opacity="0"/>
        <circle id="caja-punto" r="5" fill="var(--amber)" stroke="#fff" stroke-width="2" opacity="0"/>
        <rect x="${ml}" y="0" width="${W - ml - mr}" height="${H}" fill="transparent" id="caja-hit"/>
      </svg>`;
      const t = tooltip(cont), cruz = cont.querySelector('#caja-cruz')!, punto = cont.querySelector('#caja-punto')!, hit = cont.querySelector('#caja-hit')!;
      const mover = (ev: PointerEvent) => {
        const r = (cont.querySelector('svg') as SVGSVGElement).getBoundingClientRect();
        const i = Math.max(0, Math.min(serie.length - 1, Math.round(((ev.clientX - r.left - ml) / (W - ml - mr)) * (serie.length - 1))));
        const s = serie[i], px = x(i), py = y(s.acumulado);
        cruz.setAttribute('x1', String(px)); cruz.setAttribute('x2', String(px)); cruz.setAttribute('opacity', '1');
        punto.setAttribute('cx', String(px)); punto.setAttribute('cy', String(py)); punto.setAttribute('opacity', '1');
        const delta = i > 0 ? s.acumulado - serie[i - 1].acumulado : s.acumulado;
        t.ver(`<b>${esc(s.mes)}</b> · ${s.tipo}<br>Acumulado: <b>${mxn(s.acumulado)}</b><br>En el mes: ${mxn(delta)}`, px, py);
      };
      hit.addEventListener('pointermove', mover as EventListener);
      hit.addEventListener('pointerdown', mover as EventListener);
      hit.addEventListener('pointerleave', () => { t.ocultar(); cruz.setAttribute('opacity', '0'); punto.setAttribute('opacity', '0'); });
    }
    function graficaHoras() {
      const cont = $('#g-horas'); const hm = d.horas_miguel;
      if (!cont || !hm || !hm.serie) return;
      const s: any[] = hm.serie;
      const W = Math.max(280, cont.clientWidth), chico = W < 560, H = 210;
      const ml = 34, mr = 8, mt = 22, mb = 28, yMax = 10;
      const banda = (W - ml - mr) / s.length, bw = Math.min(30, banda * 0.68);
      const y = (v: number) => mt + ((yMax - v) * (H - mt - mb)) / yMax;
      const y0 = y(0);
      const barras = s.map((p, i) => {
        const bx = ml + i * banda + (banda - bw) / 2, by = y(p.h), r = Math.min(4, bw / 2, y0 - by);
        return `<path d="M${bx},${y0}V${by + r}Q${bx},${by} ${bx + r},${by}H${bx + bw - r}Q${bx + bw},${by} ${bx + bw},${by + r}V${y0}Z" fill="var(--c)"/>`;
      }).join('');
      const k = chico ? 3 : 1;
      const etiquetas = s.map((p, i) => (i % k === 0 ? `<text class="eje-t" x="${ml + i * banda + banda / 2}" y="${H - 9}" text-anchor="middle">${esc(chico ? p.mes : p.mes.slice(0, 3))}</text>` : '')).join('');
      const rej = [0, 5, 10].map((v) => `<line class="${v === 0 ? 'cero' : 'rej'}" x1="${ml}" x2="${W - mr}" y1="${y(v)}" y2="${y(v)}"/><text class="eje-t" x="${ml - 6}" y="${y(v) + 4}" text-anchor="end">${v} h</text>`).join('');
      const extremos = [0, s.length - 1].map((i) => `<text class="anota" x="${ml + i * banda + banda / 2}" y="${y(s[i].h) - 6}" text-anchor="middle">${s[i].h.toLocaleString('es-MX')} h</text>`).join('');
      const hits = s.map((p, i) => `<rect x="${ml + i * banda}" y="${mt}" width="${banda}" height="${H - mt - mb}" fill="transparent" data-i="${i}"/>`).join('');
      cont.innerHTML = `<svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}" aria-hidden="true">
        ${rej}${barras}${etiquetas}${extremos}
        <line x1="${ml}" x2="${W - mr}" y1="${y(hm.meta)}" y2="${y(hm.meta)}" stroke="var(--amber-t)" stroke-width="1.5" stroke-dasharray="5 4"/>
        <text class="anota" x="${W - mr}" y="${y(hm.meta) - 6}" text-anchor="end" style="fill:var(--amber-t)">meta: menos de ${hm.meta} h</text>
        ${hits}
      </svg>`;
      const t = tooltip(cont);
      cont.querySelectorAll('rect[data-i]').forEach((r) => {
        const ver = () => { const i = +(r as SVGRectElement).dataset.i!; t.ver(`<b>${esc(s[i].mes)}</b><br>${s[i].h.toLocaleString('es-MX')} h por semana`, ml + i * banda + banda / 2, y(s[i].h)); };
        r.addEventListener('pointerenter', ver); r.addEventListener('pointerdown', ver);
        r.addEventListener('pointerleave', () => t.ocultar());
      });
    }
    graficaCaja(); graficaHoras();
    let anchoPrevio = innerWidth, tRes = 0;
    addEventListener('resize', () => { if (innerWidth === anchoPrevio) return; anchoPrevio = innerWidth; clearTimeout(tRes); tRes = window.setTimeout(() => { graficaCaja(); graficaHoras(); }, 150); });

    /* ── Reparto entre capital y trabajo ── */
    const rep: any = fin.reparto;
    const segRep = $('#seg-reparto');
    if (rep && segRep) {
      const ests: any[] = rep.estructuras || [];
      const escNombres = ['Lento', 'Base', 'Fuerte'];
      const maxX = Math.max(1.2, ...ests.flatMap((e) => escNombres.map((n) => (e.recibe[n] || [0, 0])[1]))) * 1.1;
      let iRep = Math.max(0, ests.findIndex((e) => e.recomendada));
      segRep.innerHTML = ests.map((e, i) => `<button type="button" data-i="${i}" aria-pressed="${i === iRep}">${esc(e.id)} · ${esc(e.nombre)}${e.recomendada ? ' ★' : ''}</button>`).join('');
      const pintarRep = () => {
        const e = ests[iRep]; if (!e) return;
        $('#reparto-regla')!.textContent = e.regla + (e.recomendada ? ' Es la recomendada como base para negociar.' : '');
        $('#reparto-barras')!.innerHTML = escNombres.map((n) => {
          const [m, xv] = e.recibe[n] || [0, 0];
          const cap = (rep.capital && rep.capital[n]) || 0;
          return `<div class="mult"><span><b>${n}</b></span>
            <div class="pista" style="--v:${(100 * xv) / maxX}%;--u:${100 / maxX}%"><i></i><span class="uno" title="Recupera su capital"></span></div>
            <span class="val"><b>${xv.toLocaleString('es-MX', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} veces</b> su capital · recibe ${mxn(m)} de ${mxn(cap)} que puso</span></div>`;
        }).join('');
      };
      segmentado(segRep, (b) => { iRep = +b.dataset.i!; pintarRep(); });
      pintarRep();
    }

    /* ── Decisiones ── */
    const decs: any[] = d.decisiones || [];
    const votos: Record<string, string> = (() => { try { return JSON.parse(leer('ep-votos') || '{}'); } catch { return {}; } })();
    function pintarVotos() {
      $$('.decision').forEach((el) => {
        const q = el.dataset.q!;
        $$('.chip', el).forEach((c) => c.setAttribute('aria-pressed', String(votos[q] === c.dataset.op)));
      });
      $('#dec-cuenta')!.textContent = `${Object.keys(votos).filter((k) => votos[k]).length} de ${decs.length} decididas`;
    }
    $('#decisiones')!.addEventListener('click', (e) => {
      const c = (e.target as HTMLElement).closest('.chip') as HTMLElement | null; if (!c) return;
      const q = (c.closest('.decision') as HTMLElement).dataset.q!;
      votos[q] = votos[q] === c.dataset.op ? '' : c.dataset.op!;
      guardar('ep-votos', JSON.stringify(votos));
      pintarVotos();
    });
    $('#dec-copiar')!.addEventListener('click', async () => {
      const txt = 'Voz Durango · mis respuestas\n\n' + decs.map((q, i) => `${i + 1}. ${q.pregunta}\n   → ${votos[i] || '(sin decidir)'}`).join('\n');
      const b = $('#dec-copiar')!;
      try {
        if (navigator.share && matchMedia('(pointer: coarse)').matches) await navigator.share({ text: txt });
        else { await navigator.clipboard.writeText(txt); b.textContent = 'Copiado ✓'; setTimeout(() => (b.textContent = 'Copiar mis respuestas'), 1800); }
      } catch { /* el usuario canceló */ }
    });
    pintarVotos();
  </script>
</body>
</html>
