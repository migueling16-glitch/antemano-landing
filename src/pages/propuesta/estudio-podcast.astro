            <span class="g-lab"></span>
            <div class="g-pista">
              {anios.map((a) => <span class="g-anio" style={`grid-column:${a.a + 1} / ${a.b + 2}`}>{a.t}</span>)}
              {mesesEje.map((m, i) => <span class="g-mes" style={`grid-column:${i + 1}`}>{m[0]}</span>)}
            </div>
          </div>
          {(D.hitos || []).map((h: any) => {
